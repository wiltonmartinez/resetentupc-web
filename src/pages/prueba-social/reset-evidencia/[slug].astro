---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { NUCLEO_API_BASE_URL, WHATSAPP_NUMBER } from "../../../config/site";
import { parseResetEvidenciaSlug, generateResetEvidenciaSlug } from "../../../lib/slug-generator";

const locale = "es" as const;
const { slug } = Astro.params;

if (!slug) return Astro.redirect("/prueba-social/reset-evidencia/");

const parsed = parseResetEvidenciaSlug(slug);
if (!parsed) return Astro.redirect("/prueba-social/reset-evidencia/");

let evidencia: any = null;

try {
  const response = await fetch(`${NUCLEO_API_BASE_URL}/api/public/reset-realizados/`, { timeout: 10000 });
  if (response.ok) {
    const data = await response.json();
    const evidencias = data?.data && Array.isArray(data.data) ? data.data : [];
    const found = evidencias.find((e: any) => e.slug === slug);
    evidencia = found;
  }
} catch (error) {
  console.error("Error fetching evidencia:", error);
}

if (!evidencia) return Astro.redirect("/prueba-social/reset-evidencia/");

const youtubeId = evidencia.youtube_id || (evidencia.enlace_youtube ? (
  (() => {
    const patterns = [/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\n?#]+)/, /^([a-zA-Z0-9_-]{11})$/];
    for (const pattern of patterns) {
      const match = evidencia.enlace_youtube.match(pattern);
      if (match) return match[1];
    }
    return null;
  })()
) : null);
---

<BaseLayout
  title={`${evidencia.marca} ${evidencia.modelo} - Reset Evidencia - ResetEnLinea`}
  description={`Video: Reset exitoso ${evidencia.marca} ${evidencia.modelo} en ${evidencia.pais} - ${evidencia.duracion_video}`}
  locale={locale}
  path={`/prueba-social/reset-evidencia/${slug}/`}
  wide
>
  <article class="evidencia-detail">
    <header class="detail-header">
      <a href="/prueba-social/reset-evidencia/" class="back-link">← Volver a evidencias</a>
      <h1>{evidencia.marca} {evidencia.modelo}</h1>
      <div class="meta">
        <span>⏱️ {evidencia.duracion_video}</span>
        <span>📍 {evidencia.pais}</span>
      </div>
    </header>

    <section class="detail-video">
      {youtubeId ? (
        <iframe width="100%" height="600" src={`https://www.youtube.com/embed/${youtubeId}`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      ) : (
        <div class="video-placeholder"><p>Video no disponible</p></div>
      )}
    </section>

    <section class="detail-content">
      <div class="content-main">
        <h2>Reset Exitoso</h2>
        <p>Este video muestra el reset exitoso de una <strong>{evidencia.marca} {evidencia.modelo}</strong> realizado en <strong>{evidencia.pais}</strong>. El proceso se completó en <strong>{evidencia.duracion_video}</strong>. Error resuelto: <strong>{evidencia.error}</strong></p>
        <h2>Validación del Reset</h2>
        <p>La comprobación visual del contador en 0% garantiza que el reset se realizó correctamente y que tu impresora está lista para continuar funcionando sin restricciones.</p>
      </div>

      <aside class="content-cta">
        <div class="cta-box">
          <h3>¿Necesitas un reset similar?</h3>
          <p>Contáctanos para tu solución</p>
          <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hola, vi el video de reset ${evidencia.marca} ${evidencia.modelo} y necesito lo mismo para mi impresora`)}`} class="cta-button">Contactar por WhatsApp</a>
        </div>
      </aside>
    </section>
  </article>
</BaseLayout>

<style>
  .evidencia-detail { max-width: 1200px; margin: 0 auto; }
  .detail-header { padding: 2rem 1rem; border-bottom: 1px solid #e5e7eb; }
  .back-link { color: #1e40af; text-decoration: none; font-weight: 600; }
  .detail-header h1 { font-size: 2.5rem; font-weight: 700; color: #1f2937; margin: 0.5rem 0; }
  .meta { display: flex; gap: 1.5rem; font-size: 0.95rem; color: #9ca3af; }
  .detail-video { padding: 2rem 1rem; background: #000; aspect-ratio: 16 / 9; }
  .detail-video iframe { border-radius: 8px; }
  .video-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; }
  .detail-content { padding: 2rem 1rem; display: grid; grid-template-columns: 1fr 300px; gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .content-main h2 { font-size: 1.5rem; font-weight: 700; color: #1f2937; margin-top: 2rem; }
  .content-main h2:first-child { margin-top: 0; }
  .content-main p { color: #6b7280; line-height: 1.8; }
  .content-cta { display: flex; }
  .cta-box { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 2rem; border-radius: 12px; text-align: center; position: sticky; top: 100px; }
  .cta-box h3 { font-size: 1.1rem; font-weight: 700; margin: 0 0 0.5rem 0; }
  .cta-box p { font-size: 0.9rem; margin: 0 0 1.5rem 0; }
  .cta-button { display: inline-block; padding: 0.75rem 1.5rem; background: white; color: #059669; text-decoration: none; font-weight: 700; border-radius: 8px; }
  @media (max-width: 768px) { .detail-header h1 { font-size: 1.8rem; } .detail-video { aspect-ratio: auto; min-height: 300px; } .detail-content { grid-template-columns: 1fr; } .cta-box { position: static; } }
</style>
