---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/ui/YouTubeFacade.astro";
import { obtenerResetRealizadoPorSlug, tituloConRespaldo } from "../../../lib/nucleo-api";
import { buildLocalizedPath, t } from "../../../i18n/utils";

const locale = "es" as const;
const { slug } = Astro.params;
const evidencia = slug ? await obtenerResetRealizadoPorSlug(slug) : null;

if (!evidencia) {
  Astro.response.status = 404;
}

// El título (y por lo tanto el slug, que se deriva de él) se calculan UNA
// sola vez en Núcleo al crear el registro — nunca aquí en vivo. Reconstruirlo
// en Astro con otra lógica (o llamando de nuevo a la API de YouTube en cada
// visita) es lo que causaba que título y slug quedaran desincronizados.
const titulo = evidencia ? tituloConRespaldo(evidencia) : "";
const duracion = evidencia ? evidencia.duracion_video : "";

// Mismos datos del título, tejidos en el cuerpo de la página (evita que el
// contenido visible quede "vacío" de las palabras clave del título/slug).
const resumenContenido = evidencia
  ? t(locale, "resetRealizadosPage.resumenContenido")
      .replaceAll("{marca}", evidencia.marca)
      .replaceAll("{modelo}", evidencia.modelo)
      .replaceAll("{error}", evidencia.error)
      .replaceAll("{pais}", evidencia.pais)
      .replaceAll("{duracion}", duracion || "")
  : "";
---

{evidencia ? (
  <BaseLayout
    title={`${titulo} | ResetEnLinea.com`}
    description={evidencia.descripcion || titulo}
    locale={locale}
    path={`/prueba-social/reset-evidencia/${evidencia.slug}/`}
  >
    <Breadcrumb
      items={[
        { label: t(locale, "nav.home"), href: "/" },
        { label: t(locale, "nav.pruebaSocial"), href: "/prueba-social/" },
        { label: t(locale, "resetRealizadosPage.heading"), href: "/prueba-social/reset-evidencia/" },
        { label: titulo },
      ]}
    />
    <h1>{titulo}</h1>
    <p class="rr-resumen">{resumenContenido}</p>
    <YouTubeFacade
      youtubeId={evidencia.youtube_id}
      titulo={titulo}
      descripcion={evidencia.descripcion}
      reproducirLabel={t(locale, "pruebaSocialPage.reproducirVideo")}
    />
    <dl class="rr-detalle-datos">
      <div><dt>{t(locale, "resetRealizadosPage.marca")}</dt><dd>{evidencia.marca}</dd></div>
      <div><dt>{t(locale, "resetRealizadosPage.modelo")}</dt><dd>{evidencia.modelo}</dd></div>
      <div><dt>{t(locale, "resetRealizadosPage.error")}</dt><dd>{evidencia.error}</dd></div>
      <div><dt>{t(locale, "resetRealizadosPage.pais")}</dt><dd>{evidencia.pais}</dd></div>
      {duracion && <div><dt>{t(locale, "resetRealizadosPage.duracion")}</dt><dd>{duracion}</dd></div>}
    </dl>
    <p class="rr-volver">
      <a href="/prueba-social/reset-evidencia/">{t(locale, "resetRealizadosPage.volverLink")}</a>
    </p>
  </BaseLayout>
) : (
  <BaseLayout
    title="Página no encontrada | ResetEnLinea.com"
    description="La página que buscas no existe o fue movida."
    locale={locale}
    path="/prueba-social/reset-evidencia/no-encontrado/"
    noindex
  >
    <section class="not-found">
      <h1>Página no encontrada</h1>
      <p>La página que buscas no existe o fue movida.</p>
      <a href={buildLocalizedPath(locale, "/prueba-social/reset-evidencia/")}>{t(locale, "resetRealizadosPage.volverLink")}</a>
    </section>
  </BaseLayout>
)}

<style>
  .rr-detalle-datos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin: 0;
  }

  .rr-detalle-datos div {
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
  }

  .rr-detalle-datos dt {
    font-size: 0.78rem;
    color: var(--color-text-subtle);
  }

  .rr-detalle-datos dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
    color: var(--color-text);
  }

  .rr-resumen {
    color: var(--color-text-subtle);
  }

  .rr-volver {
    text-align: center;
  }

  .not-found {
    text-align: center;
    padding: 3rem 0;
  }
</style>
