---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResetEvidenciaDetailPage from "../../../components/pages/ResetEvidenciaDetailPage.astro";
import { obtenerResetRealizadoPorSlug, tituloConRespaldo } from "../../../lib/nucleo-api";
import { buildLocalizedPath, t } from "../../../i18n/utils";

const locale = "es" as const;
const { slug } = Astro.params;
const evidencia = slug ? await obtenerResetRealizadoPorSlug(slug) : null;

if (!evidencia) {
  Astro.response.status = 404;
}

const titulo = evidencia ? tituloConRespaldo(evidencia) : "";
---

{evidencia ? (
  <BaseLayout
  wide
    title={`${titulo} | ResetEnLinea.com`}
    description={evidencia.descripcion || titulo}
    locale={locale}
    path={`/prueba-social/reset-evidencia/${evidencia.slug}/`}
  >
    <ResetEvidenciaDetailPage locale={locale} evidencia={evidencia} />
  </BaseLayout>
) : (
  <BaseLayout
  wide
    title="Página no encontrada | ResetEnLinea.com"
    description="La página que buscas no existe o fue movida."
    locale={locale}
    path="/prueba-social/reset-evidencia/no-encontrado/"
    noindex
  >
    <section class="not-found">
      <h1>Página no encontrada</h1>
      <p>La página que buscas no existe o fue movida.</p>
      <a href={buildLocalizedPath(locale, "/prueba-social/reset-evidencia/")}>{t(locale, "resetRealizadosPage.volverLink")}</a>
    </section>
  </BaseLayout>
)}

<style>
  .not-found {
    text-align: center;
    padding: 3rem 0;
  }
</style>
