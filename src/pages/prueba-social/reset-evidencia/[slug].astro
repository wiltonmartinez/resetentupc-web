---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { NUCLEO_API_BASE_URL, WHATSAPP_NUMBER } from "../../../config/site";
import { parseResetEvidenciaSlug, generateResetEvidenciaSlug } from "../../../lib/slug-generator";
import { fetchAllPages } from "../../../lib/fetch-paginated";
import { extractYoutubeId, buildYoutubeEmbedUrl } from "../../../lib/youtube";

export const prerender = false;

const locale = "es" as const;
const { slug } = Astro.params;

if (!slug) return Astro.redirect("/prueba-social/reset-evidencia/");

const parsed = parseResetEvidenciaSlug(slug);
if (!parsed) return Astro.redirect("/prueba-social/reset-evidencia/");

let evidencia: any = null;

try {
  const evidencias = await fetchAllPages(`${NUCLEO_API_BASE_URL}/api/public/reset-realizados/`);
  evidencia = evidencias.find((e: any) => e.slug === slug);
} catch (error) {
  console.error("Error fetching evidencia:", error);
}

if (!evidencia) return Astro.redirect("/prueba-social/reset-evidencia/");

const youtubeId = extractYoutubeId(evidencia.youtube_id) || extractYoutubeId(evidencia.enlace_youtube);
const youtubeEmbedUrl = youtubeId ? buildYoutubeEmbedUrl(youtubeId) : null;

const MODALIDAD_LARGA = "Reset Asistido 100% Remoto por conexión USB";

const accion = parsed.accion.charAt(0).toUpperCase() + parsed.accion.slice(1);
const pageTitle = `${accion} ${evidencia.marca} ${evidencia.modelo} en ${evidencia.pais} por ${evidencia.duracion_video}`;
---

<BaseLayout
  title={`${pageTitle} - ResetEntuPC`}
  description={`${MODALIDAD_LARGA}: ${pageTitle}`}
  locale={locale}
  path={`/prueba-social/reset-evidencia/${slug}/`}
  wide
>
  <article class="evidencia-detail">
    <header class="detail-header">
      <a href="/prueba-social/reset-evidencia/" class="back-link">← Volver a evidencias</a>
      <h1>{pageTitle}</h1>
      <p class="modalidad">{MODALIDAD_LARGA}</p>
      <div class="meta">
        <span>⏱️ {evidencia.duracion_video}</span>
        <span>📍 {evidencia.pais}</span>
      </div>
    </header>

    <section class="detail-video">
      {youtubeEmbedUrl ? (
        <iframe
          width="100%"
          height="600"
          src={youtubeEmbedUrl}
          title={`Video: reset ${evidencia.marca} ${evidencia.modelo}`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      ) : (
        <div class="video-placeholder"><p>Video no disponible</p></div>
      )}
    </section>

    <section class="detail-content">
      <div class="content-main">
        <h2>Reset Exitoso</h2>
        <p>Este video muestra un <strong>{MODALIDAD_LARGA}</strong> realizado con éxito en una <strong>{evidencia.marca} {evidencia.modelo}</strong>, en <strong>{evidencia.pais}</strong>. El proceso se completó en <strong>{evidencia.duracion_video}</strong>. Error resuelto: <strong>{evidencia.error}</strong></p>
        <h2>Validación del Reset</h2>
        <p>La comprobación visual del contador en 0% garantiza que el reset se realizó correctamente y que tu impresora está lista para continuar funcionando sin restricciones.</p>
      </div>

      <aside class="content-cta">
        <div class="cta-box">
          <h3>¿Necesitas un reset similar?</h3>
          <p>Contáctanos para tu solución</p>
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hola, vi el video de reset ${evidencia.marca} ${evidencia.modelo} y necesito lo mismo para mi impresora`)}`}
            class="cta-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="whatsapp-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2Zm5.8 14.16c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.12.11-1.8-.11a17.6 17.6 0 0 1-1.65-.61c-2.9-1.25-4.8-4.17-4.94-4.36-.14-.2-1.19-1.58-1.19-3.01 0-1.43.75-2.13 1.02-2.42.27-.29.59-.36.79-.36l.56.01c.18.01.43-.07.67.51.25.6.85 2.08.92 2.23.07.15.12.32.02.51-.1.2-.15.32-.29.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.29.75 1.22 1.6 1.98 1.11.98 2.04 1.29 2.33 1.44.29.15.46.13.63-.07.17-.2.71-.83.9-1.11.19-.29.38-.24.63-.14.26.1 1.63.77 1.91.91.28.15.46.22.53.34.07.13.07.71-.17 1.4Z" />
            </svg>
            <span>Contactar por WhatsApp</span>
          </a>
        </div>

        <div class="info-box">
          <h3>Ficha del servicio</h3>
          <dl class="info-list">
            <div class="info-row">
              <dt>Marca</dt>
              <dd>{evidencia.marca}</dd>
            </div>
            <div class="info-row">
              <dt>Modelo</dt>
              <dd>{evidencia.modelo}</dd>
            </div>
            {evidencia.error && (
              <div class="info-row">
                <dt>Problema resuelto</dt>
                <dd>{evidencia.error}</dd>
              </div>
            )}
            {evidencia.pais && (
              <div class="info-row">
                <dt>País</dt>
                <dd>{evidencia.pais}</dd>
              </div>
            )}
            {evidencia.duracion_video && (
              <div class="info-row">
                <dt>Duración del proceso</dt>
                <dd>{evidencia.duracion_video}</dd>
              </div>
            )}
            {evidencia.fecha_servicio && (
              <div class="info-row">
                <dt>Fecha del servicio</dt>
                <dd>{new Date(evidencia.fecha_servicio).toLocaleDateString("es", { year: "numeric", month: "long", day: "numeric" })}</dd>
              </div>
            )}
            <div class="info-row">
              <dt>Modalidad</dt>
              <dd>{MODALIDAD_LARGA}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </section>
  </article>
</BaseLayout>

<style>
  .evidencia-detail { max-width: 1200px; margin: 0 auto; }
  .detail-header { padding: 2rem 1rem; border-bottom: 1px solid #e5e7eb; }
  .back-link { color: #1e40af; text-decoration: none; font-weight: 600; }
  .detail-header h1 { font-size: 2.5rem; font-weight: 700; color: #1f2937; margin: 0.5rem 0; }
  .modalidad { font-size: 1.1rem; color: #059669; font-weight: 600; margin: 0 0 1rem 0; }
  .meta { display: flex; gap: 1.5rem; font-size: 0.95rem; color: #9ca3af; }
  .detail-video { padding: 2rem 1rem; background: #000; aspect-ratio: 16 / 9; }
  .detail-video iframe { border-radius: 8px; }
  .video-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; }
  .detail-content { padding: 2rem 1rem; display: grid; grid-template-columns: 1fr 300px; gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .content-main h2 { font-size: 1.5rem; font-weight: 700; color: #1f2937; margin-top: 2rem; }
  .content-main h2:first-child { margin-top: 0; }
  .content-main p { color: #6b7280; line-height: 1.8; }
  .content-cta { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 100px; align-self: start; }
  .cta-box { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 2rem; border-radius: 12px; text-align: center; }
  .cta-box h3 { font-size: 1.1rem; font-weight: 700; margin: 0 0 0.5rem 0; }
  .cta-box p { font-size: 0.9rem; margin: 0 0 1.5rem 0; }
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 1.75rem;
    background: #ffffff;
    color: #128c7e;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.98rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cta-button:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22); }
  .cta-button:active { transform: translateY(-1px) scale(1); }
  .whatsapp-icon { width: 22px; height: 22px; flex-shrink: 0; fill: #25d366; }

  .info-box { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.5rem; }
  .info-box h3 { font-size: 1rem; font-weight: 700; color: #1f2937; margin: 0 0 1rem 0; }
  .info-list { margin: 0; }
  .info-row { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; padding: 0.6rem 0; border-bottom: 1px solid #f3f4f6; }
  .info-row:last-child { border-bottom: none; padding-bottom: 0; }
  .info-row dt { font-size: 0.8rem; color: #9ca3af; margin: 0; white-space: nowrap; }
  .info-row dd { font-size: 0.85rem; color: #1f2937; font-weight: 600; margin: 0; text-align: right; }

  @media (max-width: 768px) { .detail-header h1 { font-size: 1.8rem; } .detail-video { aspect-ratio: auto; min-height: 300px; } .detail-content { grid-template-columns: 1fr; } .content-cta { position: static; } }
</style>
