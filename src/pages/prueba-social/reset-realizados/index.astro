---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ResetRealizadoCard from "../../../components/ui/ResetRealizadoCard.astro";
import { listarResetRealizados } from "../../../lib/nucleo-api";
import { t } from "../../../i18n/utils";

const locale = "es" as const;

const paginaSolicitada = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const pagina = Number.isFinite(paginaSolicitada) && paginaSolicitada > 0 ? paginaSolicitada : 1;
const { data: resets, meta } = await listarResetRealizados(pagina, 12);
---

<BaseLayout
  title={t(locale, "resetRealizadosPage.title")}
  description={t(locale, "resetRealizadosPage.description")}
  locale={locale}
  path="/prueba-social/reset-realizados/"
>
  <Breadcrumb
    items={[
      { label: t(locale, "nav.home"), href: "/" },
      { label: t(locale, "nav.pruebaSocial"), href: "/prueba-social/" },
      { label: t(locale, "resetRealizadosPage.heading") },
    ]}
  />
  <h1>{t(locale, "resetRealizadosPage.heading")}</h1>
  <p>{t(locale, "pruebaSocialPage.resetsTexto")}</p>

  {resets.length > 0 ? (
    <div class="rr-index-grid">
      {resets.map((evidencia) => (
        <ResetRealizadoCard evidencia={evidencia} />
      ))}
    </div>
  ) : (
    <p class="rr-index-vacio">{t(locale, "resetRealizadosPage.sinRegistros")}</p>
  )}

  {meta.total_pages > 1 && (
    <nav class="rr-index-paginacion" aria-label="Paginación">
      {meta.page > 1 && <a href={`/prueba-social/reset-realizados/?page=${meta.page - 1}`}>{t(locale, "common.paginaAnterior")}</a>}
      <span>{meta.page} / {meta.total_pages}</span>
      {meta.page < meta.total_pages && <a href={`/prueba-social/reset-realizados/?page=${meta.page + 1}`}>{t(locale, "common.paginaSiguiente")}</a>}
    </nav>
  )}
</BaseLayout>

<style>
  .rr-index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
  }

  .rr-index-vacio {
    text-align: center;
    color: var(--color-text-subtle);
  }

  .rr-index-paginacion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .rr-index-paginacion a {
    text-decoration: none;
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
