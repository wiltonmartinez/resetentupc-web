---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import ClienteSatisfechoIndexPage from "../../../components/pages/ClienteSatisfechoIndexPage.astro";
import { listarClienteSatisfecho } from "../../../lib/nucleo-api";
import { t } from "../../../i18n/utils";

const locale = "es" as const;

const paginaSolicitada = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const pagina = Number.isFinite(paginaSolicitada) && paginaSolicitada > 0 ? paginaSolicitada : 1;
const { data: evidencias, meta } = await listarClienteSatisfecho(pagina, 12);
---

<BaseLayout
  title={t(locale, "clienteSatisfechoPage.title")}
  description={t(locale, "clienteSatisfechoPage.description")}
  locale={locale}
  path="/prueba-social/cliente-satisfecho/"
>
  <ClienteSatisfechoIndexPage locale={locale} evidencias={evidencias} meta={meta} />
</BaseLayout>
