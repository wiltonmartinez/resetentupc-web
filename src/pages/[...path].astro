---
// Catch-all: cualquier ruta que no coincida con ninguna página real cae aquí.
// Existe para que el middleware (que corre solo en rutas que Astro logra
// "matchear") se ejecute también en URLs viejas de WordPress que ya no
// corresponden a ningún patrón de ruta actual — de lo contrario Astro las
// resuelve directo a 404 sin pasar por el middleware.
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildLocalizedPath, detectLocaleFromPath, t } from "../i18n/utils";

export const prerender = false;

Astro.response.status = 404;

const locale = detectLocaleFromPath(Astro.url.pathname);
---

<BaseLayout
  wide
  title={t(locale, "notFound.title")}
  description={t(locale, "notFound.description")}
  locale={locale}
  path="/404/"
  noindex
>
  <section class="not-found">
    <h1>{t(locale, "notFound.heading")}</h1>
    <p>{t(locale, "notFound.texto")}</p>
    <a href={buildLocalizedPath(locale, "/")}>{t(locale, "notFound.volver")}</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 3rem 0;
  }
</style>
