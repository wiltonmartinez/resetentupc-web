---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactoPage from "../../components/pages/ContactoPage.astro";
import { t, buildStaticPagePath } from "../../i18n/utils";

const locale = "it" as const;
---

<BaseLayout
  wide
  title={t(locale, "contacto.title")}
  description={t(locale, "contacto.description")}
  locale={locale}
  path={buildStaticPagePath(locale, "contacto")}
  pageKey="contacto"
  ocultarBotonContacto
  ocultarNotificacionCompra
>
  <ContactoPage locale={locale} />
</BaseLayout>
