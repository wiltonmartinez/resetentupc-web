---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrustpilotWidget from "../components/TrustpilotWidget.astro";
import InfoCard from "../components/ui/InfoCard.astro";
import AyudaCTA from "../components/AyudaCTA.astro";
import Tabs from "../components/ui/Tabs.astro";
import ConversationGallery from "../components/ui/ConversationGallery.astro";
import YouTubeGallery from "../components/ui/YouTubeGallery.astro";
import { CONVERSACIONES, VIDEOS } from "../data/prueba-social";
import { t } from "../i18n/utils";

const locale = "es" as const;
---

<BaseLayout
  title={t(locale, "pruebaSocialPage.title")}
  description={t(locale, "pruebaSocialPage.description")}
  locale={locale}
  path="/prueba-social/"
  noindex
>
  <section class="prueba-social-intro">
    <h1>{t(locale, "pruebaSocialPage.heading")}</h1>
    <p>{t(locale, "pruebaSocialPage.introTexto")}</p>
    <TrustpilotWidget />
  </section>

  <InfoCard tone="muted">
    <Tabs
      tabs={[
        { id: "conversaciones", label: t(locale, "pruebaSocialPage.tabConversaciones") },
        { id: "resets", label: t(locale, "pruebaSocialPage.tabResets") },
      ]}
    >
      <div role="tabpanel" data-tab-panel="conversaciones" aria-labelledby="tab-conversaciones" id="panel-conversaciones">
        <h2>{t(locale, "pruebaSocialPage.conversacionesTitulo")}</h2>
        <p>{t(locale, "pruebaSocialPage.conversacionesTexto")}</p>
        <ConversationGallery
          conversaciones={CONVERSACIONES}
          ampliarLabel={t(locale, "pruebaSocialPage.ampliarConversacion")}
          cerrarLabel={t(locale, "pruebaSocialPage.cerrarModal")}
        />
      </div>
      <div role="tabpanel" data-tab-panel="resets" aria-labelledby="tab-resets" id="panel-resets" hidden>
        <h2>{t(locale, "pruebaSocialPage.resetsTitulo")}</h2>
        <p>{t(locale, "pruebaSocialPage.resetsTexto")}</p>
        <YouTubeGallery videos={VIDEOS} reproducirLabel={t(locale, "pruebaSocialPage.reproducirVideo")} />
      </div>
    </Tabs>
  </InfoCard>

  <InfoCard tone="accent">
    <h2>{t(locale, "pruebaSocialPage.ctaTitulo")}</h2>
    <AyudaCTA sourceId="prueba-social-cta" label={t(locale, "pruebaSocialPage.ctaBoton")} />
  </InfoCard>
</BaseLayout>

<style>
  .prueba-social-intro {
    display: grid;
    gap: 0.75rem;
    text-align: center;
  }

  [data-tab-panel] {
    display: grid;
    gap: 0.75rem;
  }

  [data-tab-panel] h2 {
    margin: 0;
  }

  [data-tab-panel] > p {
    margin: 0;
    max-width: 60ch;
  }
</style>
