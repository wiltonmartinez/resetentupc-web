---
import BaseLayout from "../layouts/BaseLayout.astro";
import ComoFuncionaPage from "../components/pages/ComoFuncionaPage.astro";
import { t } from "../i18n/utils";

const locale = "es" as const;
---

<BaseLayout
  title={t(locale, "comoFunciona.title")}
  description={t(locale, "comoFunciona.description")}
  locale={locale}
  path="/como-funciona/"
  pageKey="comoFunciona"
  ocultarBotonContacto
>
  <ComoFuncionaPage locale={locale} />
</BaseLayout>
