---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ClienteSatisfechoIndexPage from "../../../../components/pages/ClienteSatisfechoIndexPage.astro";
import { t } from "../../../../i18n/utils";
import { SUPPORTED_LOCALES, DEFAULT_LOCALE, type Locale } from "../../../../config/site";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout
  title={t(locale, "clienteSatisfechoPage.title")}
  description={t(locale, "clienteSatisfechoPage.description")}
  locale={locale}
  path="/prueba-social/cliente-satisfecho/"
  noindex
>
  <ClienteSatisfechoIndexPage locale={locale} />
</BaseLayout>
