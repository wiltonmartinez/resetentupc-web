---
/**
 * Igual que la versión "es" (sin prefijo) pero para en/pt/fr/it/de/ru — datos
 * en vivo desde la API pública de Núcleo, así que no puede ser prerenderizada.
 */
export const prerender = false;

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ResetEvidenciaIndexPage from "../../../../components/pages/ResetEvidenciaIndexPage.astro";
import { listarResetRealizados } from "../../../../lib/nucleo-api";
import { t } from "../../../../i18n/utils";
import { SUPPORTED_LOCALES, DEFAULT_LOCALE, type Locale } from "../../../../config/site";

const localeParam = Astro.params.locale ?? "";
const localeValida = SUPPORTED_LOCALES.includes(localeParam as Locale) && localeParam !== DEFAULT_LOCALE;
if (!localeValida) {
  Astro.response.status = 404;
}
const locale = (localeValida ? localeParam : DEFAULT_LOCALE) as Locale;

const paginaSolicitada = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const pagina = Number.isFinite(paginaSolicitada) && paginaSolicitada > 0 ? paginaSolicitada : 1;
const { data: resets, meta } = localeValida
  ? await listarResetRealizados(pagina, 12)
  : { data: [], meta: { page: 1, per_page: 0, total: 0, total_pages: 0 } };
---

{localeValida ? (
  <BaseLayout
  wide
    title={t(locale, "resetRealizadosPage.title")}
    description={t(locale, "resetRealizadosPage.description")}
    locale={locale}
    path="/prueba-social/reset-evidencia/"
  >
    <ResetEvidenciaIndexPage locale={locale} resets={resets} meta={meta} />
  </BaseLayout>
) : (
  <BaseLayout
  wide
    title="Página no encontrada | ResetEntuPC.com"
    description="La página que buscas no existe o fue movida."
    locale={locale}
    path="/404/"
    noindex
  >
    <section class="not-found">
      <h1>Página no encontrada</h1>
      <p>La página que buscas no existe o fue movida.</p>
      <a href="/">Volver al inicio</a>
    </section>
  </BaseLayout>
)}

<style>
  .not-found {
    text-align: center;
    padding: 3rem 0;
  }
</style>
