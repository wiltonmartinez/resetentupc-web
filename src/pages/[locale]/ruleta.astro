---
/**
 * Igual que la versión "es" (sin prefijo) pero para en/pt/fr/it/de/ru.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n/utils";
import { RULETA_URL, SUPPORTED_LOCALES, DEFAULT_LOCALE, type Locale } from "../../config/site";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout
  title={t(locale, "ruletaPage.title")}
  description={t(locale, "ruletaPage.description")}
  locale={locale}
  path="/ruleta/"
  noindex
>
  <section class="ruleta-page">
    <h1>{t(locale, "ruletaPage.heading")}</h1>
    <p>{t(locale, "ruletaPage.texto")}</p>
    <div class="ruleta-page-embed">
      <iframe src={RULETA_URL} title={t(locale, "ruletaPage.heading")} loading="lazy"></iframe>
    </div>
  </section>
</BaseLayout>

<style>
  .ruleta-page {
    display: grid;
    gap: 1rem;
  }

  .ruleta-page-embed {
    aspect-ratio: 4 / 5;
    max-height: 720px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .ruleta-page-embed iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
