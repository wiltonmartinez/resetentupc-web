---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePage from "../../components/pages/HomePage.astro";
import { t } from "../../i18n/utils";
import { SUPPORTED_LOCALES, DEFAULT_LOCALE, type Locale } from "../../config/site";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout title={t(locale, "home.title")} description={t(locale, "home.description")} locale={locale} path="/" wide>
  <HomePage locale={locale} />
</BaseLayout>
