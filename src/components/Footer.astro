---
import type { Locale } from "../config/site";
import { t, buildStaticPagePath } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <p>&copy; {new Date().getFullYear()} ResetEnLinea.com. {t(locale, "footer.rights")}</p>
    <p class="disclaimer">{t(locale, "footer.disclaimer")}</p>
    <nav class="site-footer-legal" aria-label={t(locale, "footer.legalInfoTitulo")}>
      <span class="site-footer-legal-titulo">{t(locale, "footer.legalInfoTitulo")}:</span>
      <a href={buildStaticPagePath(locale, "terminosCondiciones")}>{t(locale, "footer.terminosLink")}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-muted);
  }
  .site-footer-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-md);
    font-size: 0.85rem;
    color: var(--color-text-subtle);
  }
  .disclaimer {
    margin: 0.5rem 0 0;
  }

  .site-footer-legal {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .site-footer-legal-titulo {
    font-weight: 600;
  }

  .site-footer-legal a {
    color: var(--color-primary-dark);
  }
</style>
