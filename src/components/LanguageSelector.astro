---
import { LOCALE_LABELS, LOCALE_FLAGS, HREFLANG_BY_LOCALE, type Locale, type StaticPageKey } from "../config/site";
import { buildLocalizedPath, buildStaticPagePath, t } from "../i18n/utils";

interface Props {
  locale: Locale;
  path: string;
  pageKey?: StaticPageKey;
}

const { locale, path, pageKey } = Astro.props;
const label = t(locale, "common.selectLanguage");

// El selector ofrece activamente solo estos tres idiomas — fr/it/de/ru/ko
// siguen existiendo, funcionando y rastreables (no devuelven 404, se
// mantienen en el sitemap), simplemente ya no se promocionan en la
// navegación. Si el visitante ya está en uno de esos idiomas (llegó por un
// enlace viejo o un resultado de búsqueda), el botón sigue mostrando su
// idioma actual — solo el menú desplegable se limita a estos tres.
const LOCALES_VISIBLES: Locale[] = ["es", "en", "pt"];

// Prueba Social y Ruleta ya tienen ruta propia por idioma (ver
// [locale]/prueba-social.astro y [locale]/ruleta.astro) — solo queda "/404"
// como caso especial: esa página nunca tuvo contenido real que traducir,
// así que cambiar de idioma ahí manda a la portada de ese idioma en vez de
// a un "/{locale}/404/" que también sería un callejón sin salida.
const SECCIONES_SOLO_ESPANOL = ["/404"];
const esSeccionSoloEspanol = SECCIONES_SOLO_ESPANOL.some((prefijo) => path.startsWith(prefijo));

function hrefParaLocale(l: Locale): string {
  if (pageKey) return buildStaticPagePath(l, pageKey);
  // El idioma actual se queda en la página donde ya está — el fallback a
  // portada es solo para los OTROS idiomas, que no tienen esta sección.
  if (esSeccionSoloEspanol && l !== locale) return buildLocalizedPath(l, "/");
  return buildLocalizedPath(l, path);
}
---

<div class="language-selector" data-language-selector>
  <button type="button" class="language-selector-trigger" aria-haspopup="true" aria-expanded="false" aria-label={label}>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
      <path
        d="M3 12h18M12 3c2.4 2.4 3.6 5.6 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.6-3.6-9S9.6 5.4 12 3Z"
        stroke="currentColor"
        stroke-width="1.5"
      />
    </svg>
    <span class="language-selector-bandera" aria-hidden="true">{LOCALE_FLAGS[locale]}</span>
    <span class="language-selector-actual">{HREFLANG_BY_LOCALE[locale].split("-")[0].toUpperCase()}</span>
    <svg class="language-selector-chevron" viewBox="0 0 20 20" width="14" height="14" fill="none" aria-hidden="true">
      <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <ul class="language-selector-menu">
    {LOCALES_VISIBLES.map((l) => (
      <li>
        <a
          href={hrefParaLocale(l)}
          aria-current={l === locale ? "true" : undefined}
          data-locale={l}
          class="language-selector-link"
        >
          <span class="language-selector-bandera" aria-hidden="true">{LOCALE_FLAGS[l]}</span>
          {LOCALE_LABELS[l]}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const STORAGE_KEY = "resetenlinea_locale_preference";
  document.querySelectorAll(".language-selector-link").forEach((link) => {
    link.addEventListener("click", () => {
      const locale = link.getAttribute("data-locale");
      if (locale) localStorage.setItem(STORAGE_KEY, locale);
    });
  });
</script>

<style>
  .language-selector {
    position: relative;
    font-size: 0.85rem;
  }

  .language-selector-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-full);
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .language-selector-trigger:hover {
    color: #ffffff;
    border-color: #f97316;
  }

  .language-selector-actual {
    letter-spacing: 0.02em;
  }

  .language-selector-bandera {
    font-size: 0.95rem;
    line-height: 1;
  }

  .language-selector-chevron {
    color: rgba(255, 255, 255, 0.6);
    transition: transform 0.15s ease;
  }

  .language-selector:hover .language-selector-chevron,
  .language-selector:focus-within .language-selector-chevron {
    transform: rotate(180deg);
  }

  .language-selector-menu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.4rem;
    min-width: 160px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-floating);
    z-index: 40;
  }

  .language-selector:hover .language-selector-menu,
  .language-selector:focus-within .language-selector-menu {
    display: block;
  }

  .language-selector-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .language-selector-link:hover {
    background: var(--color-bg-muted);
    color: var(--color-primary);
  }

  .language-selector-link[aria-current="true"] {
    color: var(--color-primary);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .language-selector-menu {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.25rem;
      box-shadow: none;
      border: none;
      background: transparent;
      padding: 0.5rem 0 0;
      margin-top: 0;
    }

    .language-selector-link {
      color: rgba(255, 255, 255, 0.75);
    }

    .language-selector-link:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
    }

    .language-selector-link[aria-current="true"] {
      color: #f97316;
    }

    .language-selector-trigger {
      display: none;
    }
  }
</style>
