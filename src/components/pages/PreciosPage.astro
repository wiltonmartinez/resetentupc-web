  /* .precios-campo{display:grid} empata en especificidad con la regla nativa
     [hidden]{display:none} del navegador — como esta hoja de estilos carga
     después, gana la última y el paso "oculto" se seguía viendo. Sin esto,
     Familia/Modelo aparecían visibles antes de elegir marca. */
  [hidden] {
    display: none !important;
