---
import { Image, getImage } from "astro:assets";
import { t, buildWhatsAppMessage, buildWhatsAppLink } from "../../i18n/utils";
import { WHATSAPP_NUMBER, SITE_URL, type Locale } from "../../config/site";
import { paisesPrecioPublico, catalogoCascada, mapaErroresPublico, type PaisPrecioPublico } from "../../lib/precios";
import whatsappLogo from "../../assets/whatsapp/3.png";
import iconoClasico from "../../assets/branding/clasico.png";
import iconoPlus from "../../assets/branding/plus.png";
import iconoElite from "../../assets/branding/elite.png";

interface Props {
  locale: Locale;
  paisInicialSlug: string;
  urlPath: string;
  /** Precarga opcional (ej. enlace desde una página de modelo con
   *  ?marca=&modelo=&error=). El script valida marca/modelo contra el
   *  catálogo en el cliente; si no calzan, el selector en cascada
   *  simplemente arranca vacío en el Paso 1. */
  marca?: string;
  modelo?: string;
  error?: string;
  /** true si cf-ipcountry cae en Europa — solo cambia cuál de las 2 monedas
   *  (USD/EUR) viene seleccionada por defecto en países sin infraestructura
   *  bancaria local (ver esVisitanteEuropeo en lib/precios). El visitante
   *  siempre puede alternar a mano. */
  defaultEur?: boolean;
}

const { locale, paisInicialSlug, urlPath, marca = "", modelo = "", error = "", defaultEur = false } = Astro.props;

const paises = await paisesPrecioPublico();
const paisInicial: PaisPrecioPublico = paises.find((p) => p.slug === paisInicialSlug) ?? paises[0];
const urlOrigen = `${SITE_URL}${urlPath}`;
const catalogo = catalogoCascada();
const erroresMapa = mapaErroresPublico(locale);

// Íconos reales (no emoji) resueltos acá, no con el componente Image (que
// solo sirve dentro de markup .astro) para poder pasar la URL ya optimizada
// al script del cliente de más abajo, que arma las tarjetas de plan a mano
// con createElement.
const [iconoClasicoUrl, iconoPlusUrl, iconoEliteUrl] = await Promise.all([
  getImage({ src: iconoClasico, width: 64, height: 64 }),
  getImage({ src: iconoPlus, width: 64, height: 64 }),
  getImage({ src: iconoElite, width: 64, height: 64 }),
]).then((imgs) => imgs.map((img) => img.src));

// Orden de negocio: Reset Clásico/Esencial (izquierda) · Reset Plus/Profesional (centro, destacado) · Reset Elite (derecha).
const PLANES = [
  {
    key: "esencial" as const,
    icono: iconoClasicoUrl,
    nombre: t(locale, "preciosPage.planEsencialNombre"),
    duracion: t(locale, "preciosPage.planEsencialDuracion"),
    destacado: false,
  },
  {
    key: "profesional" as const,
    icono: iconoPlusUrl,
    nombre: t(locale, "preciosPage.planProfesionalNombre"),
    duracion: t(locale, "preciosPage.planProfesionalDuracion"),
    destacado: true,
  },
  {
    key: "elite" as const,
    icono: iconoEliteUrl,
    nombre: t(locale, "preciosPage.planEliteNombre"),
    duracion: t(locale, "preciosPage.planEliteDuracion"),
    destacado: false,
  },
];

const notaTemplate: string = t(locale, "preciosPage.notaWhatsapp");
const mensajeTemplate: string = t(locale, "whatsapp.greetingConPlan");

// El CTA general (abajo del todo) es independiente de la cascada — solo
// menciona el país, para quien prefiere escribir directo sin completar los
// 3 pasos.
const mensajeGeneral = buildWhatsAppMessage({
  locale,
  nota: t(locale, "preciosPage.metodosPagoTitulo").replaceAll("{pais}", paisInicial.nombre),
  urlOrigen,
});
const hrefGeneral = buildWhatsAppLink(WHATSAPP_NUMBER, mensajeGeneral);
---

<article
  class="precios-page"
  data-precios-page
  data-paises={JSON.stringify(paises)}
  data-catalogo={JSON.stringify(catalogo)}
  data-errores={JSON.stringify(erroresMapa)}
  data-prefill-marca={marca}
  data-prefill-modelo={modelo}
  data-prefill-error={error}
  data-default-eur={defaultEur ? "true" : "false"}
  data-whatsapp-numero={WHATSAPP_NUMBER}
  data-url-origen={urlOrigen}
  data-nota-template={notaTemplate}
  data-mensaje-template={mensajeTemplate}
  data-precio-no-disponible={t(locale, "preciosPage.precioNoDisponible")}
  data-cta-plan={t(locale, "preciosPage.ctaPlan")}
  data-metodos-titulo-template={t(locale, "preciosPage.metodosPagoTitulo")}
  data-metodos-internacionales-subtitulo={t(locale, "preciosPage.metodosInternacionalesSubtitulo")}
  data-mas-popular={t(locale, "preciosPage.masPopular")}
  data-familia-placeholder={t(locale, "preciosPage.familiaPlaceholder")}
  data-modelo-placeholder={t(locale, "preciosPage.modeloPlaceholder")}
  data-disclaimer-epson={t(locale, "preciosPage.errorDisclaimerEpson")}
  data-disclaimer-canon={t(locale, "preciosPage.errorDisclaimerCanon")}
  data-disclaimer-epson-sc-codigo0014bd={t(locale, "preciosPage.errorDisclaimerEpsonSc0014bd")}
  data-disclaimer-epson-sc-otro={t(locale, "preciosPage.errorDisclaimerEpsonScOtro")}
  data-bloque-local-titulo-template={t(locale, "preciosPage.bloqueLocalTitulo")}
  data-bloque-internacional-titulo={t(locale, "preciosPage.bloqueInternacionalTitulo")}
  data-descuento-badge-template={t(locale, "preciosPage.descuentoBadge")}
  data-descuento-countdown-template={t(locale, "preciosPage.descuentoCountdown")}
  data-plan-esencial-nombre={PLANES[0].nombre}
  data-plan-esencial-duracion={PLANES[0].duracion}
  data-plan-esencial-icono={PLANES[0].icono}
  data-plan-profesional-nombre={PLANES[1].nombre}
  data-plan-profesional-duracion={PLANES[1].duracion}
  data-plan-profesional-icono={PLANES[1].icono}
  data-plan-elite-nombre={PLANES[2].nombre}
  data-plan-elite-duracion={PLANES[2].duracion}
  data-plan-elite-icono={PLANES[2].icono}
>
  <h1>{t(locale, "preciosPage.heading")}</h1>

  <div class="precios-box precios-intro-box">
    <p>{t(locale, "preciosPage.intro")}</p>
  </div>

  <div class="precios-box precios-panel">
    <label class="precios-campo">
      <span>{t(locale, "preciosPage.paisLabel")}</span>
      <select data-pais-select data-sound="select">
        {paises.map((pais) => (
          <option value={pais.slug} selected={pais.slug === paisInicial.slug}>
            {pais.bandera} {pais.nombre}
          </option>
        ))}
      </select>
    </label>

    <div class="precios-campo precios-campo-moneda">
      <span>{t(locale, "preciosPage.monedaLabel")}</span>
      <div class="precios-moneda-opciones" data-moneda-opciones>
        {paisInicial.presentacionMoneda === "toggle" ? (
          paisInicial.monedas.map((m) => (
            <button
              type="button"
              class:list={["precios-marca-boton", "precios-moneda-boton", { "precios-marca-boton-activo": m.codigo === (defaultEur && paisInicial.monedas.some((x) => x.codigo === "EUR") ? "EUR" : paisInicial.monedas[0].codigo) }]}
              data-moneda-boton
              data-moneda-codigo={m.codigo}
              data-sound="select"
            >
              {m.codigo}
            </button>
          ))
        ) : (
          paisInicial.monedas.map((m) => <p class="precios-moneda-valor">{m.codigo}</p>)
        )}
      </div>
    </div>
  </div>

  <div class="precios-box precios-cascada">
    <h2>{t(locale, "preciosPage.pasoMarcaLabel")}</h2>
    <div class="precios-marca-botones" data-marca-botones>
      {catalogo.map((m) => (
        <button type="button" class="precios-marca-boton" data-marca-boton data-marca-slug={m.slug} data-sound="select">
          {m.nombre}
        </button>
      ))}
    </div>

    <label class="precios-campo" data-paso-familia hidden>
      <span>{t(locale, "preciosPage.pasoFamiliaLabel")}</span>
      <select data-familia-select data-sound="select"></select>
    </label>

    <label class="precios-campo" data-paso-modelo hidden>
      <span>{t(locale, "preciosPage.pasoModeloLabel")}</span>
      <select data-modelo-select data-sound="select"></select>
    </label>

    <div data-paso-error hidden>
      <h3>{t(locale, "preciosPage.pasoErrorLabel")}</h3>
      <p class="precios-disclaimer" data-error-disclaimer>⚠️ {t(locale, "preciosPage.errorDisclaimerEpson")}</p>
      <div class="precios-error-opciones" data-error-opciones></div>
      <label class="precios-campo">
        <span>{t(locale, "preciosPage.errorOtroLabel")}</span>
        <input type="text" data-error-otro placeholder={t(locale, "preciosPage.errorOtroPlaceholder")} />
      </label>
    </div>
  </div>

  <div class="precios-box precios-pendiente" data-pricing-pendiente>
    <h2>{t(locale, "preciosPage.pendienteTitulo")}</h2>
    <p>{t(locale, "preciosPage.pendienteTexto")}</p>
  </div>

  <div data-pricing-contenido hidden>
    <button type="button" class="precios-cambiar-seleccion" data-cambiar-seleccion data-sound="select">
      ← {t(locale, "preciosPage.cambiarSeleccion")}
    </button>

    <div data-bloque-local>
      <h2 class="precios-bloque-titulo" data-bloque-local-titulo hidden></h2>
      <div class="precios-planes" data-planes-local></div>
    </div>

    <div data-bloque-internacional hidden>
      <h2 class="precios-bloque-titulo" data-bloque-internacional-titulo></h2>
      <div class="precios-planes" data-planes-internacional></div>
    </div>

    <div class="precios-box precios-metodos">
      <h2 data-metodos-titulo></h2>
      <ul class="precios-metodos-lista" data-metodos-pago-locales></ul>
      <div data-metodos-internacionales-bloque hidden>
        <h3 class="precios-metodos-subtitulo" data-metodos-internacionales-titulo></h3>
        <ul class="precios-metodos-lista" data-metodos-pago-internacionales></ul>
      </div>
      <p class="precios-metodos-nota">🔒 {t(locale, "preciosPage.metodosPagoNota")}</p>
    </div>
  </div>

  <div class="precios-box precios-cta-general-box">
    <a
      class="whatsapp-cta whatsapp-cta-elevar precios-cta-general"
      href={hrefGeneral}
      data-source-id="precios_cta_general"
      data-sound="confirm"
      target="_blank"
      rel="noopener noreferrer nofollow"
      data-cta-general
    >
      <Image src={whatsappLogo} alt="" width={72} height={72} class="whatsapp-cta-icono" />
      {t(locale, "preciosPage.ctaGeneral")}
    </a>
  </div>
</article>

<script>
  interface ModeloCascada {
    slug: string;
    nombre: string;
  }
  interface FamiliaCascada {
    slug: string;
    nombre: string;
    modelos: ModeloCascada[];
  }
  interface MarcaCascada {
    slug: string;
    nombre: string;
    grupo: "impresora" | "plotter";
    familias: FamiliaCascada[] | null;
    modelos: ModeloCascada[] | null;
  }
  interface ErrorCascada {
    id: string;
    nombre: string;
    estado: string;
  }
  interface PreciosPorPlan {
    esencial: number | null;
    profesional: number | null;
    elite: number | null;
  }
  interface OpcionMoneda {
    codigo: string;
    ambito: "local" | "internacional";
    descontable?: boolean;
    precios: { impresora: PreciosPorPlan | null; plotter: PreciosPorPlan | null };
  }
  interface PaisPrecioPublico {
    slug: string;
    nombre: string;
    bandera: string;
    metodosPago: { nombre: string; logos: string[]; internacional: boolean }[];
    monedas: OpcionMoneda[];
    presentacionMoneda: "unica" | "toggle" | "apilado";
  }

  document.querySelectorAll<HTMLElement>("[data-precios-page]").forEach((root) => {
    const paises: PaisPrecioPublico[] = JSON.parse(root.dataset.paises || "[]");
    const paisesPorSlug = Object.fromEntries(paises.map((p) => [p.slug, p]));
    const catalogo: MarcaCascada[] = JSON.parse(root.dataset.catalogo || "[]");
    const catalogoPorSlug = Object.fromEntries(catalogo.map((m) => [m.slug, m]));
    const erroresMapa: Record<string, Record<string, ErrorCascada[]>> = JSON.parse(root.dataset.errores || "{}");

    const select = root.querySelector<HTMLSelectElement>("[data-pais-select]");
    const monedaOpcionesEl = root.querySelector<HTMLElement>("[data-moneda-opciones]");
    const marcaBotones = root.querySelectorAll<HTMLButtonElement>("[data-marca-boton]");
    const pasoFamiliaEl = root.querySelector<HTMLElement>("[data-paso-familia]");
    const familiaSelect = root.querySelector<HTMLSelectElement>("[data-familia-select]");
    const pasoModeloEl = root.querySelector<HTMLElement>("[data-paso-modelo]");
    const modeloSelect = root.querySelector<HTMLSelectElement>("[data-modelo-select]");
    const pasoErrorEl = root.querySelector<HTMLElement>("[data-paso-error]");
    const disclaimerEl = root.querySelector<HTMLElement>("[data-error-disclaimer]");
    const errorOpcionesEl = root.querySelector<HTMLElement>("[data-error-opciones]");
    const errorOtroInput = root.querySelector<HTMLInputElement>("[data-error-otro]");
    const pendienteEl = root.querySelector<HTMLElement>("[data-pricing-pendiente]");
    const contenidoEl = root.querySelector<HTMLElement>("[data-pricing-contenido]");
    const cambiarBtn = root.querySelector<HTMLButtonElement>("[data-cambiar-seleccion]");
    const bloqueLocalTituloEl = root.querySelector<HTMLElement>("[data-bloque-local-titulo]");
    const tarjetasLocalEl = root.querySelector<HTMLElement>("[data-planes-local]");
    const bloqueInternacionalEl = root.querySelector<HTMLElement>("[data-bloque-internacional]");
    const bloqueInternacionalTituloEl = root.querySelector<HTMLElement>("[data-bloque-internacional-titulo]");
    const tarjetasInternacionalEl = root.querySelector<HTMLElement>("[data-planes-internacional]");
    const metodosLocalesEl = root.querySelector<HTMLElement>("[data-metodos-pago-locales]");
    const metodosInternacionalesBloqueEl = root.querySelector<HTMLElement>("[data-metodos-internacionales-bloque]");
    const metodosInternacionalesEl = root.querySelector<HTMLElement>("[data-metodos-pago-internacionales]");
    const metodosInternacionalesTituloEl = root.querySelector<HTMLElement>("[data-metodos-internacionales-titulo]");
    const metodosTituloEl = root.querySelector<HTMLElement>("[data-metodos-titulo]");
    const ctaGeneralEl = root.querySelector<HTMLAnchorElement>("[data-cta-general]");
    if (!select || !familiaSelect || !modeloSelect || !errorOpcionesEl || !errorOtroInput || !pendienteEl || !contenidoEl || !tarjetasLocalEl || !metodosLocalesEl || !metodosTituloEl) return;

    const numero = root.dataset.whatsappNumero || "";
    const urlOrigen = root.dataset.urlOrigen || "";
    const notaTemplate = root.dataset.notaTemplate || "";
    const mensajeTemplate = root.dataset.mensajeTemplate || "";
    const precioNoDisponible = root.dataset.precioNoDisponible || "";
    const ctaPlanLabel = root.dataset.ctaPlan || "";
    const masPopularLabel = root.dataset.masPopular || "";
    const metodosTituloTemplate = root.dataset.metodosTituloTemplate || "";
    const metodosInternacionalesSubtitulo = root.dataset.metodosInternacionalesSubtitulo || "";
    if (metodosInternacionalesTituloEl) metodosInternacionalesTituloEl.textContent = metodosInternacionalesSubtitulo;
    const familiaPlaceholder = root.dataset.familiaPlaceholder || "";
    const modeloPlaceholder = root.dataset.modeloPlaceholder || "";
    const disclaimerEpson = root.dataset.disclaimerEpson || "";
    const disclaimerCanon = root.dataset.disclaimerCanon || "";
    const disclaimerEpsonSc0014bd = root.dataset.disclaimerEpsonScCodigo0014bd || "";
    const disclaimerEpsonScOtro = root.dataset.disclaimerEpsonScOtro || "";
    const defaultEur = root.dataset.defaultEur === "true";
    const bloqueLocalTituloTemplate = root.dataset.bloqueLocalTituloTemplate || "";
    const bloqueInternacionalTituloTexto = root.dataset.bloqueInternacionalTitulo || "";
    const descuentoBadgeTemplate = root.dataset.descuentoBadgeTemplate || "";
    const descuentoCountdownTemplate = root.dataset.descuentoCountdownTemplate || "";
    let primerRenderMoneda = true;

    // ---------- Descuento del bloque internacional (países "apilado") ----------
    // Se genera UNA sola vez por visitante (persistido en cookie, nunca se
    // recalcula en cada carga) — recargar la página no reinicia el
    // cronómetro ni sortea un % nuevo, así el "por tiempo limitado" es real,
    // no una urgencia fabricada. Cookie (no localStorage) para que la
    // ventana de 2h sobreviva igual entre pestañas/navegación normal; su
    // max-age coincide con la duración del propio descuento, así que
    // cuando el descuento expira la cookie también desaparece sola.
    const DESCUENTO_COOKIE = "resetenlinea_precios_descuento_intl_v1";
    const DESCUENTO_DURACION_MS = 2 * 60 * 60 * 1000; // 2 horas

    function leerCookie(nombre: string): string | null {
      const match = document.cookie.match(new RegExp(`(?:^|; )${nombre}=([^;]*)`));
      return match ? decodeURIComponent(match[1]) : null;
    }
    function escribirCookie(nombre: string, valor: string, maxAgeMs: number) {
      const maxAgeSeg = Math.max(0, Math.floor(maxAgeMs / 1000));
      document.cookie = `${nombre}=${encodeURIComponent(valor)}; max-age=${maxAgeSeg}; path=/; samesite=lax`;
    }

    function cargarEstadoDescuento(): { pct: number; expiraEn: number; visitas: number } {
      let datos: { pct: number; expiraEn: number; visitas: number } | null = null;
      try {
        datos = JSON.parse(leerCookie(DESCUENTO_COOKIE) || "null");
      } catch {
        datos = null;
      }
      if (!datos || typeof datos.expiraEn !== "number" || typeof datos.pct !== "number") {
        const opciones = [5, 10, 15, 25];
        datos = { pct: opciones[Math.floor(Math.random() * opciones.length)], expiraEn: Date.now() + DESCUENTO_DURACION_MS, visitas: 1 };
      } else {
        datos.visitas = (datos.visitas || 1) + 1;
      }
      try {
        escribirCookie(DESCUENTO_COOKIE, JSON.stringify(datos), datos.expiraEn - Date.now());
      } catch {
        /* cookies no disponibles (navegación privada estricta, etc.): el
           descuento simplemente no persiste entre cargas — no debe romper
           la página. */
      }
      return datos;
    }
    const estadoDescuento = cargarEstadoDescuento();

    function descuentoActivo(): boolean {
      return Date.now() < estadoDescuento.expiraEn;
    }

    function formatoCuentaRegresiva(ms: number): string {
      const totalSeg = Math.max(0, Math.floor(ms / 1000));
      const h = Math.floor(totalSeg / 3600);
      const m = Math.floor((totalSeg % 3600) / 60);
      const s = totalSeg % 60;
      const pad = (n: number) => String(n).padStart(2, "0");
      return `${h}:${pad(m)}:${pad(s)}`;
    }

    let intervaloDescuentoId: number | null = null;
    function iniciarTickDescuento() {
      if (intervaloDescuentoId != null) return;
      intervaloDescuentoId = window.setInterval(() => {
        const restante = estadoDescuento.expiraEn - Date.now();
        if (restante <= 0) {
          window.clearInterval(intervaloDescuentoId!);
          intervaloDescuentoId = null;
          renderPrecios(); // se vuelve a renderizar sin descuento ni cronómetro
          return;
        }
        root.querySelectorAll<HTMLElement>("[data-countdown]").forEach((el) => {
          el.textContent = descuentoCountdownTemplate.replaceAll("{tiempo}", formatoCuentaRegresiva(restante));
        });
      }, 1000);
    }

    const PLANES = [
      { key: "esencial" as const, icono: root.dataset.planEsencialIcono || "", nombre: root.dataset.planEsencialNombre || "", duracion: root.dataset.planEsencialDuracion || "", destacado: false },
      { key: "profesional" as const, icono: root.dataset.planProfesionalIcono || "", nombre: root.dataset.planProfesionalNombre || "", duracion: root.dataset.planProfesionalDuracion || "", destacado: true },
      { key: "elite" as const, icono: root.dataset.planEliteIcono || "", nombre: root.dataset.planEliteNombre || "", duracion: root.dataset.planEliteDuracion || "", destacado: false },
    ];

    // Última selección GLOBAL del sitio (compartida con /como-funciona/, las
    // páginas de modelo /reset/{marca}/{modelo}/ y los listados filtrables
    // de /prueba-social/) — misma clave en todos, para que elegir marca/
    // modelo/error en cualquiera de esas páginas se refleje en las demás.
    // Se guarda {marca: slug, modelo: nombre visible, error: nombre visible}
    // — nombres (no slugs) para modelo/error porque cada página tiene su
    // propio catálogo/formato interno; cada consumidor hace su propio
    // match por texto contra sus opciones reales.
    const SELECCION_GLOBAL_KEY = "resetenlinea_seleccion_global_v1";
    function leerSeleccionGlobal(): { marca?: string; modelo?: string; error?: string } | null {
      try {
        return JSON.parse(localStorage.getItem(SELECCION_GLOBAL_KEY) || "null");
      } catch {
        return null;
      }
    }
    function guardarSeleccionGlobal() {
      try {
        localStorage.setItem(SELECCION_GLOBAL_KEY, JSON.stringify({ marca: estado.marca, modelo: modeloNombre(), error: errorNombre() }));
      } catch {
        /* localStorage no disponible: no rompe la página. */
      }
    }

    const estado = {
      marca: root.dataset.prefillMarca || "",
      familia: "",
      modelo: root.dataset.prefillModelo || "",
      errorId: "",
      errorOtro: root.dataset.prefillError || "",
      monedaCodigo: "",
    };

    function marcaActual(): MarcaCascada | null {
      return catalogoPorSlug[estado.marca] || null;
    }

    function modelosDisponibles(): ModeloCascada[] {
      const marca = marcaActual();
      if (!marca) return [];
      if (marca.familias) {
        const fam = marca.familias.find((f) => f.slug === estado.familia);
        return fam ? fam.modelos : [];
      }
      return marca.modelos || [];
    }

    function erroresDisponibles(): ErrorCascada[] {
      const marca = marcaActual();
      if (!marca || !estado.modelo) return [];
      return erroresMapa[marca.slug]?.[estado.modelo] || [];
    }

    function marcaNombre(): string {
      return marcaActual()?.nombre || "";
    }

    function modeloNombre(): string {
      return modelosDisponibles().find((m) => m.slug === estado.modelo)?.nombre || estado.modelo;
    }

    function errorNombre(): string {
      if (estado.errorOtro.trim()) return estado.errorOtro.trim();
      return erroresDisponibles().find((e) => e.id === estado.errorId)?.nombre || "";
    }

    function seleccionCompleta(): boolean {
      return Boolean(estado.marca && estado.modelo && (estado.errorId || estado.errorOtro.trim()));
    }

    // Precarga: ?marca=&modelo=&error= en la URL (ej. enlace desde una página
    // de modelo) tiene prioridad; si no vino nada por URL, se usa la última
    // selección GLOBAL guardada (ver SELECCION_GLOBAL_KEY arriba) como
    // respaldo, para no arrancar en blanco si el visitante ya eligió algo en
    // otra página del sitio.
    if (!estado.marca) {
      const cache = leerSeleccionGlobal();
      if (cache?.marca && catalogoPorSlug[cache.marca]) {
        estado.marca = cache.marca;
        if (cache.modelo) {
          const marcaCache = catalogoPorSlug[cache.marca];
          const todosLosModelos = marcaCache.familias ? marcaCache.familias.flatMap((f) => f.modelos) : marcaCache.modelos || [];
          const modeloMatch = todosLosModelos.find((m) => m.nombre.toLowerCase() === cache.modelo!.toLowerCase());
          if (modeloMatch) {
            estado.modelo = modeloMatch.slug;
            if (cache.error) {
              const opciones = erroresMapa[estado.marca]?.[estado.modelo] || [];
              const match = opciones.find(
                (e) => e.nombre.toLowerCase().includes(cache.error!.toLowerCase()) || cache.error!.toLowerCase().includes(e.nombre.toLowerCase())
              );
              if (match) estado.errorId = match.id;
              else estado.errorOtro = cache.error;
            }
          }
        }
      }
    }

    // (ej. ?marca=&modelo=&error= desde una página de modelo, o la caché
    // global de arriba): valida contra el catálogo real; si algo no calza,
    // ese paso simplemente arranca vacío en vez de dejar la cascada en un
    // estado a medias inconsistente.
    (function resolverPrecarga() {
      const marca = marcaActual();
      if (!marca) {
        estado.marca = "";
        return;
      }
      if (marca.familias) {
        const fam = marca.familias.find((f) => f.modelos.some((m) => m.slug === estado.modelo));
        estado.familia = fam?.slug || "";
      }
      if (!modelosDisponibles().some((m) => m.slug === estado.modelo)) estado.modelo = "";
      if (errorOtroInput) errorOtroInput.value = estado.errorOtro;
    })();

    function poblarFamilias() {
      const marca = marcaActual();
      familiaSelect!.innerHTML = "";
      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = familiaPlaceholder;
      familiaSelect!.appendChild(placeholder);
      (marca?.familias || []).forEach((fam) => {
        const opt = document.createElement("option");
        opt.value = fam.slug;
        opt.textContent = fam.nombre;
        opt.selected = fam.slug === estado.familia;
        familiaSelect!.appendChild(opt);
      });
    }

    function poblarModelos() {
      modeloSelect!.innerHTML = "";
      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = modeloPlaceholder;
      modeloSelect!.appendChild(placeholder);
      modelosDisponibles().forEach((mo) => {
        const opt = document.createElement("option");
        opt.value = mo.slug;
        opt.textContent = mo.nombre;
        opt.selected = mo.slug === estado.modelo;
        modeloSelect!.appendChild(opt);
      });
    }

    // Error preseleccionado por defecto según la marca elegida en el Paso 1,
    // para no obligar a un clic extra cuando ya se sabe cuál es el más
    // común: Epson -> Almohadillas, Canon -> 5B00, Epson-SC -> 0014BD. Solo
    // aplica si ese error existe de verdad en la lista confirmada del
    // modelo elegido (nunca se fuerza uno que no está); y solo cuando el
    // visitante todavía no eligió nada a mano para este modelo.
    const ERROR_DEFECTO_POR_MARCA: Record<string, string> = {
      epson: "almohadillas",
      canon: "5b00",
      "epson-sc": "0014bd",
    };

    // Aviso del Paso 3: varía según la marca y, para Epson-SC, según si el
    // error elegido es el 0014bd (que se resuelve con limpieza + reset) o
    // cualquier otro (reseteable sin limpieza previa).
    function actualizarDisclaimer() {
      if (!disclaimerEl) return;
      let texto = "";
      if (estado.marca === "epson") texto = disclaimerEpson;
      else if (estado.marca === "canon") texto = disclaimerCanon;
      else if (estado.marca === "epson-sc") {
        texto = estado.errorId === "epson-sc-0014bd" ? disclaimerEpsonSc0014bd : disclaimerEpsonScOtro;
      }
      disclaimerEl.textContent = texto ? `⚠️ ${texto}` : "";
    }

    function poblarErrores() {
      const disponibles = erroresDisponibles();
      if (!estado.errorId && !estado.errorOtro) {
        const patron = ERROR_DEFECTO_POR_MARCA[estado.marca];
        const candidato = patron && disponibles.find((e) => e.nombre.toLowerCase().includes(patron));
        // Si el patrón de la marca no aparece (ej. MG3510/MG3610, que solo
        // ofrecen 5B02 en vez del 5B00 general) pero hay una única opción,
        // esa es la única razonable por defecto de todos modos.
        const porDefecto = candidato || (disponibles.length === 1 ? disponibles[0] : null);
        if (porDefecto) estado.errorId = porDefecto.id;
      }
      actualizarDisclaimer();

      errorOpcionesEl!.innerHTML = "";
      disponibles.forEach((err) => {
        const label = document.createElement("label");
        label.className = "precios-radio";
        const input = document.createElement("input");
        input.type = "radio";
        input.name = "preciosError";
        input.value = err.id;
        input.dataset.sound = "select";
        input.checked = err.id === estado.errorId;
        input.addEventListener("change", () => {
          estado.errorId = input.value;
          estado.errorOtro = "";
          errorOtroInput!.value = "";
          actualizar();
        });
        label.appendChild(input);
        const span = document.createElement("span");
        span.textContent = err.nombre;
        label.appendChild(span);
        errorOpcionesEl!.appendChild(label);
      });
    }

    function actualizarPasos() {
      marcaBotones.forEach((btn) => btn.classList.toggle("precios-marca-boton-activo", btn.dataset.marcaSlug === estado.marca));

      const marca = marcaActual();
      const tieneFamilias = Boolean(marca?.familias);
      if (pasoFamiliaEl) pasoFamiliaEl.hidden = !(marca && tieneFamilias);
      if (marca && tieneFamilias) poblarFamilias();

      const familiaResuelta = !marca ? false : tieneFamilias ? Boolean(estado.familia) : true;
      if (pasoModeloEl) pasoModeloEl.hidden = !(marca && familiaResuelta);
      if (marca && familiaResuelta) poblarModelos();

      if (pasoErrorEl) pasoErrorEl.hidden = !(marca && estado.modelo);
      if (marca && estado.modelo) poblarErrores();
    }

    function formatoPrecio(monto: number | null | undefined, moneda: string): string {
      if (monto == null) return precioNoDisponible;
      try {
        return new Intl.NumberFormat(undefined, { style: "currency", currency: moneda, maximumFractionDigits: 0 }).format(monto);
      } catch {
        return `${monto} ${moneda}`;
      }
    }

    function whatsappHref(nota: string): string {
      const mensaje = mensajeTemplate.replaceAll("{nota}", nota).replaceAll("{url}", urlOrigen);
      return `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
    }

    function poblarMonedaOpciones(pais: PaisPrecioPublico) {
      if (!monedaOpcionesEl) return;
      if (!pais.monedas.some((m) => m.codigo === estado.monedaCodigo)) {
        const preferirEur = primerRenderMoneda && defaultEur && pais.monedas.some((m) => m.codigo === "EUR");
        estado.monedaCodigo = preferirEur ? "EUR" : pais.monedas[0]?.codigo || "";
      }
      primerRenderMoneda = false;

      monedaOpcionesEl.innerHTML = "";
      if (pais.monedas.length <= 1) {
        const badge = document.createElement("p");
        badge.className = "precios-moneda-valor";
        badge.textContent = pais.monedas[0]?.codigo || "";
        monedaOpcionesEl.appendChild(badge);
        return;
      }
      pais.monedas.forEach((m) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "precios-marca-boton precios-moneda-boton";
        btn.classList.toggle("precios-marca-boton-activo", m.codigo === estado.monedaCodigo);
        btn.dataset.sound = "select";
        btn.textContent = m.codigo;
        btn.addEventListener("click", () => {
          if (estado.monedaCodigo === m.codigo) return;
          estado.monedaCodigo = m.codigo;
          renderPrecios();
        });
        monedaOpcionesEl!.appendChild(btn);
      });
    }

    function construirTarjetas(contenedorEl: HTMLElement, opcion: OpcionMoneda, pais: PaisPrecioPublico, marca: MarcaCascada) {
      const aplicarDescuento = Boolean(opcion.descontable) && descuentoActivo();
      const precios = opcion.precios[marca.grupo];

      contenedorEl.innerHTML = "";
      PLANES.forEach((plan) => {
        const montoBase = precios ? precios[plan.key] : null;
        const descuentaEstaTarjeta = aplicarDescuento && montoBase != null;
        const montoFinal = descuentaEstaTarjeta ? Math.round(montoBase! * (1 - estadoDescuento.pct / 100)) : montoBase;
        const precioTexto = formatoPrecio(montoFinal, opcion.codigo);
        const nota = notaTemplate
          .replaceAll("{marca}", marcaNombre())
          .replaceAll("{modelo}", modeloNombre())
          .replaceAll("{error}", errorNombre())
          .replaceAll("{plan}", plan.nombre)
          .replaceAll("{duracion}", plan.duracion)
          .replaceAll("{pais}", pais.nombre)
          .replaceAll("{precio}", precioTexto);

        const article = document.createElement("article");
        article.className = plan.destacado ? "precios-plan precios-plan-destacado" : "precios-plan";

        if (plan.destacado) {
          const badge = document.createElement("span");
          badge.className = "precios-plan-badge";
          badge.textContent = masPopularLabel;
          article.appendChild(badge);
        }

        const icono = document.createElement("img");
        icono.className = "precios-plan-icono";
        icono.src = plan.icono;
        icono.alt = "";
        icono.width = 64;
        icono.height = 64;

        const nombre = document.createElement("h3");
        nombre.textContent = plan.nombre;

        const duracion = document.createElement("p");
        duracion.className = "precios-plan-duracion";
        duracion.textContent = plan.duracion;

        article.append(icono, nombre, duracion);

        if (descuentaEstaTarjeta) {
          const original = document.createElement("p");
          original.className = "precios-plan-precio-original";
          original.textContent = formatoPrecio(montoBase, opcion.codigo);
          article.appendChild(original);
        }

        const precio = document.createElement("p");
        precio.className = "precios-plan-precio";
        precio.append(document.createTextNode(precioTexto));
        if (descuentaEstaTarjeta) {
          const badgeDescuento = document.createElement("span");
          badgeDescuento.className = "precios-plan-badge-descuento";
          badgeDescuento.textContent = descuentoBadgeTemplate.replaceAll("{pct}", String(estadoDescuento.pct));
          precio.appendChild(badgeDescuento);
        }
        article.appendChild(precio);

        if (descuentaEstaTarjeta) {
          const countdown = document.createElement("p");
          countdown.className = "precios-plan-countdown";
          countdown.dataset.countdown = "true";
          countdown.textContent = descuentoCountdownTemplate.replaceAll(
            "{tiempo}",
            formatoCuentaRegresiva(estadoDescuento.expiraEn - Date.now())
          );
          article.appendChild(countdown);
          iniciarTickDescuento();
        }

        const boton = document.createElement("a");
        boton.className = "whatsapp-cta whatsapp-cta-elevar precios-plan-cta";
        boton.href = whatsappHref(nota);
        boton.target = "_blank";
        boton.rel = "noopener noreferrer nofollow";
        boton.dataset.sourceId = `precios_plan_${plan.key}`;
        boton.dataset.sound = "confirm";
        boton.textContent = ctaPlanLabel;
        article.appendChild(boton);

        contenedorEl.appendChild(article);
      });
    }

    function renderPrecios() {
      const pais = paisesPorSlug[select!.value] || paises[0];
      poblarMonedaOpciones(pais);

      if (ctaGeneralEl) {
        ctaGeneralEl.href = whatsappHref(metodosTituloTemplate.replaceAll("{pais}", pais.nombre));
      }

      const completa = seleccionCompleta();
      pendienteEl.hidden = completa;
      contenidoEl.hidden = !completa;
      if (!completa) return;

      guardarSeleccionGlobal();

      const marca = marcaActual()!;

      if (pais.presentacionMoneda === "apilado") {
        const local = pais.monedas.find((m) => m.ambito === "local") || pais.monedas[0];
        const internacional = pais.monedas.find((m) => m.ambito === "internacional") || pais.monedas[1] || pais.monedas[0];

        if (bloqueLocalTituloEl) {
          bloqueLocalTituloEl.hidden = false;
          bloqueLocalTituloEl.textContent = bloqueLocalTituloTemplate.replaceAll("{pais}", pais.nombre);
        }
        construirTarjetas(tarjetasLocalEl!, local, pais, marca);

        if (bloqueInternacionalEl) bloqueInternacionalEl.hidden = false;
        if (bloqueInternacionalTituloEl) bloqueInternacionalTituloEl.textContent = bloqueInternacionalTituloTexto;
        if (tarjetasInternacionalEl) construirTarjetas(tarjetasInternacionalEl, internacional, pais, marca);
      } else {
        const monedaActual = pais.monedas.find((m) => m.codigo === estado.monedaCodigo) || pais.monedas[0];
        if (bloqueLocalTituloEl) bloqueLocalTituloEl.hidden = true;
        construirTarjetas(tarjetasLocalEl!, monedaActual, pais, marca);
        if (bloqueInternacionalEl) bloqueInternacionalEl.hidden = true;
        if (tarjetasInternacionalEl) tarjetasInternacionalEl.innerHTML = "";
      }

      metodosTituloEl!.textContent = metodosTituloTemplate.replaceAll("{pais}", pais.nombre);
      metodosLocalesEl!.innerHTML = "";
      if (metodosInternacionalesEl) metodosInternacionalesEl.innerHTML = "";
      // Cada logo va en su propia tarjeta independiente (nunca 2 logos
      // adentro de la misma tarjeta) — y un mismo logo compartido entre 2
      // medios de pago distintos (ej. "Bre-B" en "Nequi / Bre-B", o
      // "Banco Agrícola" en sus variantes "Cta. corriente"/"Cta. ahorro")
      // solo se muestra una vez por país. Si el método SÍ tiene logo pero
      // ya se mostró (duplicado), no se agrega nada — mostrar su nombre
      // como texto sería redundante con el logo ya visible. El texto solo
      // es el fallback para métodos que nunca tuvieron logo disponible.
      // Los medios internacionales (PayPal/Binance/Western Union/Whop) van
      // en su propia lista, separada de los medios bancarios locales.
      const logosYaMostrados = new Set<string>();
      let huboInternacionales = false;
      pais.metodosPago.forEach((metodo) => {
        const contenedor = metodo.internacional ? metodosInternacionalesEl : metodosLocalesEl;
        if (!contenedor) return;
        if (metodo.internacional) huboInternacionales = true;
        const tieneLogos = (metodo.logos || []).length > 0;
        const logosNuevos = (metodo.logos || []).filter((src) => !logosYaMostrados.has(src));
        if (logosNuevos.length > 0) {
          logosNuevos.forEach((src) => {
            logosYaMostrados.add(src);
            const li = document.createElement("li");
            li.className = "precios-metodo-chip precios-metodo-chip-logo";
            const img = document.createElement("img");
            img.src = src;
            img.alt = metodo.nombre;
            img.loading = "lazy";
            img.className = "precios-metodo-logo";
            li.appendChild(img);
            contenedor.appendChild(li);
          });
        } else if (!tieneLogos) {
          const li = document.createElement("li");
          li.className = "precios-metodo-chip";
          li.textContent = metodo.nombre;
          contenedor.appendChild(li);
        }
      });
      if (metodosInternacionalesBloqueEl) metodosInternacionalesBloqueEl.hidden = !huboInternacionales;
    }

    function actualizar() {
      actualizarPasos();
      renderPrecios();
    }

    marcaBotones.forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = btn.dataset.marcaSlug || "";
        if (estado.marca === slug) return;
        estado.marca = slug;
        estado.familia = "";
        estado.modelo = "";
        estado.errorId = "";
        estado.errorOtro = "";
        errorOtroInput!.value = "";
        actualizar();
      });
    });

    familiaSelect.addEventListener("change", () => {
      estado.familia = familiaSelect!.value;
      estado.modelo = "";
      estado.errorId = "";
      estado.errorOtro = "";
      errorOtroInput!.value = "";
      actualizar();
    });

    modeloSelect.addEventListener("change", () => {
      estado.modelo = modeloSelect!.value;
      estado.errorId = "";
      estado.errorOtro = "";
      errorOtroInput!.value = "";
      actualizar();
    });

    errorOtroInput.addEventListener("input", () => {
      estado.errorOtro = errorOtroInput!.value;
      if (estado.errorOtro.trim()) {
        estado.errorId = "";
        errorOpcionesEl!.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => (r.checked = false));
      }
      actualizarDisclaimer();
      renderPrecios();
    });

    select.addEventListener("change", () => {
      // Un código de moneda que por casualidad coincide entre dos países
      // (ej. "COP" es tanto la moneda de Colombia como la alternativa de
      // Venezuela) no debe sobrevivir el cambio de país — cada país resuelve
      // su propio default en poblarMonedaOpciones().
      estado.monedaCodigo = "";
      renderPrecios();
    });

    cambiarBtn?.addEventListener("click", () => {
      estado.marca = "";
      estado.familia = "";
      estado.modelo = "";
      estado.errorId = "";
      estado.errorOtro = "";
      errorOtroInput!.value = "";
      actualizar();
    });

    actualizar();
  });
</script>

<style is:global>
  /*
   * is:global a propósito: el script de esta página reconstruye los pasos de
   * la cascada y las tarjetas de precio con document.createElement al
   * cambiar de marca/familia/modelo/error/país. Esos nodos se crean en
   * tiempo de ejecución, así que nunca reciben el atributo de scope que
   * Astro añade solo a lo que existe en el template al compilar — con
   * estilos con scope, ese re-render quedaría sin CSS. Los nombres de clase
   * (precios-*, whatsapp-cta*) son específicos de esta página, así que el
   * riesgo de colisión global es mínimo.
   */
  .precios-page {
    display: grid;
    gap: var(--space-md);
