---
/**
 * Catálogo completo de modelos con buscador + filtros (marca/serie/error) +
 * favoritos — extraído tal cual de HomePage.astro (antes vivía en el Home;
 * se trasladó acá para que el Home quede libre de la grilla masiva y se
 * enfoque en conversión). Misma lógica, sin reescribir nada.
 *
 * Admite prefill opcional por query string (?marca=&error=&q=) para que el
 * Home pueda enlazar directo a un filtro ya aplicado (buscador rápido,
 * slider de errores) sin que el visitante tenga que volver a elegirlo acá.
 */
import { t, buildLocalizedPath, findErroresConfirmadosForModelo } from "../../i18n/utils";
import ModeloImage from "../ui/ModeloImage.astro";
import FavoritoEstrella from "../ui/FavoritoEstrella.astro";
import modelosCompletos from "../../data/modelos-muestra.json";
import { obtenerPopularidad } from "../../lib/popularidad.js";
import { getModeloImage } from "../../lib/model-images.js";
import { type Locale } from "../../config/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const GRUPOS_ERROR = [
  { id: "epson-almohadillas", marca: "epson", labelKey: "home.grupoAlmohadillas", errorIds: ["epson-almohadillas"] },
  { id: "canon-5b00", marca: "canon", labelKey: "home.grupoCanon5b00", errorIds: ["canon-5b00"] },
  { id: "canon-1700", marca: "canon", labelKey: "home.grupoCanon1700", errorIds: ["canon-1700"] },
  {
    id: "sc-bloqueo",
    marca: "epson-sc",
    labelKey: "home.grupoScBloqueo",
    errorIds: ["epson-sc-00010000", "epson-sc-00040000", "epson-sc-00080000", "epson-sc-000c0000"],
  },
  {
    id: "sc-notificacion",
    marca: "epson-sc",
    labelKey: "home.grupoScNotificacion",
    errorIds: ["epson-sc-00000001", "epson-sc-00000004", "epson-sc-00000008", "epson-sc-0000000c"],
  },
  {
    id: "sc-combinacion",
    marca: "epson-sc",
    labelKey: "home.grupoScCombinacion",
    errorIds: [
      "epson-sc-00080001",
      "epson-sc-00080004",
      "epson-sc-0008000c",
      "epson-sc-00040008",
      "epson-sc-00040001",
      "epson-sc-0004000c",
      "epson-sc-00010004",
      "epson-sc-00010008",
      "epson-sc-0001000c",
    ],
  },
  { id: "sc-revision", marca: "epson-sc", labelKey: "home.grupoScRevision", errorIds: ["epson-sc-0014bd"] },
] as const;

// La "serie" de un modelo es su prefijo alfabético (XP-200 → "XP", G1100 → "G",
// Artisan-1430 → "Artisan"): agrupa modelos de una misma familia dentro de una marca.
function serieDeModelo(nombreModelo: string): string {
  return nombreModelo.match(/^[A-Za-z]+/)?.[0] ?? "";
}

// Modelos agregados por tráfico/SEO que todavía no tienen foto de portada ni error
// confirmado no se listan en la grilla pública (evita tarjetas vacías/genéricas), pero
// su página /reset/{marca}/{modelo}/ sigue existiendo (getStaticPaths usa modelosCompletos
// sin filtrar) para no romper las redirecciones que apuntan a ellos. En cuanto se les
// agregue imagen o un error confirmado, reaparecen solos — no es una lista manual.
const modelos = modelosCompletos.filter(
  (modelo) =>
    getModeloImage(modelo.modeloSlug) !== null ||
    findErroresConfirmadosForModelo(modelo.marcaSlug, modelo.modeloSlug).length > 0
);

const modelosConGrupos = modelos.map((modelo) => {
  const idsModelo = new Set(findErroresConfirmadosForModelo(modelo.marcaSlug, modelo.modeloSlug).map((c) => c.error_id));
  const grupos = GRUPOS_ERROR.filter((g) => g.errorIds.some((id) => idsModelo.has(id))).map((g) => g.id);
  const id = `${modelo.marcaSlug}:${modelo.modeloSlug}`;
  const nombreCompleto = `${modelo.nombreMarca} ${modelo.nombreModelo}`;
  const ariaLabelFavorito = t(locale, "home.favoritoAgregar").replace("{nombre}", nombreCompleto);
  const serie = serieDeModelo(modelo.nombreModelo);
  const serieKey = serie ? `${modelo.marcaSlug}::${serie}` : "";
  return { modelo, grupos, id, popularidad: obtenerPopularidad(modelo), nombreCompleto, ariaLabelFavorito, serieKey };
});

const marcasDisponibles = Array.from(
  modelos.reduce((map, m) => (map.has(m.marcaSlug) ? map : map.set(m.marcaSlug, m.nombreMarca)), new Map<string, string>())
)
  .map(([slug, nombre]) => ({ slug, nombre }))
  .sort((a, b) => a.nombre.localeCompare(b.nombre));

const gruposUsados = new Set(modelosConGrupos.flatMap((m) => m.grupos));
const gruposDisponibles = GRUPOS_ERROR.filter((g) => gruposUsados.has(g.id));

const seriesDisponibles = Array.from(
  modelos.reduce((map, m) => {
    const serie = serieDeModelo(m.nombreModelo);
    if (!serie) return map;
    const key = `${m.marcaSlug}::${serie}`;
    if (!map.has(key)) map.set(key, { key, marcaSlug: m.marcaSlug, nombreMarca: m.nombreMarca, serie });
    return map;
  }, new Map<string, { key: string; marcaSlug: string; nombreMarca: string; serie: string }>())
)
  .map(([, v]) => v)
  .sort((a, b) => a.nombreMarca.localeCompare(b.nombreMarca) || a.serie.localeCompare(b.serie));
---

<section class="catalogo-modelos">
  <div
    class="modelos-buscador-fila"
    data-prefill-marca={Astro.url.searchParams.get("marca") || ""}
    data-prefill-error={Astro.url.searchParams.get("error") || ""}
    data-prefill-q={Astro.url.searchParams.get("q") || ""}
  >
    <div class="modelos-buscador" id="modelos-buscador">
      <svg class="modelos-buscador-icon" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6" />
        <path d="M16.5 16.5l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        id="modelos-buscador-input"
        placeholder={t(locale, "home.buscadorPlaceholder")}
        aria-label={t(locale, "home.buscadorPlaceholder")}
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="modelos-buscador-panel"
        aria-autocomplete="list"
      />
      <button type="button" class="modelos-buscador-clear" id="modelos-buscador-clear" hidden aria-label={t(locale, "home.buscadorLimpiar")}>
        <svg viewBox="0 0 20 20" width="14" height="14" fill="none" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>

      <div
        class="modelos-buscador-panel"
        id="modelos-buscador-panel"
        role="listbox"
        hidden
        data-texto-resultados={t(locale, "home.buscadorResultados")}
        data-texto-resultado-singular={t(locale, "home.buscadorResultadoSingular")}
        data-texto-sin-resultados={t(locale, "home.buscadorSinResultados")}
      >
      </div>
    </div>

    <div class="modelos-filtros">
      <select id="filtro-marca" aria-label={t(locale, "home.filtroMarcaLabel")}>
        <option value="">{t(locale, "home.filtroMarcaTodas")}</option>
        {marcasDisponibles.map((m) => (
          <option value={m.slug}>{m.nombre}</option>
        ))}
      </select>
      <select id="filtro-serie" aria-label={t(locale, "home.filtroSerieLabel")}>
        <option value="">{t(locale, "home.filtroSerieTodas")}</option>
        {seriesDisponibles.map((s) => (
          <option value={s.key} data-marca={s.marcaSlug}>{s.nombreMarca} {s.serie}</option>
        ))}
      </select>
      <select id="filtro-error" aria-label={t(locale, "home.filtroErrorLabel")}>
        <option value="">{t(locale, "home.filtroErrorTodos")}</option>
        {gruposDisponibles.map((g) => (
          <option value={g.id} data-marca={g.marca}>{t(locale, g.labelKey)}</option>
        ))}
      </select>
      <select id="filtro-orden" aria-label={t(locale, "home.filtrarPorLabel")}>
        <option value="az">{t(locale, "home.ordenAZ")}</option>
        <option value="za">{t(locale, "home.ordenZA")}</option>
        <option value="favoritos">{t(locale, "home.ordenFavoritos")}</option>
      </select>
    </div>
  </div>

  <div
    class="modelos-grid"
    id="modelos-grid"
    data-texto-favorito-agregar={t(locale, "home.favoritoAgregar")}
    data-texto-favorito-quitar={t(locale, "home.favoritoQuitar")}
  >
    {modelosConGrupos.map(({ modelo, grupos, id, popularidad, nombreCompleto, ariaLabelFavorito, serieKey }) => {
      const href = buildLocalizedPath(locale, `/reset/${modelo.marcaSlug}/${modelo.modeloSlug}/`);
      return (
        <div
          class="modelo-card"
          data-buscar={`${modelo.nombreMarca} ${modelo.nombreModelo}`.toLowerCase()}
          data-marca={modelo.marcaSlug}
          data-grupos={grupos.join(",")}
          data-serie={serieKey}
          data-modelo-id={id}
          data-popularidad={popularidad}
          data-nombre={nombreCompleto}
        >
          <a class="modelo-card-enlace" href={href}>
            <ModeloImage
              modeloSlug={modelo.modeloSlug}
              nombreMarca={modelo.nombreMarca}
              nombreModelo={modelo.nombreModelo}
              variant="cover"
            />
          </a>
          <FavoritoEstrella modeloId={id} variante="flotante" ariaLabel={ariaLabelFavorito} />
          <div class="modelo-card-body">
            <span class="modelo-card-marca">{t(locale, "modelo.prefijoTitulo")} {modelo.nombreMarca}</span>
            <span class="modelo-card-modelo">{modelo.nombreModelo}</span>
            <a class="modelo-card-verlink" href={href}>{t(locale, "home.verModelo")}</a>
          </div>
        </div>
      );
    })}
  </div>
  <p
    class="modelos-grid-vacio"
    id="modelos-grid-vacio"
    hidden
    data-texto-sin-resultados={t(locale, "home.buscadorSinResultados")}
    data-texto-sin-favoritos={t(locale, "home.favoritosVacio")}
  >
    {t(locale, "home.buscadorSinResultados")}
  </p>
</section>

<script>
  import { obtenerFavoritos, alternarFavorito } from "../../lib/favoritos.js";
  import { playFeedback } from "../../lib/sound-manager.js";

  function escapeHtml(str) {
    return str.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  }

  function highlight(text, query) {
    const safe = escapeHtml(text);
    if (!query) return safe;
    const idx = text.toLowerCase().indexOf(query);
    if (idx === -1) return safe;
    const before = escapeHtml(text.slice(0, idx));
    const match = escapeHtml(text.slice(idx, idx + query.length));
    const after = escapeHtml(text.slice(idx + query.length));
    return `${before}<mark>${match}</mark>${after}`;
  }

  document.querySelectorAll("#modelos-buscador").forEach((wrapper) => {
    const input = wrapper.querySelector("#modelos-buscador-input");
    const clearBtn = wrapper.querySelector("#modelos-buscador-clear");
    const panel = wrapper.querySelector("#modelos-buscador-panel");
    const grid = document.getElementById("modelos-grid");
    const gridVacio = document.getElementById("modelos-grid-vacio");
    const filtroMarca = document.getElementById("filtro-marca");
    const filtroSerie = document.getElementById("filtro-serie");
    const filtroError = document.getElementById("filtro-error");
    const filtroOrden = document.getElementById("filtro-orden");
    if (!input || !panel || !grid) return;

    const MAX_RESULTADOS = 8;
    const textoResultados = panel.dataset.textoResultados || "{n} resultados";
    const textoResultadoSingular = panel.dataset.textoResultadoSingular || textoResultados.replace("{n}", "1");
    const textoSinResultados = panel.dataset.textoSinResultados || "";
    const textoSinFavoritos = gridVacio ? gridVacio.dataset.textoSinFavoritos || "" : "";
    const textoFavoritoAgregar = grid.dataset.textoFavoritoAgregar || "Agregar a favoritos";
    const textoFavoritoQuitar = grid.dataset.textoFavoritoQuitar || "Quitar de favoritos";

    let favoritos = obtenerFavoritos();

    const cards = Array.from(grid.querySelectorAll(".modelo-card")).map((card) => ({
      el: card,
      id: card.getAttribute("data-modelo-id") || "",
      texto: (card.getAttribute("data-buscar") || "").toLowerCase(),
      marca: card.getAttribute("data-marca") || "",
      grupos: (card.getAttribute("data-grupos") || "").split(",").filter(Boolean),
      serie: card.getAttribute("data-serie") || "",
      popularidad: Number(card.getAttribute("data-popularidad")) || 0,
      nombre: card.getAttribute("data-nombre") || "",
      marcaTexto: card.querySelector(".modelo-card-marca")?.textContent.trim() || "",
      modelo: card.querySelector(".modelo-card-modelo")?.textContent.trim() || "",
      href: card.querySelector(".modelo-card-verlink")?.getAttribute("href") || "",
    }));

    let activeIndex = -1;
    let currentMatches = [];

    function ordenActual() {
      return filtroOrden ? filtroOrden.value : "az";
    }

    function matchesFiltros(c) {
      const marcaSel = filtroMarca ? filtroMarca.value : "";
      const serieSel = filtroSerie ? filtroSerie.value : "";
      const grupoSel = filtroError ? filtroError.value : "";
      if (marcaSel && c.marca !== marcaSel) return false;
      if (serieSel && c.serie !== serieSel) return false;
      if (grupoSel && !c.grupos.includes(grupoSel)) return false;
      if (ordenActual() === "favoritos" && !favoritos.has(c.id)) return false;
      return true;
    }

    function compararOrden(a, b) {
      const orden = ordenActual();
      if (orden === "az") return a.modelo.localeCompare(b.modelo);
      if (orden === "za") return b.modelo.localeCompare(a.modelo);
      if (orden === "favoritos") return a.modelo.localeCompare(b.modelo);
      return a.modelo.localeCompare(b.modelo);
    }

    function aplicarOrdenGrid() {
      cards
        .slice()
        .sort(compararOrden)
        .forEach((c, i) => {
          c.el.style.order = String(i);
        });
    }

    function actualizarEstrellas() {
      cards.forEach((c) => {
        const botones = c.el.querySelectorAll("[data-favorito-toggle]");
        if (!botones.length) return;
        const esFav = favoritos.has(c.id);
        const etiqueta = (esFav ? textoFavoritoQuitar : textoFavoritoAgregar).replace("{nombre}", c.nombre);
        botones.forEach((boton) => {
          boton.setAttribute("aria-pressed", String(esFav));
          boton.setAttribute("aria-label", etiqueta);
        });
      });
    }

    function score(card, query) {
      const modeloLower = card.modelo.toLowerCase();
      const marcaLower = card.marcaTexto.toLowerCase();
      if (modeloLower.startsWith(query)) return 0;
      if (marcaLower.startsWith(query)) return 1;
      if (modeloLower.includes(query)) return 2;
      return 3;
    }

    function renderPanel(query) {
      if (!query) {
        panel.hidden = true;
        panel.innerHTML = "";
        input.setAttribute("aria-expanded", "false");
        return;
      }

      const matches = cards
        .filter((c) => matchesFiltros(c) && c.texto.includes(query))
        .sort((a, b) => score(a, query) - score(b, query) || a.modelo.localeCompare(b.modelo));

      currentMatches = matches.slice(0, MAX_RESULTADOS);
      activeIndex = -1;

      if (matches.length === 0) {
        panel.innerHTML = `<p class="modelos-buscador-vacio">${escapeHtml(textoSinResultados)}</p>`;
      } else {
        const textoConteo = matches.length === 1 ? textoResultadoSingular : textoResultados.replace("{n}", String(matches.length));
        const encabezado = `<p class="modelos-buscador-conteo">${textoConteo}</p>`;
        const items = currentMatches
          .map(
            (c, i) => `
            <a class="modelos-buscador-item" href="${c.href}" role="option" id="modelos-buscador-opcion-${i}" data-index="${i}">
              <span class="modelos-buscador-item-titulo">${highlight(c.marcaTexto, query)} ${highlight(c.modelo, query)}</span>
            </a>`
          )
          .join("");
        const masTexto = matches.length > MAX_RESULTADOS ? `<p class="modelos-buscador-mas">+${matches.length - MAX_RESULTADOS}</p>` : "";
        panel.innerHTML = encabezado + items + masTexto;
      }

      panel.hidden = false;
      input.setAttribute("aria-expanded", "true");
    }

    function syncGrid(query) {
      let visibles = 0;
      cards.forEach((c) => {
        const coincide = matchesFiltros(c) && (query === "" || c.texto.includes(query));
        c.el.hidden = !coincide;
        if (coincide) visibles++;
      });
      if (gridVacio) {
        gridVacio.hidden = visibles !== 0;
        gridVacio.textContent = ordenActual() === "favoritos" ? textoSinFavoritos : textoSinResultados;
      }
      return visibles;
    }

    function setActive(index) {
      const opciones = panel.querySelectorAll(".modelos-buscador-item");
      opciones.forEach((op) => op.classList.remove("is-active"));
      activeIndex = index;
      if (index >= 0 && opciones[index]) {
        opciones[index].classList.add("is-active");
        opciones[index].scrollIntoView({ block: "nearest" });
        input.setAttribute("aria-activedescendant", opciones[index].id);
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    }

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      clearBtn.hidden = query === "";
      renderPanel(query);
      syncGrid(query);
    });

    input.addEventListener("keydown", (event) => {
      const opciones = panel.querySelectorAll(".modelos-buscador-item");
      if (!opciones.length) return;
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive((activeIndex + 1) % opciones.length);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive((activeIndex - 1 + opciones.length) % opciones.length);
      } else if (event.key === "Enter") {
        if (activeIndex >= 0 && opciones[activeIndex]) {
          event.preventDefault();
          window.location.href = opciones[activeIndex].getAttribute("href");
        }
      } else if (event.key === "Escape") {
        panel.hidden = true;
        input.setAttribute("aria-expanded", "false");
      }
    });

    input.addEventListener("focus", () => {
      if (input.value.trim()) renderPanel(input.value.trim().toLowerCase());
    });

    clearBtn.addEventListener("click", () => {
      input.value = "";
      clearBtn.hidden = true;
      renderPanel("");
      syncGrid("");
      input.focus();
    });

    function refrescarPorFiltro() {
      const query = input.value.trim().toLowerCase();
      if (query) renderPanel(query);
      syncGrid(query);
    }

    // Reutilizado por "Error" y "Serie": ambos selects dependen de la Marca elegida —
    // solo muestran las opciones que le corresponden, igual que ya hacía "Error".
    function actualizarOpcionesPorMarca(select) {
      if (!select) return;
      const marcaSel = filtroMarca ? filtroMarca.value : "";
      const opciones = Array.from(select.querySelectorAll("option[data-marca]"));
      let seleccionOculta = false;
      opciones.forEach((opcion) => {
        const coincide = !marcaSel || opcion.dataset.marca === marcaSel;
        opcion.hidden = !coincide;
        if (opcion.selected && !coincide) seleccionOculta = true;
      });
      if (seleccionOculta) select.value = "";
    }

    if (filtroMarca) {
      filtroMarca.addEventListener("change", () => {
        actualizarOpcionesPorMarca(filtroError);
        actualizarOpcionesPorMarca(filtroSerie);
        refrescarPorFiltro();
      });
    }
    if (filtroError) filtroError.addEventListener("change", refrescarPorFiltro);
    if (filtroSerie) {
      filtroSerie.addEventListener("change", () => {
        // Elegir una Serie ya implica su Marca (ej. "Epson XP" → Marca Epson): se
        // sincroniza el select de Marca para no obligar a elegirla dos veces.
        const marcaDeSerie = filtroSerie.options[filtroSerie.selectedIndex]?.dataset.marca || "";
        if (marcaDeSerie && filtroMarca && filtroMarca.value !== marcaDeSerie) {
          filtroMarca.value = marcaDeSerie;
          actualizarOpcionesPorMarca(filtroError);
          actualizarOpcionesPorMarca(filtroSerie);
        }
        refrescarPorFiltro();
      });
    }

    if (filtroOrden) {
      filtroOrden.addEventListener("change", () => {
        aplicarOrdenGrid();
        refrescarPorFiltro();
      });
    }

    grid.addEventListener("click", (event) => {
      const boton = event.target.closest("[data-favorito-toggle]");
      if (!boton || !grid.contains(boton)) return;
      event.preventDefault();
      event.stopPropagation();
      const id = boton.getAttribute("data-modelo-id") || "";
      if (!id) return;
      const esFavoritoAhora = alternarFavorito(id);
      if (esFavoritoAhora) favoritos.add(id);
      else favoritos.delete(id);
      actualizarEstrellas();
      playFeedback(esFavoritoAhora ? "favoritoAgregar" : "favoritoQuitar");
      if (ordenActual() === "favoritos") refrescarPorFiltro();
    });

    actualizarOpcionesPorMarca(filtroError);
    actualizarOpcionesPorMarca(filtroSerie);
    actualizarEstrellas();
    aplicarOrdenGrid();
    syncGrid("");

    document.addEventListener("click", (event) => {
      if (!wrapper.contains(event.target)) {
        panel.hidden = true;
        input.setAttribute("aria-expanded", "false");
      }
    });

    // Prefill opcional desde query string (?marca=&error=&q=) — ej. el
    // buscador rápido del Home o el slider de errores enlazan acá con estos
    // parámetros ya resueltos, para no obligar al visitante a repetir la
    // selección.
    const fila = document.querySelector(".modelos-buscador-fila");
    const prefillMarca = fila?.getAttribute("data-prefill-marca") || "";
    const prefillError = fila?.getAttribute("data-prefill-error") || "";
    const prefillQ = fila?.getAttribute("data-prefill-q") || "";
    if (prefillMarca && filtroMarca) {
      filtroMarca.value = prefillMarca;
      actualizarOpcionesPorMarca(filtroError);
      actualizarOpcionesPorMarca(filtroSerie);
    }
    if (prefillError && filtroError) filtroError.value = prefillError;
    if (prefillQ) {
      input.value = prefillQ;
      clearBtn.hidden = false;
    }
    if (prefillMarca || prefillError || prefillQ) refrescarPorFiltro();
  });
</script>

<style>
  .catalogo-modelos {
    display: grid;
    gap: var(--space-sm);
  }

