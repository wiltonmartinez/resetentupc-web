---
import { getImage } from "astro:assets";
import { t, buildStaticPagePath } from "../../i18n/utils";
import ContactoFormRapido from "../ui/ContactoFormRapido.astro";
import { RUT_VISIBLE, SITE_URL, VENDEDORES_API_URL, type Locale } from "../../config/site";
import whatsappLogo from "../../assets/whatsapp/3.png";
import DocumentoLegalProtegido from "../ui/DocumentoLegalProtegido.astro";
// RUT (DIAN) ya CENSURADO y con marca de agua: identificación, dirección y QR
// tapados en los píxeles. Se muestra en un visor sin descarga (ver
// DocumentoLegalProtegido.astro). Si se cambia el archivo, debe seguir
// saliendo censurado del Censurador de Documentos de Núcleo.
import rutPdfUrl from "../../assets/legal/RUT.pdf?url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = buildStaticPagePath(locale, "contacto");
const whatsappLabel = t(locale, "common.whatsappButton");
const urlOrigen = `${SITE_URL}${path}`;
const vendedoresApiUrl = VENDEDORES_API_URL;
// Resuelto una sola vez acá (no con el componente Image, que solo sirve
// dentro de markup .astro) para poder pasar la URL ya optimizada al script
// del cliente de más abajo, que arma la tarjeta de vendedor regional a
// mano con createElement.
const whatsappLogoOptimizado = await getImage({ src: whatsappLogo, width: 72, height: 72 });
---

<article class="contacto-page">
  <h1>{t(locale, "contacto.heading")}</h1>

  <div class="contacto-grid">
    <section class="contacto-columna contacto-columna-form">
      <h2>{t(locale, "contactoRapido.formTitulo")}</h2>
      <ContactoFormRapido locale={locale} urlPath={path} />
    </section>

    <div class="contacto-divisor" aria-hidden="true"></div>

    <section class="contacto-columna contacto-columna-equipo">
      <h2>{t(locale, "contacto.equipoTitulo")}</h2>
      <div class="contacto-equipo">
        <div data-vendedores-regionales></div>
        <p class="contacto-equipo-vacio" data-equipo-vacio hidden>{t(locale, "contacto.equipoSinDisponibles")}</p>
      </div>

      <p class="contacto-ubicacion">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
          <path
            d="M10 18s6-5.2 6-9.8a6 6 0 10-12 0C4 12.8 10 18 10 18Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <circle cx="10" cy="8.2" r="2.2" stroke="currentColor" stroke-width="1.5" />
        </svg>
        {t(locale, "contacto.ubicacion")}
      </p>
    </section>
  </div>

  {/* "Negocio Formalizado y Verificado" + PDF del RUT: oculto con RUT_VISIBLE = false en config/site.ts. */}
  {RUT_VISIBLE && (
  <section class="contacto-confianza" aria-labelledby="contacto-confianza-titulo">
    <hr class="contacto-confianza-linea" />
    <h2 id="contacto-confianza-titulo">{t(locale, "contacto.confianzaTitulo")}</h2>
    <p class="contacto-confianza-texto">{t(locale, "contacto.confianzaTexto")}</p>
    <DocumentoLegalProtegido
      src={rutPdfUrl}
      alt={t(locale, "contacto.confianzaAlt")}
      textoError={t(locale, "contacto.confianzaError")}
    />
  </section>
  )}
</article>

<style>
  .contacto-page {
    display: grid;
    gap: var(--space-md);
  }

  /* Títulos en azul oscuro (paleta propia de esta página, misma tonalidad
     que ya usa el Home para "azul oscuro" — ver --home-azul en
     HomePage.astro). */
  .contacto-page h1,
  .contacto-columna h2 {
    color: #1e3a8a;
  }

  .contacto-page h1 {
    margin: 0;
  }

  .contacto-columna h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-md);
    align-items: start;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  /* Sección de confianza bajo el bloque de contacto: línea NARANJA (mismo
     criterio que .contacto-divisor: el naranja solo en líneas divisorias). */
  .contacto-confianza {
    display: grid;
    gap: var(--space-sm);
    justify-items: center;
    text-align: center;
  }

  .contacto-confianza-linea {
    width: 100%;
    height: 3px;
    margin: var(--space-sm) 0 var(--space-xs);
    border: 0;
    border-radius: 2px;
    background: #f97316;
  }

  .contacto-page .contacto-confianza h2 {
    margin: 0;
    color: #1e3a8a;
    font-size: 1.5rem;
  }

  .contacto-confianza-texto {
    max-width: 62ch;
    margin: 0 0 var(--space-xs);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  /* Separador ESTRICTAMENTE naranja (paleta de la página: nunca en
     botones, solo en líneas divisorias — mismo criterio que el resto del
     sitio, ver .seccion-divisor / .home-divisor). */
  .contacto-divisor {
    width: 2px;
    align-self: stretch;
    background: linear-gradient(to bottom, transparent, #f97316 15%, #f97316 85%, transparent);
  }

  .contacto-equipo {
    display: grid;
    gap: 0.75rem;
  }

  .contacto-ubicacion {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    font-size: 0.88rem;
    color: var(--color-text-subtle);
  }

  @media (max-width: 860px) {
    .contacto-grid {
      grid-template-columns: 1fr;
    }

    .contacto-divisor {
      width: 100%;
      height: 2px;
      background: linear-gradient(to right, transparent, #f97316 15%, #f97316 85%, transparent);
    }
  }

  /* Todas las tarjetas de "Nuestro equipo" se arman dinámicamente acá (ver
     crearTarjetaVendedor() más abajo) — ya no hay un ContactCard.astro
     separado para las fijas, así que este es el único lugar con este
     estilo. */
  .contact-card {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .contact-card h3 {
    margin: 0;
  }

  .contact-card-encabezado {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  /* Punto verde + "ONLINE": el endpoint ya filtra por horario de atención
     (ver comentario en crearTarjetaVendedor más abajo), así que toda tarjeta
     que llega a renderizarse está, por construcción, disponible ahora mismo. */
  .contact-card-online {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #1a9f4a;
  }

  .contact-card-online::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #22c55e;
  }

  .contacto-equipo-vacio {
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    font-size: 0.88rem;
    color: var(--color-text-subtle);
  }

  .contact-card-rol {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-subtle);
  }

  .contact-card-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.6rem 1.1rem;
    border: none;
    border-radius: var(--radius-full);
    background: #20d043;
    color: #ffffff;
    font: inherit;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    cursor: pointer;
    width: fit-content;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .contact-card-whatsapp:hover {
    background: #1bb93a;
    color: #ffffff;
    transform: translateY(-0.125rem);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  }

  .contact-card-whatsapp-icono {
    flex-shrink: 0;
    align-self: stretch;
    width: auto;
    aspect-ratio: 1 / 1;
    margin: -0.6rem 0;
    object-fit: contain;
    transform: scale(0.8);
  }
</style>

<script
  define:vars={{
    vendedoresApiUrl,
    urlOrigen,
    plantillaGenerica: t(locale, "whatsapp.greetingGeneric"),
    plantillaConMarcaModelo: t(locale, "whatsapp.greetingWithoutError"),
    rolVendedorRegional: t(locale, "contacto.rolVendedorRegional"),
    whatsappLabel,
    whatsappIconoUrl: whatsappLogoOptimizado.src,
  }}
>
  // Botones de WhatsApp "regionales": el visitante ya se detectó por IP en
  // otro lado de esta misma página (ContactoFormRapido usa /api/pais.json
  // para el indicativo telefónico) — se repite acá porque son dos
  // componentes independientes y este necesita el ISO igual, sin ninguno
  // depender del otro para funcionar.
  //
  // IMPORTANTE: un script con define:vars se inyecta tal cual, SIN pasar
  // por el compilador de TypeScript de Astro (a diferencia de un <script>
  // normal) — por eso este bloque es JS plano, nada de tipos/interfaces/
  // "as X", o el navegador lo rechaza con un SyntaxError real.
  var SELECCION_GLOBAL_KEY = "resetenlinea_seleccion_global_v1";
  var MARCA_LABEL = { epson: "Epson", canon: "Canon", "epson-sc": "Epson-SC" };

  function leerSeleccionGlobal() {
    try {
      return JSON.parse(localStorage.getItem(SELECCION_GLOBAL_KEY) || "null");
    } catch (e) {
      return null;
    }
  }

  function armarMensaje() {
    var cache = leerSeleccionGlobal();
    if (cache && cache.marca && cache.modelo) {
      var marcaLabel = MARCA_LABEL[cache.marca] || cache.marca;
      return plantillaConMarcaModelo.replaceAll("{marca}", marcaLabel).replaceAll("{modelo}", cache.modelo).replaceAll("{url}", urlOrigen);
    }
    return plantillaGenerica.replaceAll("{url}", urlOrigen);
  }

  // Arma la tarjeta a mano con createElement (en vez de clonar un
  // <template> pre-renderizado) — el compilador de Astro no anida bien un
  // <template> con un <a> como último hijo dentro de una página .astro
  // (rompía el HTML final duplicando un <a> fuera de lugar), así que la
  // tarjeta completa se construye acá en tiempo de ejecución.
  //
  // Astro "scopea" el CSS de esta página agregando un atributo
  // data-astro-cid-XXXXX (hash que cambia en cada build) a cada elemento
  // de SU template — un nodo armado a mano con createElement() no lo trae,
  // así que .contact-card y compañía no le aplicaban (se veía como texto
  // y un link plano, sin tarjeta). Se copia ese atributo desde la raíz de
  // la página (.contacto-page), que Astro sí marcó, en vez de hardcodear
  // el hash.
  var atributoScopeEl = document.querySelector(".contacto-page");
  var atributoScope = atributoScopeEl
    ? Array.prototype.find.call(atributoScopeEl.attributes, function (atributo) {
        return atributo.name.indexOf("data-astro-cid-") === 0;
      })
    : null;
  atributoScope = atributoScope ? atributoScope.name : null;

  function crearTarjetaVendedor(vendedor, mensaje) {
    var tarjeta = document.createElement("div");
    tarjeta.className = "contact-card";

    var encabezado = document.createElement("div");
    encabezado.className = "contact-card-encabezado";

    var h3 = document.createElement("h3");
    h3.textContent = vendedor.nombre;

    // El endpoint solo devuelve vendedores que están EN HORARIO ahora mismo
    // (ver listar_vendedores_por_pais_db() del lado de Núcleo) — por eso acá
    // siempre se marca ONLINE, nunca "desconectado": quien no está en
    // horario directamente no llega a esta lista. en_linea_restante ya viene
    // formateado ("24 horas" o "1h 30min") o vacío si no tiene horario cargado.
    var online = document.createElement("span");
    online.className = "contact-card-online";
    online.textContent = vendedor.en_linea_restante ? "ONLINE · " + vendedor.en_linea_restante : "ONLINE";

    encabezado.appendChild(h3);
    encabezado.appendChild(online);

    // Roles reales cargados en /vendedores/ (Núcleo) — si el vendedor
    // todavía no tiene ninguno marcado, se usa el texto genérico como
    // respaldo en vez de dejar la línea vacía.
    var rol = document.createElement("p");
    rol.className = "contact-card-rol";
    rol.textContent = vendedor.roles && vendedor.roles.length ? vendedor.roles.join(", ") : rolVendedorRegional;

    var link = document.createElement("a");
    link.className = "contact-card-whatsapp";
    link.setAttribute("data-selector-vendedores-omitir", "");
    link.target = "_blank";
    link.rel = "noopener noreferrer nofollow";
    link.href = "https://wa.me/" + vendedor.whatsapp + "?text=" + encodeURIComponent(mensaje);

    var icono = document.createElement("img");
    icono.src = whatsappIconoUrl;
    icono.alt = "";
    icono.width = 72;
    icono.height = 72;
    icono.className = "contact-card-whatsapp-icono";

    link.appendChild(icono);
    link.appendChild(document.createTextNode(" " + whatsappLabel));

    tarjeta.appendChild(encabezado);
    tarjeta.appendChild(rol);
    tarjeta.appendChild(link);

    if (atributoScope) {
      [tarjeta, encabezado, h3, online, rol, link, icono].forEach(function (el) {
        el.setAttribute(atributoScope, "");
      });
    }

    return tarjeta;
  }

  function cargarVendedoresRegionales() {
    var contenedor = document.querySelector("[data-vendedores-regionales]");
    var vacio = document.querySelector("[data-equipo-vacio]");
    if (!contenedor) return;

    fetch("/api/pais.json", { cache: "no-store" })
      .then(function (resPais) {
        return resPais.json();
      })
      .then(function (datosPais) {
        var paisIso = ((datosPais && datosPais.codigo_pais) || "").toUpperCase();
        if (!/^[A-Z]{2}$/.test(paisIso)) return null;
        return fetch(vendedoresApiUrl + "?pais_iso=" + paisIso).then(function (resVendedores) {
          return resVendedores.json();
        });
      })
      .then(function (datosVendedores) {
        var vendedores = (datosVendedores && datosVendedores.data) || [];
        if (!vendedores.length) {
          if (vacio) vacio.hidden = false;
          return;
        }
        var mensaje = armarMensaje();
        vendedores.forEach(function (vendedor) {
          contenedor.appendChild(crearTarjetaVendedor(vendedor, mensaje));
        });
      })
      .catch(function () {
        // sin país detectado, Núcleo inalcanzable, o nadie en horario ahora
        // mismo: ya no hay tarjetas fijas de respaldo (todo sale de Núcleo,
        // ver comentario arriba del <script>), así que se avisa en vez de
        // dejar la sección en blanco sin explicación.
        if (vacio) vacio.hidden = false;
      });
  }

  cargarVendedoresRegionales();
</script>
