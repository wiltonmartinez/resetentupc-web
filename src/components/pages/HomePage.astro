---
/**
 * Home — bloque Hero (Atención del embudo AIDA): título, grilla de
 * "Errores y Modelos Frecuentes" (Epson / Canon / Epson-SC, en lugar del
 * subtítulo largo anterior), buscador rápido, sello de Trustpilot y CTAs
 * principales (WhatsApp + descarga). El resto del embudo
 * (Interés/Deseo/Prueba Social/Acción) se retiró a la espera de la nueva
 * estructura paso a paso; el catálogo completo de modelos vive en
 * /catalogo/ (ver CatalogoPage.astro).
 *
 * Paleta estricta: fondo del Hero en gris (--color-bg-muted), tarjetas en
 * blanco (--color-bg-card), títulos en azul oscuro (--home-azul — el teal
 * --color-primary del resto del sitio no es "azul oscuro"), botón de
 * descarga en rojo, botón de WhatsApp en verde (--color-whatsapp,
 * global). Naranja reservado para líneas/bordes separadores, nunca para
 * botones.
 */
import { getImage } from "astro:assets";
import { t, buildLocalizedPath } from "../../i18n/utils";
import WhatsAppCTA from "../WhatsAppCTA.astro";
import TrustpilotWidget from "../TrustpilotWidget.astro";
import { getErrorImage } from "../../lib/error-images.js";
import { USB_REDIRECTOR_DOWNLOAD_URL, type Locale } from "../../config/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const catalogoHref = "/catalogo/";

// Grilla "Errores y Modelos Frecuentes": 3 columnas fijas (Epson / Canon /
// Epson-SC), cada una con su imagen real de error (ver src/assets/errores,
// mismo mapeo que ya usa ErrorSelector.astro) y algunos modelos frecuentes
// elegidos al azar — se renuevan en cada deploy porque esta página es
// estática/prerenderizada, no hay forma de sortear "por visita" sin SSR.
function elegirAlAzar(lista, cantidad) {
  return [...lista].sort(() => Math.random() - 0.5).slice(0, cantidad);
}

const MODELOS_EPSON = ["L3250", "L1250", "L4260", "L3210", "L3110", "L3150", "ET-2800", "ET-2400"];
const MODELOS_CANON = ["G3010", "G2100", "G3100", "G3110", "G4110"];
const MODELOS_PLOTTER = ["F570", "F571", "T3170", "T3170X"];

const ERRORES_GRID = [
  {
    id: "epson-almohadillas",
    tituloKey: "home.grupoAlmohadillas",
    imagen: getErrorImage("l3250"),
    modelos: elegirAlAzar(MODELOS_EPSON, 4),
  },
  {
    id: "canon-5b00",
    tituloKey: "home.grupoCanon5b00",
    imagen: getErrorImage("g3110"),
    modelos: elegirAlAzar(MODELOS_CANON, 4),
  },
  {
    id: "sc-plotter",
    tituloKey: "homeLanding.erroresGridPlotterTitulo",
    imagen: getErrorImage("epson-sc-00010000"),
    modelos: MODELOS_PLOTTER,
  },
];

const erroresGrid = await Promise.all(
  ERRORES_GRID.map(async (err) => ({
    ...err,
    imagenUrl: err.imagen ? (await getImage({ src: err.imagen, format: "webp", width: 320 })).src : "",
  }))
);
---

<section class="aida-hero">
  <div class="aida-hero-contenido">
    <h1>{t(locale, "homeLanding.heroTitulo")}</h1>

    <div class="aida-errores-grid">
      {erroresGrid.map((err) => (
        <div class="aida-error-card">
          <div class="aida-error-card-imagen">
            {err.imagenUrl && <img src={err.imagenUrl} alt={t(locale, err.tituloKey)} loading="lazy" />}
          </div>
          <h2>{t(locale, err.tituloKey)}</h2>
          <p class="aida-error-card-modelos-label">{t(locale, "homeLanding.erroresGridModelosLabel")}</p>
          <ul class="aida-error-card-modelos">
            {err.modelos.map((modelo) => (
              <li>{modelo}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <form class="aida-hero-buscador" action={catalogoHref} method="get" data-sound="select">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6" />
        <path d="M16.5 16.5l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        name="q"
        placeholder={t(locale, "homeLanding.heroBuscadorPlaceholder")}
        aria-label={t(locale, "homeLanding.heroBuscadorPlaceholder")}
      />
      <button type="submit">{t(locale, "homeLanding.heroBuscadorBoton")}</button>
    </form>

    <TrustpilotWidget locale={locale} />

    <div class="aida-hero-ctas">
      <WhatsAppCTA
        sourceId="home-hero"
        label={t(locale, "homeLanding.heroCtaWhatsapp")}
        locale={locale}
        urlPath={buildLocalizedPath(locale, "/")}
        elevar
      />
      <a href={USB_REDIRECTOR_DOWNLOAD_URL} target="_blank" rel="noopener noreferrer" class="aida-boton-descarga" data-sound="select">
        ⬇️ {t(locale, "homeLanding.heroCtaDescarga")}
      </a>
    </div>
    <p class="aida-hero-descarga-microtexto">{t(locale, "homeLanding.heroCtaDescargaMicrotexto")}</p>
  </div>
</section>

<style>
  .aida-hero {
    --home-azul: #1e3a8a;
    --home-naranja: #f97316;
    background: var(--color-bg-muted);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-md);
    text-align: center;
  }

  .aida-hero-contenido {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
  }

  .aida-hero h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4.5vw, 2.1rem);
    line-height: 1.2;
    color: var(--home-azul);
  }

  /* --- Grilla "Errores y Modelos Frecuentes" (1 fila x 3 columnas) --- */
  .aida-errores-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .aida-error-card {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    background: var(--color-bg-card);
    border: 1px solid rgba(249, 115, 22, 0.35);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-sm);
    text-align: center;
  }

  .aida-error-card-imagen {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-bg-muted);
  }

  .aida-error-card-imagen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .aida-error-card h2 {
    margin: 0.2rem 0 0;
    color: var(--home-azul);
    font-size: 0.95rem;
    line-height: 1.25;
  }

  .aida-error-card-modelos-label {
    margin: 0.35rem 0 0;
    width: 100%;
    padding-top: 0.35rem;
    border-top: 1px solid var(--home-naranja);
    color: var(--color-text-subtle);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .aida-error-card-modelos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem;
  }

  .aida-error-card-modelos li {
    background: var(--color-bg-muted);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .aida-hero-buscador {
    display: flex;
    width: 100%;
    max-width: 26rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.35rem 0.35rem 1rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-subtle);
  }

  .aida-hero-buscador input {
    flex: 1;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.95rem;
    color: var(--color-text);
    min-width: 0;
  }

  .aida-hero-buscador input:focus {
    outline: none;
  }

  .aida-hero-buscador button {
    border: none;
    border-radius: var(--radius-full);
    padding: 0.55rem 1.1rem;
    background: var(--home-azul);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .aida-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.25rem;
  }

  /* Botón de descarga: SIEMPRE rojo — nunca naranja (paleta estricta). */
  .aida-boton-descarga {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-full);
    background: #dc2626;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .aida-boton-descarga:hover {
    background: #b91c1c;
    transform: translateY(-0.125rem);
  }

  .aida-hero-descarga-microtexto {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-text-subtle);
  }

  @media (max-width: 640px) {
    .aida-errores-grid {
      grid-template-columns: 1fr;
    }

    .aida-hero-buscador {
      flex-wrap: wrap;
      border-radius: var(--radius-md);
      padding: 0.6rem;
    }

    .aida-hero-buscador input {
      flex: 1 1 100%;
      padding: 0.3rem 0;
    }

    .aida-hero-buscador button {
      flex: 1 1 100%;
    }
  }
</style>
