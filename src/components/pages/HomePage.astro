---
/**
 * Home — bloque Hero (Atención del embudo AIDA): título, grilla de 3
 * "ventanas" de error clickeables (Epson / Canon / Epson-SC — sin texto,
 * solo la foto real del error, en lugar del subtítulo largo original),
 * buscador rápido, sello de Trustpilot y CTAs principales (WhatsApp +
 * descarga). El resto del embudo (Interés/Deseo/Prueba Social/Acción) se
 * retiró a la espera de la nueva estructura paso a paso; el catálogo
 * completo de modelos vive en /catalogo/ (ver CatalogoPage.astro).
 *
 * La grilla de errores rota en CADA carga/F5 (no solo por deploy): el
 * build arma el conjunto completo de combinaciones válidas por columna y
 * lo embebe como datos; un script de cliente sortea una al azar por
 * columna al cargar la página (ver "aida-errores-grid" más abajo). Esto
 * evita convertir el Home a SSR solo para esta rotación.
 *
 * Paleta estricta: fondo del Hero en gris (--color-bg-muted), tarjetas en
 * blanco (--color-bg-card), títulos en azul oscuro (--home-azul — el teal
 * --color-primary del resto del sitio no es "azul oscuro"), botón de
 * descarga en rojo, botón de WhatsApp en verde (--color-whatsapp,
 * global). Naranja reservado para líneas/bordes separadores, nunca para
 * botones.
 */
import { getImage } from "astro:assets";
import { t, buildLocalizedPath, findErroresConfirmadosForModelo } from "../../i18n/utils";
import WhatsAppCTA from "../WhatsAppCTA.astro";
import TrustpilotWidget from "../TrustpilotWidget.astro";
import { getErrorImage } from "../../lib/error-images.js";
import { getModeloImage } from "../../lib/model-images.js";
import modelosCompletos from "../../data/modelos-muestra.json";
import erroresData from "../../data/errores.json";
import { USB_REDIRECTOR_DOWNLOAD_URL, type Locale } from "../../config/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const catalogoHref = "/catalogo/";

// Índice para el buscador rápido en vivo (ver "aida-hero-buscador-wrap" más
// abajo): mismo filtro que ya usa CatalogoPage.astro (foto de portada O
// error confirmado) para no sugerir modelos sin contenido real. Se embebe
// como datos y un script de cliente lo filtra en cada tecla — sin ir al
// servidor ni esperar a enviar el formulario.
const modelosBuscables = modelosCompletos
  .filter((m) => getModeloImage(m.modeloSlug) !== null || findErroresConfirmadosForModelo(m.marcaSlug, m.modeloSlug).length > 0)
  .map((m) => ({
    nombreMarca: m.nombreMarca,
    nombreModelo: m.nombreModelo,
    href: buildLocalizedPath(locale, `/reset/${m.marcaSlug}/${m.modeloSlug}/`),
    buscar: `${m.nombreMarca} ${m.nombreModelo}`.toLowerCase(),
  }));
const modelosBuscablesJson = JSON.stringify(modelosBuscables);

// Grilla de 3 "ventanas" de error clickeables (Epson / Canon / Epson-SC):
// el build arma, por columna, TODAS las combinaciones de error+modelo que
// tengan página real (modelos-muestra.json) Y foto real disponible
// (src/assets/errores, mismo mapeo que ya usa ErrorSelector.astro) — nunca
// se fabrica ni se enlaza a un modelo sin página. Ese conjunto ("pool") se
// embebe como datos en el HTML; el script de cliente al final de este
// archivo sortea una combinación por columna en cada carga/F5.
function elegirAlAzar<T>(lista: T[]): T {
  return lista[Math.floor(Math.random() * lista.length)];
}

const paginasValidas = new Set(modelosCompletos.map((m) => `${m.marcaSlug}:${m.modeloSlug}`));
const nombresPorModelo = new Map(modelosCompletos.map((m) => [`${m.marcaSlug}:${m.modeloSlug}`, m]));

function combinacionesConImagen(marcaSlug: string) {
  const conceptos = (erroresData.errores as any[]).filter((c) => c.marcaSlug === marcaSlug);
  const combinaciones: { marcaSlug: string; modeloSlug: string; imagen: ImageMetadata }[] = [];
  for (const concepto of conceptos) {
    for (const modelo of concepto.modelos_confirmados as { marcaSlug: string; modeloSlug: string }[]) {
      if (!paginasValidas.has(`${modelo.marcaSlug}:${modelo.modeloSlug}`)) continue;
      const imagen = getErrorImage(concepto.error_id) ?? getErrorImage(modelo.modeloSlug);
      if (!imagen) continue;
      combinaciones.push({ marcaSlug: modelo.marcaSlug, modeloSlug: modelo.modeloSlug, imagen });
    }
  }
  return combinaciones;
}

interface OpcionGrid {
  href: string;
  ariaLabel: string;
  imagenUrl: string;
}

async function construirPool(marcaSlug: string): Promise<OpcionGrid[]> {
  const combinaciones = combinacionesConImagen(marcaSlug);
  return Promise.all(
    combinaciones.map(async (combo) => {
      const info = nombresPorModelo.get(`${combo.marcaSlug}:${combo.modeloSlug}`);
      const nombreCompleto = info ? `${info.nombreMarca} ${info.nombreModelo}` : combo.modeloSlug;
      return {
        href: buildLocalizedPath(locale, `/reset/${combo.marcaSlug}/${combo.modeloSlug}/`),
        ariaLabel: `${t(locale, "home.verModelo")}: ${nombreCompleto}`,
        imagenUrl: (await getImage({ src: combo.imagen, format: "webp", width: 320 })).src,
      };
    })
  );
}

const COLUMNAS_MARCA = ["epson", "canon", "epson-sc"];

const poolPorMarca: Record<string, OpcionGrid[]> = {};
for (const marcaSlug of COLUMNAS_MARCA) {
  poolPorMarca[marcaSlug] = await construirPool(marcaSlug);
}

// Primer render (SSR/no-JS): una combinación al azar por columna, igual
// que antes — el script cliente la reemplaza apenas carga la página.
const erroresGrid = COLUMNAS_MARCA.map((marcaSlug) => {
  const opciones = poolPorMarca[marcaSlug];
  return opciones.length > 0 ? { marcaSlug, ...elegirAlAzar(opciones) } : null;
}).filter((x): x is { marcaSlug: string } & OpcionGrid => x !== null);

const poolJson = JSON.stringify(poolPorMarca);
---

<section class="aida-hero">
  <div class="aida-hero-contenido">
    <h1>{t(locale, "homeLanding.heroTitulo")}</h1>

    <div class="aida-errores-grid" data-pool={poolJson}>
      {erroresGrid.map((err) => (
        <a
          class="aida-error-card"
          data-marca={err.marcaSlug}
          href={err.href}
          aria-label={err.ariaLabel}
          data-sound="select"
        >
          <img src={err.imagenUrl} alt="" loading="lazy" />
        </a>
      ))}
    </div>

    <div class="aida-hero-buscador-wrap" data-modelos={modelosBuscablesJson}>
      <form class="aida-hero-buscador" action={catalogoHref} method="get" data-sound="select" autocomplete="off">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6" />
          <path d="M16.5 16.5l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          name="q"
          id="aida-hero-buscador-input"
          placeholder={t(locale, "homeLanding.heroBuscadorPlaceholder")}
          aria-label={t(locale, "homeLanding.heroBuscadorPlaceholder")}
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="aida-hero-buscador-panel"
          aria-autocomplete="list"
        />
        <button
          type="button"
          class="aida-hero-buscador-clear"
          id="aida-hero-buscador-clear"
          hidden
          aria-label={t(locale, "home.buscadorLimpiar")}
        >
          <svg viewBox="0 0 20 20" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
        <button type="submit">{t(locale, "homeLanding.heroBuscadorBoton")}</button>
      </form>
      <div
        class="aida-hero-buscador-panel"
        id="aida-hero-buscador-panel"
        role="listbox"
        hidden
        data-texto-resultados={t(locale, "home.buscadorResultados")}
        data-texto-resultado-singular={t(locale, "home.buscadorResultadoSingular")}
        data-texto-sin-resultados={t(locale, "home.buscadorSinResultados")}
      >
      </div>
    </div>

    <TrustpilotWidget locale={locale} />

    <div class="aida-hero-ctas">
      <WhatsAppCTA
        sourceId="home-hero"
        label={t(locale, "homeLanding.heroCtaWhatsapp")}
        locale={locale}
        urlPath={buildLocalizedPath(locale, "/")}
        elevar
      />
      <a href={USB_REDIRECTOR_DOWNLOAD_URL} target="_blank" rel="noopener noreferrer" class="aida-boton-descarga" data-sound="select">
        ⬇️ {t(locale, "homeLanding.heroCtaDescarga")}
      </a>
    </div>
    <p class="aida-hero-descarga-microtexto">{t(locale, "homeLanding.heroCtaDescargaMicrotexto")}</p>
  </div>
</section>

<script>
  // Sortea una combinación de error+modelo por columna en cada carga/F5,
  // entre las opciones ya validadas en el build (ver poolPorMarca en el
  // frontmatter) — nunca inventa una imagen ni enlaza a un modelo sin
  // página real.
  document.querySelectorAll(".aida-errores-grid").forEach((grid) => {
    const poolRaw = grid.getAttribute("data-pool");
    if (!poolRaw) return;

    let pool: Record<string, { href: string; ariaLabel: string; imagenUrl: string }[]>;
    try {
      pool = JSON.parse(poolRaw);
    } catch {
      return;
    }

    grid.querySelectorAll<HTMLAnchorElement>(".aida-error-card").forEach((card) => {
      const marca = card.getAttribute("data-marca");
      const opciones = marca ? pool[marca] : null;
      if (!opciones || opciones.length === 0) return;

      const elegido = opciones[Math.floor(Math.random() * opciones.length)];
      card.setAttribute("href", elegido.href);
      card.setAttribute("aria-label", elegido.ariaLabel);
      const img = card.querySelector("img");
      if (img) img.src = elegido.imagenUrl;
    });
  });
</script>

<script>
  // Buscador rápido del Hero: resultados en vivo mientras se escribe (sin
  // esperar al submit ni ir al servidor), mismo criterio de resaltado y
  // orden que ya usa el buscador de /catalogo/. Enter navega directo al
  // modelo cuando hay una coincidencia clara; si no, el form cae en su
  // comportamiento normal (submit a /catalogo/?q=...).
  function escapeHtml(str: string) {
    return str.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string);
  }

  function highlight(text: string, query: string) {
    const safe = escapeHtml(text);
    if (!query) return safe;
    const idx = text.toLowerCase().indexOf(query);
    if (idx === -1) return safe;
    const before = escapeHtml(text.slice(0, idx));
    const match = escapeHtml(text.slice(idx, idx + query.length));
    const after = escapeHtml(text.slice(idx + query.length));
    return `${before}<mark>${match}</mark>${after}`;
  }

  interface ModeloBuscable {
    nombreMarca: string;
    nombreModelo: string;
    href: string;
    buscar: string;
  }

  document.querySelectorAll<HTMLElement>(".aida-hero-buscador-wrap").forEach((wrap) => {
    const modelosRaw = wrap.getAttribute("data-modelos");
    if (!modelosRaw) return;

    let modelos: ModeloBuscable[];
    try {
      modelos = JSON.parse(modelosRaw);
    } catch {
      return;
    }

    const input = wrap.querySelector<HTMLInputElement>("#aida-hero-buscador-input");
    const clearBtn = wrap.querySelector<HTMLButtonElement>("#aida-hero-buscador-clear");
    const panel = wrap.querySelector<HTMLElement>("#aida-hero-buscador-panel");
    if (!input || !panel) return;

    const MAX_RESULTADOS = 6;
    const textoResultados = panel.dataset.textoResultados || "{n} resultados";
    const textoResultadoSingular = panel.dataset.textoResultadoSingular || textoResultados.replace("{n}", "1");
    const textoSinResultados = panel.dataset.textoSinResultados || "";

    let activeIndex = -1;
    let currentMatches: ModeloBuscable[] = [];

    function score(m: ModeloBuscable, query: string) {
      const modeloLower = m.nombreModelo.toLowerCase();
      const marcaLower = m.nombreMarca.toLowerCase();
      if (modeloLower.startsWith(query)) return 0;
      if (marcaLower.startsWith(query)) return 1;
      if (modeloLower.includes(query)) return 2;
      return 3;
    }

    function renderPanel(query: string) {
      if (!query) {
        panel.hidden = true;
        panel.innerHTML = "";
        input.setAttribute("aria-expanded", "false");
        currentMatches = [];
        activeIndex = -1;
        return;
      }

      const matches = modelos
        .filter((m) => m.buscar.includes(query))
        .sort((a, b) => score(a, query) - score(b, query) || a.nombreModelo.localeCompare(b.nombreModelo));

      currentMatches = matches.slice(0, MAX_RESULTADOS);
      activeIndex = -1;

      if (matches.length === 0) {
        panel.innerHTML = `<p class="aida-hero-buscador-vacio">${escapeHtml(textoSinResultados)}</p>`;
      } else {
        const textoConteo = matches.length === 1 ? textoResultadoSingular : textoResultados.replace("{n}", String(matches.length));
        const encabezado = `<p class="aida-hero-buscador-conteo">${textoConteo}</p>`;
        const items = currentMatches
          .map(
            (m, i) => `
            <a class="aida-hero-buscador-item" href="${m.href}" role="option" id="aida-hero-buscador-opcion-${i}" data-index="${i}">
              <span class="aida-hero-buscador-item-titulo">${highlight(m.nombreMarca, query)} ${highlight(m.nombreModelo, query)}</span>
            </a>`
          )
          .join("");
        const masTexto = matches.length > MAX_RESULTADOS ? `<p class="aida-hero-buscador-mas">+${matches.length - MAX_RESULTADOS}</p>` : "";
        panel.innerHTML = encabezado + items + masTexto;
      }

      panel.hidden = false;
      input.setAttribute("aria-expanded", "true");
    }

    function setActive(index: number) {
      const opciones = panel.querySelectorAll(".aida-hero-buscador-item");
      opciones.forEach((op) => op.classList.remove("is-active"));
      activeIndex = index;
      if (index >= 0 && opciones[index]) {
        opciones[index].classList.add("is-active");
        opciones[index].scrollIntoView({ block: "nearest" });
        input.setAttribute("aria-activedescendant", opciones[index].id);
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    }

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      if (clearBtn) clearBtn.hidden = query === "";
      renderPanel(query);
    });

    input.addEventListener("focus", () => {
      if (input.value.trim()) renderPanel(input.value.trim().toLowerCase());
    });

    input.addEventListener("keydown", (event) => {
      const opciones = panel.querySelectorAll(".aida-hero-buscador-item");
      if (event.key === "ArrowDown" && opciones.length) {
        event.preventDefault();
        setActive((activeIndex + 1) % opciones.length);
      } else if (event.key === "ArrowUp" && opciones.length) {
        event.preventDefault();
        setActive((activeIndex - 1 + opciones.length) % opciones.length);
      } else if (event.key === "Enter") {
        if (activeIndex >= 0 && opciones[activeIndex]) {
          event.preventDefault();
          window.location.href = opciones[activeIndex].getAttribute("href") as string;
        } else if (currentMatches.length === 1) {
          event.preventDefault();
          window.location.href = currentMatches[0].href;
        }
        // Sin coincidencia clara: se deja que el form haga su submit normal
        // (GET a /catalogo/?q=...), igual que antes de este cambio.
      } else if (event.key === "Escape") {
        panel.hidden = true;
        input.setAttribute("aria-expanded", "false");
      }
    });

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        input.value = "";
        clearBtn.hidden = true;
        renderPanel("");
        input.focus();
      });
    }

    document.addEventListener("click", (event) => {
      if (!wrap.contains(event.target as Node)) {
        panel.hidden = true;
        input.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>

<style>
  .aida-hero {
    --home-azul: #1e3a8a;
    --home-naranja: #f97316;
    background: var(--color-bg-muted);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-md);
    text-align: center;
  }

  .aida-hero-contenido {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
  }

  .aida-hero h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4.5vw, 2.1rem);
    line-height: 1.2;
    color: var(--home-azul);
  }

  /* --- Grilla "Errores y Modelos Frecuentes" (1 fila x 3 columnas) --- */
  .aida-errores-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .aida-error-card {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-card);
    border: 1px solid rgba(249, 115, 22, 0.4);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .aida-error-card:hover,
  .aida-error-card:focus-visible {
    border-color: var(--home-naranja);
    transform: translateY(-2px);
  }

  .aida-error-card:focus-visible {
    outline: 2px solid var(--home-azul);
    outline-offset: 2px;
  }

  .aida-error-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .aida-hero-buscador-wrap {
    position: relative;
    width: 100%;
    max-width: 26rem;
    text-align: left;
  }

  .aida-hero-buscador {
    display: flex;
    width: 100%;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.35rem 0.35rem 1rem;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-subtle);
  }

  .aida-hero-buscador input {
    flex: 1;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.95rem;
    color: var(--color-text);
    min-width: 0;
  }

  .aida-hero-buscador input:focus {
    outline: none;
  }

  .aida-hero-buscador-clear {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.7rem;
    height: 1.7rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    color: var(--color-text-subtle);
    cursor: pointer;
  }

  .aida-hero-buscador-clear:hover {
    color: var(--color-text);
  }

  /* [hidden] comparte especificidad con .aida-hero-buscador-clear — sin
     esta regla, el display:flex de arriba gana y el botón queda visible
     aunque el script le ponga hidden (mismo caso ya resuelto en
     ContactForm.astro/PreciosPage.astro para este gotcha del navegador). */
  .aida-hero-buscador-clear[hidden] {
    display: none;
  }

  .aida-hero-buscador button[type="submit"] {
    border: none;
    border-radius: var(--radius-full);
    padding: 0.55rem 1.1rem;
    background: var(--home-azul);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .aida-hero-buscador-panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    z-index: 20;
    max-height: 60vh;
    overflow-y: auto;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-floating);
    padding: 0.4rem;
  }

  /* El contenido de .aida-hero-buscador-panel (conteo/item/titulo/mark/mas/
     vacio) se genera con innerHTML desde el script de arriba, así que nunca
     recibe el atributo de scoping de Astro — sin :global() estas reglas
     nunca coinciden con nada. */
  :global(.aida-hero-buscador-conteo) {
    margin: 0.2rem 0.5rem 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  :global(.aida-hero-buscador-item) {
    display: flex;
    align-items: center;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
  }

  :global(.aida-hero-buscador-item:hover),
  :global(.aida-hero-buscador-item.is-active) {
    background: var(--color-bg-muted);
  }

  :global(.aida-hero-buscador-item-titulo) {
    font-weight: 700;
    font-size: 0.95rem;
    min-width: 0;
  }

  :global(.aida-hero-buscador-item mark) {
    background: rgba(30, 58, 138, 0.12);
    color: var(--home-azul);
    border-radius: 0.2rem;
    padding: 0 0.1rem;
  }

  :global(.aida-hero-buscador-mas) {
    margin: 0.3rem 0.5rem 0.2rem;
    font-size: 0.8rem;
    color: var(--color-text-subtle);
    text-align: center;
  }

  :global(.aida-hero-buscador-vacio) {
    margin: 0;
    padding: 0.9rem 0.6rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .aida-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.25rem;
  }

  /* Botón de descarga: SIEMPRE rojo — nunca naranja (paleta estricta). */
  .aida-boton-descarga {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-full);
    background: #dc2626;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .aida-boton-descarga:hover {
    background: #b91c1c;
    transform: translateY(-0.125rem);
  }

  .aida-hero-descarga-microtexto {
    margin: 0;
    font-size: 0.78rem;
