---
/**
 * Galería pura de evidencias de Trustpilot — sin slug, sin título ni
 * descripción por item, sin página de detalle. Cada testimonio aporta una
 * o dos evidencias independientes: url_imgur (captura) se pinta como
 * <img>; url_trustpilot_review (link a la reseña real) se muestra como
 * tarjeta clicable simple que abre en pestaña nueva — Trustpilot bloquea
 * el framing (verificación anti-bot), así que un <iframe> ahí no funciona.
 * marca/modelo/país pueden venir vacíos (un testimonio no requiere pedido
 * real).
 */
import Breadcrumb from "../Breadcrumb.astro";
import { buildLocalizedPath, t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import type { TestimonioPublico } from "../../lib/nucleo-api";

interface Props {
  locale: Locale;
  testimonios: TestimonioPublico[];
}

const { locale, testimonios } = Astro.props;

type Evidencia = { tipo: "imagen" | "link"; url: string; alt: string };

const evidencias: Evidencia[] = testimonios.flatMap((testimonio) => {
  const alt = [testimonio.marca, testimonio.modelo, testimonio.pais].filter(Boolean).join(" · ");
  const items: Evidencia[] = [];
  if (testimonio.url_imgur?.trim()) items.push({ tipo: "imagen", url: testimonio.url_imgur, alt });
  if (testimonio.url_trustpilot_review?.trim()) items.push({ tipo: "link", url: testimonio.url_trustpilot_review, alt });
  return items;
});
---

<Breadcrumb
  items={[
    { label: t(locale, "nav.home"), href: buildLocalizedPath(locale, "/") },
    { label: t(locale, "nav.pruebaSocial"), href: buildLocalizedPath(locale, "/prueba-social/") },
    { label: t(locale, "testimoniosTruspilotPage.heading") },
  ]}
/>
<h1>{t(locale, "testimoniosTruspilotPage.heading")}</h1>
<p>{t(locale, "testimoniosTruspilotPage.texto")}</p>

{evidencias.length > 0 ? (
  <div class="testimonios-grid">
    {evidencias.map((evidencia) =>
      evidencia.tipo === "imagen" ? (
        <a class="testimonios-item" href={evidencia.url} target="_blank" rel="noopener noreferrer">
          <img src={evidencia.url} alt={evidencia.alt} loading="lazy" />
        </a>
      ) : (
        <a class="testimonios-item testimonios-item-link" href={evidencia.url} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
            <path d="M12 2l2.9 6.6L22 9.3l-5 4.6L18.5 21 12 17.3 5.5 21 7 13.9l-5-4.6 7.1-.7z" />
          </svg>
          <span>{t(locale, "testimoniosTruspilotPage.verResenaLink")}</span>
        </a>
      )
    )}
  </div>
) : (
  <p class="testimonios-vacio">{t(locale, "testimoniosTruspilotPage.sinRegistros")}</p>
)}

<style>
  .testimonios-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .testimonios-item {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }

  .testimonios-item img {
    display: block;
    width: 100%;
    height: auto;
  }

  .testimonios-item-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 140px;
    padding: 1.5rem;
    color: #00b67a;
    background: var(--color-bg-card);
    text-decoration: none;
    font-weight: 600;
    transition: border-color 0.15s ease;
  }

  .testimonios-item-link:hover {
    border-color: #00b67a;
  }

  .testimonios-item-link span {
    color: var(--color-text);
  }

  .testimonios-vacio {
    text-align: center;
    color: var(--color-text-subtle);
  }
</style>
