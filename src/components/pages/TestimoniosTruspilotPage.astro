---
/**
 * Galería pura de imágenes — sin slug, sin título ni descripción por item,
 * sin página de detalle. Cada testimonio aporta una imagen (url_imgur);
 * marca/modelo/país pueden venir vacíos (un testimonio no requiere pedido).
 */
import Breadcrumb from "../Breadcrumb.astro";
import { buildLocalizedPath, t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import type { TestimonioPublico } from "../../lib/nucleo-api";

interface Props {
  locale: Locale;
  testimonios: TestimonioPublico[];
}

const { locale, testimonios } = Astro.props;

interface Imagen {
  url: string;
  alt: string;
}

const imagenes: Imagen[] = testimonios
  .filter((testimonio) => testimonio.url_imgur && testimonio.url_imgur.trim() !== "")
  .map((testimonio) => ({
    url: testimonio.url_imgur,
    alt: [testimonio.marca, testimonio.modelo, testimonio.pais].filter(Boolean).join(" · "),
  }));
---

<Breadcrumb
  items={[
    { label: t(locale, "nav.home"), href: buildLocalizedPath(locale, "/") },
    { label: t(locale, "nav.pruebaSocial"), href: buildLocalizedPath(locale, "/prueba-social/") },
    { label: t(locale, "testimoniosTruspilotPage.heading") },
  ]}
/>
<h1>{t(locale, "testimoniosTruspilotPage.heading")}</h1>
<p>{t(locale, "testimoniosTruspilotPage.texto")}</p>

{imagenes.length > 0 ? (
  <div class="testimonios-grid">
    {imagenes.map((imagen) => (
      <a class="testimonios-item" href={imagen.url} target="_blank" rel="noopener noreferrer">
        <img src={imagen.url} alt={imagen.alt} loading="lazy" />
      </a>
    ))}
  </div>
) : (
  <p class="testimonios-vacio">{t(locale, "testimoniosTruspilotPage.sinRegistros")}</p>
)}

<style>
  .testimonios-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .testimonios-item {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }

  .testimonios-item img {
    display: block;
    width: 100%;
    height: auto;
  }

  .testimonios-vacio {
    text-align: center;
    color: var(--color-text-subtle);
  }
</style>
