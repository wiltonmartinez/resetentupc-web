---
/**
 * Galería pura de imágenes — sin slug, sin página de detalle propia, sin
 * ningún texto/leyenda visible por item. Cada testimonio con url_imgur se
 * pinta como una sola imagen clickeable; el destino del click prefiere
 * url_trustpilot_review (si viene) y si no, la propia imagen. Testimonios
 * sin url_imgur no se muestran (no hay nada que pintar sin agregar texto,
 * y esta galería no debe llevar texto).
 */
import Breadcrumb from "../Breadcrumb.astro";
import { buildLocalizedPath, t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import type { TestimonioPublico } from "../../lib/nucleo-api";

interface Props {
  locale: Locale;
  testimonios: TestimonioPublico[];
}

const { locale, testimonios } = Astro.props;

const evidencias = testimonios
  .filter((testimonio) => testimonio.url_imgur?.trim())
  .map((testimonio) => ({
    imagen: testimonio.url_imgur,
    destino: testimonio.url_trustpilot_review?.trim() || testimonio.url_imgur,
  }));

// Orden aleatorio en cada visita (Fisher-Yates) — página SSR, así que se
// recalcula por request, no queda fijo entre visitas.
for (let i = evidencias.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [evidencias[i], evidencias[j]] = [evidencias[j], evidencias[i]];
}
---

<Breadcrumb
  items={[
    { label: t(locale, "nav.home"), href: buildLocalizedPath(locale, "/") },
    { label: t(locale, "nav.pruebaSocial"), href: buildLocalizedPath(locale, "/prueba-social/") },
    { label: t(locale, "testimoniosTruspilotPage.heading") },
  ]}
/>
<h1>{t(locale, "testimoniosTruspilotPage.heading")}</h1>
<p>{t(locale, "testimoniosTruspilotPage.texto")}</p>

{evidencias.length > 0 ? (
  <div class="testimonios-grid">
    {evidencias.map((evidencia) => (
      <a href={evidencia.destino} target="_blank" rel="noopener noreferrer" class="testimonios-item">
        <img src={evidencia.imagen} alt="Testimonio de cliente en Trustpilot" loading="lazy" />
      </a>
    ))}
  </div>
) : (
  <p class="testimonios-vacio">{t(locale, "testimoniosTruspilotPage.sinRegistros")}</p>
)}

<style>
  .testimonios-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .testimonios-item {
    display: block;
    line-height: 0;
  }

  .testimonios-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
  }

  .testimonios-vacio {
    text-align: center;
    color: var(--color-text-subtle);
  }
</style>
