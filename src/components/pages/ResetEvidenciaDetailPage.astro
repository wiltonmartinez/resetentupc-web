---
import Breadcrumb from "../Breadcrumb.astro";
import YouTubeFacade from "../ui/YouTubeFacade.astro";
import { tituloConRespaldo, type ResetRealizadoPublico } from "../../lib/nucleo-api";
import { buildLocalizedPath, t } from "../../i18n/utils";
import type { Locale } from "../../config/site";

interface Props {
  locale: Locale;
  evidencia: ResetRealizadoPublico;
}

const { locale, evidencia } = Astro.props;

// El título (y por lo tanto el slug, que se deriva de él) se calculan UNA
// sola vez en Núcleo al crear el registro — nunca aquí en vivo. Reconstruirlo
// en Astro con otra lógica (o llamando de nuevo a la API de YouTube en cada
// visita) es lo que causaba que título y slug quedaran desincronizados.
const titulo = tituloConRespaldo(evidencia);
const duracion = evidencia.duracion_video;

// Mismos datos del título, tejidos en el cuerpo de la página (evita que el
// contenido visible quede "vacío" de las palabras clave del título/slug).
const resumenContenido = t(locale, duracion ? "resetRealizadosPage.resumenContenido" : "resetRealizadosPage.resumenContenidoSinDuracion")
  .replaceAll("{marca}", evidencia.marca)
  .replaceAll("{modelo}", evidencia.modelo)
  .replaceAll("{error}", evidencia.error)
  .replaceAll("{pais}", evidencia.pais)
  .replaceAll("{duracion}", duracion || "");
---

<Breadcrumb
  items={[
    { label: t(locale, "nav.home"), href: buildLocalizedPath(locale, "/") },
    { label: t(locale, "nav.pruebaSocial"), href: buildLocalizedPath(locale, "/prueba-social/") },
    { label: t(locale, "resetRealizadosPage.heading"), href: buildLocalizedPath(locale, "/prueba-social/reset-evidencia/") },
    { label: titulo },
  ]}
/>
<h1>{titulo}</h1>
<p class="rr-resumen">{resumenContenido}</p>
<YouTubeFacade
  youtubeId={evidencia.youtube_id}
  titulo={titulo}
  descripcion={evidencia.descripcion}
  reproducirLabel={t(locale, "pruebaSocialPage.reproducirVideo")}
/>
<dl class="rr-detalle-datos">
  <div><dt>{t(locale, "resetRealizadosPage.marca")}</dt><dd>{evidencia.marca}</dd></div>
  <div><dt>{t(locale, "resetRealizadosPage.modelo")}</dt><dd>{evidencia.modelo}</dd></div>
  <div><dt>{t(locale, "resetRealizadosPage.error")}</dt><dd>{evidencia.error}</dd></div>
  <div><dt>{t(locale, "resetRealizadosPage.pais")}</dt><dd>{evidencia.pais}</dd></div>
  {duracion && <div><dt>{t(locale, "resetRealizadosPage.duracion")}</dt><dd>{duracion}</dd></div>}
</dl>
<p class="rr-volver">
  <a href={buildLocalizedPath(locale, "/prueba-social/reset-evidencia/")}>{t(locale, "resetRealizadosPage.volverLink")}</a>
</p>

<style>
  .rr-detalle-datos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin: 0;
  }

  .rr-detalle-datos div {
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
  }

  .rr-detalle-datos dt {
    font-size: 0.78rem;
    color: var(--color-text-subtle);
  }

  .rr-detalle-datos dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
    color: var(--color-text);
  }

  .rr-resumen {
    color: var(--color-text-subtle);
  }

  .rr-volver {
    text-align: center;
  }
</style>
