---
/**
 * Cuerpo de la página de detalle de Cliente Satisfecho. El título se arma
 * con los datos reales de la evidencia (marca/modelo/error/país) sin
 * traducir — igual que ya pasa con marca/modelo en las páginas de modelo.
 * Solo la copia alrededor (breadcrumb, enlace de vuelta) se traduce según
 * el locale.
 */
import Breadcrumb from "../Breadcrumb.astro";
import ClienteSatisfechoEmbed from "../ui/ClienteSatisfechoEmbed.astro";
import { tituloConRespaldo, type ClienteSatisfechoPublico } from "../../lib/nucleo-api";
import { buildLocalizedPath, t } from "../../i18n/utils";
import type { Locale } from "../../config/site";

interface Props {
  locale: Locale;
  evidencia: ClienteSatisfechoPublico;
}

const { locale, evidencia } = Astro.props;
const titulo = tituloConRespaldo(evidencia);
---

<Breadcrumb
  items={[
    { label: t(locale, "nav.home"), href: buildLocalizedPath(locale, "/") },
    { label: t(locale, "nav.pruebaSocial"), href: buildLocalizedPath(locale, "/prueba-social/") },
    {
      label: t(locale, "clienteSatisfechoPage.heading"),
      href: buildLocalizedPath(locale, "/prueba-social/cliente-satisfecho/"),
    },
    { label: titulo },
  ]}
/>
<h1>{titulo}</h1>
<ClienteSatisfechoEmbed url={evidencia.html_url} titulo={titulo} />
<p class="cs-volver">
  <a href={buildLocalizedPath(locale, "/prueba-social/cliente-satisfecho/")}>
    {t(locale, "clienteSatisfechoPage.volverLink")}
  </a>
</p>

<style>
  .cs-volver {
    text-align: center;
  }
</style>
