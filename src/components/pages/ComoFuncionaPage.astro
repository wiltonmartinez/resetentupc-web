---
/**
 * Página "Cómo funciona" reestructurada en 3 bloques: resumen visual de 6
 * pasos, desglose detallado de cada paso (silos expandidos con línea lateral
 * conectora), y CTA + FAQ. Contenido genérico (no atado a un modelo real) —
 * reutiliza los textos ya validados y traducidos a los 8 idiomas de los
 * namespaces "procesoReutilizable", "procedimiento" y "proceso" (los mismos
 * que usa ProcedimientoImpresora.astro en las páginas de modelo reales),
 * más un namespace propio "comoFuncionaProceso" solo para lo que no existía.
 */
import { Image } from "astro:assets";
import { t, buildStaticPagePath, buildWhatsAppMessage, buildWhatsAppLink } from "../../i18n/utils";
import FaqAccordion from "../ui/FaqAccordion.astro";
import WhatsAppCTA from "../WhatsAppCTA.astro";
import ProcedimientoResumenDetalle from "../ProcedimientoResumenDetalle.astro";
import { listarTestimonios } from "../../lib/nucleo-api";
import { RULETA_URL, SITE_URL, WHATSAPP_NUMBER, type Locale } from "../../config/site";
import iconoReset from "../../assets/beneficios/icono-reset.png";
import iconoTraslados from "../../assets/beneficios/icono-traslados.png";
import iconoInstalaciones from "../../assets/beneficios/icono-instalaciones.png";
import iconoSeguridad from "../../assets/beneficios/icono-seguridad.png";
import iconoRespaldo from "../../assets/beneficios/icono-respaldo.png";
import iconoReembolso from "../../assets/beneficios/icono-reembols.png";
import iconoCertificado from "../../assets/beneficios/icono-certificado.png";
import iconoSoporte from "../../assets/beneficios/icono-soporte.png";
import iconoSorteos from "../../assets/beneficios/icono-sorteos.png";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Seccion de Prueba Social (Bloque 2.5, antes del CTA final): 3 resenas
// reales al azar del mismo catalogo publico que usa TestimoniosTruspilotPage
// (Nucleo /api/public/testimonios/) — nunca texto ni nombres inventados, solo
// las capturas reales ya validadas. Si Nucleo no responde o hay menos de 3
// con imagen, se muestran las que haya (sin fabricar nada para completar).
let testimoniosDestacados: { imagen: string; destino: string }[] = [];
try {
  const testimonios = await listarTestimonios();
  const conImagen = testimonios.filter((testimonio) => testimonio.url_imgur?.trim());
  for (let i = conImagen.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [conImagen[i], conImagen[j]] = [conImagen[j], conImagen[i]];
  }
  testimoniosDestacados = conImagen.slice(0, 3).map((t) => ({
    imagen: t.url_imgur,
    destino: t.url_trustpilot_review?.trim() || t.url_imgur,
  }));
} catch (error) {
  console.error("Error fetching testimonios-trustpilot para Cómo Funciona:", error);
}

// Valores por defecto (Epson + Almohadillas) para el mensaje inicial de los
// 2 botones de WhatsApp propios de esta página (banner CRO y CTA final) —
// deben coincidir con los defaults del selector de diagnóstico embebido más
// abajo (ver ProcedimientoResumenDetalle.astro), que actualiza esos mismos
// botones en vivo via [data-whatsapp-dinamico] cuando cambian.
const cascadaDefaults = {
  marca: "Epson",
  modelo: t(locale, "comoFuncionaProceso.resumenModeloEjemplo"),
  error: t(locale, "comoFuncionaProceso.errorAlmohadillasLabel"),
};

const faqItems: { pregunta: string; respuesta: string }[] = t(locale, "faq.items");
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.pregunta,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.respuesta,
    },
  })),
};
const whatsappUrlPath = buildStaticPagePath(locale, "comoFunciona");
const whatsappUrlOrigen = `${SITE_URL}${whatsappUrlPath}`;
// Estado inicial (server-render) para los 2 botones de WhatsApp que se arman
// a mano en vez de con <WhatsAppCTA> (necesitan icono/markup propio). Usa los
// mismos valores por defecto que el resto de la pagina (Epson/Almohadillas,
// sin modelo); [data-whatsapp-dinamico] los actualiza en vivo despues.
const whatsappHrefInicial = buildWhatsAppLink(
  WHATSAPP_NUMBER,
  buildWhatsAppMessage({
    locale,
    marca: cascadaDefaults.marca,
    modelo: cascadaDefaults.modelo,
    error: cascadaDefaults.error,
    urlOrigen: whatsappUrlOrigen,
  })
);

const beneficios = [
  { icono: iconoReset, titulo: t(locale, "comoFuncionaProceso.beneficio1Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio1Texto") },
  { icono: iconoTraslados, titulo: t(locale, "comoFuncionaProceso.beneficio2Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio2Texto") },
  { icono: iconoInstalaciones, titulo: t(locale, "comoFuncionaProceso.beneficio3Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio3Texto") },
  { icono: iconoSeguridad, titulo: t(locale, "comoFuncionaProceso.beneficio4Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio4Texto") },
  { icono: iconoRespaldo, titulo: t(locale, "comoFuncionaProceso.beneficio5Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio5Texto") },
  { icono: iconoReembolso, titulo: t(locale, "comoFuncionaProceso.beneficio6Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio6Texto") },
  { icono: iconoCertificado, titulo: t(locale, "comoFuncionaProceso.beneficio7Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio7Texto") },
  { icono: iconoSoporte, titulo: t(locale, "comoFuncionaProceso.beneficio8Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio8Texto") },
  { id: "sorteos", icono: iconoSorteos, titulo: t(locale, "comoFuncionaProceso.beneficio9Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio9Texto") },
];
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<article class="como-funciona">
  <h1>{t(locale, "comoFunciona.heading")}</h1>

  <!-- Título y contexto breve -->
  <section class="intro-contexto">
    <h2 class="intro-titulo">{t(locale, "proceso.titulo")}</h2>
    <div class="intro-texto">
      <h3>{t(locale, "comoFuncionaProceso.introTituloQueEs")}</h3>
      <p>{t(locale, "comoFuncionaProceso.introParrafo1")}</p>
      <p>{t(locale, "comoFuncionaProceso.introParrafo2")}</p>
      <p class="intro-destacado">{t(locale, "comoFuncionaProceso.introDestacado")}</p>
      <p class="intro-aclaracion">{t(locale, "comoFuncionaProceso.introAclaracion")}</p>
    </div>
  </section>

  <!-- Grid de beneficios -->
  <section class="beneficios-grid">
    <div class="beneficios-header">
      <h2 class="beneficios-titulo">{t(locale, "comoFuncionaProceso.beneficiosTitulo")}</h2>
      <p class="beneficios-subtitulo">{t(locale, "comoFuncionaProceso.beneficiosSubtitulo")}</p>
    </div>
    <div class="beneficios-cards">
      {beneficios.map((beneficio) =>
        beneficio.id === "sorteos" ? (
          <button
            type="button"
            class="beneficio-card beneficio-card-clickable"
            data-ruleta-trigger
            aria-haspopup="dialog"
          >
            <div class="beneficio-icono-wrap">
              <Image src={beneficio.icono} alt="" width={80} height={80} loading="lazy" />
            </div>
            <h3>{beneficio.titulo}</h3>
            <p>{beneficio.texto}</p>
            <span class="beneficio-cta">{t(locale, "comoFuncionaProceso.jugarRuletaCta")}</span>
          </button>
        ) : (
          <div class="beneficio-card">
            <div class="beneficio-icono-wrap">
              <Image src={beneficio.icono} alt="" width={80} height={80} loading="lazy" />
            </div>
            <h3>{beneficio.titulo}</h3>
            <p>{beneficio.texto}</p>
          </div>
        )
      )}
    </div>

    <dialog class="ruleta-dialog" data-ruleta-dialog aria-label={t(locale, "ruletaPage.heading")}>
      <button type="button" class="ruleta-dialog-close" data-ruleta-close aria-label={t(locale, "comoFuncionaProceso.cerrarRuletaLabel")}>
        ×
      </button>
      <div class="ruleta-dialog-embed">
        <iframe data-ruleta-iframe data-src={RULETA_URL} title={t(locale, "ruletaPage.heading")} loading="lazy"></iframe>
      </div>
    </dialog>
  </section>

  <div class="seccion-divisor" aria-hidden="true" />

  <!-- Selector de diagnóstico + resumen de 6 pasos + desglose detallado:
       extraído a ProcedimientoResumenDetalle.astro (ver ese archivo) para
       que el Home lo reutilice sin duplicar el markup ni la lógica. -->
  <ProcedimientoResumenDetalle locale={locale} urlPath={whatsappUrlPath} />

  <div class="seccion-divisor" aria-hidden="true" />

  <!-- CTA estrategico (CRO), antes de las resenas -->
  <section
    class="whatsapp-banner-cro"
    data-whatsapp-dinamico
    data-whatsapp-number={WHATSAPP_NUMBER}
    data-url-origen={whatsappUrlOrigen}
    data-msg-with-error={t(locale, "whatsapp.greetingWithError")}
    data-msg-without-error={t(locale, "whatsapp.greetingWithoutError")}
    data-msg-generic={t(locale, "whatsapp.greetingGeneric")}
  >
    <a
      class="whatsapp-banner-btn"
      href={whatsappHrefInicial}
      data-source-id="como-funciona-banner-cro"
      target="_blank"
      rel="noopener noreferrer nofollow"
      data-sound="confirm"
    >
      {t(locale, "comoFuncionaProceso.whatsappBannerCta")}
    </a>
    <p class="whatsapp-banner-subtitulo">{t(locale, "comoFuncionaProceso.whatsappBannerSubtitulo")}</p>
  </section>

  {testimoniosDestacados.length > 0 && (
    <section class="prueba-social-resenas">
      <div class="prueba-social-header">
        <h2>{t(locale, "comoFuncionaProceso.resenasTitulo")}</h2>
        <p>{t(locale, "comoFuncionaProceso.resenasSubtitulo")}</p>
      </div>
      <div class="prueba-social-grid">
        {testimoniosDestacados.map((testimonio) => (
          <a class="resena-card" href={testimonio.destino} target="_blank" rel="noopener noreferrer nofollow">
            <img src={testimonio.imagen} alt={t(locale, "comoFuncionaProceso.testimonioTrustpilotAlt")} loading="lazy" />
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- BLOQUE 3: CTA + FAQ -->
  <section
    class="cta-final"
    data-whatsapp-dinamico
    data-whatsapp-number={WHATSAPP_NUMBER}
    data-url-origen={whatsappUrlOrigen}
    data-msg-with-error={t(locale, "whatsapp.greetingWithError")}
    data-msg-without-error={t(locale, "whatsapp.greetingWithoutError")}
    data-msg-generic={t(locale, "whatsapp.greetingGeneric")}
  >
    <WhatsAppCTA
      sourceId="como-funciona-final"
      label={t(locale, "comoFuncionaProceso.ctaFinalLabel")}
      locale={locale}
      urlPath={whatsappUrlPath}
      marca={cascadaDefaults.marca}
      modelo={cascadaDefaults.modelo}
      error={cascadaDefaults.error}
      destacado
    />
  </section>

  <div class="seccion-divisor" aria-hidden="true" />

  <section class="faq-final" id="preguntas-frecuentes">
    <h2>{t(locale, "faq.heading")}</h2>
    <FaqAccordion items={faqItems} />
  </section>
</article>

<script>
  // Popup de la ruleta (tarjeta "Sorteos y Premios Diarios"): el iframe solo
  // carga su src la primera vez que se abre el dialog, para no cargar el
  // juego en cada visita a la pagina.
  document.querySelectorAll<HTMLButtonElement>("[data-ruleta-trigger]").forEach((trigger) => {
    const dialog = trigger.closest("section")?.querySelector<HTMLDialogElement>("[data-ruleta-dialog]");
    const iframe = dialog?.querySelector<HTMLIFrameElement>("[data-ruleta-iframe]");
    const closeBtn = dialog?.querySelector<HTMLButtonElement>("[data-ruleta-close]");
    if (!dialog || !iframe || !closeBtn) return;

    trigger.addEventListener("click", () => {
      if (!iframe.src && iframe.dataset.src) iframe.src = iframe.dataset.src;
      dialog.showModal();
    });

    closeBtn.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .como-funciona {
    display: grid;
    gap: 2.5rem;
  }

  /* Separador sutil entre bloques (Beneficios / Selector / Pasos / CTA /
     FAQ) — franja de 1px con gradiente que se desvanece en los bordes, en
     vez de una linea solida que corte de forma abrupta. */
  .seccion-divisor {
    height: 1px;
    width: 100%;
    background: linear-gradient(to right, transparent, var(--color-border) 20%, var(--color-border) 80%, transparent);
  }

  /* Título y contexto breve */
  .intro-contexto {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: grid;
    gap: 1.25rem;
  }

  .intro-titulo {
    margin: 0;
    font-size: 1.6rem;
  }

  .intro-texto {
    display: grid;
    gap: 0.9rem;
    text-align: left;
  }

  .intro-texto h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .intro-texto p {
    margin: 0;
    color: var(--color-text-subtle);
    line-height: 1.65;
  }

  .intro-texto .intro-destacado {
    font-weight: 700;
    color: var(--color-text);
  }

  .intro-aclaracion {
    font-style: italic;
    font-size: 0.88rem;
  }

  /* Grid de beneficios */
  .beneficios-grid {
    margin-top: 4rem;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .beneficios-header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 2.5rem;
  }

  .beneficios-titulo {
    margin: 0 0 0.75rem;
    font-size: 1.6rem;
  }

  .beneficios-subtitulo {
    margin: 0;
    color: var(--color-text-muted, #4b5563);
    font-size: 1rem;
    line-height: 1.5;
  }

  .beneficios-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .beneficios-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .beneficios-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .beneficio-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem;
    border-radius: 1rem;
    background: #ffffff;
    border: 1px solid #f3f4f6;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    transition: box-shadow 300ms, transform 300ms;
  }

  .beneficio-card:hover {
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    transform: translateY(-0.25rem);
  }

  .beneficio-card-clickable {
    width: 100%;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .beneficio-cta {
    display: inline-flex;
    align-items: center;
    margin-top: 1rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    background: #1d4ed8;
    color: white;
    font-weight: 700;
    font-size: 0.82rem;
  }

  .ruleta-dialog {
    position: relative;
    border: none;
    border-radius: 1rem;
    padding: 2.75rem 1rem 1rem;
    max-width: min(94vw, 560px);
    max-height: 96vh;
    width: 100%;
    overflow-y: auto;
  }

  .ruleta-dialog::backdrop {
    background: rgba(15, 23, 42, 0.75);
  }

  .ruleta-dialog-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .ruleta-dialog-embed {
    width: 100%;
    height: min(88vh, 760px);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .ruleta-dialog-embed iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .beneficio-icono-wrap {
    width: 5rem;
    height: 5rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .beneficio-icono-wrap :global(img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .beneficio-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .beneficio-card p {
    margin: 0;
    font-weight: 400;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-muted, #4b5563);
  }

  /* Prueba Social: resenas reales de Trustpilot, antes del CTA final */
  .prueba-social-resenas {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .prueba-social-header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 2rem;
  }

  .prueba-social-header h2 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    font-weight: 800;
  }

  .prueba-social-header p {
    margin: 0;
    color: var(--color-text-muted, #4b5563);
    font-size: 1rem;
  }

  .prueba-social-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .prueba-social-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .resena-card {
    display: block;
    line-height: 0;
    background: #ffffff;
    border: 1px solid #f3f4f6;
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    overflow: hidden;
    transition: box-shadow 300ms, transform 300ms;
  }

  .resena-card:hover {
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    transform: translateY(-0.25rem);
  }

  .resena-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* BLOQUE 3 */
  .cta-final {
    display: flex;
    justify-content: center;
  }

  /* Verde WhatsApp + texto blanco + elevacion hacia arriba en hover (en vez
     del translateY hacia abajo y el texto verde oscuro por defecto del
     componente compartido) — override acotado a esta pagina, no toca
     WhatsAppCTA.astro para no afectar a otras paginas que lo usan. */
  .cta-final :global(.whatsapp-cta) {
    font-size: 1.15rem;
    padding: 1.1rem 2.5rem;
    background: #25d366;
    color: #ffffff;
  }

  .cta-final :global(.whatsapp-cta:hover) {
    background: #20bd5a;
  }

  .cta-final :global(.whatsapp-cta-destacado:hover) {
    transform: translateY(-4px) !important;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.15), 0 8px 10px -6px rgb(0 0 0 / 0.1) !important;
  }

  @keyframes whatsapp-flotante-pulso {
    0%,
    100% {
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.2), 0 4px 6px -4px rgb(0 0 0 / 0.2), 0 0 0 0 rgba(37, 211, 102, 0.45);
    }
    50% {
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.2), 0 4px 6px -4px rgb(0 0 0 / 0.2), 0 0 0 0.6rem rgba(37, 211, 102, 0);
    }
  }

  /* Banner CRO antes de las resenas */
  .whatsapp-banner-cro {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    text-align: center;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }

  .whatsapp-banner-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    border-radius: var(--radius-full);
    background: #25d366;
    color: #ffffff;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.15), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    animation: whatsapp-flotante-pulso 2.4s ease-in-out infinite;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .whatsapp-banner-btn:hover {
    background: #20bd5a;
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.25), 0 8px 10px -6px rgb(0 0 0 / 0.15);
    animation-play-state: paused;
  }

  .whatsapp-banner-subtitulo {
    margin: 0;
    color: var(--color-text-subtle);
    font-size: 0.92rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-banner-btn {
      animation: none;
    }
  }

  .faq-final h2 {
    margin: 0 0 1rem;
    font-size: 1.3rem;
  }
</style>
