---
import { t, buildStaticPagePath } from "../../i18n/utils";
import DiagnosticWizard from "../DiagnosticWizard.astro";
import type { Locale } from "../../config/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<article class="como-funciona">
  <h1>{t(locale, "comoFunciona.heading")}</h1>
  <DiagnosticWizard locale={locale} path={buildStaticPagePath(locale, "comoFunciona")} />
</article>

<style>
  .como-funciona {
    display: grid;
    gap: var(--space-sm);
  }
</style>
