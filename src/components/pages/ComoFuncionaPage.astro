---
/**
 * Página "Cómo funciona" reestructurada en 3 bloques: resumen visual de 6
 * pasos, desglose detallado de cada paso (silos expandidos con línea lateral
 * conectora), y CTA + FAQ. Contenido genérico (no atado a un modelo real) —
 * reutiliza los textos ya validados y traducidos a los 8 idiomas de los
 * namespaces "procesoReutilizable", "procedimiento" y "proceso" (los mismos
 * que usa ProcedimientoImpresora.astro en las páginas de modelo reales),
 * más un namespace propio "comoFuncionaProceso" solo para lo que no existía.
 */
import { Image, type ImageMetadata } from "astro:assets";
import { t, buildStaticPagePath } from "../../i18n/utils";
import FaqAccordion from "../ui/FaqAccordion.astro";
import Tabs from "../ui/Tabs.astro";
import EvidenceCard from "../ui/EvidenceCard.astro";
import YouTubeFacade from "../ui/YouTubeFacade.astro";
import ClienteSatisfechoEmbed from "../ui/ClienteSatisfechoEmbed.astro";
import WhatsAppCTA from "../WhatsAppCTA.astro";
import { fetchAllPages } from "../../lib/fetch-paginated";
import { extractYoutubeId } from "../../lib/youtube";
import { TECHNICIAN_ID, USB_REDIRECTOR_DOWNLOAD_URL, NUCLEO_API_BASE_URL, RULETA_URL, type Locale } from "../../config/site";
import iconoReset from "../../assets/beneficios/icono-reset.png";
import iconoTraslados from "../../assets/beneficios/icono-traslados.png";
import iconoInstalaciones from "../../assets/beneficios/icono-instalaciones.png";
import iconoSeguridad from "../../assets/beneficios/icono-seguridad.png";
import iconoRespaldo from "../../assets/beneficios/icono-respaldo.png";
import iconoReembolso from "../../assets/beneficios/icono-reembols.png";
import iconoCertificado from "../../assets/beneficios/icono-certificado.png";
import iconoSoporte from "../../assets/beneficios/icono-soporte.png";
import iconoSorteos from "../../assets/beneficios/icono-sorteos.png";
import procEpson1 from "../../assets/procedimiento/1.png";
import procEpson2 from "../../assets/procedimiento/2.png";
import procEpson3 from "../../assets/procedimiento/3.png";
import procEpson4 from "../../assets/procedimiento/4.png";
import procEpson5 from "../../assets/procedimiento/5.png";
import procEpson6 from "../../assets/procedimiento/6.png";
import procCanon1 from "../../assets/procedimiento-canon/1.png";
import procCanon2 from "../../assets/procedimiento-canon/2.png";
import procCanon3 from "../../assets/procedimiento-canon/3.png";
import procCanon4 from "../../assets/procedimiento-canon/4.png";
import procCanon5 from "../../assets/procedimiento-canon/5.png";
import procCanon6 from "../../assets/procedimiento-canon/6.png";
import procEpsonSc1 from "../../assets/procedimiento-epson-sc/1.png";
import procEpsonSc2 from "../../assets/procedimiento-epson-sc/2.png";
import procEpsonSc3 from "../../assets/procedimiento-epson-sc/3.png";
import procEpsonSc4 from "../../assets/procedimiento-epson-sc/4.png";
import procEpsonSc5 from "../../assets/procedimiento-epson-sc/5.png";
import procEpsonSc6 from "../../assets/procedimiento-epson-sc/6.png";
import pasoModuloWebp from "../../assets/proceso/paso1-descargar.webp";
import pasoConectarWebp from "../../assets/proceso/Paso2-Formulario.webp";
import pasoCompartirWebp from "../../assets/proceso/Paso3-ReconectarCableUSB.webp";
import pasoWhatsappWebp from "../../assets/proceso/Paso4-Contactarnos.webp";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Evidencia real embebida en los pasos 5 y 6 -- un caso al azar (elegido en
// build time, se renueva en cada deploy) desde los mismos catalogos
// publicos de Prueba Social. Si Nucleo no responde o no hay candidatos
// validos, se cae al placeholder existente sin romper la pagina.
let videoEvidenciaAleatorio: { youtubeId: string; titulo: string } | null = null;
try {
  const evidencias = await fetchAllPages(`${NUCLEO_API_BASE_URL}/api/public/reset-realizados/`);
  const conVideo = evidencias
    .map((e: any) => ({ ...e, youtubeId: extractYoutubeId(e.youtube_id) || extractYoutubeId(e.enlace_youtube) }))
    .filter((e: any) => e.youtubeId);
  if (conVideo.length > 0) {
    const elegido = conVideo[Math.floor(Math.random() * conVideo.length)];
    videoEvidenciaAleatorio = { youtubeId: elegido.youtubeId, titulo: `${elegido.marca} ${elegido.modelo}` };
  }
} catch (error) {
  console.error("Error fetching reset-realizados para Cómo Funciona:", error);
}

let clienteAleatorio: { url: string; titulo: string } | null = null;
try {
  const clientes = await fetchAllPages(`${NUCLEO_API_BASE_URL}/api/public/cliente-satisfecho/`);
  const conCaptura = clientes.filter((c: any) => c.html_url);
  if (conCaptura.length > 0) {
    const elegido = conCaptura[Math.floor(Math.random() * conCaptura.length)];
    const url = elegido.html_url.startsWith("/") ? `${NUCLEO_API_BASE_URL}${elegido.html_url}` : elegido.html_url;
    clienteAleatorio = { url, titulo: `${elegido.marca} ${elegido.modelo}` };
  }
} catch (error) {
  console.error("Error fetching cliente-satisfecho para Cómo Funciona:", error);
}

// Imagenes del grid de resumen (Bloque 1), una serie de 6 por marca. La marca
// activa en el selector de diagnostico de abajo decide cual serie se muestra
// (Epson por defecto); el toggle es puramente visual en el cliente porque las
// 3 series ya vienen renderizadas en el HTML (ver [data-marca-icono] en el
// script de mas abajo).
const procedimientoImagenes: Record<string, ImageMetadata[]> = {
  epson: [procEpson1, procEpson2, procEpson3, procEpson4, procEpson5, procEpson6],
  canon: [procCanon1, procCanon2, procCanon3, procCanon4, procCanon5, procCanon6],
  "epson-sc": [procEpsonSc1, procEpsonSc2, procEpsonSc3, procEpsonSc4, procEpsonSc5, procEpsonSc6],
};

// Los textos de los pasos 1 y 5 llevan placeholders {marca}/{modelo}/{error}
// que se resuelven con valores por defecto en el render estatico y se
// actualizan en vivo via [data-cascada-*] cuando el usuario cambia de marca,
// error o escribe su modelo en el selector de diagnostico de arriba.
type CascadaToken = "marca" | "modelo" | "error";
type TemplatePart = { text: string; token?: CascadaToken };

const renderTemplateParts = (template: string, defaults: Record<CascadaToken, string>): TemplatePart[] => {
  const tokenPattern = /\{(marca|modelo|error)\}/g;
  const parts: TemplatePart[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = tokenPattern.exec(template))) {
    if (match.index > lastIndex) parts.push({ text: template.slice(lastIndex, match.index) });
    const token = match[1] as CascadaToken;
    parts.push({ text: defaults[token], token });
    lastIndex = tokenPattern.lastIndex;
  }
  if (lastIndex < template.length) parts.push({ text: template.slice(lastIndex) });
  return parts;
};

// Selector de diagnóstico (marca -> error -> modelo, cascada por JS): el
// error elegido se propaga a cada [data-cascada-error] de la página (tarjeta
// 1 del resumen, título del Paso 1, y el bullet "Error ___ verificado" del
// Paso 2), para que el mismo texto aparezca en todos lados. Las plantillas
// "{error}" ya vienen partidas en prefijo/sufijo porque el texto alrededor
// cambia según el idioma.
const splitTemplate = (template: string): [string, string] => {
  const [prefix, suffix] = template.split("{error}");
  return [prefix, suffix ?? ""];
};

const [resumenPaso1Prefix, resumenPaso1Suffix] = splitTemplate(t(locale, "comoFuncionaProceso.resumenPaso1"));
const [paso2ErrorPrefix, paso2ErrorSuffix] = splitTemplate(t(locale, "comoFuncionaProceso.paso2ReqErrorVerificado"));
const errorDefaultLabel = t(locale, "comoFuncionaProceso.errorAlmohadillasLabel");
const otroErrorLabel = t(locale, "comoFuncionaProceso.otroErrorLabel");

const marcasSelector = [
  { id: "epson", label: "Epson", errores: [errorDefaultLabel, "E-11", otroErrorLabel] },
  { id: "canon", label: "Canon", errores: ["5B00", "1700", "P07", "E-08", otroErrorLabel] },
  { id: "epson-sc", label: "Epson-SC", errores: ["0014BD", "00000008 - 00080000", "00000004 - 00040000"] },
];

// Listas de modelos frecuentes para acelerar la seleccion (en vez de escribir
// a mano) cuando la combinacion marca+error lo amerita: Epson + Almohadillas
// (el error mas comun) y Canon (cualquiera de sus errores).
const modelosEpsonAlmohadillas = [
  "L3250", "L1250", "L4260", "L555", "L3150", "L3210", "L4150", "ET-2400", "ET-2870", "L120",
  "L355", "L495", "L575", "M2120", "ET-2710", "ET-2750", "ET-2760", "ET-2800", "ET-2860",
  "ET-4550", "ET-4700", "ET-4800", "L210", "L220", "L380", "L396", "L1210", "L1300", "L3060",
  "L3110", "L3160", "L4160", "L5290", "M1120", "WF-3730", "XP-235", "XP-320", "XP-400", "XP-2150",
];
const modelosCanon = [
  "G1100", "G1110", "G2110", "G2100", "G3100", "G3110", "G4100", "G4110", "G5010", "G6010", "G7010",
];

const modeloEjemplo = t(locale, "comoFuncionaProceso.resumenModeloEjemplo");
const cascadaDefaults: Record<CascadaToken, string> = {
  marca: marcasSelector[0].label,
  modelo: modeloEjemplo,
  error: errorDefaultLabel,
};
const resumenPaso1TextoParts = renderTemplateParts(t(locale, "comoFuncionaProceso.resumenPasoTexto1"), cascadaDefaults);
const resumenPaso5TextoParts = renderTemplateParts(t(locale, "comoFuncionaProceso.resumenPasoTexto5"), cascadaDefaults);

const subpasosConexion = [
  {
    numero: "3.1",
    imagen: pasoModuloWebp,
    titulo: t(locale, "proceso.paso1Titulo"),
    texto: t(locale, "proceso.paso1Texto"),
    enlace: t(locale, "proceso.paso1Enlace"),
  },
  { numero: "3.2", imagen: pasoConectarWebp, titulo: t(locale, "proceso.paso2Titulo"), texto: t(locale, "proceso.paso2Texto") },
  { numero: "3.3", imagen: pasoCompartirWebp, titulo: t(locale, "proceso.paso3Titulo"), texto: t(locale, "proceso.paso3Texto") },
  { numero: "3.4", imagen: pasoWhatsappWebp, titulo: t(locale, "proceso.paso4Titulo"), texto: t(locale, "proceso.paso4Texto") },
];

const faqItems: { pregunta: string; respuesta: string }[] = t(locale, "faq.items");
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.pregunta,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.respuesta,
    },
  })),
};
const whatsappUrlPath = buildStaticPagePath(locale, "comoFunciona");

const beneficios = [
  { icono: iconoReset, titulo: t(locale, "comoFuncionaProceso.beneficio1Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio1Texto") },
  { icono: iconoTraslados, titulo: t(locale, "comoFuncionaProceso.beneficio2Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio2Texto") },
  { icono: iconoInstalaciones, titulo: t(locale, "comoFuncionaProceso.beneficio3Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio3Texto") },
  { icono: iconoSeguridad, titulo: t(locale, "comoFuncionaProceso.beneficio4Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio4Texto") },
  { icono: iconoRespaldo, titulo: t(locale, "comoFuncionaProceso.beneficio5Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio5Texto") },
  { icono: iconoReembolso, titulo: t(locale, "comoFuncionaProceso.beneficio6Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio6Texto") },
  { icono: iconoCertificado, titulo: t(locale, "comoFuncionaProceso.beneficio7Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio7Texto") },
  { icono: iconoSoporte, titulo: t(locale, "comoFuncionaProceso.beneficio8Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio8Texto") },
  { id: "sorteos", icono: iconoSorteos, titulo: t(locale, "comoFuncionaProceso.beneficio9Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio9Texto") },
];

// Tabs del Paso 1: un ejemplo real por marca (imagen real del error, via
// error-images.js con fallback por modeloSlug ya que "epson-almohadillas" y
// "canon-5b00" no tienen una foto propia, solo por modelo — a diferencia de
// "epson-sc-0014bd" que sí tiene su propia foto de error y de solución).
const erroresTab = [
  {
    id: "epson-almohadillas",
    label: "Epson Almohadillas",
    errorId: "epson-almohadillas",
    modeloSlug: "l3110",
    nombreMarca: "Epson",
    nombreModelo: "L3110",
    pregunta: t(locale, "comoFuncionaProceso.paso1Pregunta"),
  },
  {
    id: "canon-5b00",
    label: "Canon 5B00",
    errorId: "canon-5b00",
    modeloSlug: "g3110",
    nombreMarca: "Canon",
    nombreModelo: "G3110",
    pregunta: t(locale, "comoFuncionaProceso.paso1PreguntaCanon"),
  },
  {
    id: "epson-sc-0014bd",
    label: "Epson-SC 0014BD",
    errorId: "epson-sc-0014bd",
    modeloSlug: "epson-sc-0014bd",
    nombreMarca: "Epson-SC",
    nombreModelo: "F570",
    pregunta: t(locale, "comoFuncionaProceso.paso1PreguntaEpsonSc"),
  },
];
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<article class="como-funciona">
  <h1>{t(locale, "comoFunciona.heading")}</h1>

  <!-- Título y contexto breve -->
  <section class="intro-contexto">
    <h2 class="intro-titulo">{t(locale, "proceso.titulo")}</h2>
    <div class="intro-texto">
      <h3>{t(locale, "comoFuncionaProceso.introTituloQueEs")}</h3>
      <p>{t(locale, "comoFuncionaProceso.introParrafo1")}</p>
      <p>{t(locale, "comoFuncionaProceso.introParrafo2")}</p>
      <p class="intro-destacado">{t(locale, "comoFuncionaProceso.introDestacado")}</p>
      <p class="intro-aclaracion">{t(locale, "comoFuncionaProceso.introAclaracion")}</p>
    </div>
  </section>

  <!-- Grid de beneficios -->
  <section class="beneficios-grid">
    <div class="beneficios-header">
      <h2 class="beneficios-titulo">{t(locale, "comoFuncionaProceso.beneficiosTitulo")}</h2>
      <p class="beneficios-subtitulo">{t(locale, "comoFuncionaProceso.beneficiosSubtitulo")}</p>
    </div>
    <div class="beneficios-cards">
      {beneficios.map((beneficio) =>
        beneficio.id === "sorteos" ? (
          <button
            type="button"
            class="beneficio-card beneficio-card-clickable"
            data-ruleta-trigger
            aria-haspopup="dialog"
          >
            <div class="beneficio-icono-wrap">
              <Image src={beneficio.icono} alt="" width={80} height={80} loading="lazy" />
            </div>
            <h3>{beneficio.titulo}</h3>
            <p>{beneficio.texto}</p>
            <span class="beneficio-cta">{t(locale, "comoFuncionaProceso.jugarRuletaCta")}</span>
          </button>
        ) : (
          <div class="beneficio-card">
            <div class="beneficio-icono-wrap">
              <Image src={beneficio.icono} alt="" width={80} height={80} loading="lazy" />
            </div>
            <h3>{beneficio.titulo}</h3>
            <p>{beneficio.texto}</p>
          </div>
        )
      )}
    </div>

    <dialog class="ruleta-dialog" data-ruleta-dialog aria-label={t(locale, "ruletaPage.heading")}>
      <button type="button" class="ruleta-dialog-close" data-ruleta-close aria-label={t(locale, "comoFuncionaProceso.cerrarRuletaLabel")}>
        ×
      </button>
      <div class="ruleta-dialog-embed">
        <iframe data-ruleta-iframe data-src={RULETA_URL} title={t(locale, "ruletaPage.heading")} loading="lazy"></iframe>
      </div>
    </dialog>
  </section>

  <!-- Selector de diagnóstico: marca -> error -> modelo, en cascada -->
  <section class="selector-diagnostico" data-selector-diagnostico>
    <h2 class="selector-titulo">{t(locale, "comoFuncionaProceso.selectorTitulo")}</h2>
    <div class="selector-marcas" role="radiogroup">
      {marcasSelector.map((marca) => (
        <button type="button" class="selector-btn" data-selector-marca data-value={marca.id} data-sound="select">
          {marca.label}
        </button>
      ))}
    </div>
    {marcasSelector.map((marca) => (
      <div class="selector-errores" data-selector-errores-panel={marca.id}>
        {marca.errores.map((error) => (
          <button type="button" class="selector-btn selector-btn-error" data-selector-error data-value={error} data-sound="select">
            {error}
          </button>
        ))}
      </div>
    ))}
    <div class="selector-modelo-wrap" data-selector-modelo-wrap data-almohadillas-label={errorDefaultLabel}>
      <label for="selector-modelo-input">{t(locale, "comoFuncionaProceso.selectorModeloLabel")}</label>
      <input
        type="text"
        id="selector-modelo-input"
        data-selector-modelo
        data-modelo-ejemplo={modeloEjemplo}
        placeholder={t(locale, "comoFuncionaProceso.selectorModeloPlaceholder")}
      />
      <select class="selector-modelo-lista" data-selector-modelo-lista="epson" hidden>
        <option value="">{t(locale, "comoFuncionaProceso.selectorModeloListaPlaceholder")}</option>
        {modelosEpsonAlmohadillas.map((modelo) => (
          <option value={modelo}>{modelo}</option>
        ))}
      </select>
      <select class="selector-modelo-lista" data-selector-modelo-lista="canon" hidden>
        <option value="">{t(locale, "comoFuncionaProceso.selectorModeloListaPlaceholder")}</option>
        {modelosCanon.map((modelo) => (
          <option value={modelo}>{modelo}</option>
        ))}
      </select>
    </div>
  </section>

  <!-- BLOQUE 1: Grid de resumen, dinámico por marca -->
  <section class="resumen-grid" aria-label={t(locale, "comoFuncionaProceso.tituloResumen")}>
    <h2 class="resumen-titulo">{t(locale, "comoFuncionaProceso.tituloResumen")}</h2>
    <div class="resumen-cards">
      <a class="resumen-card" href="#paso-como-funciona-1">
        <span class="resumen-badge">1</span>
        <div class="resumen-icono-wrap">
          {marcasSelector.map((marca) => (
            <Image
              src={procedimientoImagenes[marca.id][0]}
              alt=""
              width={64}
              height={64}
              loading="lazy"
              data-marca-icono={marca.id}
              class={marca.id === "epson" ? "resumen-icono-img icono-activa" : "resumen-icono-img"}
            />
          ))}
        </div>
        <h3>{t(locale, "comoFuncionaProceso.resumenPasoTitulo1")}</h3>
        <p>
          {resumenPaso1TextoParts.map((part) =>
            part.token ? <span {...{ [`data-cascada-${part.token}`]: true }}>{part.text}</span> : part.text
          )}
        </p>
      </a>

      <a class="resumen-card" href="#paso-como-funciona-2">
        <span class="resumen-badge">2</span>
        <div class="resumen-icono-wrap">
          {marcasSelector.map((marca) => (
            <Image
              src={procedimientoImagenes[marca.id][1]}
              alt=""
              width={64}
              height={64}
              loading="lazy"
              data-marca-icono={marca.id}
              class={marca.id === "epson" ? "resumen-icono-img icono-activa" : "resumen-icono-img"}
            />
          ))}
        </div>
        <h3>{t(locale, "comoFuncionaProceso.resumenPasoTitulo2")}</h3>
        <ul class="resumen-checklist">
          <li>
            <svg class="resumen-check-icono" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M7.6 13.6 4.4 10.4l-1.4 1.4 4.6 4.6 9-9-1.4-1.4z" fill="currentColor" />
            </svg>
            {t(locale, "comoFuncionaProceso.resumenPasoBullet2a")}
          </li>
          <li>
            <svg class="resumen-check-icono" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M7.6 13.6 4.4 10.4l-1.4 1.4 4.6 4.6 9-9-1.4-1.4z" fill="currentColor" />
            </svg>
            {t(locale, "comoFuncionaProceso.resumenPasoBullet2b")}
          </li>
        </ul>
        <p class="resumen-nota">{t(locale, "comoFuncionaProceso.resumenPasoNota2")}</p>
      </a>

      <a class="resumen-card" href="#paso-como-funciona-3">
        <span class="resumen-badge">3</span>
        <div class="resumen-icono-wrap">
          {marcasSelector.map((marca) => (
            <Image
              src={procedimientoImagenes[marca.id][2]}
              alt=""
              width={64}
              height={64}
              loading="lazy"
              data-marca-icono={marca.id}
              class={marca.id === "epson" ? "resumen-icono-img icono-activa" : "resumen-icono-img"}
            />
          ))}
        </div>
        <h3>{t(locale, "comoFuncionaProceso.resumenPasoTitulo3")}</h3>
        <p>{t(locale, "comoFuncionaProceso.resumenPasoTexto3")}</p>
      </a>

      <a class="resumen-card" href="#paso-como-funciona-4">
        <span class="resumen-badge">4</span>
        <div class="resumen-icono-wrap">
          {marcasSelector.map((marca) => (
            <Image
              src={procedimientoImagenes[marca.id][3]}
              alt=""
              width={64}
              height={64}
              loading="lazy"
              data-marca-icono={marca.id}
              class={marca.id === "epson" ? "resumen-icono-img icono-activa" : "resumen-icono-img"}
            />
          ))}
        </div>
        <h3>{t(locale, "comoFuncionaProceso.resumenPasoTitulo4")}</h3>
        <p>{t(locale, "comoFuncionaProceso.resumenPasoTexto4")}</p>
        <p class="resumen-nota">{t(locale, "comoFuncionaProceso.resumenPasoNota4")}</p>
      </a>

      <a class="resumen-card" href="#paso-como-funciona-5">
        <span class="resumen-badge">5</span>
        <div class="resumen-icono-wrap">
          {marcasSelector.map((marca) => (
            <Image
              src={procedimientoImagenes[marca.id][4]}
              alt=""
