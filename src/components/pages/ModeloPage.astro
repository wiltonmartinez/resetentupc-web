---
import { Image } from "astro:assets";
import { t, buildLocalizedPath, buildCanonicalUrl } from "../../i18n/utils";
import { resolverErroresConNucleo, listarResetRealizados, tituloConRespaldo } from "../../lib/nucleo-api";
import WhatsAppCTA from "../WhatsAppCTA.astro";
import Breadcrumb from "../Breadcrumb.astro";
import InfoCard from "../ui/InfoCard.astro";
import ChecklistItem from "../ui/ChecklistItem.astro";
import FaqAccordion from "../ui/FaqAccordion.astro";
import ModeloImage from "../ui/ModeloImage.astro";
import FavoritoEstrella from "../ui/FavoritoEstrella.astro";
import ProcedimientoImpresora from "../ProcedimientoImpresora.astro";
import ErrorImage from "../ui/ErrorImage.astro";
import TrustpilotWidget from "../TrustpilotWidget.astro";
import YouTubeFacade from "../ui/YouTubeFacade.astro";
import { SITE_URL, RULETA_URL, type Locale } from "../../config/site";
import iconoReset from "../../assets/beneficios/icono-reset.png";
import iconoTraslados from "../../assets/beneficios/icono-traslados.png";
import iconoInstalaciones from "../../assets/beneficios/icono-instalaciones.png";
import iconoSeguridad from "../../assets/beneficios/icono-seguridad.png";
import iconoRespaldo from "../../assets/beneficios/icono-respaldo.png";
import iconoReembolso from "../../assets/beneficios/icono-reembols.png";
import iconoCertificado from "../../assets/beneficios/icono-certificado.png";
import iconoSoporte from "../../assets/beneficios/icono-soporte.png";
import iconoSorteos from "../../assets/beneficios/icono-sorteos.png";

interface ModeloData {
  marcaSlug: string;
  modeloSlug: string;
  nombreMarca: string;
  nombreModelo: string;
  nivel: number;
}

interface Props {
  locale: Locale;
  modeloData: ModeloData;
}

const { locale, modeloData } = Astro.props;
const { marcaSlug, modeloSlug, nombreMarca, nombreModelo } = modeloData;

const path = `/reset/${marcaSlug}/${modeloSlug}/`;
const localizedPath = buildLocalizedPath(locale, path);
const sourceIdBase = `${marcaSlug}-${modeloSlug}`;

const { errores: erroresResueltos } = await resolverErroresConNucleo(marcaSlug, modeloSlug, locale);
const erroresCompatibles = erroresResueltos.filter((e) => e.estado_servicio === "compatible");
const erroresOtros = erroresResueltos.filter((e) => e.estado_servicio !== "compatible");

const unCompatible = erroresCompatibles.length === 1 ? erroresCompatibles[0] : undefined;
const variosCompatibles = erroresCompatibles.length > 1;
const hayOtros = erroresOtros.length > 0;
const sinErrores = erroresCompatibles.length === 0 && !hayOtros;

const tituloConPrefijo = `${t(locale, "modelo.prefijoTitulo")} ${nombreMarca} ${nombreModelo}`;

const modeloId = `${marcaSlug}:${modeloSlug}`;
const nombreCompleto = `${nombreMarca} ${nombreModelo}`;
const labelFavoritoAgregar = t(locale, "home.favoritoAgregar").replace("{nombre}", nombreCompleto);
const labelFavoritoQuitar = t(locale, "home.favoritoQuitar").replace("{nombre}", nombreCompleto);

const reconocimiento = t(locale, "modelo.reconocimiento")
  .replaceAll("{marca}", nombreMarca)
  .replaceAll("{modelo}", nombreModelo);
const errorSectionText = t(locale, "modelo.errorSectionText")
  .replaceAll("{marca}", nombreMarca)
  .replaceAll("{modelo}", nombreModelo);

// Atención (AIDA): explica qué es el error apenas se reconoce el equipo.
// Si hay un único error compatible ya sabemos su descripción real y la
// mencionamos; con varios errores compatibles (el usuario todavía no eligió
// cuál) queda la version generica — nunca se inventa un {errorLargo}.
const atencionExplicacion = (
  unCompatible
    ? t(locale, "modelo.atencionExplicacionConError").replaceAll("{errorLargo}", unCompatible.descripcion)
    : t(locale, "modelo.atencionExplicacionGenerica")
)
  .replaceAll("{marca}", nombreMarca)
  .replaceAll("{modelo}", nombreModelo);

// Interés (AIDA): grid de 9 beneficios ya validado en Como Funciona, mismo
// copy generico (no depende de marca/modelo) — solo el titulo de la seccion
// menciona el equipo especifico.
const interesTitulo = t(locale, "modelo.interesTitulo").replaceAll("{marca}", nombreMarca).replaceAll("{modelo}", nombreModelo);
const ctaBeneficiosLabel = t(locale, "modelo.ctaBeneficios").replaceAll("{marca}", nombreMarca).replaceAll("{modelo}", nombreModelo);
const beneficios = [
  { icono: iconoReset, titulo: t(locale, "comoFuncionaProceso.beneficio1Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio1Texto") },
  { icono: iconoTraslados, titulo: t(locale, "comoFuncionaProceso.beneficio2Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio2Texto") },
  { icono: iconoInstalaciones, titulo: t(locale, "comoFuncionaProceso.beneficio3Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio3Texto") },
  { icono: iconoSeguridad, titulo: t(locale, "comoFuncionaProceso.beneficio4Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio4Texto") },
  { icono: iconoRespaldo, titulo: t(locale, "comoFuncionaProceso.beneficio5Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio5Texto") },
  { icono: iconoReembolso, titulo: t(locale, "comoFuncionaProceso.beneficio6Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio6Texto") },
  { icono: iconoCertificado, titulo: t(locale, "comoFuncionaProceso.beneficio7Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio7Texto") },
  { icono: iconoSoporte, titulo: t(locale, "comoFuncionaProceso.beneficio8Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio8Texto") },
  { id: "sorteos", icono: iconoSorteos, titulo: t(locale, "comoFuncionaProceso.beneficio9Titulo"), texto: t(locale, "comoFuncionaProceso.beneficio9Texto") },
];

// Interés (AIDA): video resumido "Reset Asistido en 1 minuto" — mismo patron
// que el Paso 5 de ProcedimientoImpresora (candidato real de Núcleo,
// filtrado por marca/modelo con respaldo por marca). Acá alcanza con UN
// candidato: no hace falta azarear en cliente, ese detalle mas completo ya
// vive mas abajo en el paso a paso. Nunca se inventa un youtube_id: sin
// candidato, se muestra el mensaje de "muy pronto".
const listadoResetInteres = await listarResetRealizados(1, 50);
const candidatosInteresPorModelo = listadoResetInteres.data.filter(
  (r) => r.marca.toLowerCase() === marcaSlug && r.modelo.toLowerCase() === modeloSlug
);
const candidatosInteresPorMarca = listadoResetInteres.data.filter((r) => r.marca.toLowerCase() === marcaSlug);
const candidatoVideoInteres = (candidatosInteresPorModelo.length > 0 ? candidatosInteresPorModelo : candidatosInteresPorMarca)[0];
const videoInteres = candidatoVideoInteres
  ? { youtubeId: candidatoVideoInteres.youtube_id, titulo: tituloConRespaldo(candidatoVideoInteres) }
  : null;
const videoInteresTexto = t(locale, "modelo.videoResumenTexto").replaceAll("{marca}", nombreMarca).replaceAll("{modelo}", nombreModelo);
const videoInteresPlaceholder = t(locale, "modelo.videoResumenPlaceholder")
  .replaceAll("{marca}", nombreMarca)
  .replaceAll("{modelo}", nombreModelo);

// Acción (AIDA): frase de cierre antes de los CTA finales de WhatsApp.
const accionIntro = t(locale, "modelo.accionIntro").replaceAll("{marca}", nombreMarca).replaceAll("{modelo}", nombreModelo);

const faqItems: { pregunta: string; respuesta: string }[] = t(locale, "faq.items");
const faqConfianza = faqItems.slice(0, 3);

const canonicalUrl = buildCanonicalUrl(locale, path);
const homeUrl = buildCanonicalUrl(locale, "/");

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Reset asistido de impresora",
  name: tituloConPrefijo,
  description: t(locale, "modelo.descriptionTemplate")
    .replaceAll("{marca}", nombreMarca)
    .replaceAll("{modelo}", nombreModelo),
  provider: { "@type": "Organization", name: "ResetEnLinea.com", url: SITE_URL },
  areaServed: "Worldwide",
  url: canonicalUrl,
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.pregunta,
    acceptedAnswer: { "@type": "Answer", text: item.respuesta },
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: homeUrl },
    { "@type": "ListItem", position: 2, name: tituloConPrefijo, item: canonicalUrl },
  ],
};

---

<script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

<Breadcrumb
  items={[
    { label: t(locale, "nav.home"), href: buildLocalizedPath(locale, "/") },
    { label: tituloConPrefijo },
  ]}
/>

<article class="modelo-page">
  <!-- 1. Reconocimiento inmediato -->
  <header class="modelo-hero">
    <ModeloImage modeloSlug={modeloSlug} nombreMarca={nombreMarca} nombreModelo={nombreModelo} eager />
    <div class="modelo-hero-text">
      <h1 class="modelo-hero-titulo" data-label-agregar={labelFavoritoAgregar} data-label-quitar={labelFavoritoQuitar}>
        <span>{tituloConPrefijo}</span>
        <FavoritoEstrella modeloId={modeloId} variante="titulo" ariaLabel={labelFavoritoAgregar} />
      </h1>
      <p class="modelo-hero-subtitulo">{t(locale, "proceso.titulo")}</p>
      <p class="modelo-hero-pregunta">{reconocimiento}</p>
      <p class="modelo-hero-explicacion">{atencionExplicacion}</p>
    </div>
  </header>

  <!-- 2. Interés: por qué elegir el servicio (beneficios) + video resumido -->
  <section class="modelo-interes">
    <div class="beneficios-header">
      <h2 class="beneficios-titulo">{interesTitulo}</h2>
      <p class="beneficios-subtitulo">{t(locale, "comoFuncionaProceso.beneficiosSubtitulo")}</p>
    </div>
    <div class="beneficios-cards">
      {beneficios.map((beneficio) =>
        beneficio.id === "sorteos" ? (
          <button type="button" class="beneficio-card beneficio-card-clickable" data-ruleta-trigger aria-haspopup="dialog">
            <div class="beneficio-icono-wrap">
              <Image src={beneficio.icono} alt="" width={80} height={80} loading="lazy" />
            </div>
            <h3>{beneficio.titulo}</h3>
            <p>{beneficio.texto}</p>
            <span class="beneficio-cta">{t(locale, "comoFuncionaProceso.jugarRuletaCta")}</span>
          </button>
        ) : (
          <div class="beneficio-card">
            <div class="beneficio-icono-wrap">
              <Image src={beneficio.icono} alt="" width={80} height={80} loading="lazy" />
            </div>
            <h3>{beneficio.titulo}</h3>
            <p>{beneficio.texto}</p>
          </div>
        )
      )}
    </div>

    <div class="modelo-cta-seccion">
      <WhatsAppCTA
        marca={nombreMarca}
        modelo={nombreModelo}
        sourceId={`${sourceIdBase}-beneficios`}
        urlPath={localizedPath}
        locale={locale}
        label={ctaBeneficiosLabel}
        elevar
      />
      <p class="modelo-cta-subtexto">{t(locale, "modelo.ctaBeneficiosSubtexto")}</p>
    </div>

    <dialog class="ruleta-dialog" data-ruleta-dialog aria-label={t(locale, "ruletaPage.heading")}>
      <button type="button" class="ruleta-dialog-close" data-ruleta-close aria-label={t(locale, "comoFuncionaProceso.cerrarRuletaLabel")}>
        ×
      </button>
      <div class="ruleta-dialog-embed">
        <iframe data-ruleta-iframe data-src={RULETA_URL} title={t(locale, "ruletaPage.heading")} loading="lazy" />
      </div>
    </dialog>

    <div class="modelo-video-resumen">
      <h3 class="modelo-video-resumen-titulo">{t(locale, "modelo.videoResumenTitulo")}</h3>
      {videoInteres ? (
        <>
          <p class="modelo-video-resumen-texto">{videoInteresTexto}</p>
          <div class="video-contenedor">
            <YouTubeFacade
              youtubeId={videoInteres.youtubeId}
              titulo={videoInteres.titulo}
              reproducirLabel={t(locale, "pruebaSocialPage.reproducirVideo")}
            />
          </div>
        </>
      ) : (
        <p class="modelo-video-resumen-texto">{videoInteresPlaceholder}</p>
      )}
    </div>
  </section>

  <!-- 3. Confirmación del problema -->
  {sinErrores ? (
    <InfoCard>
      <div class="seccion-header">
        <svg class="seccion-icon" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6" />
          <path d="M17 17l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <h2>{t(locale, "modelo.errorSectionTitle")}</h2>
      </div>
      <p>{errorSectionText}</p>
    </InfoCard>
  ) : erroresCompatibles.length > 0 ? (
    <InfoCard>
      <ProcedimientoImpresora marca={nombreMarca} marcaSlug={marcaSlug} modelo={nombreModelo} locale={locale} />
    </InfoCard>
  ) : null}

  {(unCompatible || variosCompatibles) && (
    <p class="opcion-secundaria">
      <WhatsAppCTA
        marca={nombreMarca}
        modelo={nombreModelo}
        sourceId={`${sourceIdBase}-otro-error`}
        urlPath={localizedPath}
        locale={locale}
        label={t(locale, "modelo.ctaOtroError")}
      />
    </p>
  )}

  {hayOtros && (
    <InfoCard tone="warning">
      <div class="seccion-header seccion-header-warning">
        <span class="seccion-icon-badge" aria-hidden="true">
          <svg class="seccion-icon" viewBox="0 0 20 20" width="18" height="18" fill="none">
            <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6" />
            <path d="M12.7 12.7L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </span>
        <h2>{t(locale, "modelo.errorRequiereRevisionTitle")}</h2>
      </div>
      <p>{t(locale, "modelo.revisionTexto")}</p>
      <ul class="lista-revision">
        {erroresOtros.map((err) => (
          <li class="revision-item">
            <ErrorImage errorId={err.error_id} modeloSlug={modeloSlug} alt={err.descripcion} />
            <p class="revision-item-texto">{err.descripcion}</p>
          </li>
        ))}
      </ul>
      <WhatsAppCTA
        marca={nombreMarca}
        modelo={nombreModelo}
        sourceId={`${sourceIdBase}-requiere-revision`}
        urlPath={localizedPath}
        locale={locale}
        label={t(locale, "modelo.ctaConsultarCaso")}
      />
    </InfoCard>
  )}

  <!-- Nota: el sensor de tinta (Epson-SC + 0014BD), el índice visual 3x2
       ("Flujo del servicio") y el módulo "Reset Asistido 100% Remoto por
       conexión USB" ahora los renderiza ProcedimientoImpresora, dentro de
       la sección "2. Confirmación del problema" de arriba (este último,
       justo después del Paso 3 del desarrollo detallado). -->

  <!-- 4. Confianza y reducción de fricción -->
  <InfoCard tone="muted">
    <div class="seccion-header">
      <svg class="seccion-icon" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
        <path
          d="M2.5 5.5a2 2 0 012-2h11a2 2 0 012 2v6a2 2 0 01-2 2H8l-3.5 3v-3H4.5a2 2 0 01-2-2v-6Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
      <h2>{t(locale, "faq.heading")}</h2>
    </div>
    <div class="confianza-checklist">
      {faqConfianza.map((item) => (
        <ChecklistItem tone="check">
          <strong>{item.pregunta}</strong> — {item.respuesta}
        </ChecklistItem>
      ))}
    </div>
    <FaqAccordion items={faqItems.slice(3)} />
    <TrustpilotWidget locale={locale} />
  </InfoCard>

  <!-- 5. Acción: ya vio el proceso, los beneficios y la prueba social -->
  <p class="modelo-accion-intro">{accionIntro}</p>

  <section class="modelo-accion-banner">
    <WhatsAppCTA
      marca={nombreMarca}
      modelo={nombreModelo}
      sourceId={`${sourceIdBase}-banner-cro`}
      urlPath={localizedPath}
      locale={locale}
      label={t(locale, "comoFuncionaProceso.whatsappBannerCta")}
      elevar
    />
    <p class="modelo-accion-banner-subtitulo">{t(locale, "comoFuncionaProceso.whatsappBannerSubtitulo")}</p>
  </section>
</article>


<script>
  import { esFavorito, alternarFavorito } from "../../lib/favoritos.js";
  import { playFeedback } from "../../lib/sound-manager.js";

  function actualizarBoton(boton, esFav) {
    const contenedor = boton.closest("[data-label-agregar]");
    const etiqueta = contenedor ? (esFav ? contenedor.dataset.labelQuitar : contenedor.dataset.labelAgregar) : null;
    boton.setAttribute("aria-pressed", String(esFav));
    if (etiqueta) boton.setAttribute("aria-label", etiqueta);
  }

  document.querySelectorAll("[data-favorito-toggle]").forEach((boton) => {
    const id = boton.getAttribute("data-modelo-id") || "";
    if (!id) return;
    actualizarBoton(boton, esFavorito(id));
  });

  document.addEventListener("click", (event) => {
    const boton = event.target.closest("[data-favorito-toggle]");
    if (!boton) return;
    const id = boton.getAttribute("data-modelo-id") || "";
    if (!id) return;
    const esFavoritoAhora = alternarFavorito(id);
    document.querySelectorAll(`[data-favorito-toggle][data-modelo-id="${CSS.escape(id)}"]`).forEach((b) => {
      actualizarBoton(b, esFavoritoAhora);
    });
    playFeedback(esFavoritoAhora ? "favoritoAgregar" : "favoritoQuitar");
  });

  // Popup de la ruleta (tarjeta "Sorteos y Premios Diarios"): el iframe solo
  // carga su src la primera vez que se abre el dialog.
  document.querySelectorAll("[data-ruleta-trigger]").forEach((trigger) => {
    const dialog = trigger.closest("section")?.querySelector("[data-ruleta-dialog]");
    const iframe = dialog?.querySelector("[data-ruleta-iframe]");
    const closeBtn = dialog?.querySelector("[data-ruleta-close]");
    if (!dialog || !iframe || !closeBtn) return;

    trigger.addEventListener("click", () => {
      if (!iframe.src && iframe.dataset.src) iframe.src = iframe.dataset.src;
      dialog.showModal();
    });

    closeBtn.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .modelo-page {
    display: grid;
    gap: var(--space-md);
  }

  .modelo-hero {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .modelo-hero-text {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .modelo-hero-titulo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .modelo-hero {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
  }

  .modelo-hero-subtitulo {
    margin: -1.4rem 0 0;
    font-size: 0.9rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-text-subtle);
  }

  .modelo-hero-pregunta {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .seccion-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .seccion-header h2 {
    margin: 0;
  }

  .seccion-icon {
    flex: none;
    color: var(--color-primary);
  }

  .seccion-header-warning .seccion-icon {
    color: var(--color-warning-text);
  }

  .seccion-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(154, 52, 18, 0.12);
    color: var(--color-warning-text);
  }

  .lista-revision {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .revision-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    border: 1px solid var(--color-warning-border);
  }

  .revision-item :global(.evidencia-imagen) {
    flex: 0 0 auto;
    width: 9rem;
    margin: 0;
  }

  .revision-item-texto {
    flex: 1 1 200px;
    margin: 0;
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.92rem;
  }

  @media (max-width: 480px) {
    .revision-item :global(.evidencia-imagen) {
      width: 100%;
    }
  }

  .confianza-checklist {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .opcion-secundaria {
    margin: -0.5rem 0 0;
    text-align: center;
  }

  .opcion-secundaria :global(.whatsapp-cta) {
    background: none;
    color: var(--color-text-subtle);
    text-decoration: underline;
    font-weight: 500;
    padding: 0.25rem;
  }

  .opcion-secundaria :global(.whatsapp-cta:hover) {
    background: none;
    color: var(--color-text);
  }

  .modelo-hero-explicacion {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Interés: grid de beneficios + video resumido */
  .modelo-interes {
    display: grid;
    gap: 2rem;
  }

  .beneficios-header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
  }

  .beneficios-titulo {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
  }

  .beneficios-subtitulo {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .beneficios-cards {
    display: grid;
