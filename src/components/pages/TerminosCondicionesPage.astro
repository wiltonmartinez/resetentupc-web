---
/**
 * Página legal, disponible en los 7 idiomas del sitio. El contenido legal
 * fue redactado originalmente en español (jurisdicción colombiana explícita
 * en el propio texto) y traducido al resto de idiomas; cada bloque marcado
 * como "REVISIÓN LEGAL RECOMENDADA" sigue necesitando revisión de un abogado
 * por jurisdicción antes de tratarse como asesoría legal definitiva.
 */
import { SITE_URL, WHATSAPP_NUMBER, type Locale } from "../../config/site";
import { buildWhatsAppLink, buildStaticPagePath, t } from "../../i18n/utils";
import InfoCard from "../ui/InfoCard.astro";
import SharePageButtons from "../ui/SharePageButtons.astro";
import ObfuscatedEmail from "../ui/ObfuscatedEmail.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const path = buildStaticPagePath(locale, "terminosCondiciones");
const url = `${SITE_URL}${path}`;

const mensajeWhatsapp = `${t(locale, "terminos.share.mensajeWhatsapp")}\n\n${url}`;
const asuntoEmail = t(locale, "terminos.share.asuntoEmail");
const cuerpoEmail = `${t(locale, "terminos.share.cuerpoEmailSaludo")}\n\n${t(locale, "terminos.share.cuerpoEmailIntro")}\n\n${url}\n\n${t(locale, "terminos.share.cuerpoEmailDespedida")}`;

const whatsappConsultaHref = buildWhatsAppLink(WHATSAPP_NUMBER, t(locale, "terminos.cta.whatsappMensaje"));

const secciones = [
  "objeto",
  "naturaleza",
  "proceso",
  "reembolsos",
  "exclusiones",
  "errores",
  "garantia",
  "certificado",
  "evidencia",
  "privacidad",
  "prestador",
  "legislacion",
].map((id) => ({ id, titulo: t(locale, `terminos.secciones.${id}.titulo`) }));
---

<article class="terminos-page">
  <h1>{t(locale, "terminos.title")}</h1>
  <p class="terminos-actualizacion">{t(locale, "terminos.actualizacion")}</p>

  <SharePageButtons
    url={url}
    tituloLabel={t(locale, "terminos.share.titulo")}
    mensajeWhatsapp={mensajeWhatsapp}
    asuntoEmail={asuntoEmail}
    cuerpoEmail={cuerpoEmail}
    labelWhatsapp={t(locale, "terminos.share.whatsapp")}
    labelEmail={t(locale, "terminos.share.email")}
    labelCopiar={t(locale, "terminos.share.copiar")}
    labelCopiado={t(locale, "terminos.share.copiado")}
    labelImprimir={t(locale, "terminos.share.imprimir")}
    labelCompartir={t(locale, "terminos.share.compartir")}
  />

  <nav class="terminos-toc" aria-label={t(locale, "terminos.tocTitulo")}>
    <h2>{t(locale, "terminos.tocTitulo")}</h2>
    <ol>
      {secciones.map((seccion) => (
        <li><a href={`#${seccion.id}`}>{seccion.titulo}</a></li>
      ))}
    </ol>
  </nav>

  <section id="objeto">
    <h2>{t(locale, "terminos.secciones.objeto.titulo")}</h2>
    <p>
      {t(locale, "terminos.secciones.objeto.p1Antes")} <strong>{t(locale, "terminos.secciones.objeto.p1Fuerte")}</strong>{t(locale, "terminos.secciones.objeto.p1Despues")}
    </p>
  </section>

  <section id="naturaleza">
    <h2>{t(locale, "terminos.secciones.naturaleza.titulo")}</h2>
    <p>{t(locale, "terminos.secciones.naturaleza.p1")}</p>
    <p>
      {t(locale, "terminos.secciones.naturaleza.p2Antes")} <strong>{t(locale, "terminos.secciones.naturaleza.p2Fuerte")}</strong>{t(locale, "terminos.secciones.naturaleza.p2Despues")}
    </p>
  </section>

  <section id="proceso">
    <h2>{t(locale, "terminos.secciones.proceso.titulo")}</h2>
    <ol class="terminos-proceso-lista">
      {(t(locale, "terminos.secciones.proceso.pasos") as string[]).map((paso) => (
        <li>{paso}</li>
      ))}
    </ol>
  </section>

  <section id="reembolsos">
    <h2>{t(locale, "terminos.secciones.reembolsos.titulo")}</h2>
    <p>{t(locale, "terminos.secciones.reembolsos.p1")}</p>
    <ul>
      <li>{t(locale, "terminos.secciones.reembolsos.li1")}</li>
      <li>{t(locale, "terminos.secciones.reembolsos.li2")}</li>
      <li>
        {t(locale, "terminos.secciones.reembolsos.li3Antes")} <strong>{t(locale, "terminos.secciones.reembolsos.li3Fuerte")}</strong>{t(locale, "terminos.secciones.reembolsos.li3Despues")}
      </li>
    </ul>
    <p>{t(locale, "terminos.secciones.reembolsos.p2")}</p>
    <p class="terminos-revision-legal">⚠️ {t(locale, "terminos.secciones.reembolsos.legal")}</p>
  </section>

  <section id="exclusiones">
    <h2>{t(locale, "terminos.secciones.exclusiones.titulo")}</h2>
    <p>{t(locale, "terminos.secciones.exclusiones.intro")}</p>
    <ul>
      {(t(locale, "terminos.secciones.exclusiones.items") as string[]).map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section id="errores">
    <h2>{t(locale, "terminos.secciones.errores.titulo")}</h2>
    <p><strong>{t(locale, "terminos.secciones.errores.epsonLabel")}</strong> E-11, W-11, E-10, W-10</p>
    <p><strong>{t(locale, "terminos.secciones.errores.canonLabel")}</strong> 5B00, 1700, P07</p>
    <p>
      <strong>{t(locale, "terminos.secciones.errores.epsonScLabel")}</strong> 0014BD, 00000008, 00000001, 00000004, 0000000C, 00010000,
      00040000, 00080000, 00010008, 0001000C, 00010004, 00040008, 0004000C, 000C0008, 000C0001, 000C0004
    </p>
    <p>{t(locale, "terminos.secciones.errores.nota")}</p>
  </section>

  <section id="garantia">
    <h2>{t(locale, "terminos.secciones.garantia.titulo")}</h2>
    <p>{t(locale, "terminos.secciones.garantia.p1")}</p>
    <p>{t(locale, "terminos.secciones.garantia.p2")}</p>
    <p>{t(locale, "terminos.secciones.garantia.p3")}</p>
    <p>{t(locale, "terminos.secciones.garantia.p4")}</p>
    <ul>
      <li>{t(locale, "terminos.secciones.garantia.li1")}</li>
      <li>{t(locale, "terminos.secciones.garantia.li2")}</li>
      <li>{t(locale, "terminos.secciones.garantia.li3")}</li>
      <li>{t(locale, "terminos.secciones.garantia.li4")}</li>
      <li>{t(locale, "terminos.secciones.garantia.li5")}</li>
    </ul>
    <p class="terminos-revision-legal">⚠️ {t(locale, "terminos.secciones.garantia.legal")}</p>
  </section>

  <section id="certificado">
    <h2>{t(locale, "terminos.secciones.certificado.titulo")}</h2>
    <p>{t(locale, "terminos.secciones.certificado.p1")}</p>
    <p>{t(locale, "terminos.secciones.certificado.p2")}</p>
  </section>

  <section id="evidencia">
    <h2>{t(locale, "terminos.secciones.evidencia.titulo")}</h2>
    <p>{t(locale, "terminos.secciones.evidencia.p1")}</p>
  </section>

  <section id="privacidad">
    <h2>{t(locale, "terminos.secciones.privacidad.titulo")}</h2>
    <p>{t(locale, "terminos.secciones.privacidad.p1")}</p>
    <p>{t(locale, "terminos.secciones.privacidad.p2")}</p>
    <p>
      {t(locale, "terminos.secciones.privacidad.p3Antes")} <ObfuscatedEmail user="info" domain="resetenlinea.com" />{t(locale, "terminos.secciones.privacidad.p3Despues")}
    </p>
    <p class="terminos-revision-legal">⚠️ {t(locale, "terminos.secciones.privacidad.legal")}</p>
  </section>

  <section id="prestador">
    <h2>{t(locale, "terminos.secciones.prestador.titulo")}</h2>
    <ul class="terminos-datos-lista">
      <li>ResetEnLinea</li>
      <li>Wilton Martinez Escorcia</li>
      <li>Santa Marta, Colombia</li>
      <li><ObfuscatedEmail user="info" domain="resetenlinea.com" /></li>
      <li><a href="https://resetenlinea.com">resetenlinea.com</a></li>
    </ul>
  </section>

  <section id="legislacion">
    <h2>{t(locale, "terminos.secciones.legislacion.titulo")}</h2>
    <p>{t(locale, "terminos.secciones.legislacion.p1")}</p>
    <p class="terminos-revision-legal">⚠️ {t(locale, "terminos.secciones.legislacion.legal")}</p>
  </section>

  <InfoCard tone="muted">
    <p class="terminos-cta-texto">{t(locale, "terminos.cta.texto")}</p>
    <a class="terminos-cta-whatsapp" href={whatsappConsultaHref} target="_blank" rel="noopener noreferrer nofollow" data-sound="select">
      {t(locale, "terminos.cta.whatsappLabel")}
    </a>
  </InfoCard>

  <SharePageButtons
    url={url}
    tituloLabel={t(locale, "terminos.share.titulo")}
    mensajeWhatsapp={mensajeWhatsapp}
    asuntoEmail={asuntoEmail}
    cuerpoEmail={cuerpoEmail}
    labelWhatsapp={t(locale, "terminos.share.whatsapp")}
    labelEmail={t(locale, "terminos.share.email")}
    labelCopiar={t(locale, "terminos.share.copiar")}
    labelCopiado={t(locale, "terminos.share.copiado")}
    labelImprimir={t(locale, "terminos.share.imprimir")}
    labelCompartir={t(locale, "terminos.share.compartir")}
  />
</article>

<style>
  .terminos-page {
    display: grid;
    gap: var(--space-md);
  }

  .terminos-actualizacion {
    margin: -0.5rem 0 0;
    color: var(--color-text-subtle);
    font-size: 0.9rem;
  }

  .terminos-toc {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-muted);
  }

  .terminos-toc h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .terminos-toc ol {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.3rem;
    columns: 1;
  }

  @media (min-width: 640px) {
    .terminos-toc ol {
      columns: 2;
      column-gap: 1.5rem;
    }
  }

  .terminos-toc a {
    color: var(--color-primary-dark);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .terminos-toc a:hover {
    text-decoration: underline;
  }

  .terminos-page section {
    scroll-margin-top: 5rem;
  }

  .terminos-page section h2 {
    margin: 0 0 0.5rem;
  }

  .terminos-page section p,
  .terminos-page section ul,
  .terminos-page section ol {
    margin: 0 0 0.6rem;
    color: var(--color-text-muted);
  }

  .terminos-proceso-lista {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.3rem;
  }

  .terminos-datos-lista {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .terminos-revision-legal {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-warning-border);
    border-radius: var(--radius-sm);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
    font-weight: 600;
    font-size: 0.88rem;
  }

  .terminos-cta-texto {
    margin: 0;
    text-align: center;
    font-weight: 600;
  }

  .terminos-cta-whatsapp {
    display: block;
    width: fit-content;
    margin: 0 auto;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .terminos-cta-whatsapp:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  @media print {
    .terminos-cta-whatsapp,
    .terminos-toc {
      display: none;
    }
  }
</style>
