---
import { t } from "../../i18n/utils";
import FaqAccordion from "../ui/FaqAccordion.astro";
import TrustpilotWidget from "../TrustpilotWidget.astro";
import type { Locale } from "../../config/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items: { pregunta: string; respuesta: string }[] = t(locale, "faq.items");
---

<article class="faq-page">
  <h1>{t(locale, "faq.heading")}</h1>
  <FaqAccordion items={items} />
  <TrustpilotWidget />
</article>

<style>
  .faq-page {
    display: grid;
    gap: var(--space-sm);
  }
</style>
