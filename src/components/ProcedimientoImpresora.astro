<script>
  // Reactividad: escucha el mismo <select> de ErrorSelector.astro (por
  // sourceIdBase) y actualiza el código y la descripción larga mostrados en
  // el Paso 1 y el Paso 2, y —solo para Epson-SC— la visibilidad de la
  // sección de sensor de tinta.
  function obtenerErrorCorto(cadena: string): string {
    if (!cadena) return "";
    const matchCodigo = cadena.match(/c[oó]digo\s+([0-9a-z]+)/i);
    if (matchCodigo) return matchCodigo[1].toUpperCase();
    if (/almohadilla/i.test(cadena)) return "Almohadillas";
    return cadena.trim();
  }

  document.querySelectorAll<HTMLElement>("[data-procedimiento]").forEach((raiz) => {
    const base = raiz.dataset.sourceIdBase;
    const marcaSlug = raiz.dataset.marca;
    const select = base ? (document.getElementById(`error-select-${base}`) as HTMLSelectElement | null) : null;

    if (select) {
      const codigoEl = raiz.querySelector<HTMLElement>("[data-procedimiento-codigo]");
      const sensorWrapper = raiz.querySelector<HTMLElement>("[data-procedimiento-sensor]");
      const requisitoSensor = raiz.querySelector<HTMLElement>("[data-procedimiento-requisito-sensor]");
      const errorLargoEls = raiz.querySelectorAll<HTMLElement>("[data-procedimiento-error-largo]");

      select.addEventListener("change", () => {
        const opcion = select.options[select.selectedIndex];
        const codigoAtributo = opcion?.getAttribute("data-codigo")?.trim();
        const descripcion = opcion?.getAttribute("data-descripcion") || "";
        const codigo = (codigoAtributo ? codigoAtributo.toUpperCase() : obtenerErrorCorto(descripcion)) || "Almohadillas";
        const esSensor = marcaSlug === "epson-sc" && codigo === "0014BD";

        if (codigoEl) codigoEl.textContent = codigo;
        if (descripcion) errorLargoEls.forEach((el) => (el.textContent = descripcion));
        if (sensorWrapper) sensorWrapper.hidden = !esSensor;
        if (requisitoSensor) requisitoSensor.hidden = !esSensor;
      });
    }

    // SSG + azar en el cliente: el HTML estático ya trae el primer
    // candidato de cada lista (video, testimonio local, Trustpilot) — acá
    // se elige uno al azar POR VISITANTE entre todos los candidatos reales
    // (traídos de Núcleo en build) y se actualiza el DOM ya renderizado.
    // Si Núcleo no devolvió más de un candidato para algo, no hay bloque
    // JSON y esta parte no hace nada (se queda con lo que ya se renderizó).
    const candidatosScript = raiz.querySelector<HTMLScriptElement>("script[data-procedimiento-candidatos]");
    if (!candidatosScript) return;

    let candidatos: {
      videos?: { youtubeId: string; titulo: string; slug: string }[];
      local?: { url: string; titulo: string; slug?: string }[];
    };
    try {
      candidatos = JSON.parse(candidatosScript.textContent || "{}");
    } catch {
      return;
    }

    const alAzar = <T,>(lista: T[] | undefined): T | null =>
      lista && lista.length > 0 ? lista[Math.floor(Math.random() * lista.length)] : null;

    // Paso 5: video
    const videoElegido = alAzar(candidatos.videos);
    const videoWrapper = raiz.querySelector<HTMLElement>("[data-procedimiento-video-real]");
    if (videoElegido && videoWrapper) {
      const trigger = videoWrapper.querySelector<HTMLElement>("[data-youtube-trigger]");
      const img = videoWrapper.querySelector<HTMLImageElement>(".youtube-card-trigger img");
      const tituloEl = videoWrapper.querySelector<HTMLElement>(".youtube-card-titulo");
      const enlaceSeo = videoWrapper.querySelector<HTMLAnchorElement>(".procedimiento-enlace-seo");
      const hrefBase = videoWrapper.dataset.hrefBase || "";
      const anchorTemplate = videoWrapper.dataset.anchorTemplate || "{titulo}";

      if (trigger) {
        trigger.setAttribute("data-youtube-id", videoElegido.youtubeId);
        trigger.setAttribute("aria-label", trigger.getAttribute("aria-label")?.replace(/:.*/, `: ${videoElegido.titulo}`) || videoElegido.titulo);
      }
      if (img) img.src = `https://i.ytimg.com/vi/${videoElegido.youtubeId}/hqdefault.jpg`;
      if (tituloEl) tituloEl.textContent = videoElegido.titulo;
      if (enlaceSeo) {
        enlaceSeo.href = `${hrefBase}${videoElegido.slug}/`;
        enlaceSeo.textContent = `${anchorTemplate.replace("{titulo}", videoElegido.titulo)} →`;
      }
    }

    // Paso 6: testimonio local (Cliente Satisfecho)
    const localElegido = alAzar(candidatos.local);
    const localWrapper = raiz.querySelector<HTMLElement>("[data-procedimiento-testimonio-local]");
    if (localElegido && localWrapper) {
      const iframe = localWrapper.querySelector<HTMLIFrameElement>("iframe");
      const enlaceSeo = localWrapper.querySelector<HTMLAnchorElement>(".procedimiento-enlace-seo");
      const hrefBase = localWrapper.dataset.hrefBase || "";
      const anchorTemplate = localWrapper.dataset.anchorTemplate || "{titulo}";

      if (iframe) {
        iframe.src = `${localElegido.url}${localElegido.url.includes("?") ? "&" : "?"}chat=1`;
        iframe.title = localElegido.titulo;
      }
      if (enlaceSeo && localElegido.slug) {
        enlaceSeo.href = `${hrefBase}${localElegido.slug}/`;
        enlaceSeo.textContent = `${anchorTemplate.replace("{titulo}", localElegido.titulo)} →`;
      }
    }

  });

  // Boton "copiar" del ID de tecnico (subtarjeta 3.2): copia al portapapeles
  // y muestra un tooltip de confirmacion breve.
  document.querySelectorAll<HTMLButtonElement>("[data-copy-value]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const valor = btn.dataset.copyValue ?? "";
      try {
        await navigator.clipboard.writeText(valor);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = valor;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }
      btn.classList.add("copiado");
      window.setTimeout(() => btn.classList.remove("copiado"), 1500);
    });
  });
</script>

