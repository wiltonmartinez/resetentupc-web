---
/**
 * Orquesta el flujo completo de reset por marca en 4 secciones: selector de
 * error, sensor condicional (solo Epson-SC + 0014BD), índice visual 3x2 y
 * desarrollo detallado de los 6 pasos. La "plantilla Epson" (Paso 1
 * reactivo, Paso 3 con resultado de revisión, Paso 4 con consulta de
 * garantía, Paso 5/6 con video/testimonios reales de Núcleo) se aplica por
 * igual a las 3 marcas — solo el índice visual 3x2 (Sección 3) sigue
 * teniendo un componente propio por marca (Epson/Canon/Epson-SC), porque
 * cada uno usa terminología de error real y distinta para su marca.
 *
 * Datos: intenta primero Núcleo (errores por modelo, testimonios) — el
 * endpoint de errores ya está en producción, pero hoy solo tiene datos
 * cargados para "epson-sc"; "epson" y "canon" devuelven data:[] hasta que
 * el panel admin de Núcleo cargue sus errores, así que esas dos marcas
 * siguen cayendo a errores.json local (resolveErroresParaModelo) por
 * ahora — ver nucleo-api.ts. Los testimonios (Trustpilot y Cliente
 * Satisfecho) y los videos de reset realizado sí son reales hoy para
 * todas las marcas (mismos endpoints que ya usan las páginas de Prueba
 * Social) — se buscan para las 3 marcas por igual.
 *
 * SSG + azar en el cliente (NO SSR): las páginas de modelo son estáticas
 * (getStaticPaths, generadas en el build). El fetch a Núcleo pasa UNA vez
 * en build y trae el listado COMPLETO de candidatos (video de Paso 5,
 * testimonio local y Trustpilot de Paso 6) — el HTML estático renderiza el
 * primer candidato de cada lista (para que Googlebot vea un enlace/video
 * real desde el primer render), y el resto de la lista se embebe como JSON
 * en la página. Un <script> del lado del cliente elige uno al azar por
 * visitante y actualiza el DOM (ver más abajo) — así se logra variedad
 * real por visita sin convertir el sitio a SSR ni depender de Núcleo en
 * vivo para que la página cargue. Este componente NO usa React (el
 * proyecto no lo tiene instalado) — la aleatoriedad por visitante se
 * resuelve con vanilla JS, mismo patrón que el resto de la reactividad ya
 * construida en este componente (basada en querySelector/dataset).
 *
 * El video del Paso 5 sale de `listarResetRealizados` — si no hay uno para
 * el modelo exacto, cae a cualquiera de la misma marca (una similitud
 * simple hecha aquí; la similitud real "por modelo hermano" vive en
 * Núcleo, ver INSTRUCCIONES PARA EL BACKEND más abajo). Nunca se inventa
 * un youtube_id: si no hay ningún candidato para una marca/modelo, se
 * muestra el placeholder visible en vez de romper la sección.
 */
import {
  t,
  resolveErroresParaModelo,
  buildLocalizedPath,
  buildWhatsAppMessage,
  buildWhatsAppLink,
  type ErrorResuelto,
} from "../i18n/utils";
import { WHATSAPP_NUMBER, SITE_URL, TECHNICIAN_ID, USB_REDIRECTOR_DOWNLOAD_URL, type Locale } from "../config/site";
import ErrorSelector from "./ErrorSelector.astro";
import EvidenceCard from "./ui/EvidenceCard.astro";
import VideoModal from "./ui/VideoModal.astro";
import SensorLocation from "./ui/SensorLocation.astro";
import SensorConditionComparison from "./ui/SensorConditionComparison.astro";
import ProcesoReutilizable from "./ui/ProcesoReutilizable.astro";
import ProcesoReutilizableCanon from "./ui/ProcesoReutilizableCanon.astro";
import ProcesoReutilizableEpsonSc from "./ui/ProcesoReutilizableEpsonSc.astro";
import YouTubeFacade from "./ui/YouTubeFacade.astro";
import TrustpilotWidget from "./TrustpilotWidget.astro";
import ClienteSatisfechoEmbed from "./ui/ClienteSatisfechoEmbed.astro";
import InfoCard from "./ui/InfoCard.astro";
import ProcessSteps from "./ui/ProcessSteps.astro";
import WhatsAppCTA from "./WhatsAppCTA.astro";
import ConsultaGarantiaPage from "./pages/ConsultaGarantiaPage.astro";
import { getSensorTintaParaMarca } from "../data/sensor-tinta";
import { getProcesoImage } from "../lib/proceso-images.js";
import {
  listarErroresPorModelo,
  listarResetRealizados,
  listarTestimonios,
  listarClienteSatisfecho,
  obtenerEvidenciaClienteSatisfecho,
  tituloConRespaldo,
  type ErrorPublico,
} from "../lib/nucleo-api";

interface Props {
  /** Nombre visible ("Epson", "Canon", "Epson SC"...) — solo para texto, no para lógica. */
  marca: string;
  /**
   * Slug real ("epson" | "canon" | "epson-sc") usado por el resto del
   * sitio (imágenes, Núcleo, sensor-tinta, etc). Opcional: si no se pasa,
   * se deriva de `marca` en minúsculas — pero eso rompe para nombres con
   * espacio como "Epson SC" (el slug real es "epson-sc", con guion, no
   * "epson sc"). Siempre que el caller ya tenga el slug real (como
   * ModeloPage.astro, que lo trae de modelos-muestra.json), debe pasarlo
   * explícito acá en vez de confiar en la derivación.
   */
  marcaSlug?: string;
  modelo: string;
  /** No pedido explícitamente por props, pero necesario para reusar los
   *  datos reales (i18n). Default "es". */
  locale?: Locale;
}

const { marca, marcaSlug: marcaSlugProp, modelo, locale = "es" } = Astro.props;
const marcaSlug = marcaSlugProp ?? marca.toLowerCase().replace(/\s+/g, "-");
const modeloSlug = modelo.toLowerCase();
const sourceIdBase = `${marcaSlug}-${modeloSlug}`;
const localizedPath = buildLocalizedPath(locale, `/reset/${marcaSlug}/${modeloSlug}/`);
const esEpson = marcaSlug === "epson";

/** "Bloqueo Código 00080000 Pump Cap Counter Reset" -> "00080000". */
function obtenerErrorCorto(cadena?: string): string {
  if (!cadena) return "";
  const matchCodigo = cadena.match(/c[oó]digo\s+([0-9a-z]+)/i);
  if (matchCodigo) return matchCodigo[1].toUpperCase();
  // Epson doméstico no tiene código numérico visible (solo "almohadilla de
  // tinta al final de su vida útil") — se usa el mismo término que ya usa
  // el resto del sitio para este caso en vez de la frase completa.
  if (/almohadilla/i.test(cadena)) return "Almohadillas";
  return cadena.trim();
}

function mapearErrorPublico(e: ErrorPublico): ErrorResuelto {
  return {
    error_id: e.error_id,
    nombre: e.codigo,
    descripcion: e.descripcion,
    codigo: e.codigo,
    estado_servicio: e.estado_servicio,
    tipo: e.categoria === "otros" ? undefined : e.categoria,
    modo: e.modo,
    foto_url: e.foto_url,
  };
}

// Evita que un título/URL con "</script>" dentro rompa el bloque JSON
// embebido más abajo (ver SECCIÓN 4).
function jsonSeguroParaScript(valor: unknown): string {
  return JSON.stringify(valor).replace(/</g, "\\u003c");
}

// 1) Errores: Núcleo primero, errores.json local como respaldo.
const erroresNucleo = await listarErroresPorModelo(marcaSlug, modeloSlug);
const fuenteErrores = erroresNucleo.length > 0 ? "nucleo" : "local";
const erroresResueltos =
  fuenteErrores === "nucleo" ? erroresNucleo.map(mapearErrorPublico) : resolveErroresParaModelo(marcaSlug, modeloSlug, locale);

const erroresCompatibles = erroresResueltos.filter((e) => e.estado_servicio === "compatible");
const variosCompatibles = erroresCompatibles.length > 1;

// Epson-SC arranca en "00080000" (pedido explícito), no vacío ni el primer
// error por orden alfabético — solo si ese código está confirmado para
// este modelo; si no, cae al primero disponible.
const ERROR_INICIAL_EPSON_SC = "epson-sc-00080000";
const codigoErrorInicialSelector =
  marcaSlug === "epson-sc" && erroresCompatibles.some((e) => e.error_id === ERROR_INICIAL_EPSON_SC)
    ? ERROR_INICIAL_EPSON_SC
    : undefined;
const errorPrincipal = erroresCompatibles.find((e) => e.error_id === codigoErrorInicialSelector) ?? erroresCompatibles[0];
// Preferir el campo `codigo` (real y confiable en los datos de Núcleo; en
// combinaciones tipo "00010000-00000004" la descripción no contiene la
// palabra "Código", así que el parser de texto no serviría ahí) — el
// regex sobre la descripción queda solo como respaldo para entradas
// locales viejas que no tengan `codigo` cargado.
const codigoCortoInicial =
  (errorPrincipal?.codigo?.trim().toUpperCase() || obtenerErrorCorto(errorPrincipal?.descripcion)) || "Almohadillas";
const esSensorInicial = marcaSlug === "epson-sc" && codigoCortoInicial === "0014BD";

const tieneSensorTinta =
  getSensorTintaParaMarca(marcaSlug) !== null &&
  erroresCompatibles.some((e) => obtenerErrorCorto(e.descripcion) === "0014BD");

// Paso 1 (Sección 4, solo Epson): la foto ya la muestra la flip card del
// selector (Sección 1) — acá solo queda el texto reactivo.
const errorLargoPrincipal = errorPrincipal?.descripcion ?? "";

// Paso 5: video real de "reset realizado" ya publicado para
// este modelo. Si no hay uno exacto, cae a cualquiera de la misma marca
// (respaldo simple por marca; el respaldo real "por modelo hermano" lo
// decide Núcleo — ver INSTRUCCIONES PARA EL BACKEND). Nunca se inventa un
// youtube_id: si no hay ningún candidato, se muestra el placeholder de
// siempre en vez de romper la sección.
//
// SSG + azar en cliente: se trae la lista COMPLETA de candidatos; el HTML
// estático (build) renderiza SIEMPRE el primero (para SEO), y el resto
// viaja como JSON para que el <script> del cliente elija uno al azar por
// visitante — ver SECCIÓN 4 y el <script> al final del archivo.
interface CandidatoVideo {
  youtubeId: string;
  titulo: string;
  slug: string;
}
const listadoReset = await listarResetRealizados(1, 50);
const porMarcaModelo = listadoReset.data.filter(
  (r) => r.marca.toLowerCase() === marcaSlug && r.modelo.toLowerCase() === modeloSlug
);
const porMarca = listadoReset.data.filter((r) => r.marca.toLowerCase() === marcaSlug);
const candidatosVideoResp = porMarcaModelo.length > 0 ? porMarcaModelo : porMarca;
const candidatosVideo: CandidatoVideo[] = candidatosVideoResp.map((r) => ({
  youtubeId: r.youtube_id,
  titulo: tituloConRespaldo(r),
  slug: r.slug,
}));
const videoResetRealizado = candidatosVideo[0] ?? null;
const hrefResetEvidencia = buildLocalizedPath(locale, "/prueba-social/reset-evidencia/");
const anchorResetEvidencia = videoResetRealizado
  ? `Ver la evidencia completa: ${videoResetRealizado.titulo}`
  : `Ver evidencias reales de reset en ${marca}`;

// 2) Prueba Social: un testimonio de Trustpilot y uno Local. Mismo patrón
// SSG + azar en cliente que el video de arriba: se traen las listas
// completas en build, se renderiza el primer candidato de cada una para
// el HTML estático/SEO, y el resto viaja como JSON para el <script>.
interface CandidatoTrustpilot {
  imagen: string;
  destino: string;
  marca: string;
  modelo: string;
}
interface CandidatoLocal {
  url: string;
  titulo: string;
  slug?: string;
}

const trustpilotList = (await listarTestimonios()).filter((tt) => tt.url_imgur?.trim() || tt.url_trustpilot_review?.trim());
const candidatosTrustpilot: CandidatoTrustpilot[] = trustpilotList.map((tt) => ({
  imagen: tt.url_imgur,
  destino: tt.url_trustpilot_review?.trim() || tt.url_imgur,
  marca: tt.marca,
  modelo: tt.modelo,
}));

// Preferido: endpoint dedicado (propuesto) donde Núcleo ya aplica su
// propia regla de "modelo hermano". Si todavía no existe, se cae a
// filtrar por marca el listado real ya existente — sin lógica de modelo
// hermano (esa vive en Núcleo, no se duplica acá). El endpoint propuesto
// devuelve un único elemento ya elegido por Núcleo (no una lista), así
// que en ese caso no hay nada más que azarear en el cliente.
const evidenciaDirecta = await obtenerEvidenciaClienteSatisfecho(marcaSlug, modeloSlug);
let candidatosLocal: CandidatoLocal[];
if (evidenciaDirecta) {
  candidatosLocal = [{ url: evidenciaDirecta.html_url, titulo: evidenciaDirecta.titulo }];
} else {
  const clienteSatisfechoResp = await listarClienteSatisfecho(1, 50);
  const dela = clienteSatisfechoResp.data.filter((e) => e.marca.toLowerCase() === marcaSlug);
  const candidatos = dela.length > 0 ? dela : clienteSatisfechoResp.data;
  candidatosLocal = candidatos.map((e) => ({ url: e.html_url, titulo: tituloConRespaldo(e), slug: e.slug }));
}

const testimonioTrustpilot = candidatosTrustpilot[0] ?? null;
const testimonioLocalEmbed = candidatosLocal[0] ?? null;

const hrefClienteSatisfecho = buildLocalizedPath(locale, "/prueba-social/cliente-satisfecho/");
const hrefClienteSatisfechoDetalle = testimonioLocalEmbed?.slug
  ? buildLocalizedPath(locale, `/prueba-social/cliente-satisfecho/${testimonioLocalEmbed.slug}/`)
  : null;
const hrefTestimoniosTrustpilot = buildLocalizedPath(locale, "/prueba-social/testimonios-truspilot/");
function anchorTrustpilotDe(c: CandidatoTrustpilot): string {
  const marcaModelo = [c.marca, c.modelo].filter(Boolean).join(" ");
  return `Reseña real en Trustpilot${marcaModelo ? ": " + marcaModelo : ""}`;
}
const anchorTrustpilot = testimonioTrustpilot ? anchorTrustpilotDe(testimonioTrustpilot) : "";

// JSON embebido para el <script> del cliente (solo cuando hay más de un
// candidato — si hay 0 o 1, no hace falta azarear nada).
const candidatosParaCliente = jsonSeguroParaScript({
  videos: candidatosVideo.length > 1 ? candidatosVideo : [],
  local: candidatosLocal.length > 1 ? candidatosLocal : [],
  trustpilot: candidatosTrustpilot.length > 1 ? candidatosTrustpilot : [],
});

// Módulo Contacto WhatsApp (cierre del Paso 6): CTA final con su propio
// source_id para trazabilidad — el número vive únicamente en
// WHATSAPP_NUMBER (config/site.ts), nunca se escribe a mano aquí.
const mensajeFinalWhatsApp = buildWhatsAppMessage({
  locale,
  marca,
  modelo,
  error: errorPrincipal?.descripcion,
  urlOrigen: `${SITE_URL}${localizedPath}`,
});
const hrefFinalWhatsApp = buildWhatsAppLink(WHATSAPP_NUMBER, mensajeFinalWhatsApp);
const sourceIdFinalWhatsApp = `${sourceIdBase}-paso6-whatsapp`;

// Módulo "Reset Asistido 100% Remoto por conexión USB" (antes vivía en
// ModeloPage.astro, más abajo en la página) — ahora se muestra justo
// después del Paso 3, entre el resultado de la revisión y la Cotización.
const imgProceso1 = getProcesoImage("paso1-descargar");
const imgProceso2a = getProcesoImage("paso2-formulario");
const imgProceso2b = getProcesoImage("paso2-formulario-2");
const imgProceso3 = getProcesoImage("paso3-reconectarcableusb");
const imgProceso4 = getProcesoImage("paso4-contactarnos");

const pasosProceso = [
  {
    titulo: t(locale, "proceso.paso1Titulo"),
    descripcion: t(locale, "proceso.paso1Texto"),
    icono: "monitor" as const,
    enlace: { href: USB_REDIRECTOR_DOWNLOAD_URL, label: t(locale, "proceso.paso1Enlace") },
    imagenes: imgProceso1 ? [{ src: imgProceso1, alt: t(locale, "proceso.paso1ImagenAlt") }] : undefined,
  },
  {
    titulo: t(locale, "proceso.paso2Titulo"),
    descripcion: t(locale, "proceso.paso2Texto"),
    icono: "conectar" as const,
    destacado: `Technician ID: ${TECHNICIAN_ID}`,
    imagenes: [
      imgProceso2a && { src: imgProceso2a, alt: t(locale, "proceso.paso2ImagenAlt") },
      imgProceso2b && { src: imgProceso2b, alt: t(locale, "proceso.paso2ImagenAlt2") },
    ].filter((imagenPaso): imagenPaso is { src: ImageMetadata; alt: string } => Boolean(imagenPaso)),
  },
  {
    titulo: t(locale, "proceso.paso3Titulo"),
    descripcion: t(locale, "proceso.paso3Texto"),
    icono: "usb" as const,
    imagenes: imgProceso3 ? [{ src: imgProceso3, alt: t(locale, "proceso.paso3ImagenAlt") }] : undefined,
  },
  {
    titulo: t(locale, "proceso.paso4Titulo"),
    descripcion: t(locale, "proceso.paso4Texto"),
    icono: "whatsapp" as const,
    imagenes: imgProceso4 ? [{ src: imgProceso4, alt: t(locale, "proceso.paso4ImagenAlt") }] : undefined,
  },
];
---

<div class="procedimiento" data-procedimiento data-source-id-base={sourceIdBase} data-marca={marcaSlug} data-fuente-errores={fuenteErrores}>
  <!-- SECCIÓN 3: Índice visual 3x2 (variante real según marca) — va primero,
       justo después del título de la página. -->
  {esEpson && (
    <ProcesoReutilizable locale={locale} modelo={modelo} sourceIdBase={sourceIdBase} codigoErrorInicial={codigoCortoInicial} />
  )}
  {marcaSlug === "canon" && <ProcesoReutilizableCanon locale={locale} modelo={modelo} sourceIdBase={sourceIdBase} />}
  {marcaSlug === "epson-sc" && (
    <ProcesoReutilizableEpsonSc locale={locale} modelo={modelo} sourceIdBase={sourceIdBase} codigoErrorInicial={codigoCortoInicial} />
  )}

  <!-- Paso 1 ("Identificación del error"): sube justo después del grid,
       antes del selector — comparte el mismo <select> reactivo. -->
  <ol class="procedimiento-detalle">
    <li>
      <h3 id={`paso-${sourceIdBase}-1`}>
        <a class="procedimiento-paso-link" href={`#tarjeta-proceso-${sourceIdBase}-1`}>
          1) Identificación del error <span data-procedimiento-codigo>{codigoCortoInicial}</span> en {marca} {modelo}
        </a>
      </h3>
      <p data-procedimiento-pregunta-error>
        ¿Tu {marca} {modelo} presenta un mensaje de error <span data-procedimiento-error-largo>{errorLargoPrincipal}</span>?
      </p>
    </li>
  </ol>

  <!-- SECCIÓN 1: Selector de error -->
  {variosCompatibles ? (
    <ErrorSelector
      errores={erroresCompatibles}
      marca={marca}
      modelo={modelo}
      modeloSlug={modeloSlug}
      locale={locale}
      urlPath={localizedPath}
      sourceIdBase={sourceIdBase}
      codigoErrorInicial={codigoErrorInicialSelector}
    />
  ) : (
    errorPrincipal && (
      <>
        <p class="procedimiento-error-unico">{errorPrincipal.descripcion}</p>
        <EvidenceCard
          errorId={errorPrincipal.error_id}
          modeloSlug={modeloSlug}
          nombreMarca={marca}
          nombreModelo={modelo}
          errorCaption={t(locale, "modelo.evidenciaErrorCaption")}
          solucionCaption={t(locale, "modelo.evidenciaSolucionCaption")}
          flipHint={t(locale, "modelo.evidenciaFlipHint")}
        />
        <VideoModal archivo="reset-demo.mp4" label={t(locale, "modelo.videoResetLabel")} />
      </>
    )
  )}

  <!-- SECCIÓN 2: Sensor de tinta (solo Epson-SC con 0014BD entre los confirmados) -->
  {tieneSensorTinta && (
    <div data-procedimiento-sensor hidden={!esSensorInicial}>
      <div class="procedimiento-sensor-columnas">
        <SensorLocation marcaSlug={marcaSlug} nombreMarca={marca} titulo={t(locale, "modelo.sensorUbicacionTitulo")} />
        <SensorConditionComparison
          marcaSlug={marcaSlug}
          tituloLimpio={t(locale, "modelo.sensorLimpioTitulo")}
          tituloSucio={t(locale, "modelo.sensorSucioTitulo")}
          hintVerLimpio={t(locale, "modelo.sensorHintVerLimpio")}
          hintVerSucio={t(locale, "modelo.sensorHintVerSucio")}
        />
      </div>
    </div>
  )}

  <!-- SECCIÓN 4: Desarrollo detallado (Paso 1 ya se movió arriba, junto al grid) -->
  <ol class="procedimiento-detalle">
    <li>
      <h3 id={`paso-${sourceIdBase}-2`}>
        <a class="procedimiento-paso-link" href={`#tarjeta-proceso-${sourceIdBase}-2`}>
          2) Requisitos y Conexión USB
        </a>
      </h3>
      <ul>
        <li>Impresora {marca} {modelo} conectada mediante CABLE USB al computador.</li>
        <li>Error <span data-procedimiento-error-largo>{errorLargoPrincipal}</span> en impresora {marca} {modelo}.</li>
        <li>PC con Windows (7, 8, 10 u 11).</li>
        <li>Conexión a Internet estable.</li>
        <li>
          Realizar los pasos Asistidos (Recibe Reset asistido, no recibe Software autónomo).
          {errorPrincipal?.modo && <> Modalidad: {errorPrincipal.modo}.</>}
        </li>
      </ul>
    </li>

    <li>
      <h3 id={`paso-${sourceIdBase}-3`}>
        <a class="procedimiento-paso-link" href={`#tarjeta-proceso-${sourceIdBase}-3`}>
          3) Revisión Asistida de compatibilidad USB y Reset Disponible
        </a>
      </h3>
      <p class="procedimiento-respuesta-destacada">Resultado Revisión: Compatible, Conexión USB reconocida, Lectura al 100% y Servicio Disponible</p>
    </li>
  </ol>

  <!-- Módulo "Reset Asistido 100% Remoto por conexión USB": va justo
       después del Paso 3 (resultado de la revisión), antes del Paso 4
       (Cotización y Pago). -->
  <InfoCard tone="muted">
    <ProcessSteps
      titulo={t(locale, "proceso.titulo")}
      introTexto={t(locale, "proceso.introTexto")}
      pasos={pasosProceso}
      marcarRevisadoLabel={t(locale, "proceso.marcarRevisado")}
      prefijoNumero="3."
    >
      {!variosCompatibles && (
        <WhatsAppCTA
          marca={marca}
          modelo={modelo}
          error={errorPrincipal?.descripcion}
          sourceId={`${sourceIdBase}-proceso`}
          urlPath={localizedPath}
          locale={locale}
          label={t(locale, "proceso.ctaContinuar")}
        />
      )}
    </ProcessSteps>
    <VideoModal archivo="proceso-demo.mp4" label={t(locale, "proceso.videoProcesoLabel")} />
  </InfoCard>

  <ol class="procedimiento-detalle">
    <li>
      <h3 id={`paso-${sourceIdBase}-4`}>
        <a class="procedimiento-paso-link" href={`#tarjeta-proceso-${sourceIdBase}-4`}>
          4) Cotización y Pago o Garantía Vigente
        </a>
      </h3>
      <ConsultaGarantiaPage locale={locale} mostrarTitulo={false} />
    </li>

    <li>
      <h3 id={`paso-${sourceIdBase}-5`}>
        <a class="procedimiento-paso-link" href={`#tarjeta-proceso-${sourceIdBase}-5`}>
          5) Reset Asistido en 1 minuto | {marca} {modelo}
        </a>
      </h3>
      {videoResetRealizado ? (
        <div class="procedimiento-video-real" data-procedimiento-video-real data-href-base={hrefResetEvidencia}>
          <YouTubeFacade
            youtubeId={videoResetRealizado.youtubeId}
            titulo={videoResetRealizado.titulo}
            reproducirLabel={t(locale, "pruebaSocialPage.reproducirVideo")}
          />
          <a class="procedimiento-enlace-seo" href={`${hrefResetEvidencia}${videoResetRealizado.slug}/`}>
            {anchorResetEvidencia} →
          </a>
        </div>
      ) : (
        <div class="procedimiento-video-placeholder">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" aria-hidden="true">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2" stroke="currentColor" stroke-width="1.6" />
            <path d="M10.5 9.2v5.6l4.8-2.8-4.8-2.8Z" fill="currentColor" />
          </svg>
          <span class="procedimiento-video-label">Reset Asistido en 1 minuto</span>
          <span class="procedimiento-video-nota">(evidencia en camino — aún sin video publicado para este modelo)</span>
          <a class="procedimiento-enlace-seo" href={hrefResetEvidencia}>{anchorResetEvidencia} →</a>
        </div>
      )}
    </li>

    <li>
      <h3 id={`paso-${sourceIdBase}-6`}>
        <a class="procedimiento-paso-link" href={`#tarjeta-proceso-${sourceIdBase}-6`}>
          6) Impresora Desbloqueada y lista para imprimir
        </a>
      </h3>
      <div class="procedimiento-prueba-social">
          {testimonioLocalEmbed && (
            <div class="procedimiento-testimonio-item" data-procedimiento-testimonio-local data-href-base={hrefClienteSatisfecho}>
              <ClienteSatisfechoEmbed url={testimonioLocalEmbed.url} titulo={testimonioLocalEmbed.titulo} />
              {hrefClienteSatisfechoDetalle && (
                <a class="procedimiento-enlace-seo" href={hrefClienteSatisfechoDetalle}>
                  Leer el caso completo: {testimonioLocalEmbed.titulo} →
                </a>
              )}
            </div>
          )}
          {testimonioTrustpilot?.imagen && (
            <div class="procedimiento-testimonio-item" data-procedimiento-testimonio-trustpilot>
              <a class="procedimiento-testimonio-trustpilot-link" href={testimonioTrustpilot.destino} target="_blank" rel="noopener noreferrer nofollow">
                <img src={testimonioTrustpilot.imagen} alt="Testimonio de cliente en Trustpilot" loading="lazy" />
              </a>
              <a
                class="procedimiento-enlace-seo"
                href={testimonioTrustpilot.destino}
                target="_blank"
                rel="noopener noreferrer nofollow"
              >
                {anchorTrustpilot} →
              </a>
            </div>
          )}
          <TrustpilotWidget />
          <div class="procedimiento-prueba-social-enlaces">
            <a href={hrefClienteSatisfecho}>Ver más clientes satisfechos →</a>
            <a href={hrefTestimoniosTrustpilot}>Ver testimonios en Trustpilot →</a>
          </div>
          <a class="whatsapp-cta procedimiento-whatsapp-final" href={hrefFinalWhatsApp} data-source-id={sourceIdFinalWhatsApp} target="_blank" rel="noopener noreferrer nofollow">
            {t(locale, "common.whatsappButton")}
          </a>
      </div>
    </li>
  </ol>

  {(candidatosVideo.length > 1 || candidatosLocal.length > 1 || candidatosTrustpilot.length > 1) && (
    <script type="application/json" data-procedimiento-candidatos set:html={candidatosParaCliente} />
  )}
</div>

<script>
  // Reactividad: escucha el mismo <select> de ErrorSelector.astro (por
  // sourceIdBase) y actualiza el código y la descripción larga mostrados en
  // el Paso 1 y el Paso 2, y —solo para Epson-SC— la visibilidad de la
  // sección de sensor de tinta.
  function obtenerErrorCorto(cadena: string): string {
    if (!cadena) return "";
    const matchCodigo = cadena.match(/c[oó]digo\s+([0-9a-z]+)/i);
    if (matchCodigo) return matchCodigo[1].toUpperCase();
    if (/almohadilla/i.test(cadena)) return "Almohadillas";
    return cadena.trim();
  }

  document.querySelectorAll<HTMLElement>("[data-procedimiento]").forEach((raiz) => {
    const base = raiz.dataset.sourceIdBase;
    const marcaSlug = raiz.dataset.marca;
    const select = base ? (document.getElementById(`error-select-${base}`) as HTMLSelectElement | null) : null;

    if (select) {
      const codigoEl = raiz.querySelector<HTMLElement>("[data-procedimiento-codigo]");
      const sensorWrapper = raiz.querySelector<HTMLElement>("[data-procedimiento-sensor]");
      const errorLargoEls = raiz.querySelectorAll<HTMLElement>("[data-procedimiento-error-largo]");

      select.addEventListener("change", () => {
        const opcion = select.options[select.selectedIndex];
        const codigoAtributo = opcion?.getAttribute("data-codigo")?.trim();
        const descripcion = opcion?.getAttribute("data-descripcion") || "";
        const codigo = (codigoAtributo ? codigoAtributo.toUpperCase() : obtenerErrorCorto(descripcion)) || "Almohadillas";

        if (codigoEl) codigoEl.textContent = codigo;
        if (descripcion) errorLargoEls.forEach((el) => (el.textContent = descripcion));
        if (sensorWrapper) sensorWrapper.hidden = !(marcaSlug === "epson-sc" && codigo === "0014BD");
      });
    }

    // SSG + azar en el cliente: el HTML estático ya trae el primer
    // candidato de cada lista (video, testimonio local, Trustpilot) — acá
    // se elige uno al azar POR VISITANTE entre todos los candidatos reales
    // (traídos de Núcleo en build) y se actualiza el DOM ya renderizado.
    // Si Núcleo no devolvió más de un candidato para algo, no hay bloque
    // JSON y esta parte no hace nada (se queda con lo que ya se renderizó).
    const candidatosScript = raiz.querySelector<HTMLScriptElement>("script[data-procedimiento-candidatos]");
    if (!candidatosScript) return;

    let candidatos: {
      videos?: { youtubeId: string; titulo: string; slug: string }[];
      local?: { url: string; titulo: string; slug?: string }[];
      trustpilot?: { imagen: string; destino: string; marca: string; modelo: string }[];
    };
    try {
      candidatos = JSON.parse(candidatosScript.textContent || "{}");
    } catch {
      return;
    }

    const alAzar = <T,>(lista: T[] | undefined): T | null =>
      lista && lista.length > 0 ? lista[Math.floor(Math.random() * lista.length)] : null;

    // Paso 5: video
    const videoElegido = alAzar(candidatos.videos);
    const videoWrapper = raiz.querySelector<HTMLElement>("[data-procedimiento-video-real]");
    if (videoElegido && videoWrapper) {
      const trigger = videoWrapper.querySelector<HTMLElement>("[data-youtube-trigger]");
      const img = videoWrapper.querySelector<HTMLImageElement>(".youtube-card-trigger img");
      const tituloEl = videoWrapper.querySelector<HTMLElement>(".youtube-card-titulo");
      const enlaceSeo = videoWrapper.querySelector<HTMLAnchorElement>(".procedimiento-enlace-seo");
      const hrefBase = videoWrapper.dataset.hrefBase || "";

      if (trigger) {
        trigger.setAttribute("data-youtube-id", videoElegido.youtubeId);
        trigger.setAttribute("aria-label", trigger.getAttribute("aria-label")?.replace(/:.*/, `: ${videoElegido.titulo}`) || videoElegido.titulo);
      }
      if (img) img.src = `https://i.ytimg.com/vi/${videoElegido.youtubeId}/hqdefault.jpg`;
      if (tituloEl) tituloEl.textContent = videoElegido.titulo;
      if (enlaceSeo) {
        enlaceSeo.href = `${hrefBase}${videoElegido.slug}/`;
        enlaceSeo.textContent = `Ver la evidencia completa: ${videoElegido.titulo} →`;
      }
    }

    // Paso 6: testimonio local (Cliente Satisfecho)
    const localElegido = alAzar(candidatos.local);
    const localWrapper = raiz.querySelector<HTMLElement>("[data-procedimiento-testimonio-local]");
    if (localElegido && localWrapper) {
      const iframe = localWrapper.querySelector<HTMLIFrameElement>("iframe");
      const enlaceSeo = localWrapper.querySelector<HTMLAnchorElement>(".procedimiento-enlace-seo");
      const hrefBase = localWrapper.dataset.hrefBase || "";

      if (iframe) {
        iframe.src = `${localElegido.url}${localElegido.url.includes("?") ? "&" : "?"}chat=1`;
        iframe.title = localElegido.titulo;
      }
      if (enlaceSeo && localElegido.slug) {
        enlaceSeo.href = `${hrefBase}${localElegido.slug}/`;
        enlaceSeo.textContent = `Leer el caso completo: ${localElegido.titulo} →`;
      }
    }

    // Paso 6: testimonio Trustpilot
    const trustpilotElegido = alAzar(candidatos.trustpilot);
    const trustpilotWrapper = raiz.querySelector<HTMLElement>("[data-procedimiento-testimonio-trustpilot]");
    if (trustpilotElegido && trustpilotWrapper) {
      const enlaceImagen = trustpilotWrapper.querySelector<HTMLAnchorElement>(".procedimiento-testimonio-trustpilot-link");
      const img = trustpilotWrapper.querySelector<HTMLImageElement>("img");
      const enlaceSeo = trustpilotWrapper.querySelector<HTMLAnchorElement>(".procedimiento-enlace-seo");
      const marcaModelo = [trustpilotElegido.marca, trustpilotElegido.modelo].filter(Boolean).join(" ");
      const anchor = `Reseña real en Trustpilot${marcaModelo ? ": " + marcaModelo : ""}`;

      if (enlaceImagen) enlaceImagen.href = trustpilotElegido.destino;
      if (img) img.src = trustpilotElegido.imagen;
      if (enlaceSeo) {
        enlaceSeo.href = trustpilotElegido.destino;
        enlaceSeo.textContent = `${anchor} →`;
      }
    }
  });
</script>

