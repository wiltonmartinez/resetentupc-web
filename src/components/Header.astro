---
import { Image } from "astro:assets";
import type { Locale, StaticPageKey } from "../config/site";
import { buildLocalizedPath, buildStaticPagePath, t } from "../i18n/utils";
import LanguageSelector from "./LanguageSelector.astro";
import SoundToggle from "./ui/SoundToggle.astro";
import { getLogo } from "../lib/branding.js";

interface Props {
  locale: Locale;
  path: string;
  pageKey?: StaticPageKey;
}

const { locale, path, pageKey } = Astro.props;
const logo = getLogo();
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-logo" href={buildLocalizedPath(locale, "/")}>
      {logo ? (
        <Image src={logo} alt="ResetEnLinea.com" width={28} height={28} class="site-logo-imagen" />
      ) : (
        <span class="site-logo-mark" aria-hidden="true">R</span>
      )}
      <span class="site-logo-texto">
        ResetEnLinea.com
        <span class="site-logo-eslogan">{t(locale, "nav.eslogan")}</span>
      </span>
    </a>
    <button
      type="button"
      class="site-nav-toggle"
      id="site-nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t(locale, "nav.abrirMenu")}
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
    <div class="site-nav-panel" id="site-nav">
      <nav class="site-nav" aria-label={t(locale, "nav.home")}>
        <a href={buildLocalizedPath(locale, "/")}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path
              d="M4 11.2 12 4l8 7.2M6 10v9a1 1 0 0 0 1 1h3.5v-6h3v6H17a1 1 0 0 0 1-1v-9"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{t(locale, "nav.home")}</span>
        </a>
        <a href={buildStaticPagePath(locale, "comoFunciona")}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
            <path d="M10 9.3 15 12l-5 2.7V9.3Z" fill="currentColor" />
          </svg>
          <span>{t(locale, "nav.comoFunciona")}</span>
        </a>
        <div class="site-nav-item-dropdown">
          <a href={buildLocalizedPath(locale, "/prueba-social/")}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <path
                d="M12 3.5 14.5 9l6 .6-4.6 4 1.4 5.9L12 16.6l-5.3 2.9 1.4-5.9-4.6-4 6-.6L12 3.5Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
            <span>{t(locale, "nav.pruebaSocial")}</span>
          </a>
          <ul class="site-nav-submenu">
            <li>
              <a href={buildLocalizedPath(locale, "/prueba-social/cliente-satisfecho/")}>
                {t(locale, "pruebaSocialPage.conversacionesTitulo")}
              </a>
            </li>
            <li>
              <a href={buildLocalizedPath(locale, "/prueba-social/reset-evidencia/")}>
                {t(locale, "pruebaSocialPage.resetsTitulo")}
              </a>
            </li>
            <li>
              <a href={buildLocalizedPath(locale, "/prueba-social/testimonios-truspilot/")}>
                {t(locale, "pruebaSocialPage.testimoniosTitulo")}
              </a>
            </li>
          </ul>
        </div>
        <a href={buildStaticPagePath(locale, "preguntasFrecuentes")}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
            <path
              d="M9.6 9.3a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 1.9-2.4 3.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
            <circle cx="12" cy="16.6" r="0.9" fill="currentColor" />
          </svg>
          <span>{t(locale, "nav.preguntasFrecuentes")}</span>
        </a>
        <a href={buildLocalizedPath(locale, "/ruleta/")}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <rect x="4" y="9" width="16" height="11" rx="1.2" stroke="currentColor" stroke-width="1.6" />
            <path d="M4 9h16M12 9v11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <path
              d="M8.3 9c-1.3 0-2.4-.9-2.4-2.1 0-1.1 1-2 2.1-2 1.7 0 3.1 1.9 3.6 4.1M15.7 9c1.3 0 2.4-.9 2.4-2.1 0-1.1-1-2-2.1-2-1.7 0-3.1 1.9-3.6 4.1"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{t(locale, "nav.ruleta")}</span>
        </a>
        <a href={buildStaticPagePath(locale, "contacto")} class="site-nav-contacto">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" stroke="currentColor" stroke-width="1.6" />
            <path d="m4.2 7 7.8 5.8L19.8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{t(locale, "nav.contacto")}</span>
        </a>
        <a href={buildStaticPagePath(locale, "consultaGarantia")}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path
              d="M12 3.3 19 6v6c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6l7-2.7Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
            <path d="m9 12 2 2 4-4.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{t(locale, "nav.consultaGarantia")}</span>
        </a>
      </nav>
      <div class="site-header-controls">
        <LanguageSelector locale={locale} path={path} pageKey={pageKey} />
        <SoundToggle locale={locale} />
      </div>
    </div>
  </div>
</header>

<script>
  const navToggle = document.getElementById("site-nav-toggle");
  const nav = document.getElementById("site-nav");
  if (navToggle && nav) {
    navToggle.addEventListener("click", () => {
      const abierto = nav.classList.toggle("site-nav-abierto");
      navToggle.setAttribute("aria-expanded", String(abierto));
    });
    nav.querySelectorAll("a").forEach((enlace) => {
      enlace.addEventListener("click", () => {
        nav.classList.remove("site-nav-abierto");
        navToggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 3px solid #f97316;
    background: #1f2937;
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .site-header-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem var(--space-md);
  }
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    text-decoration: none;
    font-size: 1.1rem;
    color: #ffffff;
  }
  .site-logo-imagen {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
    flex: none;
  }
  .site-logo-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .site-logo-eslogan {
    font-size: 0.68rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    text-transform: none;
    letter-spacing: normal;
  }
  .site-logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: white;
    font-size: 0.9rem;
  }
  .site-nav-panel {
    display: contents;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    flex-wrap: wrap;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.45rem 0.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 600;
    font-size: 0.86rem;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .site-nav a svg {
    flex: none;
    opacity: 0.75;
    transition: opacity 0.15s ease;
  }
  .site-nav a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }
  .site-nav a:hover svg {
    opacity: 1;
  }

  .site-nav-item-dropdown {
    position: relative;
  }

  .site-nav-submenu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-floating);
    z-index: 40;
  }

  .site-nav-item-dropdown:hover .site-nav-submenu,
  .site-nav-item-dropdown:focus-within .site-nav-submenu {
    display: block;
  }

  .site-nav-submenu a {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .site-nav-submenu a:hover {
    background: var(--color-bg-muted);
  }

  /* Contacto es el destino final del recorrido (punto de conversión hacia
     WhatsApp) — se distingue con el color y peso ya usados en el sitio para
     énfasis (ver .process-step-enlace), sin convertirlo en un botón. */
  .site-nav a.site-nav-contacto {
    color: #f97316;
    font-weight: 700;
  }

  .site-nav a.site-nav-contacto:hover {
    color: #fb923c;
    background: rgba(249, 115, 22, 0.14);
  }
  .site-header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  .site-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: auto;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-sm);
    background: transparent;
    color: #ffffff;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .site-header-inner {
      flex-wrap: nowrap;
    }
    .site-nav-toggle {
      display: inline-flex;
    }
    .site-nav-panel {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: #1f2937;
      border-bottom: 3px solid #f97316;
      box-shadow: var(--shadow-floating);
      padding: 0.5rem var(--space-md) 1rem;
    }
    .site-nav-panel.site-nav-abierto {
      display: flex;
    }
    .site-nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .site-nav a {
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 1rem;
    }
    .site-nav-item-dropdown {
      position: static;
    }
    .site-nav-submenu {
      display: block;
      position: static;
      box-shadow: none;
      border: none;
      padding: 0 0 0 1rem;
      background: transparent;
    }
    .site-nav-submenu a {
      padding: 0.6rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 0.92rem;
      color: rgba(255, 255, 255, 0.6);
    }
    .site-nav-submenu a:hover {
      background: transparent;
      color: #ffffff;
    }
    .site-header-controls {
      margin: 0.75rem 0 0;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
</style>
