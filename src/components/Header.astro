---
import { Image } from "astro:assets";
import type { Locale, StaticPageKey } from "../config/site";
import { buildLocalizedPath, buildStaticPagePath, t } from "../i18n/utils";
import LanguageSelector from "./LanguageSelector.astro";
import SoundToggle from "./ui/SoundToggle.astro";
import { getLogo } from "../lib/branding.js";

interface Props {
  locale: Locale;
  path: string;
  pageKey?: StaticPageKey;
}

const { locale, path, pageKey } = Astro.props;
const logo = getLogo();
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-logo" href={buildLocalizedPath(locale, "/")}>
      {logo ? (
        <Image src={logo} alt="ResetEnLinea.com" width={28} height={28} class="site-logo-imagen" />
      ) : (
        <span class="site-logo-mark" aria-hidden="true">R</span>
      )}
      <span class="site-logo-texto">
        ResetEnLinea.com
        <span class="site-logo-eslogan">{t(locale, "nav.eslogan")}</span>
      </span>
    </a>
    <button
      type="button"
      class="site-nav-toggle"
      id="site-nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t(locale, "nav.abrirMenu")}
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
    <div class="site-nav-panel" id="site-nav">
      <nav class="site-nav" aria-label={t(locale, "nav.home")}>
        <a href={buildLocalizedPath(locale, "/")}>{t(locale, "nav.home")}</a>
        <a href={buildStaticPagePath(locale, "comoFunciona")}>{t(locale, "nav.comoFunciona")}</a>
        <div class="site-nav-item-dropdown">
          <a href={buildLocalizedPath(locale, "/prueba-social/")}>{t(locale, "nav.pruebaSocial")}</a>
          <ul class="site-nav-submenu">
            <li>
              <a href={buildLocalizedPath(locale, "/prueba-social/cliente-satisfecho/")}>
                {t(locale, "pruebaSocialPage.conversacionesTitulo")}
              </a>
            </li>
            <li>
              <a href={buildLocalizedPath(locale, "/prueba-social/reset-evidencia/")}>
                {t(locale, "pruebaSocialPage.resetsTitulo")}
              </a>
            </li>
            <li>
              <a href={buildLocalizedPath(locale, "/prueba-social/testimonios-truspilot/")}>
                {t(locale, "pruebaSocialPage.testimoniosTitulo")}
              </a>
            </li>
          </ul>
        </div>
        <a href={buildStaticPagePath(locale, "preguntasFrecuentes")}>{t(locale, "nav.preguntasFrecuentes")}</a>
        <a href={buildLocalizedPath(locale, "/ruleta/")}>{t(locale, "nav.ruleta")}</a>
        <a href={buildStaticPagePath(locale, "contacto")} class="site-nav-contacto">{t(locale, "nav.contacto")}</a>
      </nav>
      <div class="site-header-controls">
        <LanguageSelector locale={locale} path={path} pageKey={pageKey} />
        <SoundToggle locale={locale} />
      </div>
    </div>
  </div>
</header>

<script>
  const navToggle = document.getElementById("site-nav-toggle");
  const nav = document.getElementById("site-nav");
  if (navToggle && nav) {
    navToggle.addEventListener("click", () => {
      const abierto = nav.classList.toggle("site-nav-abierto");
      navToggle.setAttribute("aria-expanded", String(abierto));
    });
    nav.querySelectorAll("a").forEach((enlace) => {
      enlace.addEventListener("click", () => {
        nav.classList.remove("site-nav-abierto");
        navToggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .site-header-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem var(--space-md);
  }
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    text-decoration: none;
    font-size: 1.1rem;
    color: var(--color-text);
  }
  .site-logo-imagen {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
    flex: none;
  }
  .site-logo-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .site-logo-eslogan {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--color-text-subtle);
    text-transform: none;
    letter-spacing: normal;
  }
  .site-logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: white;
    font-size: 0.9rem;
  }
  .site-nav-panel {
    display: contents;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .site-nav a:hover {
    color: var(--color-primary);
  }

  .site-nav-item-dropdown {
    position: relative;
  }

  .site-nav-submenu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-floating);
    z-index: 40;
  }

  .site-nav-item-dropdown:hover .site-nav-submenu,
  .site-nav-item-dropdown:focus-within .site-nav-submenu {
    display: block;
  }

  .site-nav-submenu a {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .site-nav-submenu a:hover {
    background: var(--color-bg-muted);
  }

  /* Contacto es el destino final del recorrido (punto de conversión hacia
     WhatsApp) — se distingue con el color y peso ya usados en el sitio para
     énfasis (ver .process-step-enlace), sin convertirlo en un botón. */
  .site-nav a.site-nav-contacto {
    color: var(--color-primary);
    font-weight: 700;
  }

  .site-nav a.site-nav-contacto:hover {
    color: var(--color-primary-dark);
  }
  .site-header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  .site-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-card);
    color: var(--color-text);
    cursor: pointer;
  }

  @media (max-width: 720px) {
    .site-header-inner {
      flex-wrap: nowrap;
    }
    .site-nav-toggle {
      display: inline-flex;
    }
    .site-nav-panel {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-floating);
      padding: 0.5rem var(--space-md) 1rem;
    }
    .site-nav-panel.site-nav-abierto {
      display: flex;
    }
    .site-nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .site-nav a {
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 1rem;
    }
    .site-nav-item-dropdown {
      position: static;
    }
    .site-nav-submenu {
      display: block;
      position: static;
      box-shadow: none;
      border: none;
      padding: 0 0 0 1rem;
      background: transparent;
    }
    .site-nav-submenu a {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 0.92rem;
      color: var(--color-text-subtle);
    }
    .site-nav-submenu a:hover {
      background: transparent;
    }
    .site-header-controls {
      margin: 0.75rem 0 0;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
