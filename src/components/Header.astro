---
import { Image } from "astro:assets";
import { CONSULTA_GARANTIA_VISIBLE, PAGE_SLUGS, PRUEBA_SOCIAL_VISIBLE, type Locale, type StaticPageKey } from "../config/site";
import { buildLocalizedPath, buildStaticPagePath, t } from "../i18n/utils";
import LanguageSelector from "./LanguageSelector.astro";
import { getLogo } from "../lib/branding.js";

interface Props {
  locale: Locale;
  path: string;
  pageKey?: StaticPageKey;
}

const { locale, path, pageKey } = Astro.props;
const logo = getLogo();

// `path` (prop) es siempre la ruta canónica SIN prefijo de idioma (ver
// src/pages/**/*.astro, que la pasan igual a BaseLayout). Para saber si un
// ítem del menú corresponde a la página actual comparamos contra esa misma
// forma sin prefijo, en vez de contra los href (que sí llevan el prefijo).
function staticPagePathSinPrefijo(pageKey: StaticPageKey): string {
  return `/${PAGE_SLUGS[pageKey][locale]}/`;
}

const inicioPath = "/";
const comoFuncionaPath = staticPagePathSinPrefijo("comoFunciona");
const pruebaSocialPath = "/prueba-social/";
const diagnosticoGratisPath = "/prueba-social/diagnostico-gratis/";
const testimoniosPath = "/prueba-social/testimonios-trustpilot/";
const resetEvidenciaPath = "/prueba-social/reset-evidencia/";
const clienteSatisfechoPath = "/prueba-social/cliente-satisfecho/";
const preciosPath = staticPagePathSinPrefijo("precios");
const consultaGarantiaPath = staticPagePathSinPrefijo("consultaGarantia");
const contactoPath = staticPagePathSinPrefijo("contacto");
const catalogoPath = "/catalogo/";

const pruebaSocialActivo = [pruebaSocialPath, diagnosticoGratisPath, testimoniosPath, resetEvidenciaPath, clienteSatisfechoPath].includes(
  path
);
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-logo" href={buildLocalizedPath(locale, "/")}>
      {/* GIF animado: <img> directo (el optimizador de Astro lo convertiría a una imagen fija). */}
      {logo && logo.format === "gif" ? (
        <img src={logo.src} alt="ResetEntuPC.com" width={34} height={34} class="site-logo-imagen" />
      ) : logo ? (
        <Image src={logo} alt="ResetEntuPC.com" width={34} height={34} class="site-logo-imagen" />
      ) : (
        <span class="site-logo-mark" aria-hidden="true">R</span>
      )}
      <span class="site-logo-texto">
        ResetEntuPC.com
        <span class="site-logo-eslogan">{t(locale, "nav.eslogan")}</span>
      </span>
    </a>
    <button
      type="button"
      class="site-nav-toggle"
      id="site-nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t(locale, "nav.abrirMenu")}
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
    <div class="site-nav-panel" id="site-nav">
      <nav class="site-nav" aria-label={t(locale, "nav.home")}>
        <a href={buildLocalizedPath(locale, "/")} class:list={{ "is-active": path === inicioPath }}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path
              d="M4 11.2 12 4l8 7.2M6 10v9a1 1 0 0 0 1 1h3.5v-6h3v6H17a1 1 0 0 0 1-1v-9"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{t(locale, "nav.home")}</span>
        </a>
        <a href={catalogoPath} class:list={{ "is-active": path === catalogoPath }}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <rect x="3.5" y="4.5" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6" />
            <rect x="13.5" y="4.5" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6" />
            <rect x="3.5" y="14.5" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6" />
            <rect x="13.5" y="14.5" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.6" />
          </svg>
          <span>{t(locale, "nav.catalogo")}</span>
        </a>
        <a
          href={buildStaticPagePath(locale, "comoFunciona")}
          class:list={{ "is-active": path === comoFuncionaPath }}
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
            <path d="M10 9.3 15 12l-5 2.7V9.3Z" fill="currentColor" />
          </svg>
          <span>{t(locale, "nav.comoFunciona")}</span>
        </a>
        {PRUEBA_SOCIAL_VISIBLE && (
        <div class="site-nav-item-dropdown">
          <a
            href={buildLocalizedPath(locale, "/prueba-social/")}
            class:list={{ "is-active": pruebaSocialActivo }}
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <path
                d="M12 3.5 14.5 9l6 .6-4.6 4 1.4 5.9L12 16.6l-5.3 2.9 1.4-5.9-4.6-4 6-.6L12 3.5Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
            <span>{t(locale, "nav.pruebaSocial")}</span>
          </a>
          <ul class="site-nav-submenu">
            <li>
              <a
                href={buildLocalizedPath(locale, "/prueba-social/testimonios-trustpilot/")}
                class:list={{ "is-active": path === testimoniosPath }}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                  <path
                    d="M12 3.5 14.5 9l6 .6-4.6 4 1.4 5.9L12 16.6l-5.3 2.9 1.4-5.9-4.6-4 6-.6L12 3.5Z"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{t(locale, "pruebaSocialPage.testimoniosTitulo")}</span>
              </a>
            </li>
            <li>
              <a
                href={buildLocalizedPath(locale, "/prueba-social/reset-evidencia/")}
                class:list={{ "is-active": path === resetEvidenciaPath }}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                  <path d="M10 9.3 15 12l-5 2.7V9.3Z" fill="currentColor" />
                </svg>
                <span>{t(locale, "pruebaSocialPage.resetsTitulo")}</span>
              </a>
            </li>
            <li>
              <a
                href={buildLocalizedPath(locale, "/prueba-social/cliente-satisfecho/")}
                class:list={{ "is-active": path === clienteSatisfechoPath }}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                  <path
                    d="M4 5h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H8l-4 3V7a1 1 0 0 1 1-1Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                  <path d="M8 10h8M8 13h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
                <span>{t(locale, "pruebaSocialPage.conversacionesTitulo")}</span>
              </a>
            </li>
          </ul>
        </div>
        )}
        <a
          href={buildStaticPagePath(locale, "precios")}
          class:list={{ "is-active": path === preciosPath }}
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path
              d="M4 12 12 4h8v8l-8 8-8-8Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
            <circle cx="14.5" cy="9.5" r="1.4" fill="currentColor" />
          </svg>
          <span>{t(locale, "nav.precios")}</span>
        </a>
        {
          // Oculto a pedido: enlace "Preguntas Frecuentes" del menu. Se deja
          // comentado (no eliminado) para poder reactivarlo facilmente.
          /* <a
          href={`${buildStaticPagePath(locale, "comoFunciona")}#preguntas-frecuentes`}
          class:list={{ "is-active": path === comoFuncionaPath }}
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
            <path
              d="M9.6 9.3a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 1.9-2.4 3.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
            <circle cx="12" cy="16.6" r="0.9" fill="currentColor" />
          </svg>
          <span>{t(locale, "nav.preguntasFrecuentes")}</span>
        </a> */
        }
        {CONSULTA_GARANTIA_VISIBLE && (
        <a
          href={buildStaticPagePath(locale, "consultaGarantia")}
          class:list={{ "is-active": path === consultaGarantiaPath }}
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path
              d="M12 3.3 19 6v6c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6l7-2.7Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
            <path d="m9 12 2 2 4-4.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{t(locale, "nav.consultaGarantia")}</span>
        </a>
        )}
        <a
          href={buildStaticPagePath(locale, "contacto")}
          class:list={{ "is-active": path === contactoPath }}
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" stroke="currentColor" stroke-width="1.6" />
            <path d="m4.2 7 7.8 5.8L19.8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{t(locale, "nav.contacto")}</span>
        </a>
      </nav>
      <div class="site-header-controls">
        <LanguageSelector locale={locale} path={path} pageKey={pageKey} />
      </div>
    </div>
  </div>
</header>

<script>
  const navToggle = document.getElementById("site-nav-toggle");
  const nav = document.getElementById("site-nav");
  if (navToggle && nav) {
    navToggle.addEventListener("click", () => {
      const abierto = nav.classList.toggle("site-nav-abierto");
      navToggle.setAttribute("aria-expanded", String(abierto));
    });
    nav.querySelectorAll("a").forEach((enlace) => {
      enlace.addEventListener("click", () => {
        nav.classList.remove("site-nav-abierto");
        navToggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 3px solid #f97316;
    background: #1f2937;
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .site-header-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    /* "stretch" (en vez de center) para que cada enlace del menú ocupe todo
       el alto de la barra: así el ítem activo puede pintarse como una
       pestaña real, de borde a borde, en vez de solo un recuadro centrado. */
    align-items: stretch;
    gap: 1rem;
    padding: 0.75rem var(--space-md);
  }
  .site-logo {
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: 0.5rem;
    font-weight: 800;
    text-decoration: none;
    /* 150% del tamaño original (1.1rem); en pantallas angostas se reduce para
       que el botón del menú no quede empujado fuera de la barra. */
    font-size: clamp(1.15rem, 6vw, 1.65rem);
    color: #ffffff;
  }
  /* Mismo alto que el bloque de texto de al lado (título + eslogan en 2
     líneas) — no el ancho literal del eslogan, que lo haría enorme en una
     barra de header angosta. */
  .site-logo-imagen {
    width: 2.15rem;
    height: 2.15rem;
    object-fit: contain;
    flex: none;
  }
  .site-logo-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .site-logo-eslogan {
    font-size: 0.68rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    text-transform: none;
    letter-spacing: normal;
  }
  .site-logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: white;
    font-size: 0.9rem;
  }
  .site-nav-panel {
    display: contents;
  }
  .site-nav {
    display: flex;
    align-items: stretch;
    gap: 0.1rem;
    flex-wrap: wrap;
  }
  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.45rem 0.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 600;
    font-size: 0.86rem;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .site-nav a svg {
    flex: none;
    opacity: 0.75;
    transition: opacity 0.15s ease;
  }
  .site-nav a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }
  .site-nav a:hover svg {
    opacity: 1;
  }

  /* Efecto "pestaña": el enlace de la página actual se pinta con el fondo
     claro del contenido (en vez del oscuro del menú) y con esquinas
     redondeadas solo arriba; un pseudo-elemento extiende ese mismo fondo
     hacia abajo, por encima del padding y del borde naranja del header,
     como si la pestaña "recortara" el separador — igual que una pestaña de
     carpeta o de navegador que sobresale de la barra. */
  .site-nav a.is-active,
  .site-nav a.is-active:hover {
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }
  .site-nav a.is-active svg,
  .site-nav a.is-active:hover svg {
    opacity: 1;
  }
  .site-nav a.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-0.75rem - 3px);
    height: calc(0.75rem + 3px);
    background: var(--color-bg);
  }

  .site-nav-item-dropdown {
    position: relative;
    display: flex;
  }

  .site-nav-submenu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-floating);
    z-index: 40;
  }

  .site-nav-item-dropdown:hover .site-nav-submenu,
  .site-nav-item-dropdown:focus-within .site-nav-submenu {
    display: block;
  }

  .site-nav-submenu a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-weight: 500;
    white-space: nowrap;
  }

  .site-nav-submenu a svg {
    flex: none;
    color: var(--color-text-subtle);
  }

  .site-nav-submenu a:hover {
    background: var(--color-bg-muted);
    color: var(--color-primary-dark);
  }

  /* Dentro del panel desplegable no aplica el efecto "pestaña" (no está
     pegado a la barra oscura del header): la página actual se distingue
     con el mismo resaltado que ya usa el hover, pero fijo. */
  .site-nav-submenu a.is-active,
  .site-nav-submenu a.is-active:hover {
    background: var(--color-bg-muted);
    color: var(--color-primary-dark);
    font-weight: 700;
    border-radius: var(--radius-sm);
  }
  .site-nav-submenu a.is-active::after {
    content: none;
  }

  .site-header-controls {
    display: flex;
    align-items: center;
    align-self: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  .site-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: auto;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-sm);
    background: transparent;
    color: #ffffff;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .site-header-inner {
      flex-wrap: nowrap;
    }
    .site-nav-toggle {
      display: inline-flex;
      margin-left: 0.5rem;
    }
    .site-nav-panel {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: #1f2937;
      border-bottom: 3px solid #f97316;
      box-shadow: var(--shadow-floating);
      padding: 0.5rem var(--space-md) 1rem;
    }
    .site-nav-panel.site-nav-abierto {
      display: flex;
    }
    .site-nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .site-nav a {
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 1rem;
    }
    .site-nav-item-dropdown {
      position: static;
      display: block;
    }
    .site-nav-submenu {
      display: block;
      position: static;
      box-shadow: none;
      border: none;
      padding: 0 0 0 1rem;
      background: transparent;
    }
    .site-nav-submenu a {
      padding: 0.6rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 0.92rem;
      color: rgba(255, 255, 255, 0.6);
    }
    .site-nav-submenu a svg {
      color: rgba(255, 255, 255, 0.6);
    }
    .site-nav-submenu a:hover {
      background: transparent;
      color: #ffffff;
    }
    .site-nav-submenu a:hover svg {
      color: #ffffff;
    }

    /* En la lista vertical del menú móvil no hay barra de header contra la
       que "recortar" una pestaña: la página actual se marca con un
       resaltado de fondo de ancho completo en vez del efecto de pestaña. */
    .site-nav a.is-active,
    .site-nav a.is-active:hover {
      background: rgba(249, 115, 22, 0.14);
      color: #ffffff;
      border-radius: 0;
    }
    .site-nav a.is-active::after {
      content: none;
    }
    .site-nav-submenu a.is-active,
    .site-nav-submenu a.is-active:hover {
      background: rgba(249, 115, 22, 0.14);
      color: #ffffff;
      border-radius: 0;
    }
    .site-header-controls {
      margin: 0.75rem 0 0;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
  }

</style>
