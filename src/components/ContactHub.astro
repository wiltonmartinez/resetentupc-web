---
/**
 * Botón flotante de WhatsApp: al hacer clic abre un menú con el/los
 * vendedor(es) EN HORARIO ahora mismo cuyo país coincida con el detectado
 * por IP del visitante (ej. Edgar Alarcón para México), o marcados como
 * "Global" en el admin (ej. Wilton) — mismo backend que ya usa "Nuestro
 * equipo" en /contacto/ (ver ContactoPage.astro). Nadie está hardcodeado
 * acá: todo (incluido Wilton) sale de /vendedores/ en Núcleo, para no
 * duplicar contactos entre el código del sitio y ese módulo. No visible en
 * "ru" (Rusia/Europa del Este usa Telegram) ni "ko" (Corea del Sur usa
 * KakaoTalk) — WhatsApp tiene adopción marginal en esos mercados.
 */
import { Image, getImage } from "astro:assets";
import { t } from "../i18n/utils";
import { NUCLEO_API_BASE_URL, SITE_URL, type Locale } from "../config/site";
import whatsappLogo from "../assets/whatsapp/1.png";
import whatsappNotif from "../assets/whatsapp/2.png";

interface Props {
  locale: Locale;
  path: string;
  marcaDefault?: string;
  modeloDefault?: string;
}

const { locale, path, marcaDefault, modeloDefault } = Astro.props;

const LOCALES_SIN_WHATSAPP: Locale[] = ["ru", "ko"];
const mostrarWhatsapp = !LOCALES_SIN_WHATSAPP.includes(locale);
// Usado por aplicarSeleccionAWhatsApp() (ver <script> más abajo) para
// completar el "{url}" del mensaje de CUALQUIER vendedor del menú, no solo
// de uno en particular — por eso vive en el wrapper y no en cada link.
const urlOrigen = `${SITE_URL}${path}`;
const vendedoresApiUrl = `${NUCLEO_API_BASE_URL}/api/public/vendedores/`;

// En una página de modelo (marcaDefault+modeloDefault ya conocidos, ej.
// /reset/epson/l3210/) la burbuja de notificación es específica al modelo
// en vez del mensaje genérico — mismo patrón que buildWhatsAppMessage ya
// usa para el propio mensaje de WhatsApp.
const bubbleMensaje =
  marcaDefault && modeloDefault
    ? t(locale, "contactHub.bubbleMensajeModelo").replaceAll("{marca}", marcaDefault).replaceAll("{modelo}", modeloDefault)
    : t(locale, "contactHub.bubbleMensaje");

// Notificacion simulada: a los pocos segundos de cargar la pagina, el icono
// cambia de 1.png (logo limpio) a 2.png (logo con insignia roja "1" ya
// incluida en la imagen) y se muestra una burbuja de mensaje. La imagen
// "notificada" se precalcula aca para que el script solo tenga que
// intercambiar el atributo src, sin pedirle a Astro que optimice nada en
// tiempo de ejecucion.
const whatsappNotifOptimizada = await getImage({ src: whatsappNotif, width: 112 });
---

{mostrarWhatsapp && (
  <div
    class="contact-hub"
    data-whatsapp-dinamico
    data-url-origen={urlOrigen}
    data-msg-without-error={t(locale, "whatsapp.greetingWithoutError")}
    data-msg-generic={t(locale, "whatsapp.greetingGeneric")}
    data-bubble-modelo={t(locale, "contactHub.bubbleMensajeModelo")}
    data-bubble-generico={t(locale, "contactHub.bubbleMensaje")}
    data-vendedores-api-url={vendedoresApiUrl}
  >
    <p class="contact-hub-bubble" data-whatsapp-bubble hidden>
      <strong class="contact-hub-bubble-autor">Wilton Martínez</strong>
      <span data-whatsapp-bubble-texto>{bubbleMensaje}</span>
    </p>

    <div class="contact-hub-menu" data-whatsapp-menu role="menu" hidden>
      <div data-whatsapp-menu-regionales></div>
      <p class="contact-hub-menu-vacio" data-whatsapp-menu-vacio hidden>
        {t(locale, "contactHub.menuVacio")}
      </p>
    </div>

    <button
      type="button"
      class="contact-hub-fab"
      data-sound="select"
      data-analytics-event="contact_hub_abrir"
      data-whatsapp-fab
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label={t(locale, "contactHub.whatsapp")}
    >
      <Image
        src={whatsappLogo}
        data-whatsapp-fab-img
        data-notif-src={whatsappNotifOptimizada.src}
        alt=""
        width="112"
        height="112"
        loading="eager"
      />
    </button>
  </div>
)}

{/* Textos (ya traducidos) del selector de vendedores de src/lib/selector-vendedores.ts, que corre en TODAS las páginas. */}
<div
  data-selector-vendedores-textos
  data-titulo={t(locale, "selectorVendedores.titulo")}
  data-cargando={t(locale, "selectorVendedores.cargando")}
  data-cerrar={t(locale, "contactHub.cerrarLabel")}
  data-vacio={t(locale, "contactHub.menuVacio")}
  data-general={t(locale, "contactHub.whatsapp")}
  hidden
></div>

<!--
  Popup de marca/modelo/error del visitante: se abre solo (nunca en páginas
  de plotter donde ya viene marca+modelo por la URL — ahí solo pregunta el
  error) o pidiendo los 3 datos cuando el visitante llega por primera vez a
  una página sin ese contexto (ej. Home) y todavía no eligió nada. Una vez
  contestado, alimenta el mismo localStorage global que ya usan el selector
  de "Cómo Funciona", /precios/ y las páginas de modelo — ver el script de
  abajo para la lógica completa.
-->
<dialog class="seleccion-popup" data-seleccion-popup aria-labelledby="seleccion-popup-titulo">
  <form method="dialog" class="seleccion-popup-form" data-seleccion-popup-form>
    <button type="button" class="seleccion-popup-cerrar" data-seleccion-popup-cerrar aria-label={t(locale, "seleccionPopup.cerrarLabel")}>×</button>
    <h2 id="seleccion-popup-titulo" data-seleccion-popup-titulo>{t(locale, "seleccionPopup.titulo")}</h2>
    <p data-seleccion-popup-intro>{t(locale, "seleccionPopup.intro")}</p>

    <div data-seleccion-popup-campo-marca>
      <label for="seleccion-popup-marca">{t(locale, "seleccionPopup.labelMarca")}</label>
      <select id="seleccion-popup-marca" data-seleccion-popup-marca>
        <option value="">{t(locale, "seleccionPopup.opcionMarcaPlaceholder")}</option>
        <option value="epson">Epson</option>
        <option value="canon">Canon</option>
        <option value="epson-sc">Epson-SC</option>
      </select>
    </div>

    <div data-seleccion-popup-campo-modelo>
      <label for="seleccion-popup-modelo">{t(locale, "seleccionPopup.labelModelo")}</label>
      <input type="text" id="seleccion-popup-modelo" data-seleccion-popup-modelo placeholder={t(locale, "seleccionPopup.placeholderModelo")} />
    </div>

    <div>
      <label for="seleccion-popup-error">{t(locale, "seleccionPopup.labelError")}</label>
      <select
        id="seleccion-popup-error"
        data-seleccion-popup-error
        data-texto-sin-marca={t(locale, "seleccionPopup.opcionErrorPlaceholderSinMarca")}
        data-texto-elegir={t(locale, "seleccionPopup.opcionErrorPlaceholder")}
      >
        <option value="">{t(locale, "seleccionPopup.opcionErrorPlaceholderSinMarca")}</option>
      </select>
    </div>

    <button
      type="submit"
      class="seleccion-popup-confirmar"
      data-seleccion-popup-confirmar
      data-texto-titulo-solo-error={t(locale, "seleccionPopup.tituloSoloError")}
      data-texto-intro-solo-error={t(locale, "seleccionPopup.introSoloError")}
      data-texto-titulo-completo={t(locale, "seleccionPopup.titulo")}
      data-texto-intro-completo={t(locale, "seleccionPopup.intro")}
    >
      {t(locale, "seleccionPopup.botonConfirmar")}
    </button>
  </form>
</dialog>

<script>
  import "../lib/selector-vendedores";
  import { trackEvent } from "../lib/analytics.js";
  import { playFeedback } from "../lib/sound-manager.js";
  import { NUCLEO_API_BASE_URL } from "../config/site";

  // Tracking propio de clics en botones de WhatsApp (independiente de GA4,
  // que ni siquiera está configurado hoy — ver trackEvent()): un registro
  // en Núcleo por clic, con botón/página/país/IP, visible en
  // /clics-whatsapp/. "Fire and forget" — nunca debe demorar ni romper la
  // experiencia del visitante si Núcleo está lento o inalcanzable.
  function registrarClicWhatsApp(boton: string, vendedor: string = ""): void {
    fetch("/api/pais.json", { cache: "no-store" })
      .then((res) => res.json())
      .then((datosPais: { codigo_pais?: string | null }) => {
        return fetch(`${NUCLEO_API_BASE_URL}/api/public/clics-whatsapp/`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            boton,
            pagina: location.pathname,
            pais_iso: (datosPais.codigo_pais || "").toUpperCase(),
            vendedor,
          }),
        });
      })
      .catch(() => {
        // Sin país detectado o Núcleo inalcanzable: el clic real del
        // visitante ya pasó, no se reintenta ni se le muestra nada.
      });
  }
  // Banderas como imagen real, no emoji: Windows/Chrome no renderiza los
  // "regional indicator symbols" de Unicode como bandera — muestra el
  // código ISO en texto plano (ej. "CO"), que es justo lo que se quería
  // evitar. Los .png sí se ven igual en cualquier sistema. Import directo
  // (no getImage(), que es para el componente <Image> del lado servidor):
  // este <script> lo procesa Vite igual, y una imagen importada en JS/TS
  // resuelve sola a la URL final.
  import banderaCL from "../assets/flag/CHILE.png";
  import banderaCO from "../assets/flag/COLOMBIA.png";
  import banderaEC from "../assets/flag/ECUADOR.png";
  import banderaGT from "../assets/flag/GUATEMALA.png";
  import banderaMX from "../assets/flag/MEXICO.png";
  import banderaPE from "../assets/flag/PERU.png";
  import banderaGlobal from "../assets/flag/GLOBAL.png";

  document.querySelectorAll<HTMLElement>(".contact-hub [data-analytics-event]").forEach((el) => {
    el.addEventListener("click", () => {
      const boton = el.dataset.analyticsEvent || "";
      trackEvent(boton);
      registrarClicWhatsApp(boton);
    });
  });

  // Notificacion simulada: a los 4s del load, cambia el icono a la version
  // con insignia, suena un aviso sutil (silencioso salvo que el usuario haya
  // activado el sonido en el sitio, asi que nunca choca con las politicas de
  // autoplay del navegador) y aparece una burbuja de mensaje que se retira
  // sola a los pocos segundos.
  const NOTIF_DELAY_MS = 4000;
  const BUBBLE_AUTOHIDE_MS = 7000;

  const fab = document.querySelector<HTMLButtonElement>("[data-whatsapp-fab]");
  const fabImg = fab?.querySelector<HTMLImageElement>("[data-whatsapp-fab-img]");
  const bubble = document.querySelector<HTMLElement>("[data-whatsapp-bubble]");

  if (fab && fabImg) {
    window.setTimeout(() => {
      const notifSrc = fabImg.dataset.notifSrc;
      if (notifSrc) fabImg.src = notifSrc;
      playFeedback("whatsapp");

      if (bubble) {
        bubble.hidden = false;
        window.setTimeout(() => {
          bubble.hidden = true;
        }, BUBBLE_AUTOHIDE_MS);
      }
    }, NOTIF_DELAY_MS);
  }

  // Menú del botón flotante: vendedores EN HORARIO ahora mismo cuyo país
  // coincida con el detectado por IP, o marcados "Global" (mismo endpoint
  // que usa "Nuestro equipo" en /contacto/ — ver ContactoPage.astro). Nadie
  // hardcodeado acá: si Núcleo no devuelve a nadie, se muestra el mensaje de
  // "sin nadie disponible" (data-whatsapp-menu-vacio) en vez de un menú
  // vacío sin explicación. El clic en el FAB ya no navega directo: abre/
  // cierra este menú.
  const contactHub = document.querySelector<HTMLElement>(".contact-hub");
  const menu = document.querySelector<HTMLElement>("[data-whatsapp-menu]");
  const menuRegionales = document.querySelector<HTMLElement>("[data-whatsapp-menu-regionales]");
  const menuVacio = document.querySelector<HTMLElement>("[data-whatsapp-menu-vacio]");

  if (fab && menu) {
    const cerrarMenu = () => {
      menu.hidden = true;
      fab.setAttribute("aria-expanded", "false");
    };
    const abrirMenu = () => {
      menu.hidden = false;
      fab.setAttribute("aria-expanded", "true");
    };

    fab.addEventListener("click", (event) => {
      event.stopPropagation();
      if (menu.hidden) abrirMenu();
      else cerrarMenu();
    });
    document.addEventListener("click", (event) => {
      if (!menu.hidden && contactHub && !contactHub.contains(event.target as Node)) cerrarMenu();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") cerrarMenu();
    });
  }

  interface VendedorPublico {
    nombre: string;
    whatsapp: string;
    foto?: string;
    roles?: string[];
    pais_iso?: string;
    en_linea_restante?: string;
  }

  const BANDERAS_POR_ISO: Record<string, ImageMetadata> = {
    CL: banderaCL,
    CO: banderaCO,
    EC: banderaEC,
    GT: banderaGT,
    MX: banderaMX,
    PE: banderaPE,
    ZZ: banderaGlobal,
  };

  /**
   * URL de la imagen de bandera para un ISO 3166-1 alpha-2 (o 'ZZ' para
   * "Global") — null si no hay imagen para ese país (no todos los países
   * del catálogo de vendedores tienen bandera cargada en src/assets/flag/),
   * para que el llamador simplemente no muestre imagen en vez de romper.
   */
  function banderaUrlDesdeIso(iso?: string): string | null {
    if (!iso) return null;
    return BANDERAS_POR_ISO[iso.toUpperCase()]?.src ?? null;
  }

  // Astro "scopea" el CSS de este componente agregando un atributo
  // data-astro-cid-XXXXX (hash que cambia en cada build) a cada elemento
  // que escribió en el markup — un nodo creado a mano con createElement()
  // no lo trae, así que .contact-hub-menu-item no le aplicaba (se veía
  // como link plano sin tarjeta). Se copia ese atributo desde el wrapper
  // ".contact-hub" (siempre renderizado por Astro), que ya no tiene ningún
  // <a> propio dentro del menú desde que todos los vendedores —Wilton
  // incluido— salen dinámicamente de Núcleo.
  const atributoScope = Array.from(contactHub?.attributes ?? []).find((atributo) => atributo.name.startsWith("data-astro-cid-"))?.name;

  function crearItemMenuVendedor(vendedor: VendedorPublico): HTMLAnchorElement {
    const link = document.createElement("a");
    link.className = "contact-hub-menu-item";
    link.target = "_blank";
    link.rel = "noopener noreferrer nofollow";
    link.dataset.whatsappMenuLink = "";
    link.dataset.numero = vendedor.whatsapp;
    link.setAttribute("role", "menuitem");
    link.addEventListener("click", () => {
      registrarClicWhatsApp("contact_hub_abrir", vendedor.nombre);
      menu && (menu.hidden = true);
    });

    const avatar = document.createElement("span");
    avatar.className = "contact-hub-menu-avatar";
    let avatarContenido: HTMLImageElement | HTMLSpanElement;
    if (vendedor.foto) {
      avatarContenido = document.createElement("img");
      avatarContenido.className = "contact-hub-menu-avatar-img";
      avatarContenido.src = vendedor.foto;
      avatarContenido.alt = "";
    } else {
      avatarContenido = document.createElement("span");
      avatarContenido.className = "contact-hub-menu-avatar-inicial";
      avatarContenido.textContent = vendedor.nombre.charAt(0);
    }
    avatar.appendChild(avatarContenido);

    const info = document.createElement("span");
    info.className = "contact-hub-menu-info";

    const nombre = document.createElement("span");
    nombre.className = "contact-hub-menu-nombre";
    nombre.textContent = vendedor.nombre;

    // El endpoint solo devuelve vendedores EN HORARIO ahora mismo (ver
    // listar_vendedores_por_pais_db() del lado de Núcleo) — quien no está en
    // horario directamente no llega a esta lista, así que todo lo que se
    // renderiza acá está, por construcción, disponible ahora. en_linea_restante
    // ya viene formateado ("24 horas" o "1h 30min") o vacío si el vendedor
    // no tiene horario cargado (no hay "hasta" del cual calcularlo).
    const online = document.createElement("span");
    online.className = "contact-hub-menu-online";
    online.textContent = vendedor.en_linea_restante ? `ONLINE · ${vendedor.en_linea_restante}` : "ONLINE";

    const elementosOpcionales: HTMLElement[] = [];
    let rol: HTMLElement | null = null;
    if (vendedor.roles && vendedor.roles.length) {
      rol = document.createElement("span");
      rol.className = "contact-hub-menu-rol";
      rol.textContent = vendedor.roles.join(", ");
      elementosOpcionales.push(rol);
    }

    const numero = document.createElement("span");
    numero.className = "contact-hub-menu-numero";
    const banderaUrl = banderaUrlDesdeIso(vendedor.pais_iso);
    let banderaImg: HTMLImageElement | null = null;
    if (banderaUrl) {
      banderaImg = document.createElement("img");
      banderaImg.className = "contact-hub-menu-bandera";
      banderaImg.src = banderaUrl;
      banderaImg.alt = "";
      numero.appendChild(banderaImg);
      elementosOpcionales.push(banderaImg);
    }
    numero.appendChild(document.createTextNode(`+${vendedor.whatsapp}`));

    info.appendChild(nombre);
    if (rol) info.appendChild(rol);
    info.appendChild(online);
    info.appendChild(numero);
    link.appendChild(avatar);
    link.appendChild(info);

    if (atributoScope) {
      [link, avatar, avatarContenido, info, nombre, online, numero, ...elementosOpcionales].forEach((el) => el.setAttribute(atributoScope, ""));
    }

    return link;
  }

  function cargarVendedoresRegionales(): void {
    const vendedoresApiUrl = contactHub?.dataset.vendedoresApiUrl;
    if (!vendedoresApiUrl || !menuRegionales) return;

    fetch("/api/pais.json", { cache: "no-store" })
      .then((res) => res.json())
      .then((datosPais: { codigo_pais?: string | null }) => {
        const paisIso = (datosPais.codigo_pais || "").toUpperCase();
        if (!/^[A-Z]{2}$/.test(paisIso)) return null;
        return fetch(`${vendedoresApiUrl}?pais_iso=${paisIso}`).then((res) => res.json());
      })
      .then((datosVendedores: { data?: VendedorPublico[] } | null) => {
        const vendedores = datosVendedores?.data ?? [];
        if (!vendedores.length) {
          if (menuVacio) menuVacio.hidden = false;
          return;
        }
        vendedores.forEach((vendedor) => {
          if (!menuRegionales) return;
          menuRegionales.appendChild(crearItemMenuVendedor(vendedor));
          // Recién agregado: aplicarle el mismo mensaje que ya tienen los
          // demás links, por si la selección global (marca/modelo) ya se
          // resolvió antes de que este fetch termine.
          const actual = leerSeleccionGlobal();
          if (actual) aplicarSeleccionAWhatsApp(actual);
        });
      })
      .catch(() => {
        // sin país detectado, Núcleo inalcanzable, o nadie en horario ahora
        // mismo: no hay nadie hardcodeado de respaldo, así que se avisa en
        // vez de dejar el menú vacío sin explicación.
        if (menuVacio) menuVacio.hidden = false;
      });
  }

  cargarVendedoresRegionales();

  // Selección global del visitante (marca/modelo/error): misma clave de
  // localStorage que ya usan ProcedimientoResumenDetalle.astro (selector de
  // "Cómo Funciona"), ProcedimientoImpresora.astro (páginas /reset/{marca}/
  // {modelo}/), PreciosPage.astro y los listados de /prueba-social/. Este
  // bloque corre en TODAS las páginas (ContactHub va en BaseLayout) — es el
  // único punto que aplica esa selección al botón flotante de WhatsApp
  // incluso en páginas que no traen el selector de Home/Cómo Funciona.
  interface SeleccionGlobal {
    marca: string;
    modelo: string;
    error: string;
  }

  const SELECCION_LS_KEY = "resetenlinea_seleccion_global_v1";

  function leerSeleccionGlobal(): SeleccionGlobal | null {
    try {
      const datos = JSON.parse(localStorage.getItem(SELECCION_LS_KEY) || "null");
      return datos && datos.marca ? datos : null;
    } catch {
      return null;
    }
  }

  function guardarSeleccionGlobal(datos: SeleccionGlobal): void {
    try {
      localStorage.setItem(SELECCION_LS_KEY, JSON.stringify(datos));
    } catch {
      /* localStorage no disponible: la selección simplemente no persiste entre visitas. */
    }
  }

  const LABEL_POR_MARCA: Record<string, string> = { epson: "Epson", canon: "Canon", "epson-sc": "Epson-SC" };
  // Epson-SC es la única "plotter" del catálogo — mismo criterio que
  // GRUPO_POR_MARCA en src/lib/precios.ts y metodos_pago.php del lado PHP.
  const GRUPO_POR_MARCA: Record<string, "impresora" | "plotter"> = { epson: "impresora", canon: "impresora", "epson-sc": "plotter" };
  // Catálogo cerrado de errores del popup — a propósito más corto que el del
  // selector de Home (ProcedimientoResumenDetalle.astro): acá es solo para
  // arrancar la conversación de WhatsApp, no para elegir el procedimiento
  // exacto. El primer valor de cada lista es el que se preselecciona por
  // defecto en Epson/Canon (Epson-SC no tiene default: por eso se pregunta
  // por popup en vez de asumir uno, ver abrirPopupSoloError()).
  const ERRORES_POR_MARCA: Record<string, string[]> = {
    epson: ["Almohadillas", "E-11"],
    canon: ["5B00", "1700"],
    "epson-sc": ["0014BD", "00080008", "00040004", "00010001", "000C000C"],
  };
  const ERROR_DEFECTO_POR_MARCA: Record<string, string> = { epson: "Almohadillas", canon: "5B00" };

  // Misma lógica que actualizarWhatsAppCta() de ProcedimientoResumenDetalle.astro
  // (marca+modelo sin el error en el saludo) — duplicada a propósito, porque
  // ese script solo corre en páginas con el selector de Home/Cómo Funciona,
  // y este bloque necesita funcionar en cualquier página.
  //
  // Actualiza TODOS los links dentro de cada [data-whatsapp-dinamico], no
  // solo uno: el botón flotante ahora puede tener varios (Wilton + vendedores
  // regionales, ver el menú más arriba), mientras que otros usos de
  // data-whatsapp-dinamico en el sitio (WhatsAppCTA.astro) siguen teniendo
  // uno solo — data-numero en el propio link gana sobre el número del wrap,
  // así cada entrada del menú manda al número que le corresponde.
  function aplicarSeleccionAWhatsApp(datos: SeleccionGlobal): void {
    const marcaLabel = LABEL_POR_MARCA[datos.marca] ?? "";
    document.querySelectorAll<HTMLElement>("[data-whatsapp-dinamico]").forEach((wrap) => {
      const links = wrap.querySelectorAll<HTMLAnchorElement>("a[data-source-id], a[data-whatsapp-menu-link]");
      if (!links.length) return;
      const urlOrigen = wrap.dataset.urlOrigen ?? "";
      const plantilla = marcaLabel ? (wrap.dataset.msgWithoutError ?? "") : (wrap.dataset.msgGeneric ?? "");
      const mensaje = plantilla
        .replaceAll("{marca}", marcaLabel)
        .replaceAll("{modelo}", datos.modelo)
        .replaceAll("{error}", datos.error)
        .replaceAll("{url}", urlOrigen)
        .replace(/[ \t]{2,}/g, " ")
        .replace(/[ \t]+([,.;:])/g, "$1");
      links.forEach((link) => {
        const numero = link.dataset.numero || wrap.dataset.whatsappNumber || "";
        if (!numero) return;
        link.href = `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
      });

      // El texto va en un <span> propio, no directo en el <p> — el <p>
      // también tiene el nombre fijo de Wilton (ver markup más arriba),
      // así que escribirle el texto entero con .textContent lo borraría.
      const bubbleTextoEl = wrap.querySelector<HTMLElement>("[data-whatsapp-bubble-texto]");
      const bubbleModeloTpl = wrap.dataset.bubbleModelo;
      const bubbleGenericoTpl = wrap.dataset.bubbleGenerico;
      if (bubbleTextoEl && (bubbleModeloTpl || bubbleGenericoTpl)) {
        const bubbleTemplate = marcaLabel && datos.modelo ? (bubbleModeloTpl ?? "") : (bubbleGenericoTpl ?? "");
        bubbleTextoEl.textContent = bubbleTemplate.replaceAll("{marca}", marcaLabel).replaceAll("{modelo}", datos.modelo);
      }
    });
  }

  const popup = document.querySelector<HTMLDialogElement>("[data-seleccion-popup]");
  const popupForm = document.querySelector<HTMLFormElement>("[data-seleccion-popup-form]");
  const popupCampoMarca = document.querySelector<HTMLElement>("[data-seleccion-popup-campo-marca]");
  const popupCampoModelo = document.querySelector<HTMLElement>("[data-seleccion-popup-campo-modelo]");
  const popupMarcaSelect = document.querySelector<HTMLSelectElement>("[data-seleccion-popup-marca]");
  const popupModeloInput = document.querySelector<HTMLInputElement>("[data-seleccion-popup-modelo]");
  const popupErrorSelect = document.querySelector<HTMLSelectElement>("[data-seleccion-popup-error]");
  const popupTitulo = document.querySelector<HTMLElement>("[data-seleccion-popup-titulo]");
  const popupIntro = document.querySelector<HTMLElement>("[data-seleccion-popup-intro]");
  const popupCerrar = document.querySelector<HTMLButtonElement>("[data-seleccion-popup-cerrar]");
  const popupConfirmarBtn = document.querySelector<HTMLButtonElement>("[data-seleccion-popup-confirmar]");

  if (popup && popupForm && popupMarcaSelect && popupModeloInput && popupErrorSelect) {
    let modoSoloError = false;
    let marcaFijaSlug = "";
    let modeloFijo = "";

    // conDefault=true (Epson/Canon en el popup completo): preselecciona el
    // primer valor de la lista, sin opción vacía — "por defecto" pedido.
    // conDefault=false (Epson-SC, o sin marca todavía): arranca en blanco,
    // obligando a elegir — no hay default confiable para plotters.
    const actualizarOpcionesError = (marca: string, conDefault: boolean) => {
      popupErrorSelect.innerHTML = "";
      const opciones = ERRORES_POR_MARCA[marca] ?? [];
      if (!conDefault || opciones.length === 0) {
        const vacia = document.createElement("option");
        vacia.value = "";
        vacia.textContent = marca ? (popupErrorSelect.dataset.textoElegir ?? "") : (popupErrorSelect.dataset.textoSinMarca ?? "");
        popupErrorSelect.appendChild(vacia);
      }
      opciones.forEach((valor) => {
        const opt = document.createElement("option");
        opt.value = valor;
        opt.textContent = valor;
        popupErrorSelect.appendChild(opt);
      });
    };

    popupMarcaSelect.addEventListener("change", () => {
      const marca = popupMarcaSelect.value;
      // Epson-SC no tiene default ni siquiera en el popup completo — "por
      // defecto: preguntar" también aplica acá, no solo en la página de modelo.
      actualizarOpcionesError(marca, GRUPO_POR_MARCA[marca] !== "plotter");
    });
    popupCerrar?.addEventListener("click", () => popup.close());

    const abrirPopupCompleto = () => {
      modoSoloError = false;
      popupCampoMarca?.removeAttribute("hidden");
      popupCampoModelo?.removeAttribute("hidden");
      popupMarcaSelect.value = "";
      popupModeloInput.value = "";
      actualizarOpcionesError("", true);
      if (popupTitulo) popupTitulo.textContent = popupConfirmarBtn?.dataset.textoTituloCompleto ?? "";
      if (popupIntro) popupIntro.textContent = popupConfirmarBtn?.dataset.textoIntroCompleto ?? "";
      if (!popup.open) popup.showModal();
    };

    const abrirPopupSoloError = (marca: string, modelo: string) => {
      modoSoloError = true;
      marcaFijaSlug = marca;
      modeloFijo = modelo;
      popupCampoMarca?.setAttribute("hidden", "");
      popupCampoModelo?.setAttribute("hidden", "");
      actualizarOpcionesError(marca, false);
      const marcaLabel = LABEL_POR_MARCA[marca] ?? marca;
      if (popupTitulo) {
        popupTitulo.textContent = (popupConfirmarBtn?.dataset.textoTituloSoloError ?? "")
          .replaceAll("{marca}", marcaLabel)
          .replaceAll("{modelo}", modelo);
      }
      if (popupIntro) popupIntro.textContent = popupConfirmarBtn?.dataset.textoIntroSoloError ?? "";
      if (!popup.open) popup.showModal();
    };

    popupForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const error = popupErrorSelect.value;
      if (!error) return;

      if (modoSoloError) {
        const datos: SeleccionGlobal = { marca: marcaFijaSlug, modelo: modeloFijo, error };
        guardarSeleccionGlobal(datos);
        aplicarSeleccionAWhatsApp(datos);
        popup.close();
        return;
      }

      const marca = popupMarcaSelect.value;
      const modelo = popupModeloInput.value.trim();
      if (!marca || !modelo) return;
      guardarSeleccionGlobal({ marca, modelo, error });
      popup.close();
      // Recarga para que el resto de módulos de la página (selector de "Cómo
      // Funciona", widget de precios, etc., cuando estén presentes) también
      // reflejen la selección recién guardada con su propia lógica de
      // restaurarSeleccion() — más simple y confiable que reimplementar acá
      // la sincronización de cada uno.
      window.location.reload();
    });

    // Decisión al cargar la página: una página de modelo (/reset/{marca}/
    // {modelo}/) manda sobre cualquier preferencia previa (misma regla que ya
    // aplica ProcedimientoImpresora.astro para impresoras) — para plotters
    // se pregunta el error por popup en vez de adivinarlo, porque no hay un
    // código "por defecto" confiable. Sin ese contexto de página, se usa lo
    // ya guardado o, si es la primera visita, se pregunta todo.
    const procedimiento = document.querySelector<HTMLElement>("[data-procedimiento]");
    const marcaPagina = procedimiento?.dataset.marca ?? "";

    if (marcaPagina && GRUPO_POR_MARCA[marcaPagina] === "plotter") {
      const modeloPagina = procedimiento?.dataset.modelo ?? "";
      const previa = leerSeleccionGlobal();
      if (previa) aplicarSeleccionAWhatsApp(previa);
      abrirPopupSoloError(marcaPagina, modeloPagina);
    } else if (marcaPagina) {
      // Epson/Canon: ProcedimientoImpresora.astro ya guardó marca/modelo/error
      // apenas cargó (su propio <script>, que corre antes que este por venir
      // primero en el documento) — acá solo se refleja en el botón flotante.
      const actual = leerSeleccionGlobal() ?? { marca: marcaPagina, modelo: procedimiento?.dataset.modelo ?? "", error: ERROR_DEFECTO_POR_MARCA[marcaPagina] ?? "" };
      aplicarSeleccionAWhatsApp(actual);
    } else {
      const guardada = leerSeleccionGlobal();
      if (guardada) {
        aplicarSeleccionAWhatsApp(guardada);
      } else {
        abrirPopupCompleto();
      }
    }
  }
</script>

<style>
  .contact-hub {
    position: fixed;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 45;
  }

  .contact-hub-fab {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border: none;
    padding: 0;
    background: transparent;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: var(--shadow-floating);
    animation: contact-hub-pulso 2.4s ease-in-out infinite;
    transition: transform 0.15s ease;
    cursor: pointer;
  }

  .contact-hub-fab:hover {
    transform: scale(1.06);
  }

  .contact-hub-fab img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  @keyframes contact-hub-pulso {
    0%,
    100% {
      box-shadow: var(--shadow-floating), 0 0 0 0 rgba(15, 118, 110, 0.45);
    }
    50% {
      box-shadow: var(--shadow-floating), 0 0 0 0.5rem rgba(15, 118, 110, 0);
    }
  }

  /* Burbuja de mensaje no leido, simulando una notificacion de chat real.
     Se muestra/oculta con el atributo [hidden] via JS — no fijar "display"
     aca para no pisar el "display:none" que aplica ese atributo. */
  /* Una sola línea a propósito (nunca se envuelve): con marca+modelo el
     mensaje es más largo que el genérico, así que en vez de un max-width
     fijo (que lo partiría en 2-3 líneas) el ancho se ajusta al contenido,
     con un tope de seguridad para no salirse de pantallas angostas. */
  .contact-hub-bubble {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.65rem);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    width: max-content;
    max-width: calc(100vw - 2 * var(--space-sm) - 1rem);
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    box-shadow: var(--shadow-floating);
    animation: contact-hub-bubble-in 0.3s ease-out;
  }

  /* Fijo a propósito (no viene del menú dinámico de vendedores): esta
     burbuja es el gancho de atención automático del sitio, y siempre debe
     verse como si viniera de Wilton — sin importar quién esté disponible
     ahora mismo en el menú real. */
  .contact-hub-bubble-autor {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .contact-hub-bubble [data-whatsapp-bubble-texto] {
    white-space: nowrap;
  }

  .contact-hub-bubble::after {
    content: "";
    position: absolute;
    top: 100%;
    right: 1.15rem;
    border: 0.4rem solid transparent;
    border-top-color: var(--color-bg-card);
  }

  /* Menú que abre el FAB al hacer clic: Wilton (fijo) + vendedores
     regionales agregados por JS con la misma clase .contact-hub-menu-item.
     [hidden] pierde contra el display:grid de abajo a igual especificidad
     (la regla del autor gana sobre la del user-agent) — hace falta este
     override explícito para que hidden realmente oculte el menú. */
  .contact-hub-menu[hidden] {
    display: none;
  }

  .contact-hub-menu {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.65rem);
    display: grid;
    gap: 0.4rem;
    width: max-content;
    min-width: 13rem;
    max-width: calc(100vw - 2 * var(--space-sm) - 1rem);
    padding: 0.5rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-floating);
    animation: contact-hub-bubble-in 0.2s ease-out;
  }

  .contact-hub-menu-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-bg-muted);
  }

  .contact-hub-menu-item:hover {
    background: var(--color-primary-light);
  }

  /* Avatar circular a la izquierda: foto real (vendedores regionales,
     cargada desde Núcleo) o, sin foto (Wilton por defecto, o un vendedor
     sin foto aún cargada), un círculo con su inicial — nunca un ícono roto. */
  .contact-hub-menu-avatar {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-primary-light);
  }

  .contact-hub-menu-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-hub-menu-avatar-inicial {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-primary-dark);
  }

  .contact-hub-menu-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .contact-hub-menu-nombre {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .contact-hub-menu-rol {
    font-size: 0.72rem;
    color: var(--color-text-subtle);
  }

  .contact-hub-menu-numero {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--color-text-subtle);
  }

  /* Imagen real de bandera, no emoji — ver comentario en el <script> sobre
     por qué (Windows/Chrome no renderiza los emoji de bandera). */
  .contact-hub-menu-bandera {
    width: 1rem;
    height: 0.72rem;
    object-fit: cover;
    border-radius: 0.15rem;
    flex-shrink: 0;
  }

  /* Punto verde + "ONLINE": el endpoint ya filtra por horario de atención
     (ver comentario en crearItemMenuVendedor más arriba), así que todo item
     que llega a renderizarse está, por construcción, disponible ahora. */
  .contact-hub-menu-online {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #1a9f4a;
  }

  .contact-hub-menu-online::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #22c55e;
  }

  .contact-hub-menu-vacio {
    margin: 0;
    padding: 0.6rem 0.7rem;
    font-size: 0.82rem;
    color: var(--color-text-subtle);
    text-align: center;
  }

  @keyframes contact-hub-bubble-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-hub-fab,
    .contact-hub-bubble {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .contact-hub-fab {
      width: 3.25rem;
      height: 3.25rem;
    }
  }

  /* Popup discreto a propósito: chico, esquinado abajo a la derecha (cerca
     del propio botón de WhatsApp que va a alimentar) en vez de un modal
     grande centrado — pide un dato puntual sin sentirse como una interrupción
     de pantalla completa. */
  .seleccion-popup {
    margin: 0;
    position: fixed;
    right: var(--space-sm);
    bottom: calc(var(--space-sm) + 4.25rem);
    left: auto;
    top: auto;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    max-width: 19rem;
    width: calc(100vw - 2 * var(--space-sm));
    background: var(--color-bg-card);
    color: var(--color-text);
  }

  .seleccion-popup::backdrop {
    background: rgba(15, 23, 42, 0.18);
  }

  @media (max-width: 480px) {
    .seleccion-popup {
      right: var(--space-xs);
      bottom: calc(var(--space-xs) + 4rem);
    }
  }

  .seleccion-popup-form {
    display: grid;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    position: relative;
  }

  .seleccion-popup-form h2 {
    margin: 0;
    padding-right: 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .seleccion-popup-form p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-text-subtle);
  }

  .seleccion-popup-form label {
    display: block;
    font-weight: 600;
    font-size: 0.78rem;
    margin-bottom: 0.2rem;
  }

  .seleccion-popup-form select,
  .seleccion-popup-form input {
    width: 100%;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 0.85rem;
    background: var(--color-bg-card);
    color: var(--color-text);
    box-sizing: border-box;
  }

  .seleccion-popup-cerrar {
    position: absolute;
    top: 0.4rem;
    right: 0.55rem;
    border: none;
    background: transparent;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-text-subtle);
    padding: 0.1rem 0.3rem;
  }

  .seleccion-popup-confirmar {
    margin-top: 0.15rem;
    padding: 0.45rem 1rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: white;
    font: inherit;
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .seleccion-popup-confirmar:hover {
    background: var(--color-primary-dark);
  }
</style>
