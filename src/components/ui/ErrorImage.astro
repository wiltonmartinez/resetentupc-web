---
import { Image } from "astro:assets";
import { getErrorImage } from "../../lib/error-images.js";

interface Props {
  errorId: string;
  modeloSlug?: string;
  alt: string;
  caption?: string;
}

const { errorId, modeloSlug, alt, caption } = Astro.props;
const imagen = getErrorImage(errorId) ?? (modeloSlug ? getErrorImage(modeloSlug) : null);
---

{
  imagen && (
    <figure class="evidencia-imagen">
      <Image src={imagen} alt={alt} width={imagen.width} height={imagen.height} loading="lazy" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .evidencia-imagen {
    margin: 0;
  }

  .evidencia-imagen :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    display: block;
  }

  .evidencia-imagen figcaption {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    text-align: center;
  }
</style>
