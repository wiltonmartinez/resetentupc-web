---
/**
 * Formulario de contacto rápido (columna izquierda de /contacto/): marca +
 * modelo + error (precargados desde la URL o la selección global guardada
 * en localStorage — misma clave que usan /precios/, /reset/{marca}/{modelo}/
 * y ContactCard.astro), país + WhatsApp (país autodetectado por IP vía
 * /api/pais.json, editable a mano), correo con verificación por código de
 * 6 dígitos antes de enviar.
 *
 * Sin wizard de varios pasos: todo vive en una sola pantalla. El envío NO
 * pasa por un endpoint propio de Astro — va directo, por fetch() desde el
 * cliente, al mismo script PHP externo que ya usa el resto del sitio
 * (CONTACT_FORM_EMAIL_ENDPOINT, ver src/config/site.ts), con dos acciones
 * nuevas que ese PHP todavía no tiene: "enviar_codigo_verificacion" y
 * "verificar_codigo_y_enviar". Hasta que se agreguen del lado del PHP, el
 * botón de enviar código mostrará el error genérico — ver el comentario al
 * final de este archivo con el contrato exacto que espera el frontend.
 */
import { t } from "../../i18n/utils";
import { CONTACT_FORM_EMAIL_ENDPOINT, CONTACT_FORM_SECRET, SITE_URL, type Locale } from "../../config/site";

interface Props {
  locale: Locale;
  urlPath: string;
}

const { locale, urlPath } = Astro.props;
const urlOrigen = `${SITE_URL}${urlPath}`;

const MARCAS = [
  { id: "epson", label: "Epson" },
  { id: "canon", label: "Canon" },
  { id: "epson-sc", label: "Epson-SC" },
];

const ERRORES_POR_MARCA: Record<string, string[]> = {
  epson: [t(locale, "comoFuncionaProceso.errorAlmohadillasLabel"), "E-11"],
  canon: ["5B00", "1700"],
  "epson-sc": ["0014BD", "00000008 - 00080000", "00000004 - 00040000", "00000001 - 00010000", "0000000c - 000c0000"],
};
---

<div
  class="cfr"
  data-contacto-form-rapido
  data-endpoint={CONTACT_FORM_EMAIL_ENDPOINT}
  data-secret={CONTACT_FORM_SECRET}
  data-url-origen={urlOrigen}
  data-texto-enviando={t(locale, "contactoRapido.botonEnviando")}
  data-texto-boton-codigo={t(locale, "contactoRapido.botonEnviarCodigo")}
  data-texto-confirmando={t(locale, "contactoRapido.botonConfirmando")}
  data-texto-boton-confirmar={t(locale, "contactoRapido.botonConfirmar")}
  data-texto-otp-info={t(locale, "contactoRapido.otpInfo")}
  data-texto-reenviar={t(locale, "contactoRapido.botonReenviar")}
  data-texto-reenviar-cooldown={t(locale, "contactoRapido.botonReenviarCooldown")}
  data-texto-error-email={t(locale, "contactoRapido.errorEmailInvalido")}
  data-texto-error-whatsapp={t(locale, "contactoRapido.errorWhatsappRequerido")}
  data-texto-error-codigo={t(locale, "contactoRapido.errorCodigoRequerido")}
  data-texto-error-generico={t(locale, "contactoRapido.errorGenerico")}
  data-texto-error-contenido={t(locale, "contactoRapido.errorContenido")}
  data-texto-exito={t(locale, "contactoRapido.exito")}
>
  <form class="cfr-form" data-cfr-form novalidate>
    <div class="cfr-campo">
      <span class="cfr-label">{t(locale, "contactoRapido.marcaLabel")}</span>
      <div class="cfr-botones" data-cfr-marca-botones role="radiogroup">
        {MARCAS.map((marca) => (
          <button type="button" class="cfr-boton-chip" data-cfr-marca-boton data-value={marca.id} data-sound="select">
            {marca.label}
          </button>
        ))}
      </div>
    </div>

    <label class="cfr-campo">
      <span class="cfr-label">{t(locale, "contactoRapido.modeloLabel")}</span>
      <input type="text" data-cfr-modelo placeholder={t(locale, "contactoRapido.modeloPlaceholder")} autocomplete="off" />
    </label>

    <div class="cfr-campo" data-cfr-error-wrap hidden>
      <span class="cfr-label">{t(locale, "contactoRapido.errorLabel")}</span>
      {Object.entries(ERRORES_POR_MARCA).map(([marcaId, errores]) => (
        <div class="cfr-botones" data-cfr-errores-panel={marcaId} hidden>
          {errores.map((error) => (
            <button type="button" class="cfr-boton-chip" data-cfr-error-boton data-value={error} data-sound="select">
              {error}
            </button>
          ))}
        </div>
      ))}
      <input
        type="text"
        class="cfr-input-otro"
        data-cfr-error-otro
        placeholder={t(locale, "contactoRapido.errorOtroPlaceholder")}
        hidden
      />
    </div>

    <label class="cfr-campo">
      <span class="cfr-label">{t(locale, "contactoRapido.nombreLabel")}</span>
      <input type="text" data-cfr-nombre placeholder={t(locale, "contactoRapido.nombrePlaceholder")} autocomplete="given-name" />
    </label>

    <label class="cfr-campo">
      <span class="cfr-label">{t(locale, "contactoRapido.emailLabel")} <span class="cfr-requerido">*</span></span>
      <input type="email" data-cfr-email required placeholder={t(locale, "contactoRapido.emailPlaceholder")} autocomplete="email" />
    </label>

    <div class="cfr-campo" data-cfr-whatsapp-wrap>
      <span class="cfr-label">
        {t(locale, "contactoRapido.whatsappLabel")} <span class="cfr-requerido" data-cfr-whatsapp-requerido>*</span>
      </span>
      <div class="cfr-whatsapp-fila">
        <select class="cfr-pais-select" data-cfr-pais-select aria-label={t(locale, "contactoRapido.paisSelectLabel")}></select>
        <input type="tel" data-cfr-whatsapp placeholder={t(locale, "contactoRapido.whatsappPlaceholder")} autocomplete="tel-national" />
      </div>
    </div>

    <label class="cfr-checkbox">
      <input type="checkbox" data-cfr-no-whatsapp />
      {t(locale, "contactoRapido.noWhatsappLabel")}
    </label>

    <label class="cfr-checkbox">
      <input type="checkbox" data-cfr-marketing />
      {t(locale, "contactoRapido.marketingLabel")}
    </label>

    <input type="text" name="website" class="cfr-honeypot" data-cfr-honeypot tabindex="-1" autocomplete="off" aria-hidden="true" />

    <button type="submit" class="cfr-boton-principal" data-cfr-enviar-codigo>
      {t(locale, "contactoRapido.botonEnviarCodigo")}
    </button>

    <div class="cfr-otp" data-cfr-otp-wrap hidden>
      <p class="cfr-otp-info" data-cfr-otp-info></p>
      <label class="cfr-campo">
        <span class="cfr-label">{t(locale, "contactoRapido.codigoLabel")}</span>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" data-cfr-codigo placeholder="000000" />
      </label>
      <div class="cfr-otp-botones">
        <button type="button" class="cfr-boton-principal" data-cfr-confirmar>{t(locale, "contactoRapido.botonConfirmar")}</button>
        <button type="button" class="cfr-boton-reenviar" data-cfr-reenviar>{t(locale, "contactoRapido.botonReenviar")}</button>
      </div>
    </div>

    <p class="cfr-mensaje" data-cfr-mensaje role="status" aria-live="polite" hidden></p>
  </form>
</div>

<script>
  import { revisarContenido } from "../../lib/contact-moderation.js";
  import { construirCuerpoMensaje, construirAsunto } from "../../lib/contact-message.js";

  interface DialInfo {
    dial: string;
    bandera: string;
    nombre: string;
  }

  // Indicativos de los países donde el sitio ya tiene cobertura de precios
  // (ver ISO_A_SLUG en src/lib/precios.ts) más EE.UU./España para clientes
  // fuera de Latinoamérica. Autodetección vía /api/pais.json (mismo
  // endpoint que ya usan PreciosCascadaWidget/PreciosModeloWidget); "CO"
  // como respaldo si no se puede detectar.
  const DIAL_CODES: Record<string, DialInfo> = {
    CO: { dial: "57", bandera: "🇨🇴", nombre: "Colombia" },
    MX: { dial: "52", bandera: "🇲🇽", nombre: "México" },
    PE: { dial: "51", bandera: "🇵🇪", nombre: "Perú" },
    GT: { dial: "502", bandera: "🇬🇹", nombre: "Guatemala" },
    CL: { dial: "56", bandera: "🇨🇱", nombre: "Chile" },
    AR: { dial: "54", bandera: "🇦🇷", nombre: "Argentina" },
    EC: { dial: "593", bandera: "🇪🇨", nombre: "Ecuador" },
    SV: { dial: "503", bandera: "🇸🇻", nombre: "El Salvador" },
    PA: { dial: "507", bandera: "🇵🇦", nombre: "Panamá" },
    HN: { dial: "504", bandera: "🇭🇳", nombre: "Honduras" },
    NI: { dial: "505", bandera: "🇳🇮", nombre: "Nicaragua" },
    PY: { dial: "595", bandera: "🇵🇾", nombre: "Paraguay" },
    VE: { dial: "58", bandera: "🇻🇪", nombre: "Venezuela" },
    BR: { dial: "55", bandera: "🇧🇷", nombre: "Brasil" },
    US: { dial: "1", bandera: "🇺🇸", nombre: "Estados Unidos" },
    ES: { dial: "34", bandera: "🇪🇸", nombre: "España" },
  };
  const PAIS_DEFECTO = "CO";
  const RESEND_COOLDOWN_SEG = 60;

  const MARCA_LABEL: Record<string, string> = { epson: "Epson", canon: "Canon", "epson-sc": "Epson-SC" };
  const SELECCION_GLOBAL_KEY = "resetenlinea_seleccion_global_v1";
  const DESTINATARIO = { email: "info@resetenlinea.com", nombre: "Wilton Martínez Escorcia" };
  const ORIGEN = "resetenlinea-site-contacto-rapido";

  function leerPrefill(): { marca?: string; modelo?: string; error?: string } | null {
    try {
      const params = new URLSearchParams(window.location.search);
      const marcaQ = (params.get("marca") || "").toLowerCase();
      if (marcaQ) {
        return { marca: marcaQ, modelo: params.get("modelo") || "", error: params.get("error") || "" };
      }
    } catch {
      /* URL inválida: sigue al respaldo de localStorage */
    }
    try {
      const cache = JSON.parse(localStorage.getItem(SELECCION_GLOBAL_KEY) || "null");
      if (cache?.marca) return { marca: cache.marca, modelo: cache.modelo || "", error: cache.error || "" };
    } catch {
      /* localStorage no disponible o dato corrupto: sin precarga */
    }
    return null;
  }

  document.querySelectorAll<HTMLElement>("[data-contacto-form-rapido]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-cfr-form]");
    const marcaBotones = root.querySelectorAll<HTMLButtonElement>("[data-cfr-marca-boton]");
    const errorWrap = root.querySelector<HTMLElement>("[data-cfr-error-wrap]");
    const errorPaneles = root.querySelectorAll<HTMLElement>("[data-cfr-errores-panel]");
    const errorOtro = root.querySelector<HTMLInputElement>("[data-cfr-error-otro]");
    const modeloInput = root.querySelector<HTMLInputElement>("[data-cfr-modelo]");
    const nombreInput = root.querySelector<HTMLInputElement>("[data-cfr-nombre]");
    const emailInput = root.querySelector<HTMLInputElement>("[data-cfr-email]");
    const paisSelect = root.querySelector<HTMLSelectElement>("[data-cfr-pais-select]");
    const whatsappInput = root.querySelector<HTMLInputElement>("[data-cfr-whatsapp]");
    const noWhatsappCheck = root.querySelector<HTMLInputElement>("[data-cfr-no-whatsapp]");
    const whatsappRequeridoMarca = root.querySelector<HTMLElement>("[data-cfr-whatsapp-requerido]");
    const marketingCheck = root.querySelector<HTMLInputElement>("[data-cfr-marketing]");
    const honeypot = root.querySelector<HTMLInputElement>("[data-cfr-honeypot]");
    const botonEnviarCodigo = root.querySelector<HTMLButtonElement>("[data-cfr-enviar-codigo]");
    const otpWrap = root.querySelector<HTMLElement>("[data-cfr-otp-wrap]");
    const otpInfo = root.querySelector<HTMLElement>("[data-cfr-otp-info]");
    const codigoInput = root.querySelector<HTMLInputElement>("[data-cfr-codigo]");
    const botonConfirmar = root.querySelector<HTMLButtonElement>("[data-cfr-confirmar]");
    const botonReenviar = root.querySelector<HTMLButtonElement>("[data-cfr-reenviar]");
    const mensajeEl = root.querySelector<HTMLElement>("[data-cfr-mensaje]");
    if (
      !form ||
      !modeloInput ||
      !emailInput ||
      !paisSelect ||
      !whatsappInput ||
      !noWhatsappCheck ||
      !botonEnviarCodigo ||
      !otpWrap ||
      !codigoInput ||
      !botonConfirmar ||
      !botonReenviar ||
      !mensajeEl
    ) {
      return;
    }

    const endpoint = root.dataset.endpoint || "";
    const secret = root.dataset.secret || "";
    const urlOrigen = root.dataset.urlOrigen || "";
    const renderedAt = Date.now();

    let marcaActiva = "";
    let errorActivo = "";

    function mostrarMensaje(texto: string, tipo: "error" | "exito" | "" = "") {
      mensajeEl!.textContent = texto;
      mensajeEl!.dataset.tipo = tipo;
      mensajeEl!.hidden = !texto;
    }

    // ---------- País + indicativo (autodetección por IP, editable a mano) ----------
    Object.entries(DIAL_CODES).forEach(([iso, info]) => {
      const opt = document.createElement("option");
      opt.value = iso;
      opt.textContent = `${info.bandera} ${info.nombre} (+${info.dial})`;
      paisSelect.appendChild(opt);
    });
    paisSelect.value = PAIS_DEFECTO;

    fetch("/api/pais.json", { cache: "no-store" })
      .then((res) => res.json())
      .then((data: { codigo_pais?: string | null }) => {
        const iso = (data.codigo_pais || "").toUpperCase();
        if (DIAL_CODES[iso]) paisSelect.value = iso;
      })
      .catch(() => {
        /* se queda en el país de respaldo (Colombia) */
      });

    // ---------- Marca / Modelo / Error: precarga desde URL o selección global ----------
    function activarMarca(marcaId: string) {
      marcaActiva = marcaId;
      errorActivo = "";
      marcaBotones.forEach((btn) => btn.classList.toggle("cfr-boton-activo", btn.dataset.value === marcaId));
      if (errorWrap) errorWrap.hidden = !marcaId;
      errorPaneles.forEach((panel) => {
        panel.hidden = panel.dataset.cfrErroresPanel !== marcaId;
        panel.querySelectorAll<HTMLButtonElement>("[data-cfr-error-boton]").forEach((b) => b.classList.remove("cfr-boton-activo"));
      });
      if (errorOtro) {
        errorOtro.hidden = marcaId !== "epson-sc";
        if (marcaId !== "epson-sc") errorOtro.value = "";
      }
    }

    function activarError(marcaId: string, valor: string) {
      errorActivo = valor;
      const panel = root.querySelector<HTMLElement>(`[data-cfr-errores-panel="${marcaId}"]`);
      panel?.querySelectorAll<HTMLButtonElement>("[data-cfr-error-boton]").forEach((b) => {
        b.classList.toggle("cfr-boton-activo", b.dataset.value === valor);
      });
    }

    marcaBotones.forEach((btn) => {
      btn.addEventListener("click", () => activarMarca(btn.dataset.value || ""));
    });
    errorPaneles.forEach((panel) => {
      panel.querySelectorAll<HTMLButtonElement>("[data-cfr-error-boton]").forEach((btn) => {
        btn.addEventListener("click", () => {
          activarError(panel.dataset.cfrErroresPanel || "", btn.dataset.value || "");
          if (errorOtro) errorOtro.value = "";
        });
      });
    });
    errorOtro?.addEventListener("input", () => {
      errorActivo = errorOtro.value.trim();
      root.querySelectorAll<HTMLButtonElement>("[data-cfr-error-boton]").forEach((b) => b.classList.remove("cfr-boton-activo"));
    });

    const prefill = leerPrefill();
    if (prefill?.marca) {
      activarMarca(prefill.marca);
      if (prefill.modelo) modeloInput.value = prefill.modelo;
      if (prefill.error) {
        const panel = root.querySelector<HTMLElement>(`[data-cfr-errores-panel="${prefill.marca}"]`);
        const boton = panel
          ? Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-cfr-error-boton]")).find(
              (b) => (b.dataset.value || "").toLowerCase() === prefill.error!.toLowerCase()
            )
          : undefined;
        if (boton) {
          activarError(prefill.marca, boton.dataset.value || "");
        } else if (errorOtro && !errorOtro.hidden) {
          errorOtro.value = prefill.error;
          errorActivo = prefill.error;
        }
      }
    }

    // ---------- WhatsApp opcional ----------
    function actualizarRequeridoWhatsapp() {
      const requerido = !noWhatsappCheck!.checked;
      whatsappInput.required = requerido;
      whatsappInput.disabled = !requerido;
      if (whatsappRequeridoMarca) whatsappRequeridoMarca.hidden = !requerido;
      if (!requerido) whatsappInput.value = "";
    }
    noWhatsappCheck.addEventListener("change", actualizarRequeridoWhatsapp);
    actualizarRequeridoWhatsapp();

    // ---------- Armar el mensaje final (mismo formato que el resto del sitio) ----------
    function armarDatos() {
      const marcaLabel = MARCA_LABEL[marcaActiva] || marcaActiva;
      const whatsappCompleto =
        !noWhatsappCheck!.checked && whatsappInput.value.trim()
          ? `+${paisSelect.value ? DIAL_CODES[paisSelect.value]?.dial : ""} ${whatsappInput.value.trim()}`
          : "";
      return {
        marca: marcaLabel,
        modelo: modeloInput.value.trim(),
        error: errorActivo,
        nombre: nombreInput?.value.trim() || "",
        email: emailInput.value.trim(),
        whatsapp: whatsappCompleto,
        urlOrigen,
      };
    }

    const LABELS = {
      marca: "Marca",
      modelo: "Modelo",
      error: "Error",
      nombre: "Nombre",
      email: "Correo",
      whatsapp: "WhatsApp",
      paginaOrigen: "Página de origen",
    };

    // ---------- Reenvío de código: cooldown ----------
    let cooldownId: number | null = null;
    function iniciarCooldown() {
      let restante = RESEND_COOLDOWN_SEG;
      botonReenviar.disabled = true;
      const plantilla = root.dataset.textoReenviarCooldown || "";
      botonReenviar.textContent = plantilla.replace("{segundos}", String(restante));
      cooldownId = window.setInterval(() => {
        restante -= 1;
        if (restante <= 0) {
          window.clearInterval(cooldownId!);
          cooldownId = null;
          botonReenviar.disabled = false;
          botonReenviar.textContent = root.dataset.textoReenviar || "";
          return;
        }
        botonReenviar.textContent = plantilla.replace("{segundos}", String(restante));
      }, 1000);
    }

    // ---------- Paso 1: pedir código ----------
    async function pedirCodigo(): Promise<boolean> {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          secret,
          action: "enviar_codigo_verificacion",
          origen: ORIGEN,
          url_origen: urlOrigen,
          email: emailInput.value.trim(),
        }),
      });
      const data = await res.json().catch(() => null);
      return Boolean(data && data.ok);
    }

    async function manejarEnvioCodigo(event: Event) {
      event.preventDefault();
      mostrarMensaje("");

      if (honeypot && honeypot.value.trim()) return; // bot: silencioso, no delata el honeypot

      if (!emailInput.checkValidity()) {
        mostrarMensaje(root.dataset.textoErrorEmail || "", "error");
        emailInput.focus();
        return;
      }
      if (!noWhatsappCheck.checked && !whatsappInput.value.trim()) {
        mostrarMensaje(root.dataset.textoErrorWhatsapp || "", "error");
        whatsappInput.focus();
        return;
      }
      const revision = revisarContenido({ nombre: nombreInput?.value || "", modelo: modeloInput.value, errorOtro: errorOtro?.value || "" });
      if (!revision.ok) {
        mostrarMensaje(root.dataset.textoErrorContenido || "", "error");
        return;
      }

      const textoOriginal = botonEnviarCodigo.textContent;
      botonEnviarCodigo.disabled = true;
      botonEnviarCodigo.textContent = root.dataset.textoEnviando || "";

      try {
        const ok = await pedirCodigo();
        if (ok) {
          otpWrap!.hidden = false;
          if (otpInfo) otpInfo.textContent = (root.dataset.textoOtpInfo || "").replace("{email}", emailInput.value.trim());
          codigoInput.focus();
          iniciarCooldown();
        } else {
          mostrarMensaje(root.dataset.textoErrorGenerico || "", "error");
        }
      } catch {
        mostrarMensaje(root.dataset.textoErrorGenerico || "", "error");
      } finally {
        botonEnviarCodigo.disabled = false;
        botonEnviarCodigo.textContent = textoOriginal;
      }
    }

    // ---------- Paso 2: verificar código y enviar ----------
    async function manejarConfirmar() {
      mostrarMensaje("");
      const codigo = codigoInput.value.trim();
      if (!/^\d{6}$/.test(codigo)) {
        mostrarMensaje(root.dataset.textoErrorCodigo || "", "error");
        codigoInput.focus();
        return;
      }

      const datos = armarDatos();
      const asunto = construirAsunto("Contacto rápido — ResetEnLinea.com", datos);
      const mensaje = construirCuerpoMensaje(datos, LABELS);

      const textoOriginal = botonConfirmar.textContent;
      botonConfirmar.disabled = true;
      botonConfirmar.textContent = root.dataset.textoConfirmando || "";

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            secret,
            action: "verificar_codigo_y_enviar",
            origen: ORIGEN,
            url_origen: urlOrigen,
            email: datos.email,
            codigo,
            to: DESTINATARIO.email,
            to_name: DESTINATARIO.nombre,
            subject: asunto,
            message: mensaje,
            reply_email: datos.email,
            reply_name: datos.nombre,
            marketing_optin: Boolean(marketingCheck?.checked),
            website: honeypot?.value || "",
            form_rendered_at: renderedAt,
          }),
        });
        const data = await res.json().catch(() => null);
        if (data && data.ok) {
          form!.hidden = true;
          mostrarMensaje(root.dataset.textoExito || "", "exito");
        } else {
          mostrarMensaje(root.dataset.textoErrorCodigo || "", "error");
        }
      } catch {
        mostrarMensaje(root.dataset.textoErrorGenerico || "", "error");
      } finally {
        botonConfirmar.disabled = false;
        botonConfirmar.textContent = textoOriginal;
      }
    }

    async function manejarReenviar() {
      mostrarMensaje("");
      botonReenviar.disabled = true;
      const ok = await pedirCodigo().catch(() => false);
      if (ok) {
        iniciarCooldown();
      } else {
        mostrarMensaje(root.dataset.textoErrorGenerico || "", "error");
        botonReenviar.disabled = false;
      }
    }

    form.addEventListener("submit", manejarEnvioCodigo);
    botonConfirmar.addEventListener("click", manejarConfirmar);
    botonReenviar.addEventListener("click", manejarReenviar);
  });
