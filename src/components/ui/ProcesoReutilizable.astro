---
// Grid de 6 pasos ("Proceso Reutilizable") para páginas de modelo
// individual: reemplaza el grid de 4 tarjetas de ServiceFlow.astro (que
// sigue usándose tal cual en la pestaña "Nuestro servicio" de Cómo
// Funciona) con un recorrido de 6 pasos ilustrado con los íconos ya
// preparados en src/assets/procedimiento/{1..6}.png.
//
// La Tarjeta 1 es reactiva: cuando el modelo tiene varios errores
// confirmados, ProcedimientoImpresora.astro ya renderiza un <ErrorSelector>
// con un <select id={`error-select-${sourceIdBase}`}> (ver
// ErrorSelector.astro). Este componente escucha ese mismo <select> —
// construido con el mismo sourceIdBase — y actualiza el código mostrado.
// Antes de que el cliente elija algo, o si el modelo no tiene selector,
// muestra `codigoErrorInicial` (por defecto "Almohadillas").
//
// OJO: este componente asume que solo se usa en páginas de modelo Epson
// (Canon y Epson-SC tienen sus propias variantes con su propia
// terminología).
import { Image } from "astro:assets";
import { t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import icono1 from "../../assets/procedimiento/1.png";
import icono2 from "../../assets/procedimiento/2.png";
import icono3 from "../../assets/procedimiento/3.png";
import icono4 from "../../assets/procedimiento/4.png";
import icono5 from "../../assets/procedimiento/5.png";
import icono6 from "../../assets/procedimiento/6.png";

interface Props {
  locale: Locale;
  /** Requerido salvo en modo genérico (isGeneric). */
  modelo?: string;
  /** Requerido salvo en modo genérico (isGeneric) — enlaza con el <select> real. */
  sourceIdBase?: string;
  codigoErrorInicial?: string;
  /** true en páginas sin marca/modelo real (ej. "Cómo funciona"): la
   *  Tarjeta 1 deja de ser reactiva y las 6 tarjetas muestran texto neutral
   *  en vez del wording específico de Epson. */
  isGeneric?: boolean;
}

const { locale, modelo = "", sourceIdBase = "", codigoErrorInicial = "Almohadillas", isGeneric = false } = Astro.props;

const paso1Template = isGeneric ? "" : t(locale, "procesoReutilizable.paso1Titulo").replaceAll("{modelo}", modelo);
const [paso1Prefijo, paso1Sufijo] = paso1Template.split("{codigoError}");

/** En modo genérico no hay Sección 4 real que enlazar — el id/href quedan
 *  vacíos (sin ancla) en vez de armar un id con sourceIdBase="". */
const idTarjeta = (n: number) => (isGeneric ? undefined : `tarjeta-proceso-${sourceIdBase}-${n}`);
const hrefPaso = (n: number) => (isGeneric ? "#" : `#paso-${sourceIdBase}-${n}`);

const TITULOS_GENERICOS = {
  paso1: t(locale, "procesoReutilizable.paso1TituloGenerico"),
  paso3: t(locale, "procesoInstalacion.titulo"), // antes procesoReutilizable.paso3TituloGenerico (sin uso)
  paso4: t(locale, "procesoReutilizable.paso4Titulo"),
  paso5: t(locale, "procesoAutonomo.titulo"), // antes procesoReutilizable.paso5Titulo (sin uso)
  paso6: t(locale, "procesoReutilizable.paso6Titulo"),
};
---

<div class="pr" data-pr-source-id-base={sourceIdBase}>
  <span class="pr-badge">✅ {t(locale, "procesoReutilizable.badge")} 🔄</span>

  <ol class="pr-grid">
    <li class="pr-card" id={idTarjeta(1)}>
      <a class="pr-card-link" href={hrefPaso(1)}>
        <span class="pr-numero" aria-hidden="true">1</span>
        <Image src={icono1} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">
          {isGeneric ? (
            TITULOS_GENERICOS.paso1
          ) : (
            <>
              {paso1Prefijo}<span class="pr-codigo-error" data-pr-codigo>{codigoErrorInicial}</span>{paso1Sufijo}
            </>
          )}
        </p>
      </a>
    </li>

    <li class="pr-card" id={idTarjeta(2)}>
      <a class="pr-card-link" href={hrefPaso(2)}>
        <span class="pr-numero" aria-hidden="true">2</span>
        <Image src={icono2} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{t(locale, "procesoReutilizable.paso2Titulo")}</p>
      </a>
    </li>

    <li class="pr-card" id={idTarjeta(3)}>
      <a class="pr-card-link" href={hrefPaso(3)}>
        <span class="pr-numero" aria-hidden="true">3</span>
        <Image src={icono3} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{isGeneric ? TITULOS_GENERICOS.paso3 : t(locale, "procesoInstalacion.titulo")}</p>
      </a>
    </li>

    <li class="pr-card" id={idTarjeta(4)}>
      <a class="pr-card-link" href={hrefPaso(4)}>
        <span class="pr-numero" aria-hidden="true">4</span>
        <Image src={icono4} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{isGeneric ? TITULOS_GENERICOS.paso4 : t(locale, "procesoReutilizable.paso4TituloEpson")}</p>
      </a>
    </li>

    <li class="pr-card" id={idTarjeta(5)}>
      <a class="pr-card-link" href={hrefPaso(5)}>
        <span class="pr-numero" aria-hidden="true">5</span>
        <Image src={icono5} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{isGeneric ? TITULOS_GENERICOS.paso5 : t(locale, "procesoAutonomo.titulo")}</p>
      </a>
    </li>

    <li class="pr-card" id={idTarjeta(6)}>
      <a class="pr-card-link" href={hrefPaso(6)}>
        <span class="pr-numero" aria-hidden="true">6</span>
        <Image src={icono6} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{isGeneric ? TITULOS_GENERICOS.paso6 : t(locale, "procesoReutilizable.paso6Titulo")}</p>
      </a>
    </li>
  </ol>
</div>

<script>
  // Escucha el <select> de ErrorSelector.astro (mismo sourceIdBase) y
  // refleja la elección en la Tarjeta 1. Si esa página no tiene selector
  // (un solo error confirmado, o ninguno), no hace nada — la tarjeta se
  // queda con su valor inicial.
  document.querySelectorAll<HTMLElement>(".pr[data-pr-source-id-base]").forEach((container) => {
    const base = container.dataset.prSourceIdBase;
    if (!base) return;

    const select = document.getElementById(`error-select-${base}`) as HTMLSelectElement | null;
    if (!select) return;

    const codigoEl = container.querySelector<HTMLElement>("[data-pr-codigo]");
    if (!codigoEl) return;

    select.addEventListener("change", () => {
      const opcion = select.options[select.selectedIndex];
      const codigoAtributo = opcion?.getAttribute("data-codigo")?.trim();
      codigoEl.textContent = codigoAtributo ? codigoAtributo.toUpperCase() : "Almohadillas";
    });
  });
</script>

<style>
  .pr {
    display: grid;
    gap: 1rem;
  }

  .pr-badge {
    justify-self: start;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .pr-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .pr-card {
    position: relative;
    padding: 1.5rem 1.1rem 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-align: center;
    scroll-margin-top: 5rem;
    transition: border-color 0.15s ease;
  }

  .pr-card:hover {
    border-color: var(--color-primary);
  }

  .pr-card-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .pr-card-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: var(--radius-md);
  }

  .pr-numero {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .pr-imagen {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    flex: none;
  }

  .pr-card-titulo {
    margin: 0;
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .pr-codigo-error {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 780px) {
    .pr-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .pr-grid {
      grid-template-columns: 1fr;
    }

    .pr-card {
      text-align: left;
      padding: 1rem;
    }

    .pr-card-link {
      flex-direction: row;
    }

    .pr-imagen {
      width: 3.5rem;
      height: 3.5rem;
    }

    .pr-numero {
      top: 0.6rem;
      right: 0.75rem;
    }
  }
</style>
