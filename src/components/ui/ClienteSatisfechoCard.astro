---
/**
 * Tarjeta liviana para el ÍNDICE de Cliente Satisfecho: solo texto (título +
 * preview corto), nunca el HTML/iframe completo — eso solo se carga en la
 * página de detalle de cada slug, para que el índice aguante cientos/miles
 * de registros sin pesar.
 */
import { tituloClienteSatisfecho, type ClienteSatisfechoEvidencia } from "../../data/cliente-satisfecho";

interface Props {
  evidencia: ClienteSatisfechoEvidencia;
}

const { evidencia } = Astro.props;
const titulo = tituloClienteSatisfecho(evidencia);
const href = `/prueba-social/cliente-satisfecho/${evidencia.slug}/`;
---

<a class="cs-card" href={href}>
  <h3 class="cs-card-titulo">{titulo}</h3>
  <p class="cs-card-preview">{evidencia.previewTexto}</p>
</a>

<style>
  .cs-card {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .cs-card:hover {
    border-color: var(--color-primary);
  }

  .cs-card-titulo {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .cs-card-preview {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-subtle);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
