---
/**
 * Tarjeta liviana para el ÍNDICE de Cliente Satisfecho: solo el título,
 * centrado — nunca el HTML/iframe completo — eso solo se carga en la
 * página de detalle de cada slug, para que el índice aguante cientos/miles
 * de registros sin pesar.
 */
import {
  tituloClienteSatisfecho,
  slugClienteSatisfecho,
  type ClienteSatisfechoEvidencia,
} from "../../data/cliente-satisfecho";
import { buildLocalizedPath } from "../../i18n/utils";
import type { Locale } from "../../config/site";

interface Props {
  evidencia: ClienteSatisfechoEvidencia;
  locale: Locale;
}

const { evidencia, locale } = Astro.props;
const titulo = tituloClienteSatisfecho(evidencia);
const href = buildLocalizedPath(locale, `/prueba-social/cliente-satisfecho/${slugClienteSatisfecho(evidencia)}/`);
---

<a class="cs-card" href={href}>
  <h3 class="cs-card-titulo">{titulo}</h3>
</a>

<style>
  .cs-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    text-align: center;
    transition: border-color 0.15s ease;
  }

  .cs-card:hover {
    border-color: var(--color-primary);
  }

  .cs-card-titulo {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text);
  }
</style>
