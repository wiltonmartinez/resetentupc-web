---
/**
 * Embebe UNA conversación real como HTML renderizado (no imagen), aislada
 * dentro de un <iframe sandbox srcdoc> — nunca inline en el DOM del sitio,
 * así el HTML de Núcleo no puede romper el layout ni el CSS de la página,
 * y viceversa. Contenedor 9:16 fijo por fuera del iframe.
 */
interface Props {
  html: string;
  titulo: string;
}

const { html, titulo } = Astro.props;
---

<div class="cliente-satisfecho-embed">
  <iframe sandbox="allow-same-origin" srcdoc={html} title={titulo} loading="lazy" />
</div>

<style>
  .cliente-satisfecho-embed {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    background: var(--color-bg-card);
  }

  .cliente-satisfecho-embed iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>
