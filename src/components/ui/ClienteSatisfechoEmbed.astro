---
/**
 * Embebe UNA conversación real ya renderizada por Núcleo (URL externa, no
 * HTML pegado) dentro de un <iframe> — nunca inline en el DOM del sitio, así
 * el contenido de Núcleo no puede romper el layout ni el CSS de la página, y
 * viceversa. Contenedor 9:16 fijo por fuera del iframe. Sin
 * "allow-same-origin" (dominio externo real, no srcdoc) para que el sandbox
 * siga aislando de verdad.
 */
interface Props {
  url: string;
  titulo: string;
}

const { url, titulo } = Astro.props;
---

<div class="cliente-satisfecho-embed">
  <iframe src={url} sandbox="allow-scripts allow-popups" title={titulo} loading="lazy" referrerpolicy="no-referrer" />
</div>

<style>
  .cliente-satisfecho-embed {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    background: var(--color-bg-card);
  }

  .cliente-satisfecho-embed iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>
