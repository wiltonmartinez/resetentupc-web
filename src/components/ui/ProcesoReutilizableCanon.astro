---
// Variante Canon de ProcesoReutilizable.astro: misma estructura (grid 3x2
// en escritorio / 1 columna en móvil), pero con los íconos de
// src/assets/procedimiento-canon/{1..6}.png y el texto del paso 1 adaptado
// al código de error real de Canon (5B00/1700) en vez de "Almohadillas".
// Los pasos 2-6 son idénticos a la versión Epson (mismas claves i18n).
import { Image } from "astro:assets";
import { t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import icono1 from "../../assets/procedimiento-canon/1.png";
import icono2 from "../../assets/procedimiento-canon/2.png";
import icono3 from "../../assets/procedimiento-canon/3.png";
import icono4 from "../../assets/procedimiento-canon/4.png";
import icono5 from "../../assets/procedimiento-canon/5.png";
import icono6 from "../../assets/procedimiento-canon/6.png";

interface Props {
  locale: Locale;
  modelo: string;
  sourceIdBase: string;
}

const { locale, modelo, sourceIdBase } = Astro.props;

const pasos = [
  { icono: icono1, titulo: t(locale, "procesoReutilizable.paso1TituloCanon").replaceAll("{modelo}", modelo) },
  { icono: icono2, titulo: t(locale, "procesoReutilizable.paso2Titulo") },
  { icono: icono3, titulo: t(locale, "procesoInstalacion.titulo") },
  { icono: icono4, titulo: t(locale, "procesoReutilizable.paso4Titulo") },
  { icono: icono5, titulo: t(locale, "procesoAutonomo.titulo") },
  { icono: icono6, titulo: t(locale, "procesoReutilizable.paso6Titulo") },
];
---

<div class="pr">
  <span class="pr-badge">✅ {t(locale, "procesoReutilizable.badge")} 🔄</span>

  <ol class="pr-grid">
    {
      pasos.map((paso, index) => (
        <li class="pr-card" id={`tarjeta-proceso-${sourceIdBase}-${index + 1}`}>
          <a class="pr-card-link" href={`#paso-${sourceIdBase}-${index + 1}`}>
            <span class="pr-numero" aria-hidden="true">
              {index + 1}
            </span>
            <Image src={paso.icono} alt="" width={80} height={80} class="pr-imagen" />
            <p class="pr-card-titulo">{paso.titulo}</p>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .pr {
    display: grid;
    gap: 1rem;
  }

  .pr-badge {
    justify-self: start;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .pr-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .pr-card {
    position: relative;
    padding: 1.5rem 1.1rem 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-align: center;
    scroll-margin-top: 5rem;
    transition: border-color 0.15s ease;
  }

  .pr-card:hover {
    border-color: var(--color-primary);
  }

  .pr-card-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .pr-card-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: var(--radius-md);
  }

  .pr-numero {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .pr-imagen {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    flex: none;
  }

  .pr-card-titulo {
    margin: 0;
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  @media (max-width: 780px) {
    .pr-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .pr-grid {
      grid-template-columns: 1fr;
    }

    .pr-card {
      text-align: left;
      padding: 1rem;
    }

    .pr-card-link {
      flex-direction: row;
    }

    .pr-imagen {
      width: 3.5rem;
      height: 3.5rem;
    }

    .pr-numero {
      top: 0.6rem;
      right: 0.75rem;
    }
  }
</style>
