---
import { t } from "../../i18n/utils";
import modelos from "../../data/modelos-muestra.json";
import pagosData from "../../data/pagos.json";
import { TECHNICIAN_ID, USB_REDIRECTOR_DOWNLOAD_URL, type Locale } from "../../config/site";

interface Props {
  locale: Locale;
  marcaDefault?: string;
  modeloDefault?: string;
  idPrefix?: string;
}

const { locale, marcaDefault = "", modeloDefault = "", idPrefix = "cf" } = Astro.props;

const marcasUnicas = Array.from(
  modelos.reduce((map, m) => (map.has(m.marcaSlug) ? map : map.set(m.marcaSlug, m.nombreMarca)), new Map<string, string>())
)
  .map(([slug, nombre]) => ({ slug, nombre }))
  .sort((a, b) => a.nombre.localeCompare(b.nombre));

// El modelo ahora lo escribe el cliente (texto libre, no hay slug real de catálogo que
// buscar), así que el paso de "Error" ya no puede depender del modelo exacto como antes:
// se reemplaza por una lista genérica de códigos típicos por marca + "Otro" (texto libre).
const ERRORES_POR_MARCA: Record<string, string[]> = {
  epson: ["Almohadillas", "E-11"],
  canon: ["5B00", "1700"],
  "epson-sc": ["0014BD", "00080008", "00040004", "00010001", "000C0008"],
};

const marcaDefaultSlug = marcasUnicas.find((m) => m.nombre === marcaDefault)?.slug ?? "";
const id = (nombre: string) => `${idPrefix}-${nombre}`;

const PAISES = pagosData.paises.map((p) => ({ slug: p.slug, nombre: p.nombre }));
---

<form
  class="contact-form"
  id={id("form")}
  data-contact-form
  data-locale={locale}
  data-errores-por-marca={JSON.stringify(ERRORES_POR_MARCA)}
  data-pagos={JSON.stringify(pagosData.paises)}
  data-marca-default={marcaDefaultSlug}
  data-modelo-default={modeloDefault}
  data-texto-otro-error={t(locale, "contactForm.errorOtro")}
  data-texto-enviando={t(locale, "contactForm.enviando")}
  data-texto-exito={t(locale, "contactForm.exito")}
  data-texto-exito-whatsapp={t(locale, "contactForm.exitoWhatsapp")}
  data-texto-error-generico={t(locale, "contactForm.errorGenerico")}
  data-texto-error-antibot={t(locale, "contactForm.errorAntibot")}
  data-texto-error-email-invalido={t(locale, "contactForm.errorEmailInvalido")}
  data-texto-verificando-correo={t(locale, "contactForm.verificandoCorreo")}
  data-texto-error-correo-no-real={t(locale, "contactForm.errorCorreoNoReal")}
  data-texto-error-bloqueado={t(locale, "contactForm.errorBloqueado")}
  data-texto-enviar-correo={t(locale, "contactForm.enviarCorreo")}
  data-texto-whatsapp-saludo={t(locale, "contactForm.whatsappSaludo")}
  data-texto-email-ayuda={t(locale, "contactForm.emailPrimeroAyuda")}
  data-texto-mensaje-no-enviado={t(locale, "contactForm.mensajeNoEnviado")}
  data-texto-razon-insultos={t(locale, "contactForm.razonInsultos")}
  data-texto-razon-codigo={t(locale, "contactForm.razonCodigo")}
  data-texto-razon-basura={t(locale, "contactForm.razonBasura")}
  data-texto-campo-requerido={t(locale, "contactForm.campoObligatorio")}
  data-texto-garantia-verificando={t(locale, "contactForm.garantiaVerificando")}
  data-texto-garantia-vigente={t(locale, "contactForm.garantiaVigente")}
  data-texto-garantia-vencida={t(locale, "contactForm.garantiaVencida")}
  data-texto-garantia-no-encontrada={t(locale, "contactForm.garantiaNoEncontrada")}
  data-servicio-remoto-usb={t(locale, "contactForm.servicioRemotoUsb")}
  data-servicio-local-wifi={t(locale, "contactForm.servicioLocalWifi")}
  data-servicio-remoto-usb-mac={t(locale, "contactForm.servicioRemotoUsbMac")}
  data-servicio-local-usb-asistido={t(locale, "contactForm.servicioLocalUsbAsistido")}
  data-servicio-autonomo-local-usb={t(locale, "contactForm.servicioAutonomoLocalUsb")}
  data-plan-esencial={t(locale, "contactForm.planEsencial")}
  data-plan-profesional={t(locale, "contactForm.planProfesional")}
  data-plan-elite={t(locale, "contactForm.planElite")}
  data-texto-precios-no-disponibles={t(locale, "contactForm.textoPreciosNoDisponibles")}
  data-label-tipo={t(locale, "contactForm.checklistTipo")}
  data-label-garantia-dato={t(locale, "contactForm.checklistGarantiaDato")}
  data-label-cupon-ruleta={t(locale, "contactForm.checklistCupon")}
  data-label-marca={t(locale, "contactForm.marcaLabel")}
  data-label-modelo={t(locale, "contactForm.modeloLabel")}
  data-label-error={t(locale, "contactForm.checklistError")}
  data-label-so={t(locale, "contactForm.soLabel")}
  data-label-conexion={t(locale, "contactForm.checklistConexion")}
  data-label-rol={t(locale, "contactForm.checklistRol")}
  data-label-cerca={t(locale, "contactForm.checklistCerca")}
  data-label-necesita={t(locale, "contactForm.checklistNecesita")}
  data-label-pais={t(locale, "contactForm.checklistPais")}
  data-label-metodo-pago={t(locale, "contactForm.checklistMetodoPago")}
  data-label-servicio-final={t(locale, "contactForm.checklistServicioFinal")}
  data-label-modulo-descargado={t(locale, "contactForm.checklistModulo")}
  data-label-nombre={t(locale, "contactForm.nombreLabel")}
  data-label-email={t(locale, "contactForm.emailLabel")}
  data-label-whatsapp={t(locale, "contactForm.whatsappLabel")}
  data-label-nota={t(locale, "contactForm.notaLabel")}
  data-label-pagina-origen={t(locale, "contactForm.paginaOrigen")}
  data-recipient-wilton-whatsapp="573016928346"
  data-recipient-diana-whatsapp="573006279131"
>
  <div class="contact-form-topbar">
    <button type="button" class="contact-form-atras" data-atras data-sound="select" hidden>
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {t(locale, "contactForm.atras")}
    </button>
    <div class="contact-form-progreso" aria-hidden="true">
      <div class="contact-form-progreso-barra" data-progreso-barra></div>
    </div>
  </div>

  <!-- PASO: tipo de solicitud (primera pregunta del asistente) -->
  <fieldset class="contact-form-paso" data-paso="tipo">
    <legend>{t(locale, "contactForm.tipoLabel")}</legend>
    <div class="contact-form-opciones">
      <label class="contact-form-opcion contact-form-opcion-grande">
        <input type="radio" name="tipo" value={t(locale, "contactForm.tipoCotizacion")} data-tipo-valor="cotizacion" required />
        <span>💰 {t(locale, "contactForm.tipoCotizacion")}</span>
      </label>
      <label class="contact-form-opcion contact-form-opcion-grande">
        <input type="radio" name="tipo" value={t(locale, "contactForm.tipoGarantia")} data-tipo-valor="garantia" />
        <span>🛡️ {t(locale, "contactForm.tipoGarantia")}</span>
      </label>
      <label class="contact-form-opcion contact-form-opcion-grande">
        <input type="radio" name="tipo" value={t(locale, "contactForm.tipoRuleta")} data-tipo-valor="ruleta" />
        <span>🎡 {t(locale, "contactForm.tipoRuleta")}</span>
      </label>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: verificación de garantía (camino corto, solo tipo=garantia) -->
  <div class="contact-form-paso" data-paso="garantiaVerificar" hidden>
    <label for={id("garantiaDato")}>{t(locale, "contactForm.garantiaVerificarLabel")}</label>
    <input
      type="text"
      id={id("garantiaDato")}
      name="garantiaDato"
      placeholder={t(locale, "contactForm.garantiaVerificarPlaceholder")}
      data-enter-continuar
    />
    <p class="contact-form-ayuda">{t(locale, "contactForm.garantiaVerificarAyuda")}</p>
    <p class="contact-form-ayuda" data-garantia-estado></p>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.garantiaVerificarBoton")}</button>
  </div>

  <!-- PASO: marca -->
  <div class="contact-form-paso" data-paso="marca" hidden>
    <label for={id("marca")}>{t(locale, "contactForm.marcaLabel")}</label>
    <select id={id("marca")} name="marca" required data-sound="select">
      <option value="">{t(locale, "contactForm.marcaPlaceholder")}</option>
      {marcasUnicas.map((m) => (
        <option value={m.nombre} data-slug={m.slug} selected={m.slug === marcaDefaultSlug}>{m.nombre}</option>
      ))}
    </select>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: modelo (texto libre, el cliente escribe el modelo exacto) -->
  <div class="contact-form-paso" data-paso="modelo" hidden>
    <label for={id("modelo")}>{t(locale, "contactForm.modeloLabel")}</label>
    <input
      type="text"
      id={id("modelo")}
      name="modelo"
      placeholder={t(locale, "contactForm.modeloPlaceholder")}
      required
      data-enter-continuar
    />
    <p class="contact-form-ayuda">{t(locale, "contactForm.modeloAyuda")}</p>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: error (lista según la marca elegida, generada por JS + "Otro" con texto libre) -->
  <fieldset class="contact-form-paso" data-paso="error" hidden>
    <legend>{t(locale, "contactForm.errorLabel")}</legend>
    <div class="contact-form-opciones" data-error-opciones></div>
    <input
      type="text"
      name="errorOtroTexto"
      placeholder={t(locale, "contactForm.errorOtroPlaceholder")}
      data-error-otro-input
      data-enter-continuar
      hidden
    />
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: conexión (menú desplegable) -->
  <div class="contact-form-paso" data-paso="conexion" hidden>
    <label for={id("conexion")}>{t(locale, "contactForm.conexionLabel")}</label>
    <select id={id("conexion")} name="conexion" required data-sound="select">
      <option value="">{t(locale, "contactForm.seleccionaOpcion")}</option>
      <option value={t(locale, "contactForm.conexionUsb")} data-conexion-valor="usb">{t(locale, "contactForm.conexionUsb")}</option>
      <option value={t(locale, "contactForm.conexionWifi")} data-conexion-valor="wifi">{t(locale, "contactForm.conexionWifi")}</option>
      <option value={t(locale, "contactForm.conexionRed")} data-conexion-valor="red">{t(locale, "contactForm.conexionRed")}</option>
      <option value={t(locale, "contactForm.conexionCompartida")} data-conexion-valor="compartida">{t(locale, "contactForm.conexionCompartida")}</option>
    </select>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: sistema operativo -->
  <fieldset class="contact-form-paso" data-paso="so" hidden>
    <legend>{t(locale, "contactForm.soLabel")}</legend>
    <div class="contact-form-opciones contact-form-opciones-grid">
      <label class="contact-form-opcion">
        <input type="radio" name="so" value="Windows 11 / 10 / 8" data-so-valor="windows" required />
        <span>Windows 11 / 10 / 8</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="so" value="Windows 7" data-so-valor="windows" />
        <span>Windows 7</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="so" value="Windows XP" data-so-valor="windows" />
        <span>Windows XP</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="so" value={t(locale, "contactForm.soMacos")} data-so-valor="mac" />
        <span>{t(locale, "contactForm.soMacos")}</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="so" value={t(locale, "contactForm.soLinux")} data-so-valor="linux" />
        <span>{t(locale, "contactForm.soLinux")}</span>
      </label>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: quién responde -->
  <fieldset class="contact-form-paso" data-paso="rol" hidden>
    <legend>{t(locale, "contactForm.rolLabel")}</legend>
    <div class="contact-form-opciones">
      <label class="contact-form-opcion">
        <input type="radio" name="rol" value={t(locale, "contactForm.rolDueno")} required />
        <span>{t(locale, "contactForm.rolDueno")}</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="rol" value={t(locale, "contactForm.rolUsuario")} />
        <span>{t(locale, "contactForm.rolUsuario")}</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="rol" value={t(locale, "contactForm.rolTecnico")} />
        <span>{t(locale, "contactForm.rolTecnico")}</span>
      </label>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: cerca de la impresora (solo informativo) -->
  <fieldset class="contact-form-paso" data-paso="cercaImpresora" hidden>
    <legend>{t(locale, "contactForm.cercaLabel")}</legend>
    <div class="contact-form-opciones">
      <label class="contact-form-opcion">
        <input type="radio" name="cercaImpresora" value={t(locale, "contactForm.cercaSi")} required />
        <span>{t(locale, "contactForm.cercaSi")}</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="cercaImpresora" value={t(locale, "contactForm.cercaNo")} />
        <span>{t(locale, "contactForm.cercaNo")}</span>
      </label>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: qué necesita recibir (determina el servicio final) -->
  <fieldset class="contact-form-paso" data-paso="necesita" hidden>
    <legend>{t(locale, "contactForm.necesitaLabel")}</legend>
    <div class="contact-form-opciones contact-form-opciones-lista">
      <label class="contact-form-opcion contact-form-opcion-servicio">
        <input type="radio" name="necesita" value={t(locale, "contactForm.necesitaResetAsistido")} data-necesita-valor="reset-asistido" required />
        <span class="contact-form-opcion-servicio-texto">
          <span class="contact-form-opcion-servicio-nombre">
            {t(locale, "contactForm.necesitaResetAsistido")}
            <span class="contact-form-badge contact-form-badge-recomendado">{t(locale, "contactForm.necesitaResetAsistidoDetalle")}</span>
          </span>
        </span>
      </label>
      <label class="contact-form-opcion contact-form-opcion-servicio">
        <input type="radio" name="necesita" value={t(locale, "contactForm.necesitaInstalacionAsistida")} data-necesita-valor="instalacion-asistida" />
        <span class="contact-form-opcion-servicio-texto">
          <span class="contact-form-opcion-servicio-nombre">{t(locale, "contactForm.necesitaInstalacionAsistida")}</span>
          <span class="contact-form-opcion-servicio-detalle">{t(locale, "contactForm.necesitaInstalacionAsistidaDetalle")}</span>
        </span>
      </label>
      <label class="contact-form-opcion contact-form-opcion-servicio">
        <input type="radio" name="necesita" value={t(locale, "contactForm.necesitaInstalacionAutonoma")} data-necesita-valor="instalacion-autonoma" />
        <span class="contact-form-opcion-servicio-texto">
          <span class="contact-form-opcion-servicio-nombre">{t(locale, "contactForm.necesitaInstalacionAutonoma")}</span>
          <span class="contact-form-opcion-servicio-detalle">{t(locale, "contactForm.necesitaInstalacionAutonomaDetalle")}</span>
        </span>
      </label>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: servicio calculado (resultado, solo lectura) -->
  <div class="contact-form-paso" data-paso="servicioCalculado" hidden>
    <label>{t(locale, "contactForm.servicioCalculadoLabel")}</label>
    <p class="contact-form-ayuda">{t(locale, "contactForm.servicioCalculadoAyuda")}</p>
    <p class="contact-form-servicio-resultado" data-servicio-resultado></p>
    <input type="hidden" name="servicioFinal" data-servicio-final-input />
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: país (solo tipo=cotizacion, ahora fusionado con "compra") -->
  <div class="contact-form-paso" data-paso="pais" hidden>
    <label for={id("pais")}>{t(locale, "contactForm.paisLabel")}</label>
    <select id={id("pais")} name="pais" required data-sound="select">
      <option value="">{t(locale, "contactForm.paisPlaceholder")}</option>
      {PAISES.map((p) => (
        <option value={p.nombre} data-slug={p.slug}>{p.nombre}</option>
      ))}
    </select>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: método de pago (opciones generadas por JS según el país elegido) -->
  <fieldset class="contact-form-paso" data-paso="metodoPago" hidden>
    <legend>{t(locale, "contactForm.metodoPagoLabel")}</legend>
    <div class="contact-form-opciones" data-metodo-pago-opciones></div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: precio + datos del método de pago elegido (solo lectura) -->
  <div class="contact-form-paso" data-paso="preciosPago" hidden>
    <label>{t(locale, "contactForm.preciosTitulo")}</label>
    <p class="contact-form-ayuda">{t(locale, "contactForm.preciosAyuda")}</p>
    <div class="contact-form-precios" data-precios-contenido></div>
    <p class="contact-form-ayuda contact-form-aviso-compra">{t(locale, "contactForm.avisoContactoCompra")}</p>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: jugar la ruleta (solo tipo=ruleta) -->
  <div class="contact-form-paso" data-paso="ruletaJuego" hidden>
    <label>{t(locale, "contactForm.ruletaJuegoTitulo")}</label>
    <p class="contact-form-ayuda">{t(locale, "contactForm.ruletaJuegoAyuda")}</p>
    <div class="contact-form-ruleta-embed">
      <iframe data-src="https://ruleta.resetalmohadillas.com" title={t(locale, "contactForm.ruletaJuegoTitulo")} loading="lazy"></iframe>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: número de cupón obtenido en la ruleta -->
  <div class="contact-form-paso" data-paso="ruletaCupon" hidden>
    <label for={id("cuponRuleta")}>{t(locale, "contactForm.cuponLabel")}</label>
    <input
      type="text"
      id={id("cuponRuleta")}
      name="cuponRuleta"
      placeholder={t(locale, "contactForm.cuponPlaceholder")}
      required
      data-enter-continuar
    />
    <p class="contact-form-ayuda">{t(locale, "contactForm.cuponAyuda")}</p>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: nombre -->
  <div class="contact-form-paso" data-paso="nombre" hidden>
    <label for={id("nombre")}>{t(locale, "contactForm.nombreLabel")}</label>
    <input type="text" id={id("nombre")} name="nombre" autocomplete="name" data-enter-continuar />
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: conexión 1/3 — PC + WhatsApp + descargar módulo (solo si el servicio calculado es remoto por USB) -->
  <div class="contact-form-paso" data-paso="conexionPaso1" hidden>
    <label>📌 {t(locale, "contactForm.conexionTitulo")}</label>
    <p class="contact-form-conexion-paso-titulo">1️⃣ {t(locale, "contactForm.conexionPaso1Titulo")}</p>
    <p>💻 {t(locale, "contactForm.conexionPaso1Pc")}</p>
    <p>📱 {t(locale, "contactForm.conexionPaso1Whatsapp")}</p>
    <p>🔌 {t(locale, "contactForm.conexionPaso1Usb")}</p>
    <p>⬇️ {t(locale, "contactForm.conexionPaso1Descarga")}</p>
    <a class="contact-form-conexion-descarga" href={USB_REDIRECTOR_DOWNLOAD_URL} target="_blank" rel="noopener noreferrer nofollow" data-sound="select">
      ⬇️ {t(locale, "contactForm.conexionDescargarBoton")}
    </a>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: conexión 2/3 — conectarse con el Technician ID -->
  <div class="contact-form-paso" data-paso="conexionPaso2" hidden>
    <label>2️⃣ {t(locale, "contactForm.conexionPaso2Titulo")}</label>
    <p class="contact-form-ayuda">{t(locale, "contactForm.conexionPaso2Intro")}</p>
    <p>🔹 {t(locale, "contactForm.conexionPaso2TechnicianIdLabel")}<br />👉 <strong>{TECHNICIAN_ID}</strong></p>
    <p>🔹 {t(locale, "contactForm.conexionPaso2InfoLabel")}<br />👉 {t(locale, "contactForm.conexionPaso2InfoValor")}</p>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: conexión 3/3 — desconectar y reconectar el USB -->
  <div class="contact-form-paso" data-paso="conexionPaso3" hidden>
    <label>3️⃣ {t(locale, "contactForm.conexionPaso3Titulo")}</label>
    <p>🔌 {t(locale, "contactForm.conexionPaso3Desconectar")}</p>
    <p>⏳ {t(locale, "contactForm.conexionPaso3Esperar")}</p>
    <p>🔌 {t(locale, "contactForm.conexionPaso3Reconectar")}</p>
    <p class="contact-form-ayuda">📢 {t(locale, "contactForm.conexionAviso")}</p>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: confirmar cómo aparece la conexión -->
  <fieldset class="contact-form-paso" data-paso="infoAdicional" hidden>
    <legend>{t(locale, "contactForm.infoAdicionalTitulo")}</legend>
    <p class="contact-form-ayuda">{t(locale, "contactForm.moduloAyuda")}</p>
    <div class="contact-form-opciones">
      <label class="contact-form-opcion">
        <input type="radio" name="moduloDescargado" value={t(locale, "contactForm.moduloSi")} data-modulo-valor="si" required />
        <span>{t(locale, "contactForm.moduloSi")}</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="moduloDescargado" value={t(locale, "contactForm.moduloNo")} data-modulo-valor="no" />
        <span>{t(locale, "contactForm.moduloNo")}</span>
      </label>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: método de respuesta -->
  <fieldset class="contact-form-paso" data-paso="metodoRespuesta" hidden>
    <legend>{t(locale, "contactForm.canalLabel")}</legend>
    <div class="contact-form-opciones">
      <label class="contact-form-opcion contact-form-opcion-grande">
        <input type="radio" name="metodoRespuesta" value={t(locale, "contactForm.canalWhatsapp")} data-metodo-valor="whatsapp" required />
        <span>🟢 {t(locale, "contactForm.canalWhatsapp")}</span>
      </label>
      <label class="contact-form-opcion contact-form-opcion-grande">
        <input type="radio" name="metodoRespuesta" value={t(locale, "contactForm.canalCorreo")} data-metodo-valor="correo" />
        <span>✉️ {t(locale, "contactForm.canalCorreo")}</span>
      </label>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: WhatsApp -->
  <div class="contact-form-paso" data-paso="whatsappNumero" hidden>
    <label for={id("whatsapp")}>{t(locale, "contactForm.whatsappLabel")}</label>
    <input type="tel" id={id("whatsapp")} name="whatsapp" autocomplete="tel" data-telefono-input data-enter-continuar />
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: correo (siempre se pregunta, sin importar el canal preferido, para poder enviar
       siempre una copia de la solicitud al propio cliente) -->
  <div class="contact-form-paso" data-paso="correoEmail" hidden>
    <label for={id("email")}>{t(locale, "contactForm.emailLabel")}</label>
    <input type="email" id={id("email")} name="email" autocomplete="email" />
    <p class="contact-form-ayuda" data-email-estado>{t(locale, "contactForm.emailPrimeroAyuda")}</p>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </div>

  <!-- PASO: destinatario (al final del asistente, justo antes del resumen) -->
  <fieldset class="contact-form-paso" data-paso="para" hidden>
    <legend>{t(locale, "contactForm.paraLabel")}</legend>
    <div class="contact-form-opciones">
      <label class="contact-form-opcion">
        <input type="radio" name="recipient" value="wilton" checked required />
        <span>{t(locale, "contactForm.paraWilton")}</span>
      </label>
      <label class="contact-form-opcion">
        <input type="radio" name="recipient" value="diana" />
        <span>{t(locale, "contactForm.paraDiana")}</span>
      </label>
    </div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.continuar")}</button>
  </fieldset>

  <!-- PASO: resumen antes de enviar -->
  <div class="contact-form-paso" data-paso="resumen" hidden>
    <label>{t(locale, "contactForm.resumenTitulo")}</label>
    <p class="contact-form-ayuda">{t(locale, "contactForm.resumenAyuda")}</p>
    <div class="contact-form-resumen" data-resumen-contenido></div>
    <button type="button" class="contact-form-continuar" data-continuar>{t(locale, "contactForm.resumenContinuar")}</button>
  </div>

  <!-- PASO final: nota opcional + confirmación + envío -->
  <div class="contact-form-paso contact-form-paso-final" data-paso="final" hidden>
    <div>
      <label for={id("nota")}>
        {t(locale, "contactForm.notaLabel")}
        <span class="contact-form-badge">{t(locale, "contactForm.opcionalBadge")}</span>
      </label>
      <textarea id={id("nota")} name="nota" rows="3"></textarea>
    </div>

    <label class="contact-form-antibot">
      <input type="checkbox" name="antibot" required />
      {t(locale, "contactForm.antibotLabel")}
    </label>

    <!-- Honeypot: invisible para humanos, un bot que autollena formularios sí lo llena. -->
    <div class="contact-form-honeypot" aria-hidden="true">
      <label for={id("website")}>Website</label>
      <input type="text" id={id("website")} name="website" tabindex="-1" autocomplete="off" />
    </div>

    <p class="contact-form-mensaje" data-contact-form-mensaje role="status" aria-live="polite"></p>

    <div class="contact-form-acciones">
      <button type="button" class="contact-form-boton contact-form-boton-whatsapp" data-accion="whatsapp" data-sound="select" hidden>
        {t(locale, "contactForm.continuarWhatsapp")}
      </button>
      <button type="submit" class="contact-form-boton contact-form-boton-correo" data-accion="correo" data-sound="confirm" hidden>
        {t(locale, "contactForm.enviarCorreo")}
      </button>
    </div>
  </div>
</form>

<script>
  import { construirCuerpoMensaje, construirAsunto } from "../../lib/contact-message.js";
  import { revisarContenido } from "../../lib/contact-moderation.js";
  import { buildWhatsAppLink } from "../../i18n/utils";
  import { CONTACT_FORM_EMAIL_ENDPOINT, CONTACT_FORM_SECRET } from "../../config/site";
  import { playFeedback } from "../../lib/sound-manager.js";
  import { lanzarConfeti } from "../../lib/confetti.js";

  const ORIGEN = "resetenlinea-site-contacto";

  // cc_email/cc_name: pide a send-email.php que envíe una copia del mismo mensaje al propio
  // cliente (no solo al técnico). Si esa versión del PHP todavía no reconoce el campo, lo
  // ignora sin romper nada — mismo patrón defensivo que el resto de acciones nuevas del backend.

  // Debe coincidir con $DESTINATARIOS_PERMITIDOS en send-email.php. Se manda también aquí
  // (además de "recipient") para que el formulario funcione incluso mientras el servidor
  // remoto todavía no tenga subida la versión actualizada del PHP.
  const DESTINATARIOS = {
    wilton: { email: "info@resetenlinea.com", nombre: "Wilton Martínez Escorcia" },
    diana: { email: "anaidcaba@hotmail.com", nombre: "Diana Cabana Orozco" },
  };

  // Secuencia intermedia según el tipo de solicitud elegido en el primer paso ("tipo"). Todas
  // comparten los datos técnicos base (marca hasta el servicio calculado). Cotización/Compra
  // (fusionadas en una sola opción) suman después país + método de pago + precio; Ruleta suma
  // el juego de la ruleta; Garantía tiene su propio camino corto. Lo que sigue después de la
  // secuencia (instructivo de conexión si aplica, método de respuesta, contacto, "para quién
  // es" y resumen) es igual para todos — ver siguientePaso().
  const SECUENCIA_BASE = ["marca", "modelo", "error", "conexion", "so", "rol", "cercaImpresora", "necesita", "servicioCalculado"];
  const SECUENCIAS_MEDIO = {
    cotizacion: [...SECUENCIA_BASE, "pais", "metodoPago", "preciosPago", "nombre"],
    garantia: ["garantiaVerificar", "nombre"],
    ruleta: [...SECUENCIA_BASE, "nombre", "ruletaJuego", "ruletaCupon"],
  };

  // Carga perezosa de intl-tel-input (solo cuando el usuario llega al paso de WhatsApp, así no
  // afecta el peso ni la velocidad del resto del sitio).
  let cargaLibreriaTelefono = null;
  function cargarLibreriaTelefono() {
    if (cargaLibreriaTelefono) return cargaLibreriaTelefono;
    cargaLibreriaTelefono = new Promise((resolve) => {
      if (window.intlTelInput) {
        resolve();
        return;
      }
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://cdn.jsdelivr.net/npm/intl-tel-input@23.8.0/build/css/intlTelInput.css";
      document.head.appendChild(link);

      const script = document.createElement("script");
      script.src = "https://cdn.jsdelivr.net/npm/intl-tel-input@23.8.0/build/js/intlTelInputWithUtils.min.js";
      script.onload = () => resolve();
      script.onerror = () => resolve(); // si falla la CDN, el campo sigue funcionando como texto normal
      document.head.appendChild(script);
    });
    return cargaLibreriaTelefono;
  }

  function emailValido(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  document.querySelectorAll("[data-contact-form]").forEach((formEl) => {
    const form = formEl;
    form.dataset.renderedAt = String(Date.now());

    const erroresPorMarca = JSON.parse(form.dataset.erroresPorMarca || "{}");
    const pagosPorPais = JSON.parse(form.dataset.pagos || "[]");
    const paisesPorSlug = Object.fromEntries(pagosPorPais.map((p) => [p.slug, p]));
    const marcaSelect = form.querySelector('select[name="marca"]');
    const modeloInput = form.querySelector('input[name="modelo"]');
    const conexionSelect = form.querySelector('select[name="conexion"]');
    const paisSelect = form.querySelector('select[name="pais"]');
    const metodoPagoContenedor = form.querySelector("[data-metodo-pago-opciones]");
    const preciosContenido = form.querySelector("[data-precios-contenido]");
    const errorOpcionesContenedor = form.querySelector("[data-error-opciones]");
    const errorOtroInput = form.querySelector("[data-error-otro-input]");
    const servicioResultadoEl = form.querySelector("[data-servicio-resultado]");
    const resumenContenedor = form.querySelector("[data-resumen-contenido]");
    const servicioFinalInput = form.querySelector("[data-servicio-final-input]");
    const garantiaInput = form.querySelector('input[name="garantiaDato"]');
    const garantiaEstadoEl = form.querySelector("[data-garantia-estado]");
    const emailInput = form.querySelector('input[name="email"]');
    const emailEstado = form.querySelector("[data-email-estado]");
    const nombreInput = form.querySelector('input[name="nombre"]');
    const cuponInput = form.querySelector('input[name="cuponRuleta"]');
    const ruletaIframe = form.querySelector('[data-paso="ruletaJuego"] iframe');
    const mensajeEl = form.querySelector("[data-contact-form-mensaje]");
    const telefonoInput = form.querySelector("[data-telefono-input]");
    const botonCorreo = form.querySelector('[data-accion="correo"]');
    const botonWhatsapp = form.querySelector('[data-accion="whatsapp"]');
    const botonAtras = form.querySelector("[data-atras]");
    const barraProgreso = form.querySelector("[data-progreso-barra]");

    // ---------- Motor de pasos ----------
    let historial = [];
    let pasoActual = "tipo";
    let defaultsPendientes = Boolean(form.dataset.marcaDefault);
    // Se completan desde afuera (ej. un botón "Escribir por WhatsApp" en otra parte del sitio)
    // vía el listener de [data-abrir-formulario-contacto]: si ya sabemos que el usuario quiere
    // WhatsApp, o ya sabemos el error exacto que eligió, el formulario no vuelve a preguntarlo.
    let defaultsMetodoPendiente = "";
    let defaultsErrorPendiente = "";

    function elPaso(idPaso) {
      return form.querySelector(`[data-paso="${idPaso}"]`);
    }

    // Un paso oculto (saltado por la rama actual, o aún no alcanzado) nunca debe poder
    // bloquear el envío vía validación nativa del navegador: sus campos "required" se
    // desactivan mientras está oculto y se reactivan solo cuando vuelve a mostrarse.
    function desactivarRequeridos(el) {
      el?.querySelectorAll("[required]").forEach((campo) => {
        campo.dataset.requeridoOriginal = "true";
        campo.removeAttribute("required");
      });
    }

    function activarRequeridos(el) {
      el?.querySelectorAll('[data-requerido-original="true"]').forEach((campo) => {
        campo.setAttribute("required", "");
      });
    }

    form.querySelectorAll("[data-paso]").forEach((paso) => {
      if (paso.dataset.paso !== pasoActual) desactivarRequeridos(paso);
    });

    // Sonido en cada clic del asistente: botones Continuar/Atrás y cada tarjeta de opción
    // (radios/checkbox) se marcan con data-sound="select" de una sola vez acá, en vez de
    // repetir el atributo en cada fieldset del markup. Las opciones de "error" se generan
    // aparte en construirOpcionesError() y se marcan ahí mismo.
    form.querySelectorAll(".contact-form-continuar, .contact-form-opcion, .contact-form-antibot").forEach((el) => {
      if (!el.dataset.sound) el.dataset.sound = "select";
    });

    function valorRadio(nombreCampo) {
      return form.querySelector(`input[name="${nombreCampo}"]:checked`)?.value || "";
    }

    function tipoActual() {
      const radio = form.querySelector('input[name="tipo"]:checked');
      return radio ? radio.dataset.tipoValor : "";
    }

    function metodoActual() {
      const radio = form.querySelector('input[name="metodoRespuesta"]:checked');
      return radio ? radio.dataset.metodoValor : "";
    }

    function marcaSlugActual() {
      const opcion = marcaSelect?.options[marcaSelect.selectedIndex];
      return opcion ? opcion.dataset.slug || "" : "";
    }

    function paisSlugActual() {
      const opcion = paisSelect?.options[paisSelect.selectedIndex];
      return opcion ? opcion.dataset.slug || "" : "";
    }

    function paisActual() {
      return paisesPorSlug[paisSlugActual()] || null;
    }

    // Epson-SC es la única marca de formato grande (plotter) del catálogo; el resto de marcas
    // usa la tarifa normal de "impresora".
    function tipoEquipoActual() {
      return marcaSlugActual() === "epson-sc" ? "plotter" : "impresora";
    }

    // El instructivo de conexión (descargar módulo + Technician ID) solo aplica cuando el
    // servicio calculado implica de verdad una conexión remota por USB — para los demás
    // resultados (local por WiFi, o instalación de programa) no hace falta ese instructivo.
    function requiereConexionRemota() {
      const valor = servicioFinalInput?.value || "";
      return valor === form.dataset.servicioRemotoUsb || valor === form.dataset.servicioRemotoUsbMac;
    }

    function siguientePaso(actual) {
      const secuencia = SECUENCIAS_MEDIO[tipoActual()] || [];

      if (actual === "tipo") return secuencia[0] || "metodoRespuesta";

      const indice = secuencia.indexOf(actual);
      if (indice !== -1) {
        const siguienteEnSecuencia = secuencia[indice + 1];
        if (siguienteEnSecuencia) return siguienteEnSecuencia;
        return requiereConexionRemota() ? "conexionPaso1" : "metodoRespuesta";
      }

      if (actual === "conexionPaso1") return "conexionPaso2";
      if (actual === "conexionPaso2") return "conexionPaso3";
      if (actual === "conexionPaso3") return "infoAdicional";
      if (actual === "infoAdicional") return "metodoRespuesta";
      if (actual === "metodoRespuesta") return metodoActual() === "correo" ? "correoEmail" : "whatsappNumero";
      // El correo siempre se pregunta (incluso si el canal preferido es WhatsApp), para poder
      // enviar siempre una copia de la solicitud al propio cliente.
      if (actual === "whatsappNumero") return "correoEmail";
      if (actual === "correoEmail") return "para";
      if (actual === "para") return "resumen";
      if (actual === "resumen") return "final";
      return null;
    }

    function longitudTotalEstimada() {
      const secuencia = SECUENCIAS_MEDIO[tipoActual()] || SECUENCIAS_MEDIO.cotizacion;
      // tipo + secuencia + (posibles 4 pasos de conexión) + metodoRespuesta+whatsapp+correo+para+resumen+final
      return 1 + secuencia.length + 6;
    }

    function actualizarProgreso() {
      if (!barraProgreso) return;
      const porcentaje = Math.min(100, Math.round(((historial.length + 1) / longitudTotalEstimada()) * 100));
      barraProgreso.style.width = `${porcentaje}%`;
    }

    // ---------- Error: opciones generadas según la marca elegida ----------
    function construirOpcionesError() {
      if (!errorOpcionesContenedor) return;
      const codigos = erroresPorMarca[marcaSlugActual()] || [];
      errorOpcionesContenedor.innerHTML = "";
      codigos.forEach((codigo) => {
        const label = document.createElement("label");
        label.className = "contact-form-opcion";
        label.dataset.sound = "select";
        const input = document.createElement("input");
        input.type = "radio";
        input.name = "error";
        input.value = codigo;
        input.required = true;
        label.appendChild(input);
        const span = document.createElement("span");
        span.textContent = codigo;
        label.appendChild(span);
        errorOpcionesContenedor.appendChild(label);
      });
      const labelOtro = document.createElement("label");
      labelOtro.className = "contact-form-opcion";
      labelOtro.dataset.sound = "select";
      const inputOtro = document.createElement("input");
      inputOtro.type = "radio";
      inputOtro.name = "error";
      inputOtro.value = form.dataset.textoOtroError || "Otro";
      inputOtro.dataset.errorValor = "otro";
      labelOtro.appendChild(inputOtro);
      const spanOtro = document.createElement("span");
      spanOtro.textContent = form.dataset.textoOtroError || "Otro";
      labelOtro.appendChild(spanOtro);
      errorOpcionesContenedor.appendChild(labelOtro);

      if (errorOtroInput) {
        errorOtroInput.hidden = true;
        errorOtroInput.required = false;
        errorOtroInput.value = "";
      }

      errorOpcionesContenedor.querySelectorAll('input[name="error"]').forEach((radio) => {
        radio.addEventListener("change", () => {
          const esOtro = radio.dataset.errorValor === "otro";
          if (errorOtroInput) {
            errorOtroInput.hidden = !esOtro;
            errorOtroInput.required = esOtro;
          }
          if (esOtro) {
            errorOtroInput?.focus();
            return; // se espera a que escriba el error antes de avanzar
          }
          avanzar();
        });
      });
    }

    // ---------- Método de pago: opciones generadas según el país elegido ----------
    function construirOpcionesMetodoPago() {
      if (!metodoPagoContenedor) return;
      const pais = paisActual();
      metodoPagoContenedor.innerHTML = "";
      (pais?.metodosPago || []).forEach((metodo) => {
        const label = document.createElement("label");
        label.className = "contact-form-opcion";
        label.dataset.sound = "select";
        const input = document.createElement("input");
        input.type = "radio";
        input.name = "metodoPago";
        input.value = metodo.nombre;
        input.required = true;
        label.appendChild(input);
        const span = document.createElement("span");
        span.textContent = metodo.nombre;
        label.appendChild(span);
        metodoPagoContenedor.appendChild(label);
        input.addEventListener("change", avanzar);
      });
    }

    function formatoMoneda(numero, moneda) {
      return `${Number(numero).toLocaleString("es-CO")} ${moneda}`;
    }

    // ---------- Precio + datos del método de pago elegido (solo lectura) ----------
    function mostrarPreciosPago() {
      if (!preciosContenido) return;
      preciosContenido.innerHTML = "";
      const pais = paisActual();
      if (!pais) return;

      const precios = pais.precios?.[tipoEquipoActual()];
      const tabla = document.createElement("div");
      tabla.className = "contact-form-precios-tabla";
      if (precios) {
        [
          ["esencial", form.dataset.planEsencial],
          ["profesional", form.dataset.planProfesional],
          ["elite", form.dataset.planElite],
        ].forEach(([clave, etiqueta]) => {
          if (precios[clave] == null) return;
          const fila = document.createElement("div");
          fila.className = "contact-form-precios-fila";
          const nombre = document.createElement("span");
          nombre.textContent = etiqueta;
          const valor = document.createElement("strong");
          valor.textContent = formatoMoneda(precios[clave], pais.moneda);
          fila.append(nombre, valor);
          tabla.appendChild(fila);
        });
      } else {
        const aviso = document.createElement("p");
        aviso.className = "contact-form-ayuda";
        aviso.textContent = form.dataset.textoPreciosNoDisponibles;
        tabla.appendChild(aviso);
      }
      preciosContenido.appendChild(tabla);

      const metodoNombre = valorRadio("metodoPago");
      const metodo = (pais.metodosPago || []).find((m) => m.nombre === metodoNombre);
      if (metodo) {
        const bloqueMetodo = document.createElement("div");
        bloqueMetodo.className = "contact-form-precios-metodo";
        const titulo = document.createElement("strong");
        titulo.textContent = metodo.nombre;
        const detalle = document.createElement("p");
        detalle.className = "contact-form-ayuda";
        detalle.textContent = metodo.detalle;
        bloqueMetodo.append(titulo, detalle);
        preciosContenido.appendChild(bloqueMetodo);
      }

      if (pais.nota) {
        const nota = document.createElement("p");
        nota.className = "contact-form-ayuda";
        nota.textContent = pais.nota;
        preciosContenido.appendChild(nota);
      }
    }

    // ---------- Servicio calculado, según conexión + sistema operativo + qué necesita ----------
    function calcularServicioFinal() {
      const necesitaRadio = form.querySelector('input[name="necesita"]:checked');
      const necesitaValor = necesitaRadio ? necesitaRadio.dataset.necesitaValor : "";
      if (necesitaValor === "instalacion-asistida") return form.dataset.servicioLocalUsbAsistido;
      if (necesitaValor === "instalacion-autonoma") return form.dataset.servicioAutonomoLocalUsb;

      const conexionOpcion = conexionSelect?.options[conexionSelect.selectedIndex];
      const conexionValor = conexionOpcion ? conexionOpcion.dataset.conexionValor : "";
      const soRadio = form.querySelector('input[name="so"]:checked');
      const soValor = soRadio ? soRadio.dataset.soValor : "";

      if (conexionValor !== "usb") return form.dataset.servicioLocalWifi;
      if (soValor === "mac" || soValor === "linux") return form.dataset.servicioRemotoUsbMac;
      return form.dataset.servicioRemotoUsb;
    }

    function mostrarServicioCalculado() {
      const resultado = calcularServicioFinal();
      if (servicioResultadoEl) servicioResultadoEl.textContent = resultado;
      if (servicioFinalInput) servicioFinalInput.value = resultado;
    }

    // ---------- Resumen final: reutiliza el mismo checklist que arma el cuerpo del mensaje,
    // así lo que el usuario revisa acá es exactamente lo que va a recibir el técnico. ----------
    function mostrarResumen() {
      if (!resumenContenedor) return;
      const datos = datosDelFormulario();
      const labels = labelsDelFormulario();
      const texto = construirCuerpoMensaje(datos, labels);
      resumenContenedor.innerHTML = "";
      texto.split("\n").forEach((linea) => {
        if (!linea) return;
        const p = document.createElement("p");
        p.className = "contact-form-resumen-linea";
        const idx = linea.indexOf(":");
        if (idx > -1) {
          const strong = document.createElement("strong");
          strong.textContent = linea.slice(0, idx + 1);
          p.appendChild(strong);
          p.appendChild(document.createTextNode(` ${linea.slice(idx + 1).trim()}`));
        } else {
          p.textContent = linea;
        }
        resumenContenedor.appendChild(p);
      });
    }

    function prepararPaso(idPaso) {
      if (idPaso === "final") {
        const metodo = metodoActual();
        if (botonWhatsapp) botonWhatsapp.hidden = metodo === "correo";
        if (botonCorreo) botonCorreo.hidden = metodo !== "correo";
      }
    }

    function mostrarPaso(idPaso, retrocediendo = false) {
      const nuevoEl = elPaso(idPaso);
      if (!nuevoEl) return;
      prepararPaso(idPaso);
      const actualEl = elPaso(pasoActual);
      if (actualEl && actualEl !== nuevoEl) {
        actualEl.hidden = true;
        desactivarRequeridos(actualEl);
      }
      nuevoEl.hidden = false;
      activarRequeridos(nuevoEl);
      nuevoEl.classList.remove("contact-form-paso-animada");
      void nuevoEl.offsetWidth;
      nuevoEl.classList.add("contact-form-paso-animada");
      pasoActual = idPaso;
      // Los auto-saltos solo aplican avanzando: si el usuario presiona "Atrás" para revisar
      // un paso que se saltó, debe poder verlo (y seguir retrocediendo), no rebotar de nuevo
      // hacia adelante.
      if (idPaso === "error") {
        construirOpcionesError();
        if (!retrocediendo) aplicarErrorDefaultSiCorresponde();
      }
      if (idPaso === "servicioCalculado") mostrarServicioCalculado();
      if (idPaso === "metodoPago") construirOpcionesMetodoPago();
      if (idPaso === "preciosPago") mostrarPreciosPago();
      if (idPaso === "resumen") mostrarResumen();
      if (!retrocediendo) {
        if (idPaso === "marca") aplicarDefaultsSiCorresponde();
        if (idPaso === "metodoRespuesta") aplicarMetodoDefaultSiCorresponde();
      }
      if (idPaso === "ruletaJuego") cargarRuletaSiCorresponde();
      if (botonAtras) botonAtras.hidden = idPaso === "tipo";
      actualizarProgreso();
      const enfocable = nuevoEl.querySelector(
        'input:not([type="radio"]):not([type="checkbox"]):not([type="hidden"]), select, textarea'
      );
      requestAnimationFrame(() => {
        nuevoEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
        enfocable?.focus({ preventScroll: true });
      });
    }

    function avanzar() {
      const siguiente = siguientePaso(pasoActual);
      if (!siguiente) return;
      historial.push(pasoActual);
      mostrarPaso(siguiente);
    }

    function retroceder() {
      const anterior = historial.pop();
      if (!anterior) return;
      mostrarPaso(anterior, true);
    }

    botonAtras?.addEventListener("click", retroceder);

    // ---------- Grupos de radios: avanzan automáticamente al elegir una opción ----------
    ["recipient", "tipo", "so", "rol", "cercaImpresora", "necesita", "metodoRespuesta", "moduloDescargado"].forEach((nombreCampo) => {
      form.querySelectorAll(`input[name="${nombreCampo}"]`).forEach((radio) => {
        radio.addEventListener("change", avanzar);
      });
    });

    marcaSelect?.addEventListener("change", () => {
      if (marcaSelect.value) avanzar();
    });

    conexionSelect?.addEventListener("change", () => {
      if (conexionSelect.value) avanzar();
    });

    paisSelect?.addEventListener("change", () => {
      if (paisSelect.value) avanzar();
    });

    // Si el formulario ya viene con Marca/Modelo precargados (una página de modelo), no tiene
    // sentido volver a preguntarlos: se autocompletan y el flujo salta directo a "error" la
    // primera vez.
    function aplicarDefaultsSiCorresponde() {
      if (!defaultsPendientes || !marcaSelect) return;
      defaultsPendientes = false;
      const marcaDefaultSlug = form.dataset.marcaDefault || "";
      const modeloDefaultTexto = form.dataset.modeloDefault || "";
      if (!marcaDefaultSlug) return;
      if (modeloDefaultTexto && modeloInput) {
        modeloInput.value = modeloDefaultTexto;
        avanzar(); // de "marca" a "modelo"
        avanzar(); // de "modelo" a "error" (ya con ambos precargados)
      }
    }

    // Si quien abrió el formulario ya indicó el error exacto (ej. una tarjeta de error
    // específica en la página del modelo), no tiene sentido volver a preguntarlo: si coincide
    // con una de las opciones fijas se marca esa, si no, se manda a "Otro" con ese texto.
    function aplicarErrorDefaultSiCorresponde() {
      if (!defaultsErrorPendiente || !errorOpcionesContenedor) return;
      const valor = defaultsErrorPendiente;
      defaultsErrorPendiente = "";
      const opcion = Array.from(errorOpcionesContenedor.querySelectorAll('input[name="error"]')).find((r) => r.value === valor);
      if (opcion) {
        opcion.checked = true;
        avanzar();
        return;
      }
      const otroRadio = errorOpcionesContenedor.querySelector('input[data-error-valor="otro"]');
      if (otroRadio && errorOtroInput) {
        otroRadio.checked = true;
        errorOtroInput.hidden = false;
        errorOtroInput.required = true;
        errorOtroInput.value = valor;
        avanzar();
      }
    }

    // La ruleta es un sitio externo pesado (script de la rueda + confeti): no tiene sentido
    // cargarla en cada visita al formulario, solo la primera vez que se llega a este paso.
    let ruletaCargada = false;
    function cargarRuletaSiCorresponde() {
      if (ruletaCargada || !ruletaIframe || !ruletaIframe.dataset.src) return;
      ruletaCargada = true;
      ruletaIframe.src = ruletaIframe.dataset.src;
    }

    // Si quien abrió el formulario ya es un botón de WhatsApp, no tiene sentido volver a
    // preguntar el método de respuesta: ya se sabe que es WhatsApp.
    function aplicarMetodoDefaultSiCorresponde() {
      if (!defaultsMetodoPendiente) return;
      const metodo = defaultsMetodoPendiente;
      defaultsMetodoPendiente = "";
      const radio = form.querySelector(`input[name="metodoRespuesta"][data-metodo-valor="${metodo}"]`);
      if (radio) {
        radio.checked = true;
        avanzar(); // de "metodoRespuesta" a whatsappNumero/correoEmail
      }
    }

    // ---------- Verificación de garantía (no bloquea si el backend no responde o no tiene
    // desplegada esta acción todavía — mismo patrón defensivo que verificarCorreoEnServidor) ----------
    let garantiaVerificando = false;
    async function verificarGarantia() {
      if (garantiaVerificando) return;
      const valor = garantiaInput?.value.trim() || "";
      if (!valor) {
        avanzar();
        return;
      }
      garantiaVerificando = true;
      if (garantiaEstadoEl) {
        garantiaEstadoEl.textContent = form.dataset.textoGarantiaVerificando;
        garantiaEstadoEl.dataset.tipo = "";
      }
      try {
        const res = await fetch(CONTACT_FORM_EMAIL_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            secret: CONTACT_FORM_SECRET,
            origen: ORIGEN,
            action: "verificar_garantia",
            dato: valor,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (data && typeof data.vigente === "boolean" && garantiaEstadoEl) {
          garantiaEstadoEl.textContent = data.vigente ? form.dataset.textoGarantiaVigente : form.dataset.textoGarantiaVencida;
          garantiaEstadoEl.dataset.tipo = data.vigente ? "exito" : "error";
        } else if (garantiaEstadoEl) {
          // El backend todavía no tiene esta acción desplegada (o no encontró nada): no
          // bloqueamos, el técnico lo revisa manualmente con el dato que ya se envía.
          garantiaEstadoEl.textContent = form.dataset.textoGarantiaNoEncontrada;
          garantiaEstadoEl.dataset.tipo = "";
        }
      } catch {
        // Falla de red: no bloqueamos, la revisión manual la hace el técnico.
      } finally {
        garantiaVerificando = false;
        avanzar();
      }
    }

    // ---------- Campos de texto: Enter o el botón "Continuar" avanzan ----------
    function continuarDesdeCampo(inputEl) {
      const pasoEl = inputEl.closest("[data-paso]");
      if (!pasoEl) return;
      if (pasoEl.dataset.paso === "nombre" && !nombreInput.value.trim()) {
        mostrarRequerido(nombreInput);
        return;
      }
      if (pasoEl.dataset.paso === "whatsappNumero" && !telefonoInput.value.trim()) {
        mostrarRequerido(telefonoInput);
        return;
      }
      if (pasoEl.dataset.paso === "ruletaCupon" && !cuponInput.value.trim()) {
        mostrarRequerido(cuponInput);
        return;
      }
      if (pasoEl.dataset.paso === "modelo" && !modeloInput.value.trim()) {
        mostrarRequerido(modeloInput);
        return;
      }
      if (pasoEl.dataset.paso === "marca" && !marcaSelect.value) {
        mostrarRequerido(marcaSelect);
        return;
      }
      if (pasoEl.dataset.paso === "pais" && !paisSelect.value) {
        mostrarRequerido(paisSelect);
        return;
      }
      if (pasoEl.dataset.paso === "correoEmail") {
        const val = emailInput.value.trim();
        if (!val || !emailValido(val)) {
          mostrarRequerido(emailInput);
          return;
        }
        if (emailVerificado) {
          avanzar();
          return;
        }
        dispararVerificacionCorreo();
        return; // avanzar() se llama dentro, tras la verificación
      }
      if (pasoEl.dataset.paso === "metodoPago") {
        const seleccionado = form.querySelector('input[name="metodoPago"]:checked');
        if (!seleccionado) {
          const primero = pasoEl.querySelector('input[name="metodoPago"]');
          if (primero) mostrarRequerido(primero);
          return;
        }
      }
      if (pasoEl.dataset.paso === "error") {
        const seleccionado = pasoEl.querySelector('input[name="error"]:checked');
        if (!seleccionado) return;
        if (seleccionado.dataset.errorValor === "otro" && !errorOtroInput.value.trim()) {
          mostrarRequerido(errorOtroInput);
          return;
        }
      }
      if (pasoEl.dataset.paso === "garantiaVerificar") {
        verificarGarantia();
        return; // avanzar() se llama dentro, tras la respuesta (o de inmediato si está vacío)
      }
      avanzar();
    }

    function mostrarRequerido(inputEl) {
      inputEl.setCustomValidity(form.dataset.textoCampoRequerido || "Campo obligatorio");
      inputEl.reportValidity();
      inputEl.addEventListener("input", () => inputEl.setCustomValidity(""), { once: true });
    }

    form.querySelectorAll("[data-enter-continuar]").forEach((inputEl) => {
      inputEl.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          continuarDesdeCampo(inputEl);
        }
      });
    });

    form.querySelectorAll("[data-continuar]").forEach((boton) => {
      boton.addEventListener("click", () => {
        const pasoEl = boton.closest("[data-paso]");
        const campo = pasoEl?.querySelector("input:not([hidden]), textarea, select");
        if (campo) continuarDesdeCampo(campo);
        else avanzar();
      });
    });

    // ---------- Correo: verificación en vivo (misma lógica de siempre) ----------
    let emailTimer = null;
    let emailVerificacionId = 0;
    let emailBloqueado = false;
    let emailVerificado = false;

    async function verificarCorreoEnServidor(val, idVerificacion) {
      emailEstado.textContent = form.dataset.textoVerificandoCorreo;
      emailEstado.dataset.tipo = "";
      try {
        const res = await fetch(CONTACT_FORM_EMAIL_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            secret: CONTACT_FORM_SECRET,
            origen: ORIGEN,
            action: "verificar_correo",
            email: val,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (idVerificacion !== emailVerificacionId) return; // el usuario ya siguió escribiendo, esta respuesta quedó vieja

        if (data && data.ok) {
          emailVerificado = true;
          emailEstado.textContent = form.dataset.textoEmailAyuda;
          emailEstado.dataset.tipo = "";
          avanzar();
          return;
        }

        if (data && data.bloqueado) {
          emailBloqueado = true;
          emailEstado.textContent = form.dataset.textoErrorBloqueado;
          emailEstado.dataset.tipo = "error";
          if (botonCorreo) botonCorreo.disabled = true;
          if (botonWhatsapp) botonWhatsapp.disabled = true;
          return;
        }

        // Si el servidor todavía no tiene desplegada la acción "verificar_correo" (versión
        // vieja del PHP), responde con este mismo error genérico de "to" vacío. En ese caso
        // no podemos verificar de verdad — dejamos pasar en vez de arriesgarnos a bloquear
        // a alguien real por un chequeo que el servidor ni siquiera está haciendo.
        const servidorSinDesplegar = data && data.error === "Correo destino inválido" && !("bloqueado" in data);
        if (servidorSinDesplegar) {
          emailVerificado = true;
          emailEstado.textContent = form.dataset.textoEmailAyuda;
          emailEstado.dataset.tipo = "";
          avanzar();
          return;
        }

        emailEstado.textContent = form.dataset.textoErrorCorreoNoReal;
        emailEstado.dataset.tipo = "error";
      } catch {
        if (idVerificacion !== emailVerificacionId) return;
        // Si el chequeo en vivo falla por red, no bloqueamos al usuario — la validación
        // final (server-side) igual se hace al enviar.
        emailVerificado = true;
        emailEstado.textContent = form.dataset.textoEmailAyuda;
        emailEstado.dataset.tipo = "";
        avanzar();
      }
    }

    function dispararVerificacionCorreo() {
      if (emailBloqueado) return;
      const val = emailInput.value.trim();
      if (!val || !emailValido(val)) return;
      clearTimeout(emailTimer);
      emailVerificacionId++;
      verificarCorreoEnServidor(val, emailVerificacionId);
    }

    emailInput?.addEventListener("input", () => {
      if (emailBloqueado) return;
      emailVerificado = false;
      clearTimeout(emailTimer);
      emailVerificacionId++;
      const idActual = emailVerificacionId;
      const val = emailInput.value.trim();
      if (!val) {
        emailEstado.textContent = form.dataset.textoEmailAyuda;
        emailEstado.dataset.tipo = "";
        return;
      }
      if (!emailValido(val)) {
        emailEstado.textContent = form.dataset.textoErrorEmailInvalido;
        emailEstado.dataset.tipo = "error";
        return;
      }
      emailTimer = setTimeout(() => verificarCorreoEnServidor(val, idActual), 500);
    });

    emailInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        if (emailVerificado) avanzar();
        else dispararVerificacionCorreo();
      }
    });

    // ---------- Teléfono internacional (carga perezosa, solo al llegar a ese paso) ----------
    let telefonoWidget = null;
    telefonoInput?.addEventListener(
      "focus",
      async () => {
        await cargarLibreriaTelefono();
        if (window.intlTelInput) {
          telefonoWidget = window.intlTelInput(telefonoInput, {
            initialCountry: "co",
            separateDialCode: true,
          });
        }
      },
      { once: true }
    );

    function mostrarMensaje(texto, tipo) {
      if (!mensajeEl) return;
      mensajeEl.textContent = texto;
      mensajeEl.dataset.tipo = tipo || "";
    }

    function textoDeTipo() {
      const radio = form.querySelector('input[name="tipo"]:checked');
      return radio ? radio.value : "";
    }

    function datosDelFormulario() {
      const fd = new FormData(form);
      const errorSeleccionado = form.querySelector('input[name="error"]:checked');
      const errorValor = errorSeleccionado
        ? errorSeleccionado.dataset.errorValor === "otro"
          ? errorOtroInput?.value.trim() || errorSeleccionado.value
          : errorSeleccionado.value
        : "";
      return {
        recipient: fd.get("recipient") || "",
        tipo: textoDeTipo(),
        garantiaDato: fd.get("garantiaDato") || "",
        cuponRuleta: fd.get("cuponRuleta") || "",
        marca: fd.get("marca") || "",
        modelo: fd.get("modelo") || "",
        error: errorValor,
        sistemaOperativo: fd.get("so") || "",
        conexion: fd.get("conexion") || "",
        rol: fd.get("rol") || "",
        cercaImpresora: fd.get("cercaImpresora") || "",
        necesita: fd.get("necesita") || "",
        servicioFinal: fd.get("servicioFinal") || "",
        pais: fd.get("pais") || "",
        metodoPago: valorRadio("metodoPago"),
        moduloDescargado: valorRadio("moduloDescargado"),
        nombre: fd.get("nombre") || "",
        email: (fd.get("email") || "").toString().trim(),
        whatsapp: telefonoWidget ? telefonoWidget.getNumber() || fd.get("whatsapp") || "" : fd.get("whatsapp") || "",
        nota: fd.get("nota") || "",
        antibot: fd.get("antibot") === "on",
        website: (fd.get("website") || "").toString(),
      };
    }

    function labelsDelFormulario() {
      return {
        tipo: form.dataset.labelTipo,
        garantiaDato: form.dataset.labelGarantiaDato,
        cuponRuleta: form.dataset.labelCuponRuleta,
        marca: form.dataset.labelMarca,
        modelo: form.dataset.labelModelo,
        error: form.dataset.labelError,
        sistemaOperativo: form.dataset.labelSo,
        conexion: form.dataset.labelConexion,
        rol: form.dataset.labelRol,
        cercaImpresora: form.dataset.labelCerca,
        necesita: form.dataset.labelNecesita,
        servicioFinal: form.dataset.labelServicioFinal,
        pais: form.dataset.labelPais,
        metodoPago: form.dataset.labelMetodoPago,
        moduloDescargado: form.dataset.labelModuloDescargado,
        nombre: form.dataset.labelNombre,
        email: form.dataset.labelEmail,
        whatsapp: form.dataset.labelWhatsapp,
        nota: form.dataset.labelNota,
        paginaOrigen: form.dataset.labelPaginaOrigen,
      };
    }

    function razonModeracionTexto(razon) {
      if (razon === "insultos") return form.dataset.textoRazonInsultos;
      if (razon === "codigo") return form.dataset.textoRazonCodigo;
      return form.dataset.textoRazonBasura;
    }

    function validarComun(datos, requiereEmail) {
      if (!datos.antibot) {
        mostrarMensaje(form.dataset.textoErrorAntibot, "error");
        return false;
      }
      if (datos.website) {
        // Honeypot lleno: no delatamos nada, simplemente no continuamos.
        return false;
      }
      if (requiereEmail && !emailValido(datos.email)) {
        mostrarMensaje(form.dataset.textoErrorEmailInvalido, "error");
        return false;
      }
      const moderacion = revisarContenido({ nombre: datos.nombre, nota: datos.nota, garantiaDato: datos.garantiaDato });
      if (!moderacion.ok) {
        mostrarMensaje(`${form.dataset.textoMensajeNoEnviado} — ${razonModeracionTexto(moderacion.razon)}`, "error");
        return false;
      }
      return true;
    }

    async function manejarEnvioCorreo(event) {
      event.preventDefault();
      const datos = datosDelFormulario();
      if (!form.reportValidity()) return;
      if (!validarComun(datos, true)) return;

      const labels = labelsDelFormulario();
      const cuerpoDatos = { ...datos, urlOrigen: window.location.href };
      const mensaje = construirCuerpoMensaje(cuerpoDatos, labels);
      const asunto = construirAsunto(datos.tipo, datos);

      botonCorreo.disabled = true;
      botonCorreo.textContent = form.dataset.textoEnviando;
      mostrarMensaje("", "");

      try {
        const res = await fetch(CONTACT_FORM_EMAIL_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            secret: CONTACT_FORM_SECRET,
            origen: ORIGEN,
            recipient: datos.recipient,
            to: DESTINATARIOS[datos.recipient]?.email || "",
            to_name: DESTINATARIOS[datos.recipient]?.nombre || "",
            subject: asunto,
            message: mensaje,
            reply_email: datos.email,
            reply_name: datos.nombre,
            cc_email: datos.email,
            cc_name: datos.nombre,
            website: datos.website,
            form_rendered_at: Number(form.dataset.renderedAt),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (data && data.ok) {
          mostrarMensaje(form.dataset.textoExito, "exito");
          playFeedback("celebracion");
          lanzarConfeti();
          form.reset();
        } else {
          mostrarMensaje((data && data.error) || form.dataset.textoErrorGenerico, "error");
        }
      } catch {
        mostrarMensaje(form.dataset.textoErrorGenerico, "error");
      } finally {
        botonCorreo.disabled = false;
        botonCorreo.textContent = form.dataset.textoEnviarCorreo;
      }
    }

    function manejarContinuarWhatsapp() {
      const datos = datosDelFormulario();
      if (!form.reportValidity()) return;
      // El correo ahora siempre es obligatorio (se pide en todos los canales), así que aquí
      // también se exige válido — es lo que permite enviarle siempre copia al cliente.
      if (!validarComun(datos, true)) return;

      const labels = labelsDelFormulario();
      const cuerpoDatos = { ...datos, urlOrigen: window.location.href };
      const cuerpo = construirCuerpoMensaje(cuerpoDatos, labels);
      const asunto = construirAsunto(datos.tipo, datos);
      const texto = `${form.dataset.textoWhatsappSaludo}\n\n${cuerpo}`;

      const numero = datos.recipient === "diana" ? form.dataset.recipientDianaWhatsapp : form.dataset.recipientWiltonWhatsapp;
      // window.open debe llamarse sincrónicamente dentro del clic para que el navegador no lo
      // bloquee como popup — por eso el envío de la copia por correo (más abajo) va después,
      // sin esperar su respuesta.
      window.open(buildWhatsAppLink(numero, texto), "_blank", "noopener");

      mostrarMensaje(form.dataset.textoExitoWhatsapp, "exito");
      playFeedback("celebracion");
      lanzarConfeti();

      // Copia de la solicitud al correo del cliente, en segundo plano (no bloquea ni retrasa
      // la apertura de WhatsApp): mismo endpoint y patrón defensivo que el envío por correo.
      fetch(CONTACT_FORM_EMAIL_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          secret: CONTACT_FORM_SECRET,
          origen: ORIGEN,
          recipient: datos.recipient,
          to: DESTINATARIOS[datos.recipient]?.email || "",
          to_name: DESTINATARIOS[datos.recipient]?.nombre || "",
          subject: asunto,
          message: cuerpo,
          reply_email: datos.email,
          reply_name: datos.nombre,
          cc_email: datos.email,
          cc_name: datos.nombre,
          website: datos.website,
          form_rendered_at: Number(form.dataset.renderedAt),
          canal: "whatsapp",
        }),
      }).catch(() => {});
    }

    form.addEventListener("submit", manejarEnvioCorreo);
    botonWhatsapp?.addEventListener("click", manejarContinuarWhatsapp);

    // Conecta cualquier disparador externo (ej. el botón "Enviar mensaje" de las tarjetas del
    // equipo, o cualquier botón de WhatsApp del sitio) con este formulario: si vive dentro de
    // un <dialog> (botón flotante) lo abre, preselecciona destinatario/método/error según lo
    // que ya sabíamos por el botón que se pulsó, y lleva el foco al formulario — sin duplicar
    // componentes ni lógica de envío/validación, que sigue viviendo solo aquí.
    document.addEventListener("click", (event) => {
      const trigger = event.target.closest("[data-abrir-formulario-contacto]");
      if (!trigger) return;
      if (document.querySelector("[data-contact-form]") !== form) return;

      const recipient = trigger.dataset.abrirFormularioContacto;
      const dialogAncestro = form.closest("dialog");
      if (dialogAncestro && !dialogAncestro.open) dialogAncestro.showModal();

      const radio = recipient ? form.querySelector(`input[name="recipient"][value="${recipient}"]`) : null;
      if (radio) radio.checked = true;

      if (trigger.dataset.metodo) defaultsMetodoPendiente = trigger.dataset.metodo;
      if (trigger.dataset.error) defaultsErrorPendiente = trigger.dataset.error;

      // Preselecciona el "tipo" de solicitud (cotización/garantía/ruleta) y
      // avanza el asistente, para que un botón externo (ej. el hub de
      // contacto) pueda llevar directo a ese camino sin que el usuario
      // tenga que volver a elegirlo.
      if (trigger.dataset.tipo) {
        const tipoRadio = form.querySelector(`input[name="tipo"][data-tipo-valor="${trigger.dataset.tipo}"]`);
        if (tipoRadio && !tipoRadio.checked) {
          tipoRadio.checked = true;
          form.querySelector('[data-paso="tipo"] [data-continuar]')?.click();
        }
      }

      requestAnimationFrame(() => {
        form.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // Estado inicial
    actualizarProgreso();
  });
</script>

