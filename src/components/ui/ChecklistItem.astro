---
interface Props {
  tone?: "check" | "cross" | "warning";
}

const { tone = "check" } = Astro.props;
---

<div class:list={["checklist-item", `checklist-item-${tone}`]}>
  <span class="checklist-icon" aria-hidden="true">
    {
      tone === "check" ? (
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none">
          <path
            d="M4 10.5l3.5 3.5L16 6"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      ) : tone === "cross" ? (
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      ) : (
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none">
          <path
            d="M10 3.5l7.5 13h-15l7.5-13z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
          <path d="M10 8.5v3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          <circle cx="10" cy="14.2" r="0.9" fill="currentColor" />
        </svg>
      )
    }
  </span>
  <span class="checklist-text"><slot /></span>
</div>

<style>
  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .checklist-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
    margin-top: 0.1rem;
  }

  .checklist-item-check .checklist-icon {
    color: #15803d;
    background: #dcfce7;
  }

  .checklist-item-cross .checklist-icon {
    color: #b91c1c;
    background: #fee2e2;
  }

  .checklist-item-warning .checklist-icon {
    color: var(--color-warning-text);
    background: #ffedd5;
  }

  .checklist-text {
    color: var(--color-text-muted);
    padding-top: 0.15rem;
  }
</style>
