---
interface Tab {
  id: string;
  label: string;
}

interface Props {
  tabs: Tab[];
}

const { tabs } = Astro.props;
---

<div class="tabs" data-tabs>
  <div class="tabs-list" role="tablist">
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? "0" : "-1"}
          class="tabs-trigger"
          data-tab-target={tab.id}
          data-sound="select"
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <div class="tabs-panels">
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll("[data-tabs]").forEach((root) => {
    const triggers = Array.from(root.querySelectorAll("[data-tab-target]"));
    const panels = Array.from(root.querySelectorAll("[data-tab-panel]"));

    const activate = (id, focusTrigger) => {
      triggers.forEach((btn) => {
        const active = btn.getAttribute("data-tab-target") === id;
        btn.setAttribute("aria-selected", String(active));
        btn.setAttribute("tabindex", active ? "0" : "-1");
        if (active && focusTrigger) btn.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-tab-panel") !== id;
      });
    };

    triggers.forEach((btn, index) => {
      btn.addEventListener("click", () => activate(btn.getAttribute("data-tab-target"), false));
      btn.addEventListener("keydown", (event) => {
        let next = null;
        if (event.key === "ArrowRight") next = triggers[(index + 1) % triggers.length];
        if (event.key === "ArrowLeft") next = triggers[(index - 1 + triggers.length) % triggers.length];
        if (next) {
          event.preventDefault();
          activate(next.getAttribute("data-tab-target"), true);
        }
      });
    });
  });
</script>

<style>
  .tabs-list {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .tabs-trigger {
    appearance: none;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.65rem 0.25rem;
    margin-bottom: -1px;
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-subtle);
    cursor: pointer;
  }

  .tabs-trigger[aria-selected="true"] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .tabs-trigger:hover {
    color: var(--color-text);
  }

  .tabs-trigger[aria-selected="true"]:hover {
    color: var(--color-primary);
  }
</style>
