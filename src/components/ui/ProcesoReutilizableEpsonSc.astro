---
// Variante Epson-SC (formato ancho) de ProcesoReutilizable.astro: misma
// estructura (grid 3x2 en escritorio / 1 columna en móvil), con los
// íconos de src/assets/procedimiento-epson-sc/{1..6}.png.
//
// La Tarjeta 1 es reactiva: cuando el modelo tiene varios errores
// confirmados, ModeloPage.astro ya renderiza un <ErrorSelector> con un
// <select id={`error-select-${sourceIdBase}`}> (ver ErrorSelector.astro).
// Este componente escucha ese mismo <select> por su id — construido con el
// mismo sourceIdBase — y actualiza el código de error mostrado en la
// Tarjeta 1 cada vez que el cliente cambia su selección. Antes de que el
// cliente elija algo, o si el modelo no tiene selector (un solo error
// confirmado, o ninguno), se muestra "Almohadillas" como valor genérico.
import { Image } from "astro:assets";
import { t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import icono1 from "../../assets/procedimiento-epson-sc/1.png";
import icono2 from "../../assets/procedimiento-epson-sc/2.png";
import icono3 from "../../assets/procedimiento-epson-sc/3.png";
import icono4 from "../../assets/procedimiento-epson-sc/4.png";
import icono5 from "../../assets/procedimiento-epson-sc/5.png";
import icono6 from "../../assets/procedimiento-epson-sc/6.png";

interface Props {
  locale: Locale;
  modelo: string;
  sourceIdBase: string;
  codigoErrorInicial?: string;
}

const { locale, modelo, sourceIdBase, codigoErrorInicial = "Almohadillas" } = Astro.props;

const paso1Template = t(locale, "procesoReutilizable.paso1TituloEpsonSc").replaceAll("{modelo}", modelo);
const [paso1Prefijo, paso1Sufijo] = paso1Template.split("{codigoError}");

const pasosResto = [
  { icono: icono2, titulo: t(locale, "procesoReutilizable.paso2Titulo") },
  { icono: icono3, titulo: t(locale, "procesoReutilizable.paso3Titulo") },
  { icono: icono4, titulo: t(locale, "procesoReutilizable.paso4Titulo") },
  { icono: icono5, titulo: t(locale, "procesoReutilizable.paso5TituloEpsonSc") },
  { icono: icono6, titulo: t(locale, "procesoReutilizable.paso6Titulo") },
];
---

<div class="pr">
  <span class="pr-badge">✅ {t(locale, "procesoReutilizable.badge")} 🔄</span>

  <ol class="pr-grid">
    <li class="pr-card">
      <span class="pr-numero" aria-hidden="true">1</span>
      <Image src={icono1} alt="" width={80} height={80} class="pr-imagen" />
      <p class="pr-card-titulo" data-pr-source-id-base={sourceIdBase}>
        {paso1Prefijo}<span class="pr-codigo-error" data-pr-codigo>{codigoErrorInicial}</span>{paso1Sufijo}
      </p>
    </li>
    {
      pasosResto.map((paso, index) => (
        <li class="pr-card">
          <span class="pr-numero" aria-hidden="true">
            {index + 2}
          </span>
          <Image src={paso.icono} alt="" width={80} height={80} class="pr-imagen" />
          <p class="pr-card-titulo">{paso.titulo}</p>
        </li>
      ))
    }
  </ol>
</div>

<script>
  // Escucha el <select> de ErrorSelector.astro (mismo sourceIdBase) y
  // refleja el código elegido en la Tarjeta 1. Si esa página no tiene
  // selector (un solo error confirmado, o ninguno), no hace nada — la
  // tarjeta se queda con su valor inicial ("Almohadillas" por defecto).
  document.querySelectorAll<HTMLElement>("[data-pr-source-id-base]").forEach((titulo) => {
    const base = titulo.dataset.prSourceIdBase;
    const codigoEl = titulo.querySelector<HTMLElement>("[data-pr-codigo]");
    if (!base || !codigoEl) return;

    const select = document.getElementById(`error-select-${base}`) as HTMLSelectElement | null;
    if (!select) return;

    select.addEventListener("change", () => {
      const valor = select.value || "";
      const codigo = valor.replace(/^epson-sc-/i, "").toUpperCase();
      codigoEl.textContent = codigo || "Almohadillas";
    });
  });
</script>

<style>
  .pr {
    display: grid;
    gap: 1rem;
  }

  .pr-badge {
    justify-self: start;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .pr-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .pr-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.5rem 1.1rem 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .pr-numero {
    position: absolute;
    top: 0.85rem;
    right: 0.95rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-subtle);
  }

  .pr-imagen {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    flex: none;
  }

  .pr-card-titulo {
    margin: 0;
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .pr-codigo-error {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 780px) {
    .pr-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .pr-grid {
      grid-template-columns: 1fr;
    }

    .pr-card {
      flex-direction: row;
      text-align: left;
      padding: 1rem;
    }

    .pr-imagen {
      width: 3.5rem;
      height: 3.5rem;
    }

    .pr-numero {
      top: 0.6rem;
      right: 0.75rem;
    }
  }
</style>
