---
// Variante Epson-SC (formato ancho) de ProcesoReutilizable.astro: misma
// estructura (grid 3x2 en escritorio / 1 columna en móvil), con los
// íconos de src/assets/procedimiento-epson-sc/{1..6}.png.
//
// Las Tarjetas 1 y 5 son reactivas: cuando el modelo tiene varios errores
// confirmados, ModeloPage.astro ya renderiza un <ErrorSelector> con un
// <select id={`error-select-${sourceIdBase}`}> (ver ErrorSelector.astro).
// Este componente escucha ese mismo <select> por su id — construido con el
// mismo sourceIdBase — y:
//   - actualiza el código de error mostrado en la Tarjeta 1.
//   - cambia el texto de la Tarjeta 5 según si el código elegido es 0014BD
//     (requiere cambiar almohadillas + limpiar sensor) o cualquier otro
//     (reset estándar en modo reparación).
// Antes de que el cliente elija algo, o si el modelo no tiene selector (un
// solo error confirmado, o ninguno), la Tarjeta 1 muestra "Almohadillas" y
// la Tarjeta 5 muestra el texto genérico de reset estándar.
import { Image } from "astro:assets";
import { t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import icono1 from "../../assets/procedimiento-epson-sc/1.png";
import icono2 from "../../assets/procedimiento-epson-sc/2.png";
import icono3 from "../../assets/procedimiento-epson-sc/3.png";
import icono4 from "../../assets/procedimiento-epson-sc/4.png";
import icono5 from "../../assets/procedimiento-epson-sc/5.png";
import icono6 from "../../assets/procedimiento-epson-sc/6.png";

interface Props {
  locale: Locale;
  modelo: string;
  sourceIdBase: string;
  codigoErrorInicial?: string;
}

const { locale, modelo, sourceIdBase, codigoErrorInicial = "Almohadillas" } = Astro.props;

const paso1Template = t(locale, "procesoReutilizable.paso1TituloEpsonSc").replaceAll("{modelo}", modelo);
const [paso1Prefijo, paso1Sufijo] = paso1Template.split("{codigoError}");

const paso5TituloDefault = t(locale, "procesoReutilizable.paso5TituloEpsonSc");
const paso5Titulo0014bd = t(locale, "procesoReutilizable.paso5TituloEpsonSc0014bd");
---

<div class="pr" data-pr-source-id-base={sourceIdBase}>
  <span class="pr-badge">✅ {t(locale, "procesoReutilizable.badge")} 🔄</span>

  <ol class="pr-grid">
    <li class="pr-card" id={`tarjeta-proceso-${sourceIdBase}-1`}>
      <a class="pr-card-link" href={`#paso-${sourceIdBase}-1`}>
        <span class="pr-numero" aria-hidden="true">1</span>
        <Image src={icono1} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">
          {paso1Prefijo}<span class="pr-codigo-error" data-pr-codigo>{codigoErrorInicial}</span>{paso1Sufijo}
        </p>
      </a>
    </li>

    <li class="pr-card" id={`tarjeta-proceso-${sourceIdBase}-2`}>
      <a class="pr-card-link" href={`#paso-${sourceIdBase}-2`}>
        <span class="pr-numero" aria-hidden="true">2</span>
        <Image src={icono2} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{t(locale, "procesoReutilizable.paso2Titulo")}</p>
      </a>
    </li>

    <li class="pr-card" id={`tarjeta-proceso-${sourceIdBase}-3`}>
      <a class="pr-card-link" href={`#paso-${sourceIdBase}-3`}>
        <span class="pr-numero" aria-hidden="true">3</span>
        <Image src={icono3} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{t(locale, "procesoInstalacion.titulo")}</p>
      </a>
    </li>

    <li class="pr-card" id={`tarjeta-proceso-${sourceIdBase}-4`}>
      <a class="pr-card-link" href={`#paso-${sourceIdBase}-4`}>
        <span class="pr-numero" aria-hidden="true">4</span>
        <Image src={icono4} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{t(locale, "procesoReutilizable.paso4Titulo")}</p>
      </a>
    </li>

    <li class="pr-card" id={`tarjeta-proceso-${sourceIdBase}-5`}>
      <a class="pr-card-link" href={`#paso-${sourceIdBase}-5`}>
        <span class="pr-numero" aria-hidden="true">5</span>
        <Image src={icono5} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">
          <span data-pr-paso5 data-pr-paso5-default={paso5TituloDefault} data-pr-paso5-sensor={paso5Titulo0014bd}>
            {paso5TituloDefault}
          </span>
        </p>
      </a>
    </li>

    <li class="pr-card" id={`tarjeta-proceso-${sourceIdBase}-6`}>
      <a class="pr-card-link" href={`#paso-${sourceIdBase}-6`}>
        <span class="pr-numero" aria-hidden="true">6</span>
        <Image src={icono6} alt="" width={80} height={80} class="pr-imagen" />
        <p class="pr-card-titulo">{t(locale, "procesoReutilizable.paso6Titulo")}</p>
      </a>
    </li>
  </ol>
</div>

<script>
  // Escucha el <select> de ErrorSelector.astro (mismo sourceIdBase) y
  // refleja la elección en las Tarjetas 1 y 5. Si esa página no tiene
  // selector (un solo error confirmado, o ninguno), no hace nada — las
  // tarjetas se quedan con su valor inicial (genérico).
  document.querySelectorAll<HTMLElement>(".pr[data-pr-source-id-base]").forEach((container) => {
    const base = container.dataset.prSourceIdBase;
    if (!base) return;

    const select = document.getElementById(`error-select-${base}`) as HTMLSelectElement | null;
    if (!select) return;

    const codigoEl = container.querySelector<HTMLElement>("[data-pr-codigo]");
    const paso5El = container.querySelector<HTMLElement>("[data-pr-paso5]");

    select.addEventListener("change", () => {
      const valor = select.value || "";
      const es0014bd = /^epson-sc-0014bd$/i.test(valor);

      if (codigoEl) {
        const codigo = valor.replace(/^epson-sc-/i, "").toUpperCase();
        codigoEl.textContent = codigo || "Almohadillas";
      }

      if (paso5El) {
        const texto = es0014bd ? paso5El.dataset.prPaso5Sensor : paso5El.dataset.prPaso5Default;
        if (texto) paso5El.textContent = texto;
      }
    });
  });
</script>

<style>
  .pr {
    display: grid;
    gap: 1rem;
  }

  .pr-badge {
    justify-self: start;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .pr-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .pr-card {
    position: relative;
    padding: 1.5rem 1.1rem 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-align: center;
    scroll-margin-top: 5rem;
    transition: border-color 0.15s ease;
  }

  .pr-card:hover {
    border-color: var(--color-primary);
  }

  .pr-card-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .pr-card-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: var(--radius-md);
  }

  .pr-numero {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .pr-imagen {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    flex: none;
  }

  .pr-card-titulo {
    margin: 0;
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .pr-codigo-error {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 780px) {
    .pr-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .pr-grid {
      grid-template-columns: 1fr;
    }

    .pr-card {
      text-align: left;
      padding: 1rem;
    }

    .pr-card-link {
      flex-direction: row;
    }

    .pr-imagen {
      width: 3.5rem;
      height: 3.5rem;
    }

    .pr-numero {
      top: 0.6rem;
      right: 0.75rem;
    }
  }
</style>
