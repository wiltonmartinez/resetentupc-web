---
interface FaqItem {
  pregunta: string;
  respuesta: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-accordion">
  {
    items.map((item) => (
      <details class="faq-item" data-sound="toggle">
        <summary>
          <span>{item.pregunta}</span>
          <svg class="faq-chevron" viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
            <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <p>{item.respuesta}</p>
      </details>
    ))
  }
</div>

<style>
  .faq-accordion {
    display: grid;
    gap: 0.6rem;
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    padding: 0.9rem 1rem;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    flex: none;
    transition: transform 0.2s ease;
    color: var(--color-text-subtle);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-item p {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
  }
</style>
