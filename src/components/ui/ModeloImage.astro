---
import { Image } from "astro:assets";
import { getModeloImage } from "../../lib/model-images.js";

interface Props {
  modeloSlug: string;
  nombreMarca: string;
  nombreModelo: string;
  eager?: boolean;
  variant?: "compact" | "cover";
}

const { modeloSlug, nombreMarca, nombreModelo, eager = false, variant = "compact" } = Astro.props;
const imagen = getModeloImage(modeloSlug);
const alt = `Impresora ${nombreMarca} ${nombreModelo}`;
---

<div class={`modelo-image modelo-image-${variant}`}>
  {
    imagen ? (
      <Image
        src={imagen}
        alt={alt}
        width={imagen.width}
        height={imagen.height}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
      />
    ) : (
      <div class="modelo-image-fallback" role="img" aria-label={alt}>
        <svg viewBox="0 0 64 64" width="60%" height="60%" fill="none" aria-hidden="true">
          <rect x="12" y="24" width="40" height="20" rx="2" stroke="currentColor" stroke-width="2.5" />
          <path d="M18 24v-9a3 3 0 013-3h22a3 3 0 013 3v9" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
          <rect x="20" y="40" width="24" height="14" rx="1.5" stroke="currentColor" stroke-width="2.5" />
          <circle cx="44" cy="30" r="1.8" fill="currentColor" />
        </svg>
      </div>
    )
  }
</div>

<style>
  .modelo-image {
    width: 96px;
    height: 96px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .modelo-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.4rem;
  }

  .modelo-image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-subtle);
  }

  @media (min-width: 640px) {
    .modelo-image-compact {
      width: 152px;
      height: 152px;
    }
  }

  .modelo-image-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border: none;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
  }

  .modelo-image-cover :global(img) {
    padding: 0.75rem;
  }

  .modelo-image-cover .modelo-image-fallback svg {
    width: 40%;
    height: 40%;
  }
</style>
