---
/**
 * Demostración real: muestra un certificado de garantía de ejemplo elegido al
 * azar en el navegador en cada carga/recarga (F5): un PDF censurado en visor
 * embebido, o una imagen censurada subida en el admin de Núcleo.
 *
 * Privacidad: NO se censura nada por código/CSS. Núcleo entrega solo material
 * ya censurado (nombre, correo, número de pedido y QR); este componente solo
 * lo muestra.
 *
 * Fuente: GET {NUCLEO_API_BASE_URL}/api/public/certificados-ejemplo/
 *   -> { "imagenes": [ { "url": "https://.../x.pdf|.webp", "alt": "..." } ] }
 * Núcleo agrega a esa lista, tras las imágenes activas, los PDF censurados de
 * las copias publicadas en Pedidos Públicos. Los PDF NO se enmarcan (Núcleo
 * rechaza iframe/navegación directa): se bajan con fetch y se dibujan en
 * <canvas> con pdf.js, para que no haya visor con "guardar como"/imprimir.
 * Lista vacía o fetch fallido: sección oculta.
 */
import { t } from "../../i18n/utils";
import { NUCLEO_API_BASE_URL, type Locale } from "../../config/site";

interface Props {
  locale: Locale;
  /** Nivel del encabezado: 2 en la página propia de Consulta de Garantía; 4
   *  cuando va DENTRO de un paso (Cómo funciona / páginas de modelo), cuyo
   *  título ya es un h3 — así no se salta un nivel en el esquema del documento. */
  nivelTitulo?: 2 | 4;
}

const { locale, nivelTitulo = 2 } = Astro.props;
const Encabezado = nivelTitulo === 4 ? "h4" : "h2";
const API_URL = `${NUCLEO_API_BASE_URL}/api/public/certificados-ejemplo/`;
---

<section class="certificado-ejemplo" data-certificado-ejemplo data-api-url={API_URL} hidden>
  <Encabezado class="certificado-ejemplo-titulo">{t(locale, "consultaGarantiaPage.ejemploTitulo")}</Encabezado>
  <p>{t(locale, "consultaGarantiaPage.ejemploTexto")}</p>
  <div class="certificado-ejemplo-visor" data-certificado-visor></div>
</section>

<script>
  interface ItemCertificado {
    url?: string;
    alt?: string;
  }

  // pdf.js (build 3.11 "min", servida desde /pdfjs/, mismo origen: cumple la CSP
  // sin abrir script-src ni worker-src). Se carga solo si hay un PDF que mostrar.
  let pdfjsPromesa: Promise<any> | null = null;
  function cargarPdfJs(): Promise<any> {
    pdfjsPromesa ??= new Promise((ok, fallo) => {
      const w = window as any;
      if (w.pdfjsLib) return ok(w.pdfjsLib);
      const s = document.createElement("script");
      s.src = "/pdfjs/pdf.min.js";
      s.onload = () => {
        w.pdfjsLib.GlobalWorkerOptions.workerSrc = "/pdfjs/pdf.worker.min.js";
        ok(w.pdfjsLib);
      };
      s.onerror = () => fallo(new Error("pdf.js"));
      document.head.appendChild(s);
    });
    return pdfjsPromesa;
  }

  document.querySelectorAll<HTMLElement>("[data-certificado-ejemplo]").forEach(async (seccion) => {
    const visor = seccion.querySelector<HTMLElement>("[data-certificado-visor]");
    const apiUrl = seccion.dataset.apiUrl;
    if (!visor || !apiUrl) return;

    // Sin menú contextual (guardar imagen como…), sin arrastrar ni copiar.
    // Freno de uso normal: una captura de pantalla no se puede impedir.
    for (const evento of ["contextmenu", "dragstart", "selectstart", "copy", "cut"]) {
      seccion.addEventListener(evento, (e) => e.preventDefault());
    }

    try {
      const res = await fetch(apiUrl, { cache: "no-store" });
      if (!res.ok) return;
      const data: { imagenes?: ItemCertificado[] } = await res.json();
      const lista = (data.imagenes || []).filter(
        (i) => typeof i.url === "string" && i.url.startsWith("https://")
      );
      if (lista.length === 0) return;

      // Azar que SIEMPRE cambia al recargar: con pocos certificados el azar
      // puro repite el mismo a menudo y parece que F5 no hace nada, así que se
      // excluye el último mostrado en esta pestaña (si hay más de uno).
      const CLAVE_ULTIMO = "certificado-ejemplo-ultimo";
      let ultimo = "";
      try {
        ultimo = sessionStorage.getItem(CLAVE_ULTIMO) || "";
      } catch {
        /* sin sessionStorage: cae al azar puro */
      }
      const candidatos = lista.length > 1 ? lista.filter((i) => i.url !== ultimo) : lista;
      const elegido = candidatos[Math.floor(Math.random() * candidatos.length)];
      try {
        sessionStorage.setItem(CLAVE_ULTIMO, elegido.url as string);
      } catch {
        /* idem */
      }
      const url = elegido.url as string;
      const alt = elegido.alt || seccion.querySelector(".certificado-ejemplo-titulo")?.textContent || "";
      const esPdf = new URL(url).pathname.toLowerCase().endsWith(".pdf");

      if (esPdf) {
        // Se dibuja en <canvas> con pdf.js en vez de un <iframe>/<embed>: así
        // no aparece el visor del navegador con sus botones de guardar,
        // "guardar como" e imprimir. Si algo falla, la sección queda oculta.
        try {
          const pdfjs = await cargarPdfJs();
          const respuesta = await fetch(url, { cache: "no-store" });
          if (!respuesta.ok) return;
          const pdf = await pdfjs.getDocument({ data: await respuesta.arrayBuffer(), isEvalSupported: false }).promise;
          const ancho = Math.min(visor.clientWidth || 820, 820);
          for (let n = 1; n <= pdf.numPages; n++) {
            const pagina = await pdf.getPage(n);
            const base = pagina.getViewport({ scale: 1 });
            const nitidez = Math.min(window.devicePixelRatio || 1, 2) * (ancho / base.width);
            const vista = pagina.getViewport({ scale: nitidez });
            const lienzo = document.createElement("canvas");
            lienzo.className = "certificado-ejemplo-pagina";
            lienzo.width = Math.floor(vista.width);
            lienzo.height = Math.floor(vista.height);
            lienzo.setAttribute("role", "img");
            lienzo.setAttribute("aria-label", alt);
            await pagina.render({ canvasContext: lienzo.getContext("2d"), viewport: vista }).promise;
            visor.appendChild(lienzo);
          }
          seccion.hidden = false;
        } catch {
          visor.replaceChildren();
        }
      } else {
        const img = document.createElement("img");
        img.className = "certificado-ejemplo-img";
        img.alt = alt;
        img.decoding = "async";
        img.draggable = false;
        img.addEventListener("load", () => {
          seccion.hidden = false;
        });
        img.addEventListener("error", () => {
          seccion.hidden = true;
        });
        visor.appendChild(img);
        img.src = url;
      }
    } catch {
      /* sin red o CORS: la sección simplemente no se muestra. */
    }
  });
</script>

<style is:global>
  /* is:global: el visor se llena con createElement en el cliente, nodos que
     nunca reciben el atributo de scope de Astro. Clases específicas de este
     componente, sin riesgo de colisión. */
  .certificado-ejemplo {
    display: grid;
    gap: var(--space-sm);
    justify-items: center;
    text-align: center;
    padding: var(--space-md);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .certificado-ejemplo[hidden] {
    display: none;
  }

  .certificado-ejemplo-titulo {
    margin: 0;
    font-size: 1.15rem;
  }

  .certificado-ejemplo p {
    margin: 0;
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .certificado-ejemplo-visor {
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .certificado-ejemplo-img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.22));
  }

  .certificado-ejemplo-visor {
    gap: var(--space-sm);
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .certificado-ejemplo-pagina {
    display: block;
    width: 100%;
    max-width: 820px;
    height: auto;
    border-radius: var(--radius-sm);
    background: #ffffff;
    box-shadow: 0 6px 14px rgb(0 0 0 / 0.22);
    -webkit-user-drag: none;
  }

  .certificado-ejemplo-img {
    -webkit-user-drag: none;
  }

  /* Imprimir (o "guardar como PDF" desde imprimir) no incluye el certificado. */
  @media print {
    .certificado-ejemplo {
      display: none !important;
    }
  }
</style>
