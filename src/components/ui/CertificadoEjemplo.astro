---
/**
 * Demostración real: muestra un certificado de garantía de ejemplo elegido al
 * azar en el navegador en cada carga/recarga (F5): un PDF censurado en visor
 * embebido, o una imagen censurada subida en el admin de Núcleo.
 *
 * Privacidad: NO se censura nada por código/CSS. Núcleo entrega solo material
 * ya censurado (nombre, correo, número de pedido y QR); este componente solo
 * lo muestra.
 *
 * Fuente: GET {NUCLEO_API_BASE_URL}/api/public/certificados-ejemplo/
 *   -> { "imagenes": [ { "url": "https://.../x.pdf|.webp", "alt": "..." } ] }
 * Núcleo agrega a esa lista, tras las imágenes activas, los PDF censurados de
 * las copias publicadas en Pedidos Públicos. Un PDF solo se puede ENMARCAR
 * desde resetenlinea.com (CSP frame-src ya permite Núcleo; object-src es
 * 'none', por eso <iframe>). Lista vacía o fetch fallido: sección oculta.
 */
import { t } from "../../i18n/utils";
import { NUCLEO_API_BASE_URL, type Locale } from "../../config/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const API_URL = `${NUCLEO_API_BASE_URL}/api/public/certificados-ejemplo/`;
---

<section class="certificado-ejemplo" data-certificado-ejemplo data-api-url={API_URL} hidden>
  <h2>{t(locale, "consultaGarantiaPage.ejemploTitulo")}</h2>
  <p>{t(locale, "consultaGarantiaPage.ejemploTexto")}</p>
  <div class="certificado-ejemplo-visor" data-certificado-visor></div>
</section>

<script>
  interface ItemCertificado {
    url?: string;
    alt?: string;
  }

  // APAGADO DE EMERGENCIA (2026-09-24): Núcleo estaba sirviendo un certificado
  // con datos reales de un cliente sin censurar. Volver a false solo cuando
  // Núcleo confirme que TODO lo que publica está censurado.
  const VISOR_DESACTIVADO = true;

  document.querySelectorAll<HTMLElement>("[data-certificado-ejemplo]").forEach(async (seccion) => {
    if (VISOR_DESACTIVADO) return;
    const visor = seccion.querySelector<HTMLElement>("[data-certificado-visor]");
    const apiUrl = seccion.dataset.apiUrl;
    if (!visor || !apiUrl) return;

    try {
      const res = await fetch(apiUrl, { cache: "no-store" });
      if (!res.ok) return;
      const data: { imagenes?: ItemCertificado[] } = await res.json();
      const lista = (data.imagenes || []).filter(
        (i) => typeof i.url === "string" && i.url.startsWith("https://")
      );
      if (lista.length === 0) return;

      // Azar que SIEMPRE cambia al recargar: con pocos certificados el azar
      // puro repite el mismo a menudo y parece que F5 no hace nada, así que se
      // excluye el último mostrado en esta pestaña (si hay más de uno).
      const CLAVE_ULTIMO = "certificado-ejemplo-ultimo";
      let ultimo = "";
      try {
        ultimo = sessionStorage.getItem(CLAVE_ULTIMO) || "";
      } catch {
        /* sin sessionStorage: cae al azar puro */
      }
      const candidatos = lista.length > 1 ? lista.filter((i) => i.url !== ultimo) : lista;
      const elegido = candidatos[Math.floor(Math.random() * candidatos.length)];
      try {
        sessionStorage.setItem(CLAVE_ULTIMO, elegido.url as string);
      } catch {
        /* idem */
      }
      const url = elegido.url as string;
      const alt = elegido.alt || seccion.querySelector("h2")?.textContent || "";
      const esPdf = new URL(url).pathname.toLowerCase().endsWith(".pdf");

      if (esPdf) {
        const marco = document.createElement("iframe");
        marco.className = "certificado-ejemplo-pdf";
        marco.src = `${url}#toolbar=0&navpanes=0&view=FitH`;
        marco.title = alt;
        marco.loading = "lazy";
        marco.addEventListener("load", () => {
          seccion.hidden = false;
        });
        visor.appendChild(marco);
        seccion.hidden = false;
      } else {
        const img = document.createElement("img");
        img.className = "certificado-ejemplo-img";
        img.alt = alt;
        img.decoding = "async";
        img.addEventListener("load", () => {
          seccion.hidden = false;
        });
        img.addEventListener("error", () => {
          seccion.hidden = true;
        });
        visor.appendChild(img);
        img.src = url;
      }
    } catch {
      /* sin red o CORS: la sección simplemente no se muestra. */
    }
  });
</script>

<style is:global>
  /* is:global: el visor se llena con createElement en el cliente, nodos que
     nunca reciben el atributo de scope de Astro. Clases específicas de este
     componente, sin riesgo de colisión. */
  .certificado-ejemplo {
    display: grid;
    gap: var(--space-sm);
    justify-items: center;
    text-align: center;
    padding: var(--space-md);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .certificado-ejemplo[hidden] {
    display: none;
  }

  .certificado-ejemplo h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .certificado-ejemplo p {
    margin: 0;
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .certificado-ejemplo-visor {
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .certificado-ejemplo-img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.22));
  }

  .certificado-ejemplo-pdf {
    width: 100%;
    max-width: 820px;
    height: min(75vh, 1100px);
    min-height: 420px;
    border: 0;
    border-radius: var(--radius-sm);
    background: #ffffff;
    box-shadow: 0 6px 14px rgb(0 0 0 / 0.22);
  }
</style>
