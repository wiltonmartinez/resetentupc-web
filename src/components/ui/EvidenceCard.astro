---
import { Image, getImage } from "astro:assets";
import { t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import { getErrorImage, getErrorImageFamiliaFallback } from "../../lib/error-images.js";
import { getSolucionImage } from "../../lib/solucion-images.js";
import { getModeloImage } from "../../lib/model-images.js";
import EvidenceImagePlaceholder from "./EvidenceImagePlaceholder.astro";

interface Props {
  errorId: string;
  modeloSlug: string;
  nombreMarca: string;
  nombreModelo: string;
  errorCaption: string;
  solucionCaption: string;
  flipHint: string;
  locale: Locale;
}

const { errorId, modeloSlug, nombreMarca, nombreModelo, errorCaption, solucionCaption, flipHint, locale } = Astro.props;

const errorImg = getErrorImage(errorId) ?? getErrorImage(modeloSlug) ?? getErrorImageFamiliaFallback(modeloSlug);
const solucionImg = getSolucionImage(errorId) ?? getSolucionImage(modeloSlug);
const modeloImgFallback = !solucionImg ? getModeloImage(modeloSlug) : null;

const traseraDisponible = solucionImg || modeloImgFallback;
const grupoModal = `evidence-card-${errorId}`;
const ampliarLabel = t(locale, "imageModal.ampliarLabel");
const fotoNoDisponibleLabel = t(locale, "modelo.evidenciaFotoNoDisponible");

// Mismo ancho que ya usa ErrorSelector.astro para el popup — el <Image>
// de arriba sigue sirviendo la miniatura optimizada de la tarjeta.
const errorImgModalUrl = errorImg ? (await getImage({ src: errorImg, format: "webp", width: 960 })).src : "";
const solucionImgModalUrl = solucionImg ? (await getImage({ src: solucionImg, format: "webp", width: 960 })).src : "";
const modeloImgFallbackModalUrl = modeloImgFallback ? (await getImage({ src: modeloImgFallback, format: "webp", width: 960 })).src : "";
---

{(
    <div class="evidence-flip">
      {traseraDisponible ? (
        <div class="evidence-flip-trigger" role="button" tabindex="0" aria-pressed="false" data-sound="select">
          <span class="evidence-flip-inner">
            <span class="evidence-face evidence-face-front">
              <span class="evidence-imagen">
                {errorImg ? (
                  <>
                    <Image src={errorImg} alt={`Así se ve este error en la ${nombreMarca} ${nombreModelo}`} width={errorImg.width} height={errorImg.height} loading="lazy" />
                    <button
                      type="button"
                      class="evidence-ampliar"
                      data-modal-trigger
                      data-modal-group={grupoModal}
                      data-modal-src={errorImgModalUrl}
                      data-modal-alt={`Así se ve este error en la ${nombreMarca} ${nombreModelo}`}
                      aria-label={ampliarLabel}
                    >
                      🔍
                    </button>
                  </>
                ) : (
                  <EvidenceImagePlaceholder label={fotoNoDisponibleLabel} />
                )}
              </span>
              <p class="evidence-caption">{errorCaption}</p>
              <span class="evidence-flip-hint">↻ {flipHint}</span>
            </span>

            <span class="evidence-face evidence-face-back">
              <span class="evidence-imagen">
                {solucionImg ? (
                  <>
                    <Image src={solucionImg} alt="Así queda una vez resuelto" width={solucionImg.width} height={solucionImg.height} loading="lazy" />
                    <button
                      type="button"
                      class="evidence-ampliar"
                      data-modal-trigger
                      data-modal-group={grupoModal}
                      data-modal-src={solucionImgModalUrl}
                      data-modal-alt="Así queda una vez resuelto"
                      aria-label={ampliarLabel}
                    >
                      🔍
                    </button>
                  </>
                ) : (
                  <>
                    <Image src={modeloImgFallback} alt={`${nombreMarca} ${nombreModelo} funcionando correctamente`} width={modeloImgFallback.width} height={modeloImgFallback.height} loading="lazy" />
                    <span class="evidence-check" aria-hidden="true">✅</span>
                    <button
                      type="button"
                      class="evidence-ampliar"
                      data-modal-trigger
                      data-modal-group={grupoModal}
                      data-modal-src={modeloImgFallbackModalUrl}
                      data-modal-alt={`${nombreMarca} ${nombreModelo} funcionando correctamente`}
                      aria-label={ampliarLabel}
                    >
                      🔍
                    </button>
                  </>
                )}
              </span>
              <p class="evidence-caption">{solucionCaption}</p>
            </span>
          </span>
        </div>
      ) : (
        <div class="evidence-static">
          <span class="evidence-imagen">
            {errorImg ? (
              <>
                <Image src={errorImg} alt={`Así se ve este error en la ${nombreMarca} ${nombreModelo}`} width={errorImg.width} height={errorImg.height} loading="lazy" />
                <button
                  type="button"
                  class="evidence-ampliar"
                  data-modal-trigger
                  data-modal-src={errorImgModalUrl}
                  data-modal-alt={`Así se ve este error en la ${nombreMarca} ${nombreModelo}`}
                  aria-label={ampliarLabel}
                >
                  🔍
                </button>
              </>
            ) : (
              <EvidenceImagePlaceholder label={fotoNoDisponibleLabel} />
            )}
          </span>
          <p class="evidence-caption">{errorCaption}</p>
        </div>
      )}
    </div>
  )}

<script>
  document.querySelectorAll(".evidence-flip-trigger").forEach((btn) => {
    const toggleFlip = () => {
      const flipped = btn.getAttribute("aria-pressed") === "true";
      btn.setAttribute("aria-pressed", String(!flipped));
    };
    btn.addEventListener("click", toggleFlip);
    btn.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggleFlip();
      }
    });
  });
</script>

<style>
  .evidence-flip {
    width: 100%;
    max-width: 480px;
    margin: 0.25rem auto 0;
  }

  .evidence-flip-trigger {
    all: unset;
    display: block;
    width: 100%;
    cursor: pointer;
    perspective: 1200px;
  }

  .evidence-flip-inner {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.4, 0.1, 0.2, 1);
  }

  .evidence-flip-trigger[aria-pressed="true"] .evidence-flip-inner {
    transform: rotateY(180deg);
  }

  .evidence-flip-trigger:focus-visible .evidence-flip-inner {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .evidence-face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.35rem;
    backface-visibility: hidden;
  }

  .evidence-face-back {
    transform: rotateY(180deg);
  }

  .evidence-static,
  .evidence-face {
    text-align: center;
  }

  .evidence-static {
    max-width: 480px;
    margin: 0.25rem auto 0;
    display: grid;
    gap: 0.35rem;
  }

  .evidence-imagen {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
  }

  .evidence-static .evidence-imagen {
    aspect-ratio: 4 / 3;
  }

  .evidence-imagen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .evidence-check {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    font-size: 1.9rem;
    line-height: 1;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
  }

  .evidence-ampliar {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.55);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  .evidence-ampliar:hover {
    background: rgba(0, 0, 0, 0.75);
  }

  .evidence-ampliar:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .evidence-caption {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text-subtle);
  }

  .evidence-flip-hint {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8rem;
    font-weight: 600;
    color: white;
    background: rgba(15, 23, 42, 0.72);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .evidence-flip-inner {
      transition: none;
    }
  }
</style>
