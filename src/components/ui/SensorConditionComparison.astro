---
// Flash card "Sensor sucio / Sensor limpio" con giro 3D real (perspective +
// rotateY), reutilizable por marca (no por modelo). Datos en
// src/data/sensor-tinta.ts. Frente = Sucio (estado real que ve el cliente
// antes de limpiar); reverso = Limpio, al hacer clic.
//
// Truco para que ambas caras midan lo mismo aunque tengan distinta
// cantidad de imágenes: el frente queda en flujo normal (define el alto de
// la tarjeta) y el reverso se superpone con position:absolute; inset:0
// sobre esa misma caja — es el patrón estándar para flip-cards de alto
// variable (ver también .evidence-flip en ErrorSelector.astro).
import { Image, getImage } from "astro:assets";
import { t } from "../../i18n/utils";
import type { Locale } from "../../config/site";
import { getSensorLimpioImages, getSensorSucioImages } from "../../lib/sensor-images.js";

interface Props {
  marcaSlug: string;
  tituloLimpio: string;
  tituloSucio: string;
  hintVerLimpio: string;
  hintVerSucio: string;
  locale: Locale;
}

const { marcaSlug, tituloLimpio, tituloSucio, hintVerLimpio, hintVerSucio, locale } = Astro.props;
const imagenesLimpio = getSensorLimpioImages(marcaSlug);
const imagenesSucio = getSensorSucioImages(marcaSlug);
const ampliarLabel = t(locale, "imageModal.ampliarLabel");
const grupoModal = `sensor-condicion-${marcaSlug}`;

// URLs para el popup (960px) — el <Image> de la tarjeta sigue mostrando su
// propia miniatura optimizada; esto solo resuelve el src grande a mostrar
// al ampliar.
const imagenesSucioModal = await Promise.all(
  imagenesSucio.map(async (imagen) => (await getImage({ src: imagen, format: "webp", width: 960 })).src)
);
const imagenesLimpioModal = await Promise.all(
  imagenesLimpio.map(async (imagen) => (await getImage({ src: imagen, format: "webp", width: 960 })).src)
);
---

{(imagenesLimpio.length > 0 || imagenesSucio.length > 0) && (
  <div class="sensor-flip-trigger" role="button" tabindex="0" data-sensor-flip-trigger aria-pressed="false" data-sound="select">
    <span class="sensor-flip-inner">
      <span class="sensor-flip-cara sensor-flip-cara-frente">
        <h3 class="sensor-flip-titulo">{tituloSucio}</h3>
        <span class="sensor-flip-grid">
          {imagenesSucio.map((imagen, indice) => (
            <span class="sensor-flip-imagen">
              <Image src={imagen} alt={`${tituloSucio} — referencia ${indice + 1}`} width={imagen.width} height={imagen.height} loading="lazy" />
              <button
                type="button"
                class="sensor-ampliar"
                data-modal-trigger
                data-modal-group={grupoModal}
                data-modal-src={imagenesSucioModal[indice]}
                data-modal-alt={`${tituloSucio} — referencia ${indice + 1}`}
                aria-label={ampliarLabel}
              >
                🔍
              </button>
            </span>
          ))}
        </span>
        <span class="sensor-flip-hint">👆 {hintVerLimpio}</span>
      </span>

      <span class="sensor-flip-cara sensor-flip-cara-reverso">
        <h3 class="sensor-flip-titulo">{tituloLimpio}</h3>
        <span class="sensor-flip-grid">
          {imagenesLimpio.map((imagen, indice) => (
            <span class="sensor-flip-imagen">
              <Image src={imagen} alt={`${tituloLimpio} — referencia ${indice + 1}`} width={imagen.width} height={imagen.height} loading="lazy" />
              <button
                type="button"
                class="sensor-ampliar"
                data-modal-trigger
                data-modal-group={grupoModal}
                data-modal-src={imagenesLimpioModal[indice]}
                data-modal-alt={`${tituloLimpio} — referencia ${indice + 1}`}
                aria-label={ampliarLabel}
              >
                🔍
              </button>
            </span>
          ))}
        </span>
        <span class="sensor-flip-hint">👆 {hintVerSucio}</span>
      </span>
    </span>
  </div>
)}

<script>
  import { playFeedback } from "../../lib/sound-manager.js";

  document.querySelectorAll<HTMLElement>("[data-sensor-flip-trigger]").forEach((trigger) => {
    const toggleFlip = () => {
      const volteado = trigger.getAttribute("aria-pressed") === "true";
      trigger.setAttribute("aria-pressed", String(!volteado));
      playFeedback("select");
    };
    trigger.addEventListener("click", toggleFlip);
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggleFlip();
      }
    });
  });
</script>

<style>
  .sensor-flip-trigger {
    all: unset;
    display: block;
    width: 100%;
    cursor: pointer;
    perspective: 1400px;
  }

  .sensor-flip-trigger:focus-visible .sensor-flip-inner {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .sensor-flip-inner {
    position: relative;
    display: block;
    width: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.4, 0.1, 0.2, 1);
  }

  .sensor-flip-trigger[aria-pressed="true"] .sensor-flip-inner {
    transform: rotateY(180deg);
  }

  .sensor-flip-cara {
    display: grid;
    gap: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    text-align: center;
    backface-visibility: hidden;
  }

  .sensor-flip-cara-frente {
    position: relative;
  }

  .sensor-flip-cara-reverso {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
  }

  .sensor-flip-titulo {
    margin: 0;
    color: var(--color-primary-dark);
  }

  .sensor-flip-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .sensor-flip-imagen {
    position: relative;
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .sensor-ampliar {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    z-index: 1;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.55);
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
  }

  .sensor-ampliar:hover {
    background: rgba(0, 0, 0, 0.75);
  }

  .sensor-ampliar:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .sensor-flip-imagen :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .sensor-flip-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-subtle);
  }

  @media (max-width: 420px) {
    .sensor-flip-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sensor-flip-inner {
      transition: none;
    }
  }
</style>
