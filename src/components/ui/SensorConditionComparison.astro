---
// Flash card "Sensor sucio / Sensor limpio" con giro 3D real (perspective +
// rotateY), reutilizable por marca (no por modelo). Datos en
// src/data/sensor-tinta.ts. Frente = Sucio (estado real que ve el cliente
// antes de limpiar); reverso = Limpio, al hacer clic.
//
// Truco para que ambas caras midan lo mismo aunque tengan distinta
// cantidad de imágenes: el frente queda en flujo normal (define el alto de
// la tarjeta) y el reverso se superpone con position:absolute; inset:0
// sobre esa misma caja — es el patrón estándar para flip-cards de alto
// variable (ver también .evidence-flip en ErrorSelector.astro).
import { Image } from "astro:assets";
import { getSensorLimpioImages, getSensorSucioImages } from "../../lib/sensor-images.js";

interface Props {
  marcaSlug: string;
  tituloLimpio: string;
  tituloSucio: string;
  hintVerLimpio: string;
  hintVerSucio: string;
}

const { marcaSlug, tituloLimpio, tituloSucio, hintVerLimpio, hintVerSucio } = Astro.props;
const imagenesLimpio = getSensorLimpioImages(marcaSlug);
const imagenesSucio = getSensorSucioImages(marcaSlug);
---

{(imagenesLimpio.length > 0 || imagenesSucio.length > 0) && (
  <button type="button" class="sensor-flip-trigger" data-sensor-flip-trigger aria-pressed="false" data-sound="select">
    <span class="sensor-flip-inner">
      <span class="sensor-flip-cara sensor-flip-cara-frente">
        <h3 class="sensor-flip-titulo">{tituloSucio}</h3>
        <span class="sensor-flip-grid">
          {imagenesSucio.map((imagen, indice) => (
            <span class="sensor-flip-imagen">
              <Image src={imagen} alt={`${tituloSucio} — referencia ${indice + 1}`} width={imagen.width} height={imagen.height} loading="lazy" />
            </span>
          ))}
        </span>
        <span class="sensor-flip-hint">👆 {hintVerLimpio}</span>
      </span>

      <span class="sensor-flip-cara sensor-flip-cara-reverso">
        <h3 class="sensor-flip-titulo">{tituloLimpio}</h3>
        <span class="sensor-flip-grid">
          {imagenesLimpio.map((imagen, indice) => (
            <span class="sensor-flip-imagen">
              <Image src={imagen} alt={`${tituloLimpio} — referencia ${indice + 1}`} width={imagen.width} height={imagen.height} loading="lazy" />
            </span>
          ))}
        </span>
        <span class="sensor-flip-hint">👆 {hintVerSucio}</span>
      </span>
    </span>
  </button>
)}

<script>
  import { playFeedback } from "../../lib/sound-manager.js";

  document.querySelectorAll<HTMLButtonElement>("[data-sensor-flip-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const volteado = trigger.getAttribute("aria-pressed") === "true";
      trigger.setAttribute("aria-pressed", String(!volteado));
      playFeedback("select");
    });
  });
</script>

<style>
  .sensor-flip-trigger {
    all: unset;
    display: block;
    width: 100%;
    cursor: pointer;
    perspective: 1400px;
  }

  .sensor-flip-trigger:focus-visible .sensor-flip-inner {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .sensor-flip-inner {
    position: relative;
    display: block;
    width: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.4, 0.1, 0.2, 1);
  }

  .sensor-flip-trigger[aria-pressed="true"] .sensor-flip-inner {
    transform: rotateY(180deg);
  }

  .sensor-flip-cara {
    display: grid;
    gap: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    text-align: center;
    backface-visibility: hidden;
  }

  .sensor-flip-cara-frente {
    position: relative;
  }

  .sensor-flip-cara-reverso {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
  }

  .sensor-flip-titulo {
    margin: 0;
    color: var(--color-primary-dark);
  }

  .sensor-flip-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .sensor-flip-imagen {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .sensor-flip-imagen :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .sensor-flip-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-subtle);
  }

  @media (max-width: 420px) {
    .sensor-flip-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sensor-flip-inner {
      transition: none;
    }
  }
</style>
