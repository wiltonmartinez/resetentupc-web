---
import type { Locale } from '../config/site';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
  marcaSlug?: string;
  modeloSlug?: string;
}

const { locale, marcaSlug = '', modeloSlug = '' } = Astro.props;

// Datos recuperados del servidor (SSR en Cloudflare Workers)
const nucleoBase = 'https://nucleo.resetalmohadillas.com';
const apiUrl = `${nucleoBase}/api/public/evidencias/diagnosticos/`;

let diagnosticos: any[] = [];
let cargando = true;
let error = '';

try {
  const response = await fetch(apiUrl);
  if (response.ok) {
    const data = await response.json();
    diagnosticos = data.diagnosticos || [];
  } else {
    error = 'Error al cargar diagnósticos';
  }
} catch (e) {
  error = 'No se pudo conectar al servidor';
}

cargando = false;

// Agrupar por marca para el menú
const marcas = [...new Set(diagnosticos.map(d => d.marca))].sort();
const modelosPorMarca: Record<string, string[]> = {};
marcas.forEach(marca => {
  modelosPorMarca[marca] = [...new Set(diagnosticos
    .filter(d => d.marca === marca)
    .map(d => d.modelo)
  )].sort();
});

// Filtrar por marca/modelo si se proporciona
let diagnosticosFiltrados = diagnosticos;
if (marcaSlug) {
  diagnosticosFiltrados = diagnosticosFiltrados.filter(
    d => d.marca.toLowerCase() === marcaSlug.toLowerCase()
  );
}
if (modeloSlug) {
  diagnosticosFiltrados = diagnosticosFiltrados.filter(
    d => d.modelo.toLowerCase() === modeloSlug.toLowerCase()
  );
}
---

<div class="prueba-social" data-locale={locale}>
  <div class="encabezado">
    <h2>{t(locale, 'pruebaSocial.titulo')}</h2>
    <p>{t(locale, 'pruebaSocial.descripcion')}</p>
  </div>

  {error && (
    <div class="alerta error">
      {error}
    </div>
  )}

  {!error && diagnosticos.length === 0 && (
    <div class="alerta vacia">
      {t(locale, 'pruebaSocial.sinDatos')}
    </div>
  )}

  {!error && diagnosticos.length > 0 && (
    <>
      {/* Filtros */}
      <div class="filtros">
        <div class="filtro-grupo">
          <label for="marca-select">{t(locale, 'pruebaSocial.filtrarPorMarca')}:</label>
          <select id="marca-select" class="filtro-select">
            <option value="">{t(locale, 'pruebaSocial.todasLasMarcas')}</option>
            {marcas.map(marca => (
              <option value={marca.toLowerCase()} selected={marcaSlug === marca.toLowerCase()}>
                {marca}
              </option>
            ))}
          </select>
        </div>

        <div class="filtro-grupo" id="modelo-filtro" style={!marcaSlug ? 'display: none;' : ''}>
          <label for="modelo-select">{t(locale, 'pruebaSocial.filtrarPorModelo')}:</label>
          <select id="modelo-select" class="filtro-select">
            <option value="">{t(locale, 'pruebaSocial.todosLosModelos')}</option>
            {marcaSlug && modelosPorMarca[Object.keys(modelosPorMarca).find(m => m.toLowerCase() === marcaSlug) || '']?.map(modelo => (
              <option value={modelo.toLowerCase()} selected={modeloSlug === modelo.toLowerCase()}>
                {modelo}
              </option>
            ))}
          </select>
        </div>
      </div>

      {/* Grid de Diagnósticos */}
      {diagnosticosFiltrados.length === 0 ? (
        <div class="alerta vacia">
          {t(locale, 'pruebaSocial.sinResultados')}
        </div>
      ) : (
        <div class="grid-diagnosticos">
          {diagnosticosFiltrados.map((diag) => (
            <div class="tarjeta-diagnostico" data-diagnostico={diag.diagnostico}>
              <div class="contenido">
                <h3>{diag.marca} {diag.modelo}</h3>
                <p class="error">{diag.error}</p>
                <p class="diagnostico">
                  <strong>{t(locale, 'pruebaSocial.tipo')}:</strong> {diag.diagnostico}
                </p>
                <p class="pais">
                  <strong>{t(locale, 'pruebaSocial.pais')}:</strong> {diag.codigo_pais}
                </p>
              </div>

              <div class="acciones">
                <a href={diag.enlace_youtube} target="_blank" rel="noopener noreferrer" class="btn btn-video">
                  {t(locale, 'pruebaSocial.verVideo')} →
                </a>
                <button class="btn btn-whatsapp" data-diagnostico={diag.slug} data-marca={diag.marca} data-modelo={diag.modelo}>
                  {t(locale, 'pruebaSocial.consultarPorWhatsapp')}
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </>
  )}
</div>

<style>
  .prueba-social {
    display: grid;
    gap: var(--space-lg);
  }

  .encabezado {
    text-align: center;
    margin-bottom: var(--space-md);
  }

  .encabezado h2 {
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .encabezado p {
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .alerta {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    text-align: center;
    font-size: 14px;
  }

  .alerta.error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .alerta.vacia {
    background: #e7f3ff;
    color: #0c5460;
    border: 1px solid #b8daff;
  }

  .filtros {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding: var(--space-md);
    background: var(--color-bg-muted);
    border-radius: var(--radius-md);
  }

  .filtro-grupo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .filtro-grupo label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
  }

  .filtro-select {
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 13px;
    background: white;
    cursor: pointer;
    min-width: 150px;
  }

  .filtro-select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
  }

  .grid-diagnosticos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }

  .tarjeta-diagnostico {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-card);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .tarjeta-diagnostico:hover {
    box-shadow: var(--shadow-floating);
    transform: translateY(-2px);
  }

  .tarjeta-diagnostico::before {
    content: attr(data-diagnostico);
    display: inline-block;
    background: var(--color-primary);
    color: white;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    width: fit-content;
  }

  .contenido {
    flex: 1;
    margin-bottom: var(--space-md);
  }

  .contenido h3 {
    margin: 0 0 var(--space-sm) 0;
    font-size: 16px;
    color: var(--color-text);
  }

  .contenido p {
    margin: var(--space-xs) 0;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .contenido .error {
    font-weight: 600;
    color: var(--color-primary);
  }

  .contenido .diagnostico,
  .contenido .pais {
    font-size: 12px;
  }

  .acciones {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .btn {
    padding: 10px 14px;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .btn-video {
    background: var(--color-primary);
    color: white;
  }

  .btn-video:hover {
    background: var(--color-primary-dark);
  }

  .btn-whatsapp {
    background: var(--color-whatsapp);
    color: white;
  }

  .btn-whatsapp:hover {
    background: var(--color-whatsapp-dark);
  }

  @media (max-width: 640px) {
    .grid-diagnosticos {
      grid-template-columns: 1fr;
    }

    .filtros {
      flex-direction: column;
    }

    .filtro-grupo {
      flex-direction: column;
      align-items: flex-start;
    }

    .filtro-select {
      width: 100%;
      min-width: unset;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const marcaSelect = document.getElementById('marca-select') as HTMLSelectElement;
    const modeloSelect = document.getElementById('modelo-select') as HTMLSelectElement;
    const modeloFiltro = document.getElementById('modelo-filtro');
    const whatsappButtons = document.querySelectorAll('.btn-whatsapp');

    if (marcaSelect) {
      marcaSelect.addEventListener('change', () => {
        const marca = marcaSelect.value;
        if (marca) {
          if (modeloFiltro) modeloFiltro.style.display = 'flex';
          // Aquí podrías filtrar dinámicamente o redirigir
        } else {
          if (modeloFiltro) modeloFiltro.style.display = 'none';
        }
      });
    }

    whatsappButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-diagnostico');
        const marca = btn.getAttribute('data-marca');
        const modelo = btn.getAttribute('data-modelo');
        const whatsappNumber = '573016928346'; // Desde config
        const mensaje = `Hola, necesito información sobre el diagnóstico:\n${marca} ${modelo} (${slug})`;
        const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`;
        window.open(url, '_blank');
      });
    });
  });
</script>
