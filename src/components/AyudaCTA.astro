---
interface Props {
  sourceId: string;
  label: string;
  destacado?: boolean;
}

const { sourceId, label, destacado = false } = Astro.props;
---

<button
  type="button"
  class:list={["ayuda-cta", { "ayuda-cta-destacado": destacado }]}
  data-abrir-formulario-contacto=""
  data-source-id={sourceId}
  data-sound="select"
>
  {label}
</button>

<style>
  .ayuda-cta {
    display: inline-block;
    background: white;
    color: var(--color-primary-dark);
    font: inherit;
    font-weight: 700;
    border: none;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
  }
  .ayuda-cta:hover {
    background: var(--color-primary-light);
  }

  .ayuda-cta-destacado {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-primary);
    color: white;
    box-shadow: var(--shadow-floating);
    animation: ayuda-cta-pulso 2.4s ease-in-out infinite;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .ayuda-cta-destacado:hover {
    background: var(--color-primary-dark);
    transform: translateY(3px);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.15);
    animation-play-state: paused;
  }

  @keyframes ayuda-cta-pulso {
    0%,
    100% {
      box-shadow: var(--shadow-floating), 0 0 0 0 rgba(15, 118, 110, 0.45);
    }
    50% {
      box-shadow: var(--shadow-floating), 0 0 0 0.5rem rgba(15, 118, 110, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ayuda-cta-destacado {
      animation: none;
    }
  }
</style>
