---
import { Image } from "astro:assets";
import { buildWhatsAppMessage, buildWhatsAppLink } from "../i18n/utils";
import { WHATSAPP_NUMBER, SITE_URL, type Locale } from "../config/site";
import whatsappLogo from "../assets/whatsapp/3.png";

interface Props {
  marca?: string;
  modelo?: string;
  error?: string;
  sourceId: string;
  urlPath: string;
  locale: Locale;
  label: string;
  destacado?: boolean;
  /** Efecto hover de elevación (translateY + sombra), para los CTA del
   *  embudo AIDA de la página de modelo. Opt-in: no afecta los usos
   *  existentes de este componente en el resto del sitio. */
  elevar?: boolean;
}

const { marca, modelo, error, sourceId, urlPath, locale, label, destacado = false, elevar = false } = Astro.props;

const urlOrigen = `${SITE_URL}${urlPath}`;
const message = buildWhatsAppMessage({ locale, marca, modelo, error, urlOrigen });
const href = buildWhatsAppLink(WHATSAPP_NUMBER, message);
---

<a
  class:list={["whatsapp-cta", { "whatsapp-cta-destacado": destacado, "whatsapp-cta-elevar": elevar }]}
  href={href}
  data-source-id={sourceId}
  data-sound="confirm"
  target="_blank"
  rel="noopener noreferrer nofollow"
>
  {elevar && <Image src={whatsappLogo} alt="" width={72} height={72} class="whatsapp-cta-icono" />}
  {label}
</a>

<style>
  .whatsapp-cta {
    display: inline-block;
    background: #25d366;
    color: #062f1a;
    font-weight: 600;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .whatsapp-cta:hover {
    background: #1fb958;
  }

  .whatsapp-cta-elevar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #20d043;
    color: #ffffff;
    font-weight: 700;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .whatsapp-cta-elevar:hover {
    background: #1bb93a;
    color: #ffffff;
    transform: translateY(-0.125rem);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  }

  .whatsapp-cta-icono {
    flex-shrink: 0;
    align-self: stretch;
    width: auto;
    aspect-ratio: 1 / 1;
    margin: -0.75rem 0;
    object-fit: contain;
    transform: scale(0.8);
  }

  .whatsapp-cta-destacado {
    box-shadow: var(--shadow-floating);
    animation: whatsapp-cta-pulso 2.4s ease-in-out infinite;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .whatsapp-cta-destacado:hover {
    transform: translateY(3px);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.15);
    animation-play-state: paused;
  }

  @keyframes whatsapp-cta-pulso {
    0%,
    100% {
      box-shadow: var(--shadow-floating), 0 0 0 0 rgba(37, 211, 102, 0.45);
    }
    50% {
      box-shadow: var(--shadow-floating), 0 0 0 0.5rem rgba(37, 211, 102, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-cta-destacado {
      animation: none;
    }
  }
</style>
