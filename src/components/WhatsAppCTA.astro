---
import { buildWhatsAppMessage, buildWhatsAppLink } from "../i18n/utils";
import { WHATSAPP_NUMBER, SITE_URL, type Locale } from "../config/site";

interface Props {
  marca?: string;
  modelo?: string;
  error?: string;
  sourceId: string;
  urlPath: string;
  locale: Locale;
  label: string;
  destacado?: boolean;
}

const { marca, modelo, error, sourceId, urlPath, locale, label, destacado = false } = Astro.props;

const urlOrigen = `${SITE_URL}${urlPath}`;
const message = buildWhatsAppMessage({ locale, marca, modelo, error, urlOrigen });
const href = buildWhatsAppLink(WHATSAPP_NUMBER, message);
---

<a
  class:list={["whatsapp-cta", { "whatsapp-cta-destacado": destacado }]}
  href={href}
  data-source-id={sourceId}
  data-sound="confirm"
  target="_blank"
  rel="noopener noreferrer nofollow"
>
  {label}
</a>

<style>
  .whatsapp-cta {
    display: inline-block;
    background: #25d366;
    color: #062f1a;
    font-weight: 600;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .whatsapp-cta:hover {
    background: #1fb958;
  }

  .whatsapp-cta-destacado {
    box-shadow: var(--shadow-floating);
    animation: whatsapp-cta-pulso 2.4s ease-in-out infinite;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .whatsapp-cta-destacado:hover {
    transform: translateY(3px);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.15);
    animation-play-state: paused;
  }

  @keyframes whatsapp-cta-pulso {
    0%,
    100% {
      box-shadow: var(--shadow-floating), 0 0 0 0 rgba(37, 211, 102, 0.45);
    }
    50% {
      box-shadow: var(--shadow-floating), 0 0 0 0.5rem rgba(37, 211, 102, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-cta-destacado {
      animation: none;
    }
  }
</style>
