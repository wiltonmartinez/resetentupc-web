---
/**
 * Selector de diagnóstico (marca -> error -> modelo, en cascada) + grilla de
 * resumen (Bloque 1, 6 pasos) + desglose detallado (Bloque 2, 6 pasos) del
 * proceso de reset asistido. Extraído de ComoFuncionaPage.astro para que
 * tanto /como-funciona/ como el Home lo usen sin duplicar el markup, el CSS
 * ni la lógica de cascada — un solo lugar para mantener este contenido.
 *
 * Reutiliza los mismos textos ya validados y traducidos de los namespaces
 * "procesoReutilizable", "procedimiento", "proceso" y "comoFuncionaProceso"
 * (no crea ninguna clave nueva). No incluye el intro, el grid de beneficios,
 * el CTA final ni el FAQ — eso sigue siendo específico de cada página que lo
 * use.
 */
import { Image, getImage, type ImageMetadata } from "astro:assets";
import { getErrorImage } from "../lib/error-images.js";
import { getModeloImage } from "../lib/model-images.js";
import { t, buildLocalizedPath } from "../i18n/utils";
import YouTubeFacade from "./ui/YouTubeFacade.astro";
import ClienteSatisfechoEmbed from "./ui/ClienteSatisfechoEmbed.astro";
import PreciosCascadaWidget from "./pages/PreciosCascadaWidget.astro";
import { fetchAllPages } from "../lib/fetch-paginated";
import { listarTestimonios } from "../lib/nucleo-api";
import { extractYoutubeId } from "../lib/youtube";
import { getPruebaSocialBannerVideo } from "../lib/prueba-social-banners";
import { TECHNICIAN_ID, USB_REDIRECTOR_DOWNLOAD_URL, NUCLEO_API_BASE_URL, type Locale } from "../config/site";
import modelosCompletos from "../data/modelos-muestra.json";
import procEpson1 from "../assets/procedimiento/1.png";
import procEpson2 from "../assets/procedimiento/2.png";
import procEpson3 from "../assets/procedimiento/3.png";
import procEpson4 from "../assets/procedimiento/4.png";
import procEpson5 from "../assets/procedimiento/5.png";
import procEpson6 from "../assets/procedimiento/6.png";
import procCanon1 from "../assets/procedimiento-canon/1.png";
import procCanon2 from "../assets/procedimiento-canon/2.png";
import procCanon3 from "../assets/procedimiento-canon/3.png";
import procCanon4 from "../assets/procedimiento-canon/4.png";
import procCanon5 from "../assets/procedimiento-canon/5.png";
import procCanon6 from "../assets/procedimiento-canon/6.png";
import procEpsonSc1 from "../assets/procedimiento-epson-sc/1.png";
import procEpsonSc2 from "../assets/procedimiento-epson-sc/2.png";
import procEpsonSc3 from "../assets/procedimiento-epson-sc/3.png";
import procEpsonSc4 from "../assets/procedimiento-epson-sc/4.png";
import procEpsonSc5 from "../assets/procedimiento-epson-sc/5.png";
import procEpsonSc6 from "../assets/procedimiento-epson-sc/6.png";
import pasoModuloWebp from "../assets/proceso/paso1-descargar.webp";
import pasoConectarWebp from "../assets/proceso/Paso2-Formulario.webp";
import pasoCompartirWebp from "../assets/proceso/Paso3-ReconectarCableUSB.webp";
import pasoWhatsappWebp from "../assets/proceso/Paso4-Contactarnos.webp";

interface Props {
  locale: Locale;
  /** Para el widget de precios (Paso 4): de qué página viene la cotización. */
  urlPath: string;
}

const { locale, urlPath } = Astro.props;

// Video en bucle del Paso 1 (src/assets/prueba-social/diagnostico/banner-video.mp4),
// vía el mismo helper que ya usan las páginas de Prueba Social. Si el
// archivo no está disponible, simplemente no se renderiza el <video> — no
// se rompe el Paso 1 por esto.
const paso1VideoDiagnostico = getPruebaSocialBannerVideo("diagnostico");

// Evidencia real embebida en los pasos 5 y 6 -- un caso al azar por cada
// variante marca+error (elegido en build time, se renueva en cada deploy)
// desde los mismos catalogos publicos de Prueba Social, para que el video
// del Paso 5 coincida con la marca/error activos en el selector de
// diagnostico de arriba. Si Nucleo no responde o una variante no tiene
// ningun caso propio con video, esa variante cae al placeholder existente
// sin romper la pagina.
type VideoEvidencia = { youtubeId: string; titulo: string } | null;
const videosPorVariante: Record<string, VideoEvidencia> = {
  epson: null,
  canon: null,
  "epson-sc-0014bd": null,
  "epson-sc-otro": null,
};
try {
  const evidencias = await fetchAllPages(`${NUCLEO_API_BASE_URL}/api/public/reset-realizados/`);
  const conVideo = evidencias
    .map((e: any) => ({ ...e, youtubeId: extractYoutubeId(e.youtube_id) || extractYoutubeId(e.enlace_youtube) }))
    .filter((e: any) => e.youtubeId);

  const elegirDe = (candidatos: any[]): VideoEvidencia => {
    if (candidatos.length === 0) return null;
    const elegido = candidatos[Math.floor(Math.random() * candidatos.length)];
    return { youtubeId: elegido.youtubeId, titulo: `${elegido.marca} ${elegido.modelo}` };
  };

  const marcaEs = (e: any, marca: string) => (e.marca ?? "").trim().toLowerCase() === marca;
  const errorEs0014bd = (e: any) => (e.error ?? "").trim().toUpperCase() === "0014BD";

  videosPorVariante.epson = elegirDe(conVideo.filter((e: any) => marcaEs(e, "epson")));
  videosPorVariante.canon = elegirDe(conVideo.filter((e: any) => marcaEs(e, "canon")));
  videosPorVariante["epson-sc-0014bd"] = elegirDe(conVideo.filter((e: any) => marcaEs(e, "epson-sc") && errorEs0014bd(e)));
  videosPorVariante["epson-sc-otro"] = elegirDe(conVideo.filter((e: any) => marcaEs(e, "epson-sc") && !errorEs0014bd(e)));
} catch (error) {
  console.error("Error fetching reset-realizados para ProcedimientoResumenDetalle:", error);
}

// Conversacion embebida del Paso 6: una por marca (Epson/Canon/Epson-SC) para
// que coincida siempre con la marca elegida en el selector de diagnostico —
// la variante "default" (cualquier caso, sin filtrar) queda solo como
// respaldo si esa marca puntual no tiene todavia ninguna captura real en
// Nucleo, nunca como reemplazo directo de Epson-SC (mostraba la conversacion
// de un cliente de otra marca, incoherente con lo seleccionado arriba).
// Mismo catalogo publico que usa Prueba Social.
type ClienteEmbed = { url: string; titulo: string } | null;
const clientesPorVariante: Record<string, ClienteEmbed> = { epson: null, canon: null, default: null };
try {
  const clientes = await fetchAllPages(`${NUCLEO_API_BASE_URL}/api/public/cliente-satisfecho/`);
  const conCaptura = clientes.filter((c: any) => c.html_url);

  const elegirDe = (candidatos: any[]): ClienteEmbed => {
    if (candidatos.length === 0) return null;
    const elegido = candidatos[Math.floor(Math.random() * candidatos.length)];
    const url = elegido.html_url.startsWith("/") ? `${NUCLEO_API_BASE_URL}${elegido.html_url}` : elegido.html_url;
    return { url, titulo: `${elegido.marca} ${elegido.modelo}` };
  };
  const marcaEs = (c: any, marca: string) => (c.marca ?? "").trim().toLowerCase() === marca;

  clientesPorVariante.epson = elegirDe(conCaptura.filter((c: any) => marcaEs(c, "epson")));
  clientesPorVariante.canon = elegirDe(conCaptura.filter((c: any) => marcaEs(c, "canon")));
  clientesPorVariante.default = elegirDe(conCaptura.filter((c: any) => marcaEs(c, "epson-sc"))) ?? elegirDe(conCaptura);
} catch (error) {
  console.error("Error fetching cliente-satisfecho para ProcedimientoResumenDetalle:", error);
}

// Reseñas reales de Trustpilot (mismo catálogo público que usa
// /prueba-social/testimonios-trustpilot/): pool completo para la sección
// "Prueba Social" que va después de los 6 pasos, re-sorteado en cliente en
// cada carga/F5 (ver el <script> más abajo), no solo por deploy. Si Núcleo
// no responde o no hay ninguna con imagen, no se muestra nada — nunca se
// fabrica una reseña.
type Testimonio = { imagen: string; destino: string };
let testimoniosPool: Testimonio[] = [];
try {
  const testimonios = await listarTestimonios();
  testimoniosPool = testimonios
    .filter((testimonio: any) => testimonio.url_imgur?.trim())
    .map((testimonio: any) => ({
      imagen: testimonio.url_imgur,
      destino: testimonio.url_trustpilot_review?.trim() || testimonio.url_imgur,
    }));
} catch (error) {
  console.error("Error fetching testimonios-trustpilot para ProcedimientoResumenDetalle:", error);
}

// Primer render (SSR/no-JS): 3 al azar del pool — el script cliente las
// reemplaza apenas carga la página (ver más abajo).
const testimoniosDestacadosInicial = [...testimoniosPool].sort(() => Math.random() - 0.5).slice(0, 3);

// Páginas de modelo realmente válidas (mismo criterio que la grilla de
// errores del Home): nunca se enlaza el Paso 1 a un modelo sin página real.
const paginasValidas = new Set(modelosCompletos.map((m) => `${m.marcaSlug}:${m.modeloSlug}`));

// Imagenes del grid de resumen (Bloque 1), una serie de 6 por marca. La marca
// activa en el selector de diagnostico de abajo decide cual serie se muestra
// (Epson por defecto); el toggle es puramente visual en el cliente porque las
// 3 series ya vienen renderizadas en el HTML (ver [data-marca-icono] en el
// script de mas abajo).
const procedimientoImagenes: Record<string, ImageMetadata[]> = {
  epson: [procEpson1, procEpson2, procEpson3, procEpson4, procEpson5, procEpson6],
  canon: [procCanon1, procCanon2, procCanon3, procCanon4, procCanon5, procCanon6],
  "epson-sc": [procEpsonSc1, procEpsonSc2, procEpsonSc3, procEpsonSc4, procEpsonSc5, procEpsonSc6],
};

// Los textos de los pasos 1 y 5 llevan placeholders {marca}/{modelo}/{error}
// que se resuelven con valores por defecto en el render estatico y se
// actualizan en vivo via [data-cascada-*] cuando el usuario cambia de marca,
// error o escribe su modelo en el selector de diagnostico de arriba.
type CascadaToken = "marca" | "modelo" | "error";
type TemplatePart = { text: string; token?: CascadaToken };

const renderTemplateParts = (template: string, defaults: Record<CascadaToken, string>): TemplatePart[] => {
  const tokenPattern = /\{(marca|modelo|error)\}/g;
  const parts: TemplatePart[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = tokenPattern.exec(template))) {
    if (match.index > lastIndex) parts.push({ text: template.slice(lastIndex, match.index) });
    const token = match[1] as CascadaToken;
    parts.push({ text: defaults[token], token });
    lastIndex = tokenPattern.lastIndex;
  }
  if (lastIndex < template.length) parts.push({ text: template.slice(lastIndex) });
  return parts;
};

// Selector de diagnóstico (marca -> error -> modelo, cascada por JS): el
// error elegido se propaga a cada [data-cascada-error] de la página (tarjeta
// 1 del resumen, título del Paso 1, y el bullet "Error ___ verificado" del
// Paso 2), para que el mismo texto aparezca en todos lados. Las plantillas
// "{error}" ya vienen partidas en prefijo/sufijo porque el texto alrededor
// cambia según el idioma.
const splitTemplate = (template: string): [string, string] => {
  const [prefix, suffix] = template.split("{error}");
  return [prefix, suffix ?? ""];
};

const [paso2ErrorPrefix, paso2ErrorSuffix] = splitTemplate(t(locale, "comoFuncionaProceso.paso2ReqErrorVerificado"));
const errorDefaultLabel = t(locale, "comoFuncionaProceso.errorAlmohadillasLabel");

const marcasSelector = [
  { id: "epson", label: "Epson", errores: [errorDefaultLabel, "E-11"] },
  { id: "canon", label: "Canon", errores: ["5B00", "1700", "P07", "E-08"] },
  {
    id: "epson-sc",
    label: "Epson-SC",
    errores: [
      "0014BD",
      "00000008 - 00080000",
      "00000004 - 00040000",
      "00000001 - 00010000",
      "0000000c - 000c0000",
    ],
  },
];

// Listas de modelos frecuentes para acelerar la seleccion (en vez de escribir
// a mano) cuando la combinacion marca+error lo amerita: Epson + Almohadillas
// (el error mas comun) y Canon (cualquiera de sus errores).
const modelosEpsonAlmohadillas = [
  "L3250", "L1250", "L4260", "L555", "L3150", "L3210", "L4150", "ET-2400", "ET-2870", "L120",
  "L355", "L495", "L575", "M2120", "ET-2710", "ET-2750", "ET-2760", "ET-2800", "ET-2860",
  "ET-4550", "ET-4700", "ET-4800", "L210", "L220", "L380", "L396", "L1210", "L1300", "L3060",
  "L3110", "L3160", "L4160", "L5290", "M1120", "WF-3730", "XP-235", "XP-320", "XP-400", "XP-2150",
];
const modelosCanon = [
  "G1100", "G1110", "G2110", "G2100", "G3100", "G3110", "G4100", "G4110", "G5010", "G6010", "G7010",
];
const modelosEpsonSc = ["F570", "F571", "T3170", "T3170x"];
const OTRO_MODELO_VALOR = "otro";

// Foto de error + foto de la impresora (catálogo) + enlace real por modelo
// exacto (no solo por marca) para Epson-Almohadillas y Canon: tanto
// src/assets/errores/ (captura del error, ej. G3110.png) como
// src/assets/modelos/ (foto real del equipo, ej. G3110.png en esa otra
// carpeta) tienen una imagen por cada modelo del desplegable, así que en
// vez de mostrar siempre la misma foto genérica, el Paso 1 sirve las del
// modelo que el usuario realmente eligió, como enlace directo a
// /reset/{marca}/{modelo}/. Un modelo solo entra al mapa si tiene página
// real (la foto del error o la del equipo pueden faltar sueltas sin
// bloquear el resto — nunca se fabrica ninguna imagen ni se enlaza a un
// modelo sin página, mismo criterio que la grilla de errores del Home).
type FotoConHref = { srcError: string | null; srcModelo: string | null; href: string };
const construirFotosConHref = async (modelos: string[], marcaSlug: string): Promise<Record<string, FotoConHref>> => {
  const entradas = await Promise.all(
    modelos.map(async (modelo) => {
      const modeloSlug = modelo.toLowerCase();
      if (!paginasValidas.has(`${marcaSlug}:${modeloSlug}`)) return null;
      const imgError = getErrorImage(modelo);
      const imgModelo = getModeloImage(modeloSlug);
      if (!imgError && !imgModelo) return null;
      const [srcError, srcModelo] = await Promise.all([
        imgError ? getImage({ src: imgError, format: "webp", width: imgError.width }).then((r) => r.src) : Promise.resolve(null),
        imgModelo ? getImage({ src: imgModelo, format: "webp", width: 320 }).then((r) => r.src) : Promise.resolve(null),
      ]);
      return [modelo, { srcError, srcModelo, href: buildLocalizedPath(locale, `/reset/${marcaSlug}/${modeloSlug}/`) }] as const;
    })
  );
  return Object.fromEntries(entradas.filter((e): e is [string, FotoConHref] => e !== null));
};
const fotosEpsonConHref = await construirFotosConHref(modelosEpsonAlmohadillas, "epson");
const fotosCanonConHref = await construirFotosConHref(modelosCanon, "canon");

// Epson-SC es distinto: la foto de error no depende del modelo exacto (es
// la misma pantalla del plotter para cualquier modelo), sino del código de
// error elegido — src/assets/errores/epson-sc-{codigo}.* Se arma un mapa
// aparte, por VALOR del botón de error (ej. "0014BD"), reutilizando la
// misma correspondencia código->foto ya usada en errores.json. La foto del
// equipo sí depende del modelo, igual que Epson/Canon.
const ERROR_ID_EPSON_SC: Record<string, string> = {
  "0014BD": "epson-sc-0014bd",
  "00000008 - 00080000": "epson-sc-00000008",
  "00000004 - 00040000": "epson-sc-00000004",
  "00000001 - 00010000": "epson-sc-00000001",
  "0000000c - 000c0000": "epson-sc-0000000c",
};
const construirFotosErrorEpsonSc = async (): Promise<Record<string, string>> => {
  const entradas = await Promise.all(
    Object.entries(ERROR_ID_EPSON_SC).map(async ([errorValor, errorId]) => {
      const img = getErrorImage(errorId);
      if (!img) return null;
      const optimizada = await getImage({ src: img, format: "webp", width: img.width });
      return [errorValor, optimizada.src] as const;
    })
  );
  return Object.fromEntries(entradas.filter((e): e is [string, string] => e !== null));
};
const fotosErrorEpsonSc = await construirFotosErrorEpsonSc();

const construirModelosConHref = async (modelos: string[], marcaSlug: string): Promise<Record<string, { srcModelo: string | null; href: string }>> => {
  const entradas = await Promise.all(
    modelos.map(async (modelo) => {
      const modeloSlug = modelo.toLowerCase();
      if (!paginasValidas.has(`${marcaSlug}:${modeloSlug}`)) return null;
      const imgModelo = getModeloImage(modeloSlug);
      const srcModelo = imgModelo ? (await getImage({ src: imgModelo, format: "webp", width: 320 })).src : null;
      return [modelo, { srcModelo, href: buildLocalizedPath(locale, `/reset/${marcaSlug}/${modeloSlug}/`) }] as const;
    })
  );
  return Object.fromEntries(entradas.filter((e): e is [string, { srcModelo: string | null; href: string }] => e !== null));
};
const modelosEpsonScConHref = await construirModelosConHref(modelosEpsonSc, "epson-sc");

// Paso 1 por defecto de cada marca: el caso más común de cada una, como
// única ventana de error visible (sin pestañas de otros errores). Se activa
// solo al elegir la marca (ver el script más abajo) — el usuario sigue
// pudiendo cambiar modelo y error a mano.
const MODELO_DEFAULT_POR_MARCA: Record<string, string> = {
  epson: "L3210",
  canon: "G6010",
  "epson-sc": "F570",
};
const PASO1_MODELO_DEFAULT = MODELO_DEFAULT_POR_MARCA.epson;
const paso1FotoDefault = fotosEpsonConHref[PASO1_MODELO_DEFAULT];

const modeloEjemplo = t(locale, "comoFuncionaProceso.resumenModeloEjemplo");
const cascadaDefaults: Record<CascadaToken, string> = {
  marca: marcasSelector[0].label,
  modelo: modeloEjemplo,
  error: errorDefaultLabel,
};
const resumenPaso1TextoParts = renderTemplateParts(t(locale, "comoFuncionaProceso.resumenPasoTexto1"), cascadaDefaults);
const resumenPaso5TextoParts = renderTemplateParts(t(locale, "comoFuncionaProceso.resumenPasoTexto5"), cascadaDefaults);
const paso1TituloParts = renderTemplateParts(t(locale, "comoFuncionaProceso.resumenPaso1"), cascadaDefaults);

// Bullet "Impresora conectada..." del Paso 2: 4 variantes segun marca+error
// (Epson, Canon, Epson-SC con 0014BD, Epson-SC con cualquier otro error), ya
// que cada una describe un estado de la impresora distinto. Las 4 se
// renderizan ocultas salvo la de Epson (estado por defecto de la pagina) y
// [data-requisito-usb] alterna cual se ve segun la marca+error elegidos.
const requisitosUsbVariantes = [
  { id: "epson", key: "paso2ReqUsbEpson" },
  { id: "canon", key: "paso2ReqUsbCanon" },
  { id: "epson-sc-otro", key: "paso2ReqUsbEpsonScOtro" },
  { id: "epson-sc-0014bd", key: "paso2ReqUsbEpsonSc0014bd" },
];

const subpasosConexion = [
  {
    numero: "3.1",
    imagen: pasoModuloWebp,
    titulo: t(locale, "proceso.paso1Titulo"),
    texto: t(locale, "proceso.paso1Texto"),
    enlace: t(locale, "comoFuncionaProceso.paso31BotonDescarga"),
  },
  { numero: "3.2", imagen: pasoConectarWebp, titulo: t(locale, "proceso.paso2Titulo"), texto: t(locale, "proceso.paso2Texto") },
  { numero: "3.3", imagen: pasoCompartirWebp, titulo: t(locale, "proceso.paso3Titulo"), texto: t(locale, "proceso.paso3Texto") },
  { numero: "3.4", imagen: pasoWhatsappWebp, titulo: t(locale, "proceso.paso4Titulo"), texto: t(locale, "proceso.paso4Texto") },
];
---

<div class="procedimiento-resumen-detalle">
  <!-- Video en bucle del diagnóstico: primer elemento del bloque, justo
       después del separador que lo antecede en cada página (.home-divisor
       en el Home, .seccion-divisor en /como-funciona/). -->
  {paso1VideoDiagnostico && (
    <div class="paso1-video-banner">
      <video
        autoplay
        loop
        muted
        playsinline
        disablePictureInPicture
        controlsList="nodownload noremoteplayback nofullscreen"
        oncontextmenu="return false"
        aria-label={t(locale, "comoFuncionaProceso.paso1VideoLabel")}
      >
        <source src={paso1VideoDiagnostico} type="video/mp4" />
      </video>
    </div>
  )}

  <!-- BLOQUE 1: Grid de resumen, dinámico por marca -->
  <section class="resumen-grid" aria-label={t(locale, "comoFuncionaProceso.tituloResumen")}>
    <h2 class="resumen-titulo">{t(locale, "comoFuncionaProceso.tituloResumen")}</h2>
    <div class="resumen-cards">
      <a class="resumen-card" href="#paso-como-funciona-1">
        <span class="resumen-badge">1</span>
        <div class="resumen-icono-wrap">
          {marcasSelector.map((marca) => (
            <Image
              src={procedimientoImagenes[marca.id][0]}
              alt=""
              width={64}
              height={64}
              loading="lazy"
              data-marca-icono={marca.id}
              class={marca.id === "epson" ? "resumen-icono-img icono-activa" : "resumen-icono-img"}
            />
          ))}
        </div>
        <h3>{t(locale, "comoFuncionaProceso.resumenPasoTitulo1")}</h3>
        <p>
          {resumenPaso1TextoParts.map((part) =>
            part.token ? <span {...{ [`data-cascada-${part.token}`]: true }}>{part.text}</span> : part.text
          )}
        </p>
      </a>

      <a class="resumen-card" href="#paso-como-funciona-2">
        <span class="resumen-badge">2</span>
        <div class="resumen-icono-wrap">
          {marcasSelector.map((marca) => (
            <Image
              src={procedimientoImagenes[marca.id][1]}
              alt=""
              width={64}
              height={64}
              loading="lazy"
              data-marca-icono={marca.id}
              class={marca.id === "epson" ? "resumen-icono-img icono-activa" : "resumen-icono-img"}
            />
          ))}
        </div>
        <h3>{t(locale, "comoFuncionaProceso.resumenPasoTitulo2")}</h3>
        <ul class="resumen-checklist">
          <li>
            <svg class="resumen-check-icono" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M7.6 13.6 4.4 10.4l-1.4 1.4 4.6 4.6 9-9-1.4-1.4z" fill="currentColor" />
            </svg>
            {t(locale, "comoFuncionaProceso.resumenPasoBullet2a")}
          </li>
          <li>
            <svg class="resumen-check-icono" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M7.6 13.6 4.4 10.4l-1.4 1.4 4.6 4.6 9-9-1.4-1.4z" fill="currentColor" />
            </svg>
            {t(locale, "comoFuncionaProceso.resumenPasoBullet2b")}
          </li>
