<script>
  // Selector de diagnóstico: marca -> error -> modelo, en cascada. El texto
  // del error elegido se propaga a cada [data-cascada-error] de la página
  // (tarjeta 1 del resumen, título del Paso 1, bullet del Paso 2), la marca
  // a cada [data-cascada-marca] y el modelo escrito a cada [data-cascada-modelo]
  // (ambos en las tarjetas 1 y 5 del grid de resumen), para que el mismo
  // contenido aparezca coherente en todas partes. La marca elegida también
  // decide qué serie de íconos [data-marca-icono] del grid de resumen se
  // muestra (las 3 series ya están renderizadas en el HTML, solo se alterna
  // la visibilidad).
  document.querySelectorAll<HTMLElement>("[data-selector-diagnostico]").forEach((raiz) => {
    const marcaBtns = raiz.querySelectorAll<HTMLButtonElement>("[data-selector-marca]");
    const erroresPaneles = raiz.querySelectorAll<HTMLElement>("[data-selector-errores-panel]");
    const modeloWrap = raiz.querySelector<HTMLElement>("[data-selector-modelo-wrap]");
    const modeloInput = raiz.querySelector<HTMLInputElement>("[data-selector-modelo]");
    const listaEpson = raiz.querySelector<HTMLSelectElement>('[data-selector-modelo-lista="epson"]');
    const listaCanon = raiz.querySelector<HTMLSelectElement>('[data-selector-modelo-lista="canon"]');
    const listaEpsonSc = raiz.querySelector<HTMLSelectElement>('[data-selector-modelo-lista="epson-sc"]');
    const todasLasListas = [listaEpson, listaCanon, listaEpsonSc];
    const OTRO_MODELO_VALOR = "otro";
    // Debe coincidir con MODELO_DEFAULT_POR_MARCA del frontmatter (Astro no
    // comparte esas constantes con este <script>, que corre en el cliente).
    const MODELO_DEFAULT_POR_MARCA: Record<string, string> = { epson: "L3210", canon: "G6010", "epson-sc": "F570" };
    let marcaActivaId = "";
    let marcaActivaLabel = "";
    let modeloActivo = "";
    let errorActivo = "";

    // CTA de WhatsApp de la página (si existe uno o más [data-whatsapp-dinamico]
    // en la misma página, como el banner CRO o el CTA final de /como-funciona/):
    // reconstruye el mensaje pre-rellenado con la marca+modelo+error elegidos
    // arriba, con la misma lógica de plantillas que buildWhatsAppMessage
    // (src/i18n/utils.ts) — solo que corrida en el cliente, porque estos
    // valores cambian sin recargar la página. Sin marca+modelo confirmados
    // cae al saludo genérico de siempre. Si la página no tiene ninguno de
    // estos banners (ej. el Home), este bloque simplemente no encuentra nada
    // y no hace nada.
    const actualizarWhatsAppCta = () => {
      document.querySelectorAll<HTMLElement>("[data-whatsapp-dinamico]").forEach((wrap) => {
        // querySelectorAll (no solo el primero): el botón flotante
        // (ContactHub.astro) puede traer varios links en su menú — Wilton +
        // vendedores regionales agregados por su propio script — y todos
        // deben quedar con el mismo mensaje. data-numero en el link (si lo
        // tiene) manda sobre el número del wrap, así cada uno va al suyo.
        const links = wrap.querySelectorAll<HTMLAnchorElement>("a[data-source-id], a[data-whatsapp-menu-link]");
        if (!links.length) return;
        const urlOrigen = wrap.dataset.urlOrigen ?? "";
        // Alcanza con tener la marca para dejar de usar el saludo generico —
        // no se espera a que tambien haya modelo, para que elegir marca ya
        // se refleje en el mensaje aunque el usuario todavia no haya escrito
        // o seleccionado su modelo exacto. Un solo saludo con marca+modelo
        // (sin el error) siempre que haya marca, para que el mensaje sea
        // consistente con el resto del sitio (ver buildWhatsAppMessage en
        // i18n/utils.ts, misma decision del lado servidor).
        const plantilla = marcaActivaLabel
          ? (wrap.dataset.msgWithoutError ?? "")
          : (wrap.dataset.msgGeneric ?? "");
        const mensaje = plantilla
          .replaceAll("{marca}", marcaActivaLabel)
          .replaceAll("{modelo}", modeloActivo)
          .replaceAll("{error}", errorActivo)
          .replaceAll("{url}", urlOrigen)
          .replace(/[ \t]{2,}/g, " ")
          .replace(/[ \t]+([,.;:])/g, "$1");
        links.forEach((link) => {
          const numero = link.dataset.numero || wrap.dataset.whatsappNumber || "";
          if (!numero) return;
          link.href = `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
        });

        // Burbuja de notificación del botón flotante (ContactHub.astro): si
        // este wrap trae plantillas de burbuja, la actualiza con la misma
        // marca/modelo elegidos arriba — mismo criterio que el mensaje. El
        // texto va en un <span data-whatsapp-bubble-texto> propio, no
        // directo en el <p data-whatsapp-bubble> — ese <p> también tiene el
        // nombre fijo de Wilton, así que escribirle con .textContent lo
        // borraría (ver ContactHub.astro).
        const bubbleTexto = wrap.querySelector<HTMLElement>("[data-whatsapp-bubble-texto]");
        const bubbleModeloTpl = wrap.dataset.bubbleModelo;
        const bubbleGenericoTpl = wrap.dataset.bubbleGenerico;
        if (bubbleTexto && (bubbleModeloTpl || bubbleGenericoTpl)) {
          const bubbleTemplate = marcaActivaLabel && modeloActivo ? (bubbleModeloTpl ?? "") : (bubbleGenericoTpl ?? "");
          bubbleTexto.textContent = bubbleTemplate.replaceAll("{marca}", marcaActivaLabel).replaceAll("{modelo}", modeloActivo);
        }
      });
    };

    // Variante segun marca+error: "epson"/"canon" para esas marcas (el error
    // no importa), y para Epson-SC depende de si el error es 0014BD o
    // cualquier otro. La reutilizan el bullet USB del Paso 2, el requisito de
    // limpieza y el video de evidencia del Paso 5.
    const calcularVarianteMarcaError = (marcaId: string, errorValor: string): string => {
      if (marcaId === "canon") return "canon";
      if (marcaId === "epson-sc") return errorValor === "0014BD" ? "epson-sc-0014bd" : "epson-sc-otro";
      return "epson";
    };

    const actualizarRequisitoUsb = (variante: string) => {
      document.querySelectorAll<HTMLElement>("[data-requisito-usb]").forEach((li) => {
        li.hidden = li.dataset.requisitoUsb !== variante;
      });

      // El requisito de limpieza (sensor de tinta, plasticos, almohadilla
      // nueva) solo aplica al error 0014BD.
      const limpiezaLi = document.querySelector<HTMLElement>("[data-requisito-limpieza]");
      if (limpiezaLi) limpiezaLi.hidden = variante !== "epson-sc-0014bd";
    };

    const actualizarVideoReset = (variante: string) => {
      document.querySelectorAll<HTMLElement>("[data-video-marca]").forEach((el) => {
        el.hidden = el.dataset.videoMarca !== variante;
      });
    };

    // Ventana de error + foto de la impresora del Paso 1 (sin pestañas):
    // Epson-Almohadillas y Canon tienen ambas fotos por modelo exacto (ver
    // [data-fotos-epson]/[data-fotos-canon]); Epson-SC es distinto — la
    // foto de error depende del código de error elegido, no del modelo
    // ([data-fotos-epson-sc-error]), mientras que la foto de la impresora
    // sí depende del modelo ([data-modelos-epson-sc]). Todo servido desde
    // el frontmatter, mismo criterio que la grilla de errores del Home:
    // nunca se enlaza a un modelo sin página ni se fabrica una imagen — si
    // algo no resuelve, esa foto puntual se queda tal como estaba.
    const paso1Fotos = raiz.closest(".detalle-contenido")?.querySelector<HTMLElement>("[data-paso1-fotos]") ?? null;
    const paso1LinkError = paso1Fotos?.querySelector<HTMLAnchorElement>(".paso1-imagen-error") ?? null;
    const paso1ImgError = paso1LinkError?.querySelector<HTMLImageElement>("img") ?? null;
    const paso1LinkModelo = paso1Fotos?.querySelector<HTMLAnchorElement>(".paso1-imagen-modelo") ?? null;
    const paso1ImgModelo = paso1LinkModelo?.querySelector<HTMLImageElement>("img") ?? null;
    const paso1ModeloSpan = raiz.closest(".detalle-contenido")?.querySelector<HTMLElement>("[data-modelo-evidencia]") ?? null;
    const textoVerModelo = paso1Fotos?.dataset.textoVerModelo ?? "";

    interface FotoModeloJs {
      srcError: string | null;
      srcModelo: string | null;
      href: string;
    }
    let fotosEpsonJs: Record<string, FotoModeloJs> = {};
    let fotosCanonJs: Record<string, FotoModeloJs> = {};
    let fotosErrorEpsonScJs: Record<string, string> = {};
    let modelosEpsonScJs: Record<string, { srcModelo: string | null; href: string }> = {};
    try {
      fotosEpsonJs = JSON.parse(paso1Fotos?.dataset.fotosEpson ?? "{}");
    } catch {
      /* datos invalidos: la ventana se queda en su estado por defecto */
    }
    try {
      fotosCanonJs = JSON.parse(paso1Fotos?.dataset.fotosCanon ?? "{}");
    } catch {
      /* datos invalidos: la ventana se queda en su estado por defecto */
    }
    try {
      fotosErrorEpsonScJs = JSON.parse(paso1Fotos?.dataset.fotosEpsonScError ?? "{}");
    } catch {
      /* datos invalidos: la ventana se queda en su estado por defecto */
    }
    try {
      modelosEpsonScJs = JSON.parse(paso1Fotos?.dataset.modelosEpsonSc ?? "{}");
    } catch {
      /* datos invalidos: la ventana se queda en su estado por defecto */
    }

    const aplicarFotoError = (src: string | null | undefined) => {
      if (!paso1ImgError || !src) return;
      paso1ImgError.src = src;
      paso1ImgError.removeAttribute("srcset");
    };
    const aplicarFotoModelo = (src: string | null | undefined) => {
      if (!paso1LinkModelo || !paso1ImgModelo) return;
      if (!src) {
        paso1LinkModelo.hidden = true;
        return;
      }
      paso1ImgModelo.src = src;
      paso1ImgModelo.removeAttribute("srcset");
      paso1LinkModelo.hidden = false;
    };
    const aplicarEnlace = (href: string, marcaLabel: string, modelo: string) => {
      const etiqueta = `${textoVerModelo}: ${marcaLabel} ${modelo}`;
      paso1LinkError?.setAttribute("href", href);
      paso1LinkError?.setAttribute("aria-label", etiqueta);
      paso1LinkModelo?.setAttribute("href", href);
      paso1LinkModelo?.setAttribute("aria-label", etiqueta);
      if (paso1ModeloSpan) paso1ModeloSpan.textContent = modelo;
    };

    const actualizarImagenPaso1 = (marcaId: string, marcaLabel: string, modelo: string, errorValor: string) => {
      if (!paso1LinkError || !paso1ImgError) return;

      if (marcaId === "epson" || marcaId === "canon") {
        const foto = (marcaId === "epson" ? fotosEpsonJs : fotosCanonJs)[modelo];
        if (!foto) return;
        aplicarFotoError(foto.srcError);
        aplicarFotoModelo(foto.srcModelo);
        aplicarEnlace(foto.href, marcaLabel, modelo);
        return;
      }

      if (marcaId === "epson-sc") {
        const srcError = errorValor ? fotosErrorEpsonScJs[errorValor] : undefined;
        const infoModelo = modelo ? modelosEpsonScJs[modelo] : undefined;
        if (srcError) aplicarFotoError(srcError);
        if (infoModelo) {
          aplicarFotoModelo(infoModelo.srcModelo);
          aplicarEnlace(infoModelo.href, marcaLabel, modelo);
        }
      }
    };

    const actualizarModelo = (valor: string) => {
      modeloActivo = valor;
      document.querySelectorAll<HTMLElement>("[data-cascada-modelo]").forEach((el) => {
        el.textContent = valor;
      });
      actualizarWhatsAppCta();
    };

    // Conecta este selector con el widget de precios embebido del Paso 4
    // (PreciosCascadaWidget.astro): elegir marca/error/modelo aquí arriba
    // también completa esa calculadora, sin obligar a repetir la selección
    // dos veces en la misma página. Se maneja por eventos DOM (click en el
    // botón de marca, cambio en los <select>, input en el texto de error) —
    // el mismo tipo de interacción que dispararía el usuario a mano — porque
    // el estado interno del widget vive en su propio <script>, sin acceso
    // directo desde aquí.
    const widgetPrecios = document.querySelector<HTMLElement>("[data-precios-cascada-widget]");
    const sincronizarWidgetPrecios = () => {
      if (!widgetPrecios || !marcaActivaId) return;

      const marcaBtn = widgetPrecios.querySelector<HTMLButtonElement>(`[data-marca-boton][data-marca-slug="${marcaActivaId}"]`);
      if (marcaBtn && !marcaBtn.classList.contains("precios-marca-boton-activo")) marcaBtn.click();

      if (modeloActivo) {
        // Familia (solo Epson): mismo criterio que el catálogo real —
        // prefijo alfabético del nombre del modelo (ej. "L3210" -> "l").
        const familiaSelect = widgetPrecios.querySelector<HTMLSelectElement>("[data-familia-select]");
        if (familiaSelect && !familiaSelect.closest("[hidden]")) {
          const familiaSlug = (modeloActivo.match(/^[A-Za-z]+/)?.[0] ?? "").toLowerCase();
          const tieneFamilia = Array.from(familiaSelect.options).some((o) => o.value === familiaSlug);
          if (tieneFamilia && familiaSelect.value !== familiaSlug) {
            familiaSelect.value = familiaSlug;
            familiaSelect.dispatchEvent(new Event("change", { bubbles: true }));
          }
        }

        const modeloSelect = widgetPrecios.querySelector<HTMLSelectElement>("[data-modelo-select]");
        if (modeloSelect) {
          const opcion = Array.from(modeloSelect.options).find(
            (o) => o.textContent?.trim().toLowerCase() === modeloActivo.trim().toLowerCase()
          );
          // Si el modelo escrito/elegido arriba no existe en el catálogo real
          // de precios (el de arriba admite texto libre), no se fuerza nada:
          // el widget se queda en su propio placeholder de modelo y el
          // visitante lo completa ahí — el precio no depende del modelo
          // exacto, solo de la marca, así que esto no bloquea la cotización.
          if (opcion && modeloSelect.value !== opcion.value) {
            modeloSelect.value = opcion.value;
            modeloSelect.dispatchEvent(new Event("change", { bubbles: true }));
          }
        }
      }

      if (errorActivo) {
        // Si el error elegido arriba tiene una opción equivalente en el
        // catálogo de precios (mismo texto, coincidencia por substring en
        // cualquier sentido — cubre "E-11" vs "Almohadillas / E-11 / Tampón"),
        // se selecciona esa. Si no existe ahí (ej. Canon P07/E-08, que no
        // tienen tarifa propia distinta a 5B00/1700), cae al campo "Otro / no
        // lo veo en la lista" del widget con el mismo texto.
        const radios = widgetPrecios.querySelectorAll<HTMLInputElement>('[data-error-opciones] input[type="radio"]');
        const radioMatch = Array.from(radios).find((r) => {
          const texto = r.closest("label")?.querySelector("span")?.textContent?.trim().toLowerCase() ?? "";
          return texto.includes(errorActivo.toLowerCase()) || errorActivo.toLowerCase().includes(texto);
        });
        if (radioMatch) {
          if (!radioMatch.checked) radioMatch.click();
        } else {
          const errorOtro = widgetPrecios.querySelector<HTMLInputElement>("[data-error-otro]");
          if (errorOtro && errorOtro.value !== errorActivo) {
            errorOtro.value = errorActivo;
            errorOtro.dispatchEvent(new Event("input", { bubbles: true }));
          }
        }
      }
    };

    // Recuerda la última marca/error/modelo elegidos — clave GLOBAL
    // compartida con /precios/, las páginas de modelo
    // (/reset/{marca}/{modelo}/) y los listados filtrables de
    // /prueba-social/ (misma clave en todos: ver el comentario gemelo en
    // PreciosPage.astro). Elegir algo en cualquiera de esas páginas se
    // refleja en las demás — se conserva tal cual hasta que el visitante
    // elija algo distinto, sin fecha de vencimiento.
    const SELECCION_LS_KEY = "resetenlinea_seleccion_global_v1";
    const guardarSeleccion = () => {
      try {
        localStorage.setItem(SELECCION_LS_KEY, JSON.stringify({ marca: marcaActivaId, error: errorActivo, modelo: modeloActivo }));
      } catch {
        /* localStorage no disponible: la selección simplemente no persiste entre visitas. */
      }
    };

    const restaurarSeleccion = () => {
      let datos: { marca?: string; error?: string; modelo?: string } | null = null;
      try {
        datos = JSON.parse(localStorage.getItem(SELECCION_LS_KEY) || "null");
      } catch {
        datos = null;
      }
      if (!datos?.marca) return;

      const marcaBtn = Array.from(marcaBtns).find((b) => b.dataset.value === datos!.marca);
      if (!marcaBtn) return;
      marcaBtn.click();

      if (datos.error) {
        const panel = raiz.querySelector<HTMLElement>(`[data-selector-errores-panel="${datos.marca}"]`);
        const errorBtn = panel ? Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-selector-error]")).find((b) => b.dataset.value === datos!.error) : undefined;
        errorBtn?.click();
      }

      if (datos.modelo) {
        // Reintenta primero contra la lista que haya quedado visible según
        // la marca+error restaurados; si el modelo guardado no está ahí
        // (se escribió a mano), cae al campo de texto libre — mismo criterio
        // que ya sigue el usuario al elegir a mano.
        const listaVisible = todasLasListas.find((l) => l && !l.hidden);
        const opcion = listaVisible ? Array.from(listaVisible.options).find((o) => o.value.toLowerCase() === datos!.modelo!.toLowerCase()) : undefined;
        if (listaVisible && opcion) {
          listaVisible.value = opcion.value;
          listaVisible.dispatchEvent(new Event("change", { bubbles: true }));
        } else if (modeloInput) {
          if (modeloInput.hidden && listaVisible) {
            listaVisible.value = OTRO_MODELO_VALOR;
            listaVisible.dispatchEvent(new Event("change", { bubbles: true }));
          }
          modeloInput.value = datos.modelo;
          modeloInput.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    };

    // Epson, Canon y Epson-SC (cualquier error de cada una) muestran una
    // lista de modelos frecuentes en vez del campo de texto libre, para
    // elegir con un clic en lugar de escribir. La opcion "Otro" de cada
    // lista vuelve a mostrar el campo de texto.
    const mostrarListaDeModelos = (marcaId: string) => {
      const mostrarListaEpson = marcaId === "epson";
      const mostrarListaCanon = marcaId === "canon";
      const mostrarListaEpsonSc = marcaId === "epson-sc";
      const mostrarAlgunaLista = mostrarListaEpson || mostrarListaCanon || mostrarListaEpsonSc;
      if (modeloInput) modeloInput.hidden = mostrarAlgunaLista;
      if (listaEpson) {
        listaEpson.hidden = !mostrarListaEpson;
        if (!mostrarListaEpson) listaEpson.value = "";
      }
      if (listaCanon) {
        listaCanon.hidden = !mostrarListaCanon;
        if (!mostrarListaCanon) listaCanon.value = "";
      }
      if (listaEpsonSc) {
        listaEpsonSc.hidden = !mostrarListaEpsonSc;
        if (!mostrarListaEpsonSc) listaEpsonSc.value = "";
      }
    };

    // Selector "en escalera": Marca (siempre visible) -> Modelo (aparece al
    // elegir marca) -> Error (aparece recien al elegir modelo). Esta
    // función revela el panel de error de la marca activa y activa su
    // error por defecto (el primero de su lista — Almohadillas en Epson,
    // 5B00 en Canon, 0014BD en Epson-SC) la PRIMERA vez que hay un modelo
    // para esta marca; si el usuario ya había elegido un error, no lo
    // vuelve a tocar (solo cambiar de marca reinicia errorActivo).
    const revelarErrorSiHaceFalta = () => {
      if (errorActivo) return;
      const panelActivo = raiz.querySelector<HTMLElement>(`[data-selector-errores-panel="${marcaActivaId}"]`);
      panelActivo?.querySelector<HTMLButtonElement>("[data-selector-error]")?.click();
    };

    marcaBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        marcaBtns.forEach((b) => b.classList.toggle("selector-btn-activo", b === btn));
        // Escalera: al elegir marca todavía no se muestra ningún error —
        // recién aparece cuando se elige un modelo (ver revelarErrorSiHaceFalta).
        erroresPaneles.forEach((panel) => {
          panel.style.display = "none";
        });
        raiz.querySelectorAll<HTMLElement>("[data-selector-error]").forEach((b) => b.classList.remove("selector-btn-activo"));

        const marcaValor = btn.dataset.value ?? "";
        marcaActivaId = marcaValor;
        marcaActivaLabel = btn.textContent?.trim() ?? "";
        document.querySelectorAll<HTMLElement>("[data-cascada-marca]").forEach((el) => {
          el.textContent = marcaActivaLabel;
        });
        document.querySelectorAll<HTMLElement>("[data-marca-icono]").forEach((img) => {
          img.classList.toggle("icono-activa", img.dataset.marcaIcono === marcaValor);
        });
        // Conversacion embebida del Paso 6: Epson y Canon muestran su propia
        // conversacion real; cualquier otra marca (Epson-SC) usa la variante
        // "default" (caso sin filtrar por marca).
        const varianteChat = marcaValor === "epson" || marcaValor === "canon" ? marcaValor : "default";
        document.querySelectorAll<HTMLElement>("[data-chat-marca]").forEach((el) => {
          el.hidden = el.dataset.chatMarca !== varianteChat;
        });
        actualizarWhatsAppCta();

        // Cambiar de marca es un equipo distinto: reinicia modelo Y error
        // (a diferencia de cambiar de error dentro de la misma marca, que
        // conserva el modelo — ver el handler de las listas más abajo).
        actualizarModelo("");
        errorActivo = "";
        document.querySelectorAll<HTMLElement>("[data-cascada-error]").forEach((el) => {
          el.textContent = "";
        });

        if (modeloWrap) modeloWrap.style.display = "grid";
        mostrarListaDeModelos(marcaValor);

        // Modelo por defecto de cada marca (Epson L3210, Canon G6010,
        // Epson-SC F570): se preselecciona solo, disparando el mismo
        // evento "change" que si el usuario lo hubiera elegido a mano —
        // actualiza la foto de error, la foto de la impresora, y (via
        // revelarErrorSiHaceFalta, dentro del handler de la lista) activa
        // el error por defecto de esa marca. El usuario sigue pudiendo
        // cambiar modelo y error a mano despues.
        const modeloDefault = MODELO_DEFAULT_POR_MARCA[marcaValor];
        const listaActiva =
          marcaValor === "epson" ? listaEpson : marcaValor === "canon" ? listaCanon : marcaValor === "epson-sc" ? listaEpsonSc : null;
        if (modeloDefault && listaActiva) {
          listaActiva.value = modeloDefault;
          listaActiva.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    });

    raiz.querySelectorAll<HTMLButtonElement>("[data-selector-error]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const panel = btn.closest<HTMLElement>("[data-selector-errores-panel]");
        // Revela el panel del error clickeado (escalera: aparece recien
        // acá, ya sea por un click real del usuario, por el default
        // automatico de revelarErrorSiHaceFalta, o al restaurar una
        // seleccion guardada).
        if (panel) panel.style.display = "flex";
        panel?.querySelectorAll<HTMLElement>("[data-selector-error]").forEach((b) => b.classList.toggle("selector-btn-activo", b === btn));

        const valor = btn.dataset.value ?? "";
        errorActivo = valor;
        document.querySelectorAll<HTMLElement>("[data-cascada-error]").forEach((el) => {
          el.textContent = valor;
        });
        actualizarWhatsAppCta();
        const variante = calcularVarianteMarcaError(marcaActivaId, valor);
        actualizarRequisitoUsb(variante);
        actualizarVideoReset(variante);
        // Epson-SC: la foto de error depende del codigo elegido, no solo
        // del modelo — hace falta refrescarla aca tambien (Epson/Canon no
        // cambian de foto por esto, la llamada es inofensiva para ellas).
        actualizarImagenPaso1(marcaActivaId, marcaActivaLabel, modeloActivo, valor);
        sincronizarWidgetPrecios();
        guardarSeleccion();
      });
    });

    modeloInput?.addEventListener("input", () => {
      actualizarModelo(modeloInput.value.trim() || modeloInput.dataset.modeloEjemplo || "");
      revelarErrorSiHaceFalta();
      sincronizarWidgetPrecios();
      guardarSeleccion();
    });

    todasLasListas.forEach((lista) => {
      lista?.addEventListener("change", () => {
        const esOtro = lista.value === OTRO_MODELO_VALOR;
        if (modeloInput) {
          modeloInput.hidden = !esOtro;
          if (esOtro) {
            modeloInput.value = "";
            modeloInput.focus();
          }
        }
        actualizarModelo(esOtro ? (modeloInput?.dataset.modeloEjemplo ?? "") : lista.value || modeloInput?.dataset.modeloEjemplo || "");
        actualizarImagenPaso1(marcaActivaId, marcaActivaLabel, esOtro ? "" : lista.value, errorActivo);
        revelarErrorSiHaceFalta();
        sincronizarWidgetPrecios();
        guardarSeleccion();
      });
    });

    restaurarSeleccion();
  });

  // Boton "copiar" del ID de tecnico (Paso 3.2): copia al portapapeles y
  // muestra un tooltip de confirmacion breve.
  document.querySelectorAll<HTMLButtonElement>("[data-copy-value]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const valor = btn.dataset.copyValue ?? "";
      try {
        await navigator.clipboard.writeText(valor);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = valor;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }
      btn.classList.add("copiado");
      window.setTimeout(() => btn.classList.remove("copiado"), 1500);
    });
  });
</script>

<script>
  // Sección "Prueba Social" después de los 6 pasos: sortea 3 reseñas del
  // pool completo (embebido en [data-testimonios]) en CADA carga/F5, no
  // solo por deploy — mismo criterio que la grilla de errores del Hero del
  // Home. Reemplaza las 3 elegidas al azar en el build (SSR/no-JS) apenas
  // carga la página.
  function escapeAttr(str: string) {
    return str.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string);
  }

  interface Testimonio {
    imagen: string;
    destino: string;
  }

  document.querySelectorAll<HTMLElement>("[data-testimonios]").forEach((seccion) => {
    let pool: Testimonio[];
    try {
      pool = JSON.parse(seccion.dataset.testimonios ?? "[]");
    } catch {
      return;
    }
    if (!Array.isArray(pool) || pool.length === 0) return;

    const grid = seccion.querySelector<HTMLElement>("[data-testimonios-grid]");
    if (!grid) return;

    const barajado = [...pool];
    for (let i = barajado.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [barajado[i], barajado[j]] = [barajado[j], barajado[i]];
    }

    grid.innerHTML = barajado
      .slice(0, 3)
      .map(
        (testimonio) => `
          <a class="resenas-dinamicas-card" href="${escapeAttr(testimonio.destino)}" target="_blank" rel="noopener noreferrer nofollow">
            <img src="${escapeAttr(testimonio.imagen)}" alt="" loading="lazy" />
          </a>`
      )
      .join("");
  });
</script>

<style>
  .procedimiento-resumen-detalle {
    display: grid;
    gap: 2.5rem;
  }

  .selector-diagnostico {
    display: grid;
    gap: 1.1rem;
    padding: 1.5rem;
    border-radius: 16px;
    background: var(--color-bg-card);
    box-shadow: var(--shadow-card);
  }

  /* Selector "en escalera": Marca -> Modelo -> Error aparecen uno tras
     otro (ver el script de arriba); este fade + desplazamiento breve es
     lo que da la sensación de "escalón" cada vez que un bloque nuevo se
     revela, en vez de aparecer de golpe. */
  @keyframes selector-escalon {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .selector-marcas,
  .selector-errores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .selector-errores {
    display: none;
    animation: selector-escalon 0.3s ease-out;
  }

  .selector-btn {
    padding: 0.6rem 1.1rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .selector-btn:hover {
    border-color: #1d4ed8;
  }

  .selector-btn-activo {
    border-color: #1d4ed8;
    background: #1d4ed8;
    color: white;
  }

  .selector-modelo-wrap {
    display: none;
    gap: 0.4rem;
    max-width: 320px;
    animation: selector-escalon 0.3s ease-out;
  }

  .selector-modelo-wrap label {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .selector-modelo-wrap input {
    padding: 0.6rem 0.9rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
