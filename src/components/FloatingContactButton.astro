---
import { t } from "../i18n/utils";
import ContactForm from "./ui/ContactForm.astro";
import type { Locale } from "../config/site";

interface Props {
  locale: Locale;
  marcaDefault?: string;
  modeloDefault?: string;
}

const { locale, marcaDefault, modeloDefault } = Astro.props;
---

<div class="floating-contact" data-contact-modal>
  <button type="button" class="floating-contact-trigger" data-sound="select" aria-haspopup="dialog">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
      <path
        d="M4 5h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H8l-4 3V7a1 1 0 0 1 1-1Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path d="M8 10h8M8 13h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <span>{t(locale, "contactForm.botonFlotante")}</span>
  </button>

  <dialog class="floating-contact-dialog">
    <button type="button" class="floating-contact-close" data-sound="select" aria-label={t(locale, "contactForm.cerrarModal")}>
      ×
    </button>
    <h2>{t(locale, "contactForm.tituloModal")}</h2>
    <ContactForm locale={locale} marcaDefault={marcaDefault} modeloDefault={modeloDefault} idPrefix="cf-flotante" />
  </dialog>
</div>

<script>
  document.querySelectorAll("[data-contact-modal]").forEach((wrapper) => {
    const trigger = wrapper.querySelector(".floating-contact-trigger");
    const dialog = wrapper.querySelector("dialog");
    const closeBtn = wrapper.querySelector(".floating-contact-close");
    if (!trigger || !dialog || !closeBtn) return;

    trigger.addEventListener("click", () => dialog.showModal());
    closeBtn.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .floating-contact {
    position: fixed;
    right: var(--space-sm);
    bottom: calc(var(--space-sm) + 3.75rem);
    z-index: 39;
  }

  .floating-contact-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: white;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-floating);
  }

  .floating-contact-trigger:hover {
    background: var(--color-primary-dark);
  }

  @media (max-width: 480px) {
    .floating-contact {
      bottom: calc(var(--space-sm) + 3.5rem);
    }

    .floating-contact-trigger span {
      display: none;
    }

    .floating-contact-trigger {
      padding: 0.7rem;
    }
  }

  .floating-contact-dialog {
    position: fixed;
    margin: auto;
    border: none;
    border-radius: var(--radius-md);
    padding: var(--space-md);
    max-width: min(92vw, 560px);
    max-height: 88vh;
    overflow-y: auto;
    background: var(--color-bg-card);
    box-shadow: var(--shadow-floating);
  }

  .floating-contact-dialog::backdrop {
    background: rgba(15, 23, 42, 0.6);
  }

  .floating-contact-dialog h2 {
    margin: 0 0 0.9rem;
    padding-right: 2rem;
  }

  .floating-contact-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    color: var(--color-text);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .floating-contact-close:hover {
    background: var(--color-border);
  }
</style>
