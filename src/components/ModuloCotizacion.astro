---
/**
 * Paso 4 (Cotización y Pago): el visitante elige un plan y un método de
 * pago, y pide los datos de pago por WhatsApp o correo — NUNCA se
 * muestran números de cuenta/CLABE/etc. en pantalla, eso lo entrega un
 * humano por el canal elegido.
 *
 * Datos 100% client-side (no SSG): el país del visitante solo se conoce
 * en el momento real de la visita (vía /api/pais.json, que lee
 * request.cf.country en el borde de Cloudflare — la API de Geolocation
 * del navegador está deshabilitada a propósito en este sitio, ver
 * Permissions-Policy en src/middleware.ts). Por eso este componente no
 * intenta resolver los planes en build time: renderiza un esqueleto de
 * carga y un script del lado del cliente hace
 * /api/pais.json -> /api/public/cotizacion/ contra Núcleo.
 *
 * GET /api/public/cotizacion/?pais=..&marca=.. YA está en producción
 * (probado en vivo, degrada solo a USD/COP genérico si falta el país o
 * la marca — nunca hay que inventar un fallback propio para eso).
 *
 * POST /api/public/enviar-cotizacion TODAVÍA NO EXISTE en Núcleo (hoy
 * responde 404, probado en vivo) — se llama de todos modos, así empieza a
 * funcionar solo en cuanto el backend lo despliegue, sin tocar este
 * componente. Si falla (404 o cualquier error de red) se muestra un
 * error honesto invitando a WhatsApp, nunca un "éxito" falso.
 */
import { t } from "../i18n/utils";
import { WHATSAPP_NUMBER, NUCLEO_API_BASE_URL, type Locale } from "../config/site";

interface Props {
  marca: string;
  marcaSlug: string;
  modelo: string;
  locale: Locale;
}

const { marca, marcaSlug, modelo, locale } = Astro.props;

const PLANES = ["esencial", "profesional", "elite"] as const;

const planLabels: Record<(typeof PLANES)[number], string> = {
  esencial: t(locale, "cotizacion.planEsencial"),
  profesional: t(locale, "cotizacion.planProfesional"),
  elite: t(locale, "cotizacion.planElite"),
};

const textos = {
  cargando: t(locale, "cotizacion.cargando"),
  errorCarga: t(locale, "cotizacion.errorCarga"),
  destacadoBadge: t(locale, "cotizacion.destacadoBadge"),
  selectMetodoPago: t(locale, "cotizacion.selectMetodoPago"),
  selectMetodoPlaceholder: t(locale, "cotizacion.selectMetodoPlaceholder"),
  btnWhatsapp: t(locale, "cotizacion.btnWhatsapp"),
  btnEmail: t(locale, "cotizacion.btnEmail"),
  emailPlaceholder: t(locale, "cotizacion.emailPlaceholder"),
  emailInvalido: t(locale, "cotizacion.emailInvalido"),
  btnEnviar: t(locale, "cotizacion.btnEnviar"),
  enviando: t(locale, "cotizacion.enviando"),
  exitoEnvio: t(locale, "cotizacion.exitoEnvio"),
  errorEnvio: t(locale, "cotizacion.errorEnvio"),
  mensajeWhatsappTemplate: t(locale, "cotizacion.mensajeWhatsapp"),
};
---

<div
  class="cotizacion-modulo"
  data-cotizacion
  data-marca-slug={marcaSlug}
  data-marca={marca}
  data-modelo={modelo}
  data-whatsapp-number={WHATSAPP_NUMBER}
  data-nucleo-base={NUCLEO_API_BASE_URL}
  data-mensaje-template={textos.mensajeWhatsappTemplate}
  data-texto-exito={textos.exitoEnvio}
  data-texto-error-envio={textos.errorEnvio}
  data-texto-enviando={textos.enviando}
  data-texto-email-invalido={textos.emailInvalido}
  data-texto-select-placeholder={textos.selectMetodoPlaceholder}
>
  <p class="cotizacion-cargando" data-cotizacion-cargando>{textos.cargando}</p>
  <p class="cotizacion-error" data-cotizacion-error hidden>{textos.errorCarga}</p>

  <div class="cotizacion-grid" data-cotizacion-grid hidden>
    {
      PLANES.map((planId) => (
        <div class:list={["cotizacion-card", { "cotizacion-card-destacada": planId === "profesional" }]} data-cotizacion-card data-plan-id={planId}>
          {planId === "profesional" && <span class="cotizacion-badge">{textos.destacadoBadge}</span>}
          <h3 class="cotizacion-card-titulo">{planLabels[planId]}</h3>
          <p class="cotizacion-card-precio" data-plan-precio-display>—</p>

          <label class="cotizacion-select-label">
            {textos.selectMetodoPago}
            <select class="cotizacion-select-metodo" data-metodo-select></select>
          </label>

          <div class="cotizacion-acciones" data-acciones-pago>
            <a
              class="cotizacion-btn cotizacion-btn-whatsapp"
              data-btn-whatsapp
              href="#"
              data-sound="confirm"
              target="_blank"
              rel="noopener noreferrer nofollow"
            >
              {textos.btnWhatsapp}
            </a>
            <button type="button" class="cotizacion-btn cotizacion-btn-email" data-btn-email>
              {textos.btnEmail}
            </button>
          </div>

          <div class="cotizacion-email-form" data-email-form hidden>
            <input type="email" class="cotizacion-email-input" data-email-input placeholder={textos.emailPlaceholder} autocomplete="email" />
            <button type="button" class="cotizacion-btn cotizacion-btn-enviar" data-btn-enviar>
              {textos.btnEnviar}
            </button>
            <p class="cotizacion-email-estado" data-email-estado role="status" aria-live="polite"></p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-cotizacion]").forEach((modulo) => {
    const marcaSlug = modulo.dataset.marcaSlug || "";
    const marca = modulo.dataset.marca || "";
    const modeloNombre = modulo.dataset.modelo || "";
    const whatsappNumber = modulo.dataset.whatsappNumber || "";
    const nucleoBase = modulo.dataset.nucleoBase || "";
    const mensajeTemplate = modulo.dataset.mensajeTemplate || "";
    const textoExito = modulo.dataset.textoExito || "";
    const textoErrorEnvio = modulo.dataset.textoErrorEnvio || "";
    const textoEnviando = modulo.dataset.textoEnviando || "";
    const textoEmailInvalido = modulo.dataset.textoEmailInvalido || "";
    const textoSelectPlaceholder = modulo.dataset.textoSelectPlaceholder || "";

    const cargando = modulo.querySelector<HTMLElement>("[data-cotizacion-cargando]");
    const errorCarga = modulo.querySelector<HTMLElement>("[data-cotizacion-error]");
    const grid = modulo.querySelector<HTMLElement>("[data-cotizacion-grid]");
    const tarjetas = modulo.querySelectorAll<HTMLElement>("[data-cotizacion-card]");

    function emailValido(valor: string): boolean {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(valor);
    }

    function construirMensajeWhatsapp(planNombre: string, planPrecio: string, metodoNombre: string): string {
      return mensajeTemplate
        .replaceAll("{marca}", marca)
        .replaceAll("{modelo}", modeloNombre)
        .replaceAll("{plan}", planNombre)
        .replaceAll("{precio}", planPrecio)
        .replaceAll("{metodo}", metodoNombre || "—");
    }

    function actualizarHrefWhatsapp(tarjeta: HTMLElement) {
      const btn = tarjeta.querySelector<HTMLAnchorElement>("[data-btn-whatsapp]");
      const select = tarjeta.querySelector<HTMLSelectElement>("[data-metodo-select]");
      if (!btn) return;
      const planNombre = tarjeta.dataset.planNombre || "";
      const planPrecio = tarjeta.dataset.planPrecioTexto || "";
      const metodoNombre = select?.selectedOptions[0]?.textContent?.trim() || "";
      const mensaje = construirMensajeWhatsapp(planNombre, planPrecio, metodoNombre);
      btn.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`;
    }

    function inicializarTarjeta(tarjeta: HTMLElement) {
      const select = tarjeta.querySelector<HTMLSelectElement>("[data-metodo-select]");
      const btnEmail = tarjeta.querySelector<HTMLButtonElement>("[data-btn-email]");
      const acciones = tarjeta.querySelector<HTMLElement>("[data-acciones-pago]");
      const emailForm = tarjeta.querySelector<HTMLElement>("[data-email-form]");
      const emailInput = tarjeta.querySelector<HTMLInputElement>("[data-email-input]");
      const btnEnviar = tarjeta.querySelector<HTMLButtonElement>("[data-btn-enviar]");
      const emailEstado = tarjeta.querySelector<HTMLElement>("[data-email-estado]");

      select?.addEventListener("change", () => actualizarHrefWhatsapp(tarjeta));

      btnEmail?.addEventListener("click", () => {
        if (acciones) acciones.hidden = true;
        if (emailForm) emailForm.hidden = false;
        emailInput?.focus();
      });

      btnEnviar?.addEventListener("click", async () => {
        const email = emailInput?.value.trim() || "";
        if (!emailEstado) return;

        if (!emailValido(email)) {
          emailEstado.textContent = textoEmailInvalido;
          emailEstado.dataset.tipo = "error";
          return;
        }

        const planNombre = tarjeta.dataset.planNombre || "";
        const planPrecio = tarjeta.dataset.planPrecioTexto || "";
        const metodoNombre = select?.selectedOptions[0]?.textContent?.trim() || "";

        if (btnEnviar) btnEnviar.disabled = true;
        emailEstado.textContent = textoEnviando;
        emailEstado.dataset.tipo = "";

        try {
          const respuesta = await fetch(`${nucleoBase}/api/public/enviar-cotizacion`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              impresora: `${marca} ${modeloNombre}`.trim(),
              plan_nombre: planNombre,
              plan_precio: planPrecio,
              metodo_pago: metodoNombre,
            }),
          });
          if (!respuesta.ok) throw new Error("enviar_cotizacion_failed");
          emailEstado.textContent = textoExito;
          emailEstado.dataset.tipo = "exito";
        } catch {
          emailEstado.textContent = textoErrorEnvio;
          emailEstado.dataset.tipo = "error";
        } finally {
          if (btnEnviar) btnEnviar.disabled = false;
        }
      });
    }

    tarjetas.forEach(inicializarTarjeta);

    async function cargar() {
      try {
        const paisRespuesta = await fetch("/api/pais.json").catch(() => null);
        const { codigo_pais: codigoPais } = paisRespuesta && paisRespuesta.ok ? await paisRespuesta.json() : { codigo_pais: null };

        const params = new URLSearchParams({ marca: marcaSlug });
        if (codigoPais) params.set("pais", codigoPais);

        const respuesta = await fetch(`${nucleoBase}/api/public/cotizacion/?${params.toString()}`);
        if (!respuesta.ok) throw new Error("cotizacion_failed");
        const datos = await respuesta.json();

        const metodosPago: { id: number; nombre: string }[] = datos.metodos_pago || [];
        const planes: Record<string, string> = datos.planes || {};
        const moneda = datos.moneda || "";
        const simbolo = datos.simbolo || "";

        tarjetas.forEach((tarjeta) => {
          const planId = tarjeta.dataset.planId || "";
          const precioNumero = planes[planId];
          if (precioNumero === undefined) {
            tarjeta.hidden = true;
            return;
          }
          const precioTexto = `${simbolo}${precioNumero} ${moneda}`.trim();
          tarjeta.dataset.planNombre = tarjeta.querySelector(".cotizacion-card-titulo")?.textContent?.trim() || planId;
          tarjeta.dataset.planPrecioTexto = precioTexto;

          const precioDisplay = tarjeta.querySelector<HTMLElement>("[data-plan-precio-display]");
          if (precioDisplay) precioDisplay.textContent = precioTexto;

          const select = tarjeta.querySelector<HTMLSelectElement>("[data-metodo-select]");
          if (select) {
            select.innerHTML = "";
            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = textoSelectPlaceholder;
            select.appendChild(placeholder);
            metodosPago.forEach((metodo) => {
              const option = document.createElement("option");
              option.value = String(metodo.id);
              option.textContent = metodo.nombre;
              select.appendChild(option);
            });
          }

          actualizarHrefWhatsapp(tarjeta);
        });

        if (cargando) cargando.hidden = true;
        if (grid) grid.hidden = false;
      } catch {
        if (cargando) cargando.hidden = true;
        if (errorCarga) errorCarga.hidden = false;
      }
    }

    cargar();
  });
</script>

<style>
  .cotizacion-modulo {
    display: grid;
    gap: 1rem;
  }

  .cotizacion-cargando {
    color: var(--color-text-subtle);
    text-align: center;
  }

  .cotizacion-error[hidden],
  .cotizacion-grid[hidden] {
    display: none;
  }

  .cotizacion-error {
    color: var(--color-warning-text);
    text-align: center;
    font-weight: 600;
  }

  .cotizacion-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: start;
  }

  @media (max-width: 1023px) {
    .cotizacion-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .cotizacion-grid {
      grid-template-columns: 1fr;
    }
  }

  .cotizacion-card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    text-align: center;
  }

  .cotizacion-card[hidden] {
    display: none;
  }

  .cotizacion-card-destacada {
    border-color: var(--color-primary);
    border-width: 2px;
    box-shadow: var(--shadow-card);
  }

  .cotizacion-badge {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .cotizacion-card-titulo {
    margin: 0;
    color: var(--color-primary-dark);
  }

  .cotizacion-card-precio {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
  }

  .cotizacion-select-label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    text-align: left;
  }

  .cotizacion-select-metodo {
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-card);
    font: inherit;
  }

  .cotizacion-acciones {
    display: grid;
    gap: 0.5rem;
  }

  .cotizacion-acciones[hidden] {
    display: none;
  }

  .cotizacion-btn {
    display: block;
    width: 100%;
    padding: 0.6rem;
    border: none;
    border-radius: var(--radius-sm);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
  }

  .cotizacion-btn-whatsapp {
    background: #25d366;
    color: white;
  }

  .cotizacion-btn-email {
    background: var(--color-bg-card);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .cotizacion-email-form {
    display: grid;
    gap: 0.5rem;
  }

  .cotizacion-email-form[hidden] {
    display: none;
  }

  .cotizacion-email-input {
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font: inherit;
  }

  .cotizacion-btn-enviar {
    background: var(--color-primary);
    color: white;
  }

  .cotizacion-btn-enviar:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .cotizacion-email-estado {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    min-height: 1.2em;
  }

  .cotizacion-email-estado[data-tipo="error"] {
    color: var(--color-warning-text);
  }

  .cotizacion-email-estado[data-tipo="exito"] {
    color: var(--color-primary-dark);
  }
</style>
