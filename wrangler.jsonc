{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resetentupc",
  // Dominios personalizados (la zona resetentupc.com está en esta misma cuenta de Cloudflare).
  // No usar el nombre "resetenlinea-site": es el Worker del sitio anterior.
  // www.resetentupc.com lo atiende el Worker "resetentupc-www" (carpeta redirect-www/), que redirige al dominio principal.
  "routes": [{ "pattern": "resetentupc.com", "custom_domain": true }],
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    // IMPORTANTE — probado y revertido: poner esto en `true` (Worker corre
    // siempre) rompe en producción TODAS las páginas de modelo prerenderizadas
    // (/reset/{marca}/{modelo}/, generadas via getStaticPaths), que empiezan
    // a dar 404 — el fallback de `next()` hacia el asset estático no
    // funciona igual para rutas dinámicas prerenderizadas que para archivos
    // .astro de nivel superior. Confirmado en vivo: con `true`, "/" y
    // "/como-funciona/" seguían en 200 pero "/reset/epson/l3210/" pasó a
    // 404 (¡con minúsculas correctas, sin ningún typo!). No volver a poner
    // `true` sin resolver antes ese problema.
    //
    // ru/ko están retirados (ver RETIRED_LOCALES en config/site.ts): el
    // Worker debe correr SIEMPRE en estas rutas para que el redirect de
    // middleware.ts se aplique, incluso si Cloudflare ya tiene el archivo
    // estático viejo cacheado en el borde — sin esto, un hit de caché sirve
    // el HTML directo y nunca pasa por el middleware.
    //
    // Los 4 patrones de abajo (tecnico/usb/modulo/asistente-tecnico) son
    // URLs viejas de WordPress SIN archivo estático propio — el middleware
    // SIEMPRE responde con un redirect 301 para ellas (nunca llama next()),
    // así que agregarlas acá es seguro. NO agregar "/reset/*" ni un patrón
    // amplio: se probó y rompe en producción las páginas de modelo
    // prerenderizadas (/reset/{marca}/{modelo}/, via getStaticPaths) — el
    // fallback de next() hacia el asset estático no las sirve bien cuando
    // el Worker corre primero. El caso de /reset/Epson/L3210/ (mayúsculas)
    // queda sin resolver hasta encontrar otra forma de arreglarlo.
    // Prueba Social OCULTA (PRUEBA_SOCIAL_VISIBLE = false en src/config/site.ts): las páginas principales
    // /prueba-social/ y /{idioma}/prueba-social son estáticas (prerenderizadas), así que sin estas
    // entradas Cloudflare las serviría directo y el redirect 302 de middleware.ts nunca correría. Mientras
    // esté oculta, el middleware SIEMPRE redirige (nunca llama next()), igual que los patrones de
    // WordPress de abajo. SI SE VUELVE A MOSTRAR (PRUEBA_SOCIAL_VISIBLE = true), QUITAR estas entradas
    // "prueba-social" (ru/ko ya están cubiertos por /ru/* y /ko/*), o el Worker correría primero en
    // rutas prerenderizadas y podrían dar 404 (ver advertencia de arriba).
    "run_worker_first": [
      "/prueba-social",
      "/prueba-social/*",
      "/en/prueba-social",
      "/en/prueba-social/*",
      "/pt/prueba-social",
      "/pt/prueba-social/*",
      "/fr/prueba-social",
      "/fr/prueba-social/*",
      "/it/prueba-social",
      "/it/prueba-social/*",
      "/de/prueba-social",
      "/de/prueba-social/*",
      "/pl/prueba-social",
      "/pl/prueba-social/*",
      "/nl/prueba-social",
      "/nl/prueba-social/*",
      // Consultar Garantía OCULTA (CONSULTA_GARANTIA_VISIBLE = false): mismas razones que Prueba Social; son
      // páginas estáticas, así que el Worker debe correr primero para que el redirect 302 se aplique. Quitar
      // estas entradas si se vuelve a `true`. (ru/ko ya están cubiertos por /ru/* y /ko/*.)
      "/consulta-garantia",
      "/consulta-garantia/*",
      "/en/warranty-check",
      "/en/warranty-check/*",
      "/pt/consulta-garantia",
      "/pt/consulta-garantia/*",
      "/fr/verifier-garantie",
      "/fr/verifier-garantie/*",
      "/it/verifica-garanzia",
      "/it/verifica-garanzia/*",
      "/de/garantie-abfrage",
      "/de/garantie-abfrage/*",
      "/pl/sprawdz-gwarancje",
      "/pl/sprawdz-gwarancje/*",
      "/nl/garantie-controleren",
      "/nl/garantie-controleren/*",
      "/ru/*",
      "/ko/*",
      "/tecnico",
      "/tecnico/*",
      "/asistente-tecnico",
      "/asistente-tecnico/*",
      "/usb",
      "/usb/*",
      "/modulo",
      "/modulo/*",
      "/modulo-seguro",
      "/modulo-seguro/*"
    ]
  }
}
